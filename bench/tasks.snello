// Tasks and channels: the cost of a spawn, one hundred thousand tasks
// started and waited for, and of a context switch, a value handed
// back and forth over unbuffered channels a million times.

package main

import (
	"fmt"
	"time"
)

func nothing(done chan ()) {
	done <- ()
}

func echo(in chan int, out chan int) {
	for v := range in {
		out <- v
	}
}

func main() {
	start := time.Now()
	done := make(chan (), 100000)
	for i := 0; i < 100000; i++ {
		spawn nothing(done.Clone())
	}

	for i := 0; i < 100000; i++ {
		<-done
	}

	spawned := time.Since(start)
	in := make(chan int)
	out := make(chan int)
	spawn echo(in.Clone(), out.Clone())
	start = time.Now()
	for i := 0; i < 500000; i++ {
		in <- i
		<-out
	}

	switched := time.Since(start)
	close(in)
	fmt.Println("spawn", spawned/100000, "ns/op switch", switched/1000000, "ns/op")
}
