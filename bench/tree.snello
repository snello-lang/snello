// Allocation-heavy code: binary trees built, walked and freed, one
// block per node, as the classic benchmark does.

package main

import "fmt"

struct Node {
	left  *Node?
	right *Node?
}

func build(depth int) *Node {
	if depth == 0 {
		return &Node{left: None, right: None}
	}

	return &Node{left: Some(build(depth - 1)), right: Some(build(depth - 1))}
}

func count(n ref Node) int {
	total := 1
	if l := n.left {
		total += count(l)
	}

	if r := n.right {
		total += count(r)
	}

	return total
}

func main() {
	total := 0
	for i := 0; i < 20; i++ {
		t := build(16)
		total += count(t)
	}

	fmt.Println(total)
}
