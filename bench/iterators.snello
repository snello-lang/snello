// Iterator adapters: the sum of the squares of the even numbers among
// a million, twenty times over, through iter's Filter, Map and Fold
// over a slice's iterator, the same slice walked from the back by Rev,
// a deque's iterator and an iterator that counts, and through the loops
// written by hand that do the same; it prints the sums, then the cost
// of an item of each, in tenths of a nanosecond.

package main

import (
	"deque"
	"fmt"
	"iter"
	"time"
)

const items = 1000000
const rounds = 20

// The timings are printed in tenths of a nanosecond an item.
const tenthsPerNanosecond i64 = 10

// A Count gives the numbers from next up to end.
struct Count impl iter.Iterator<int> {
	next int
	end  int
}

func (c mut Count) Next() int? {
	if c.next >= c.end {
		return None
	}

	c.next++
	return Some(c.next - 1)
}

func lentSquare(x ref int) int { return *x * *x }

func even(x ref int) bool { return *x % 2 == 0 }

func square(x int) int { return x * x }

func add(total int, x int) int { return total + x }

// overSlice times the chains and the loop over a slice of the items,
// and returns their totals and times; the slice is dropped as it
// returns.
func overSlice() (int, int, int, int, time.Duration, time.Duration, time.Duration) {
	xs := make([]int, 0, items) // the room reserved, as the Go program reserves it
	for i := 0; i < items; i++ {
		xs.Push(i)
	}

	// A round discarded, so that the first section timed does not pay for
	// the cold cache and the clock's ramp, as the suite discards each
	// program's first run.
	warm := iter.Over(ref xs).Filter(even).Map(lentSquare).Fold(0, add)
	sliceChain := 0
	start := time.Now()
	for r := 0; r < rounds; r++ {
		sliceChain += iter.Over(ref xs).Filter(even).Map(lentSquare).Fold(0, add)
	}

	sliceChainTime := time.Since(start)
	sliceLoop := 0
	start = time.Now()
	for r := 0; r < rounds; r++ {
		for _, x := range ref xs {
			if *x % 2 == 0 {
				sliceLoop += *x * *x
			}
		}
	}

	sliceLoopTime := time.Since(start)
	rev := 0
	start = time.Now()
	for r := 0; r < rounds; r++ {
		rev += iter.Over(ref xs).Rev().Filter(even).Map(lentSquare).Fold(0, add)
	}

	revTime := time.Since(start)
	return (warm, sliceChain, sliceLoop, rev, sliceChainTime, sliceLoopTime, revTime)
}

func main() {
	// The slice's rows first, and the slice dropped before the deque is
	// built, so that the program holds one collection at a time, as the
	// Go program holds its slice alone, and the peaks compare.
	warm, sliceChain, sliceLoop, rev, sliceChainTime, sliceLoopTime, revTime := overSlice()
	d := deque.New<int>()
	for i := 0; i < items; i++ {
		d.PushBack(i)
	}

	chain := 0
	start := time.Now()
	for r := 0; r < rounds; r++ {
		chain += d.Iter().Filter(even).Map(lentSquare).Fold(0, add)
	}

	chainTime := time.Since(start)
	loop := 0
	start = time.Now()
	for r := 0; r < rounds; r++ {
		for x := range d.Iter() {
			if *x % 2 == 0 {
				loop += *x * *x
			}
		}
	}

	loopTime := time.Since(start)
	counted := 0
	start = time.Now()
	for r := 0; r < rounds; r++ {
		counted += Count{next: 0, end: d.Len()}.Filter(even).Map(square).Fold(0, add)
	}

	countedTime := time.Since(start)
	plain := 0
	end := d.Len() // known when the program runs, as the iterators' end is, so that the loop is not worked out when it is compiled
	start = time.Now()
	for r := 0; r < rounds; r++ {
		for i := 0; i < end; i++ {
			if i % 2 == 0 {
				plain += i * i
			}
		}
	}

	plainTime := time.Since(start)
	n := i64(items * rounds)
	if chain != sliceChain || loop != sliceLoop {
		fmt.Println("the deque's totals differ from the slice's", chain, loop)
	}

	fmt.Println(warm, sliceChain, sliceLoop, rev, counted, plain) // the totals the Go program prints, held equal by the suite
	fmt.Println("slice chain", sliceChainTime.Nanoseconds() * tenthsPerNanosecond / n, "slice loop", sliceLoopTime.Nanoseconds() * tenthsPerNanosecond / n, "rev chain", revTime.Nanoseconds() * tenthsPerNanosecond / n, "deque chain", chainTime.Nanoseconds() * tenthsPerNanosecond / n, "deque loop", loopTime.Nanoseconds() * tenthsPerNanosecond / n, "count chain", countedTime.Nanoseconds() * tenthsPerNanosecond / n, "count loop", plainTime.Nanoseconds() * tenthsPerNanosecond / n)
}
