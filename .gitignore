# The compiler built with go build -o teak ./cmd/teak.
/teak

# Binaries teak build writes next to the example programs.
/examples/run/*
!/examples/run/*.teak
!/examples/run/*.out
!/examples/run/README.md

# Objects a C compiler leaves when the runtime is compiled by hand; the
# builds themselves work in a temporary directory.
*.o

.DS_Store
Thumbs.db

.tools/
.idea/
.vscode/
*.iml