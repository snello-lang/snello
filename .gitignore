# The compiler built with go build -o snello ./cmd/snello, or into
# bin/ by make build.
/snello
/bin/

# Binaries snello build writes next to the example programs, or inside
# a program directory built from within; at any depth, the sources,
# a package's C side, the module files, the Go versions and the tests,
# the expected outputs and scripts, the READMEs and the fixture
# directories stay.
/examples/**
!/examples/**/
!/examples/**/*.snello
!/examples/**/*.go
!/examples/**/*.c
!/examples/**/*.h
!/examples/**/*.out
!/examples/**/*.script
!/examples/**/snello.mod
!/examples/**/README.md
!/examples/*.files/**

# Objects a C compiler leaves when the runtime is compiled by hand; the
# builds themselves work in a temporary directory.
*.o

.DS_Store
Thumbs.db

.tools/
.idea/
.vscode/
*.iml
