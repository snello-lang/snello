// Text, whole: a range over a string, its runes as a slice, a rune
// asked about and changed by the unicode package, its category and
// script, read and written in UTF-8 and UTF-16, a string that is not
// valid UTF-8, full case mapping and comparison ignoring case, the
// normalization forms, and text cut into graphemes, words and
// sentences. Chapter 19 of the book is cut from this program.

package main

import ("fmt"; "strings"; "unicode"; "unicode/norm"; "unicode/segment"; "unicode/utf16"; "unicode/utf8")

// title upper-cases the first letter of every word: the range gives
// each rune, whatever its width in bytes.
func title(s ref string) string {
	var b strings.Builder
	start := true
	for _, r := range s {
		if start && unicode.IsLetter(r) {
			b.WriteRune(unicode.ToUpper(r))
		} else {
			b.WriteRune(r)
		}

		start = unicode.IsSpace(r)
	}

	return b.String()
}

// counts says how many letters, digits and spaces s holds.
func counts(s ref string) (int, int, int) {
	letters, digits, spaces := 0, 0, 0
	for _, r := range s {
		if unicode.IsLetter(r) {
			letters += 1
		} else if unicode.IsDigit(r) {
			digits += 1
		} else if unicode.IsSpace(r) {
			spaces += 1
		}
	}

	return (letters, digits, spaces)
}

func main() {
	s := "héllo, 世界"
	for i, r := range s {
		fmt.Println(i, r, utf8.RuneLen(r))
	}

	fmt.Println(len(s), len(s.Runes()), s[1], s.Runes()[1])
	rs := s.Runes()
	rs.Push('!')
	fmt.Println(string(rs), string(rs[1]), string('x')) // back from runes to a string
	fmt.Println(title("élan vital 2 mondo"))
	letters, digits, spaces := counts("Año 2026 ٣ times")
	fmt.Println(letters, digits, spaces)

	// Bytes in, runes out, and back.
	p := []byte{}
	utf8.AppendRune(mut p, 'é')
	utf8.AppendRune(mut p, 0x1F600)
	r, n := utf8.DecodeRune(ref p)
	fmt.Println(p, r, n)

	// A string that is not valid UTF-8 reads its stray bytes as U+FFFD,
	// one byte each.
	for i, r := range "a\xffb" {
		fmt.Println(i, r, r == utf8.RuneError)
	}

	// Counting bytes is the counted loop; it allocates nothing.
	ascii := 0
	for i := 0; i < len(s); i++ {
		if s[i] < 0x80 {
			ascii += 1
		}
	}

	fmt.Println(ascii)

	// A rune's category, script and values.
	for _, r := range "A٣€Ж世" {
		fmt.Println(r, unicode.Category(r), unicode.Script(r), unicode.ScriptCode(r), unicode.IsSymbol(r), unicode.IsNumber(r))
	}

	fmt.Println(unicode.DigitValue(0x0663), unicode.NumericValue(0x216B), unicode.IsAlphabetic(0x093E), unicode.IsIDStart('_'), unicode.IsEmoji(0x1F600))

	// Full case mapping on strings, and comparison ignoring case.
	fmt.Println(strings.ToUpper("straße"), strings.ToLower("ΟΔΥΣΣΕΥΣ"), strings.ToTitle("straße ﬁx ǆungla"))
	fmt.Println(strings.EqualIgnoreCase("Straße", "STRASSE"), strings.EqualIgnoreCase("ı", "I"))
	fmt.Println(utf8.ValidString("añ"), utf8.ValidString("a\xff"), utf8.RuneCountInString("añ世"))

	// UTF-16, for a system that speaks it, as units and as bytes.
	units := utf16.Encode(ref "a😀".Runes())
	fmt.Println(units, utf16.Decode(ref units))
	fmt.Println(utf16.EncodeBytes("a😀", utf16.LittleEndian, true), utf16.DecodeBytes(ref []byte{0xFF, 0xFE, 97, 0}, utf16.BigEndian))

	// The same text written two ways is equal once normalized.
	one := "caf\u00E9"
	two := "cafe\u0301"
	fmt.Println(one == two, norm.String(norm.NFC, ref one) == norm.String(norm.NFC, ref two), len(one), len(two))
	fmt.Println(norm.String(norm.NFKC, "ﬁ x²"))

	// What a reader sees as characters, words and sentences.
	flags := "e\u0301🇫🇷👍🏽"
	fmt.Println(len(flags), utf8.RuneCountInString(flags), segment.Count(segment.Grapheme, ref flags))
	for w := range segment.Words("Hello, wörld! 3.14") {
		if segment.IsWord(w) {
			fmt.Printf("[%s]", w)
		}
	}

	fmt.Println()
	for s := range segment.Sentences("It rained. We stayed in! Did you?") {
		fmt.Printf("[%s]", s)
	}

	fmt.Println()

	// A walk by offsets reads the same boundaries one at a time.
	text := "Hi. Bye."
	at := 0
	for {
		match segment.Next(segment.Sentence, ref text, at) {
			None => break,
			Some(end) => {
				fmt.Printf("[%s]", text[at:end])
				at = end
			},
		}
	}

	fmt.Println()
}
