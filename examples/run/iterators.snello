// Generic traits: an Iterator<T> trait with a required Next and default
// adapters, one with a type parameter of its own, a Range implementing
// Iterator<int>, generic MapIter and FilterIter structs bounded by the
// trait and implementing it over their own parameters, a chain of Map,
// Filter and Collect over a named function and over closures, and a
// mut method called on a temporary.

package main

import "fmt"

trait Iterator<T> {
	func (it mut Self) Next() T?

	func (it Self) Map<U>(f func(T) U) MapIter<Self, T, U> {
		return MapIter{inner: it, f: f}
	}
	func (it Self) Filter(keep func(ref T) bool) FilterIter<Self, T> {
		return FilterIter{inner: it, keep: keep}
	}
	func (it mut Self) Collect() []T {
		out := []T{}
		for {
			v := it.Next() ?? break
			out.Push(v)
		}
		return out
	}
}

struct Range impl Iterator<int> { cur int; end int }

func (r mut Range) Next() int? {
	if r.cur >= r.end { return None }
	r.cur += 1
	return Some(r.cur - 1)
}

struct MapIter<I: Iterator<T>, T, U> impl Iterator<U> {
	inner I
	f     func(T) U
}

func (m mut MapIter<I, T, U>) Next() U? { return m.inner.Next().Map(m.f) }

struct FilterIter<I: Iterator<T>, T> impl Iterator<T> {
	inner I
	keep  func(ref T) bool
}

func (f mut FilterIter<I, T>) Next() T? {
	for {
		v := f.inner.Next() ?? return None
		if f.keep(ref v) { return Some(v) }
	}
}

func plusTen(x int) int { return x + 10 }

func main() {
	evens := Range{0, 5}.Map(plusTen).Filter(func(x ref int) bool { return x % 2 == 0 }).Collect()
	fmt.Println(evens)
	words := Range{1, 4}.Map(func(x int) string { return fmt.Sprint("n", x) }).Collect()
	fmt.Println(words)
	fmt.Println(Range{0, 3}.Map(plusTen).Map(func(x int) int { return x * 2 }).Collect()) // a generic method on a call's result
}
