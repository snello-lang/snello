// The standard library written in Teak: the math package imported,
// its constant read, its functions called and one the runtime
// provides, a library function passed as a value, a float printed
// with a precision, and a top-level constant of the program's own.

package main

import ("fmt"; "math")

const Scale f64 = 2.5

func apply(f func(f64) f64, x f64) f64 { return f(x) }

func main() {
	fmt.Println(math.Sqrt(16), math.Abs(-3.5), math.Min(2, 7), math.Max(2, 7))
	fmt.Printf("%.2f %.0f %f\n", math.Pi, math.Pi, 1.5)
	fmt.Println(apply(math.Sqrt, 2) > 1.41)
	fmt.Println(math.Pi * Scale)
	area := fmt.Sprintf("area %.3f", math.Pi*math.Sqrt(2)*math.Sqrt(2))
	fmt.Println(area)
}
