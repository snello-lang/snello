// The edges of io, bufio and os: an Error a program builds with
// io.NewError and the three ways an Error prints; ReadToString naming
// the step that failed, on a directory and on an empty path; WriteString
// and Remove; MkdirTemp putting its number where the pattern's last *
// is, and refusing a pattern with a /; io.Copy refusing a writer that
// claims more than it was given; a Scanner refusing a line longer than
// its limit rather than growing without one, over a reader that gives
// a few bytes a call and over a file, which gives all it is asked for;
// a Reader asked again after the end of the input, as a file being
// appended to is; and a Writer that keeps its first error for an empty
// write too, and whose size of zero is the default.

package main

import (
	"bufio"
	"fmt"
	"io"
	"os"
	"strings"
)

// Liar claims one byte more than it was given.
struct Liar impl io.Writer {
	calls int
}

func (l mut Liar) Write(p ref []byte) Result<int, io.Error> {
	l.calls++
	return Ok(len(p) + 1)
}

// Text hands out its data, at most four bytes a call.
struct Text impl io.Reader {
	data string
	pos  int
}

func (t mut Text) Read(p mut []byte) Result<int, io.Error> {
	n := 0
	for n < len(p) && n < 4 && t.pos < t.data.Len() {
		p[n] = t.data[t.pos]
		n++
		t.pos++
	}

	return Ok(n)
}

// Tail has nothing the first time it is asked, then its data four
// bytes a call, then nothing again: a file being appended to.
struct Tail impl io.Reader {
	data  string
	pos   int
	calls int
}

func (t mut Tail) Read(p mut []byte) Result<int, io.Error> {
	t.calls++
	if t.calls == 1 {
		return Ok(0)
	}

	n := 0
	for n < len(p) && n < 4 && t.pos < t.data.Len() {
		p[n] = t.data[t.pos]
		n++
		t.pos++
	}

	return Ok(n)
}

// Broken fails every write.
struct Broken impl io.Writer {
	calls int
}

func (b mut Broken) Write(p ref []byte) Result<int, io.Error> {
	b.calls++
	return Err(io.NewError("write", "disk", "broken", io.Other))
}

// Sink takes every write and counts them.
struct Sink impl io.Writer {
	calls int
}

func (s mut Sink) Write(p ref []byte) Result<int, io.Error> {
	s.calls++
	return Ok(len(p))
}

func main() {
	fmt.Println(io.NewError("parse", "config.toml", "unexpected end", io.Other))
	fmt.Println(io.NewError("decode", "", "bad header", io.Other))
	fmt.Println(io.NewError("", "", "plain message", io.Other))

	match os.ReadToString("") {
		Ok(_) => fmt.Println("read the empty path"),
		Err(e) => fmt.Println(e, e.Kind() == io.NotExist),
	}

	dir := os.MkdirTemp("", "streams-*-dir").Expect("tempdir")
	match os.ReadToString(ref dir) {
		Ok(_) => fmt.Println("read a directory"),
		Err(e) => fmt.Println(e.Op, e.Msg),
	}

	name := dir + "/note.txt"
	fmt.Println(os.WriteString(ref name, "written whole\n"), os.ReadToString(ref name))
	fmt.Println(os.Remove(ref name), os.ReadToString(ref name).IsErr())
	match os.Remove(ref name) {
		Ok(_) => fmt.Println("removed it twice"),
		Err(e) => fmt.Println(e.Op, e.Kind() == io.NotExist),
	}

	inner := os.MkdirTemp(ref dir, "pre-*-suf").Expect("inner")
	base := inner[dir.Len() + 1:]
	fmt.Println(base.HasPrefix("pre-"), base.HasSuffix("-suf"), base.Contains("*"), base.Len() > 8)
	plain := os.MkdirTemp(ref dir, "plain").Expect("plain")
	fmt.Println(plain[dir.Len() + 1:].HasPrefix("plain"), plain.Len() > dir.Len() + 6)
	fmt.Println(os.MkdirTemp(ref dir, "a/b*"))
	match os.Remove(ref dir) {
		Ok(_) => fmt.Println("removed a full directory"),
		Err(e) => fmt.Println(e.Op, "of a full directory refused"),
	}

	fmt.Println(os.Remove(ref inner), os.Remove(ref plain), os.Remove(ref dir))

	var liar Liar
	src := Text{data: "abcdefgh".Clone(), pos: 0}
	fmt.Println(io.Copy(mut liar, mut src), liar.calls)

	long := Text{data: "short\nthis line is too long\nafter\n".Clone(), pos: 0}
	sc := bufio.NewScanner(mut long)
	sc.Buffer(12)
	for sc.Scan() {
		fmt.Println("line:", sc.Text())
	}

	fmt.Println("err:", sc.Err())

	// A file gives all it is asked for at a call, and the limit holds
	// all the same.
	lines := os.MkdirTemp("", "streams-lines").Expect("tempdir")
	path := lines + "/lines.txt"
	os.WriteString(ref path, "short\nthis line is far longer than twelve bytes\n").Expect("write")
	f := os.Open(ref path).Expect("open")
	fs := bufio.NewScanner(mut f)
	fs.Buffer(12)
	for fs.Scan() {
		fmt.Println("line:", fs.Text())
	}

	fmt.Println("err:", fs.Err())
	fmt.Println(os.RemoveAll(ref lines))

	tail := Tail{data: "one\ntwo".Clone(), pos: 0, calls: 0}
	r := bufio.NewReader(mut tail)
	for i := 0; i < 4; i++ {
		fmt.Println(r.ReadString('\n'))
	}

	var broken Broken
	w := bufio.NewWriterSize(mut broken, 2)
	fmt.Println(w.WriteString("abc"), w.Get().calls)
	fmt.Println(w.Write(ref []byte{}))
	fmt.Println(w.WriteString(""))
	var sink Sink
	whole := bufio.NewWriterSize(mut sink, 0)
	whole.WriteString(strings.Repeat("x", 100)).Expect("write")
	fmt.Println(whole.Buffered(), whole.Get().calls)
	whole.Flush().Expect("flush")
	fmt.Println(whole.Buffered(), whole.Get().calls)
}
