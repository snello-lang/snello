// The standard traits: the operator traits with their methods, a right
// operand of another type, unary minus, operators on a type that moves,
// operators in a generic function over numbers and over a struct, and
// an operator on a value reached through a mut borrow, compound
// assignment on a variable and on a slice element, and a literal right
// operand taking the method's parameter type. Then the derived
// methods: Cmp, Clone and Hash written from the fields of a struct and
// of an enum with payloads, Cmp on numbers and strings, an Ordering
// printed and matched on, a generic largest-of bounded by Ord, a struct
// deriving over a field type that wrote its methods, and an argument
// with an effect evaluated once.

package main

import "fmt"

struct Vec2 impl Copy, Eq, Add, Sub, Mul<f64>, Neg {
	x, y f64
}

func (a Vec2) Add(b Vec2) Vec2 { return Vec2{x: a.x + b.x, y: a.y + b.y} }
func (a Vec2) Sub(b Vec2) Vec2 { return Vec2{x: a.x - b.x, y: a.y - b.y} }
func (a Vec2) Mul(k f64) Vec2  { return Vec2{x: a.x * k, y: a.y * k} }
func (a Vec2) Neg() Vec2       { return Vec2{x: -a.x, y: -a.y} }
func (a Vec2) Dot(b Vec2) f64  { return a.x*b.x + a.y*b.y }

// A type that owns memory moves into the operator, as into any method
// taking its receiver by value; the sum owns the result.
struct Money impl Add, Drop {
	cents    int
	currency string
}

func (a Money) Add(b Money) Money {
	return Money{cents: a.cents + b.cents, currency: a.currency.Clone()}
}

func (m mut Money) Drop() { fmt.Println("drop", m.cents, m.currency) }

func Sum<T: Add + Copy>(xs ref []T, zero T) T {
	s := zero
	for _, x := range xs {
		s += *x
	}

	return s
}

func Scale<T: Mul<f64>>(x T, k f64) T { return x * k }

// Derived from the fields: Cmp orders by the first field that differs,
// Clone copies each, Hash mixes them; an enum compares its variants in
// declaration order, then their payloads.
struct Pt impl Copy, Eq, Ord, Hash, Clone {
	x, y int
}

struct Bag impl Clone {
	name  string
	items []int
}

enum Grade impl Eq, Ord, Clone, Hash {
	Fail
	Pass(score int)
	Honors(score int, note string)
}

// A struct deriving its methods over a field whose type wrote them: the
// derived Eq, Cmp, Hash and Clone call Ver's own.
struct Ver impl Eq, Ord, Hash, Clone {
	major, minor int
}

func (a ref Ver) Eq(o ref Ver) bool      { return a.major == o.major }
func (a ref Ver) Cmp(o ref Ver) Ordering { return a.major.Cmp(o.major) }
func (a ref Ver) Hash() u64              { return u64(a.major) }
func (a ref Ver) Clone() Ver             { return Ver{major: a.major, minor: 0} }

struct Release impl Eq, Ord, Hash, Clone {
	v    Ver
	name string
}

func next(n mut int) int {
	*n += 1
	return *n
}

func Largest<T: Ord + Clone>(xs ref []T) T? {
	var best T? = None
	for _, x := range xs {
		better := match ref best {
			Some(b) => x.Cmp(b) == Greater,
			None => true,
		}
		if better {
			best = Some(x.Clone())
		}
	}

	return best
}

func ScaleAll(vs mut []Vec2, k f64) {
	for _, v := range vs {
		*v = *v * k
	}
}

func main() {
	a, b := Vec2{x: 1, y: 2}, Vec2{x: 3, y: 4}
	c := a + b
	fmt.Println(c, c - a == b, a * 2.0, -a)
	fmt.Println(a.Dot(b), (a + b).Dot(a - b))
	fmt.Println(Sum(ref []int{1, 2, 3}, 0), Sum(ref []Vec2{a, b, c}, Vec2{x: 0, y: 0}))
	fmt.Println(Scale(a, 10), Scale(1.5, 2.0))
	vs := []Vec2{a, b}
	ScaleAll(mut vs, 3)
	vs[0] *= 2
	fmt.Println(vs, a * 2)

	wallet := Money{cents: 150, currency: "EUR"}
	tip := Money{cents: 50, currency: "EUR"}
	total := wallet + tip
	fmt.Println(total.cents, total.currency)

	p, q := Pt{x: 1, y: 5}, Pt{x: 2, y: 0}
	fmt.Println(p.Cmp(ref q), q.Cmp(ref p), p.Cmp(ref p), p.Hash() == Pt{x: 1, y: 5}.Hash(), p.Hash() == q.Hash())
	n, m := 3, 4
	fmt.Println(n.Cmp(m), m.Cmp(n) == Greater, "b".Cmp("a"), "a".Cmp("a") == Equal)
	match n.Cmp(m) {
		Less => fmt.Println("less"),
		Equal => fmt.Println("equal"),
		Greater => fmt.Println("greater"),
	}

	bag := Bag{name: "tools", items: []int{1, 2}}
	copy := bag.Clone()
	bag.items.Push(3)
	fmt.Println(bag.name == copy.name, len(bag.items), len(copy.items), copy.name)
	grades := []Grade{Pass(70), Honors(90, "fine"), Fail, Pass(85)}
	fmt.Println(Largest(ref grades), Largest(ref []Pt{p, q}), Largest(ref []int{}))
	fmt.Println(Pass(70).Cmp(ref Pass(85)), Honors(1, "a").Cmp(ref Honors(1, "b")), Fail == Fail.Clone())
	seen := map[Grade]int{}
	seen[Fail] = 1
	seen[Pass(70)] = 2
	seen[Pass(70)] += 3
	fmt.Println(len(seen), seen[Pass(70)], seen[Fail])

	r1 := Release{v: Ver{major: 1, minor: 5}, name: "one"}
	r2 := r1.Clone()
	fmt.Println(r1 == r2, r1.Cmp(ref r2), r2.v.minor, r1.Cmp(ref Release{v: Ver{major: 2, minor: 0}, name: "one"}))
	byVersion := map[Release]int{r1: 1}
	fmt.Println(byVersion[Release{v: Ver{major: 1, minor: 9}, name: "one"}], byVersion[r2])
	calls := 0
	fmt.Println(n.Cmp(next(mut calls)), calls, n == n, n.Eq(n))
}
