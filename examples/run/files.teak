// Files and errors: a temporary directory, Create and WriteString, Open
// and ReadToString, io.Copy, Close, RemoveAll, the message of a failed
// open, ? on library results, os.Args, and writing to os.Stdout.

package main

import ("fmt"; "io"; "os")

func write(path ref string, text ref string) Result<int, error> {
	f := os.Create(path)?
	n := f.WriteString(text)?
	f.Close()?
	return Ok(n)
}

func copy(src ref string, dst ref string) Result<i64, error> {
	in := os.Open(src)?
	out := os.Create(dst)?
	n := io.Copy(mut out, mut in)?
	out.Close()?
	in.Close()?
	return Ok(n)
}

func main() {
	dir := os.MkdirTemp("", "teak").Expect("tempdir")
	a := dir + "/a.txt"
	b := dir + "/b.txt"
	fmt.Println(write(ref a, "hello, file\n"))
	fmt.Println(copy(ref a, ref b))
	fmt.Println(os.ReadToString(ref b))
	fmt.Println(os.ReadToString("/nonexistent/missing.txt"))
	fmt.Println(os.RemoveAll(ref dir), os.ReadToString(ref a).IsErr(), os.ReadToString("bad\x00name").IsErr())
	fmt.Println(len(os.Args) > 0, os.Args[0].HasSuffix("files"))
	os.Stdout.WriteString("direct\n").Expect("write")
	match os.Open("/nonexistent") {
		Ok(_) => fmt.Println("opened"),
		Err(e) => fmt.Println("error:", e),
	}
}
