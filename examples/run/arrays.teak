// Arrays in the backend: an array of strings written to, printed,
// cloned inside a struct and dropped with every element released; an
// array of arrays; an array copied whole and changed apart; a struct
// holding an array compared field by field through its own Eq.

package main

import "fmt"

struct Grid impl Clone { cells [2][2]int; name string }

struct Pair impl Eq { a [2]int }

func (p ref Pair) Eq(o ref Pair) bool { return p.a[0] == o.a[0] && p.a[1] == o.a[1] }

func main() {
	var words [3]string
	words[0] = "a".Clone()
	words[1] = "bb".Clone()
	words[2] = "ccc".Clone()
	fmt.Println(words, len(words), words[2].Len())
	words[1] = "x".Clone() // the old element is dropped

	g := Grid{cells: [2][2]int{}, name: "g".Clone()}
	g.cells[1][0] = 7
	h := g.Clone()
	h.cells[1][0] = 8
	fmt.Println(g.cells, h.cells, g.cells[1][0] + h.cells[1][0])

	var nums [4]int
	copy := nums
	nums[3] = 9
	fmt.Println(nums, copy, cap(nums))

	p := Pair{a: [2]int{}}
	q := p
	fmt.Println(p == q)
	q.a[1] = 1
	fmt.Println(p == q)
}
