// Options and Results: Some and None, Ok and Err, ? passing the absent
// or failed case up, ?? with a value, a panic and a return on its right,
// if with a binding, if as an expression, a match on a Result, the
// order of evaluation when an operand needs statements, and Map and
// MapErr on both, with a closure capturing a local, a function value,
// a function argument that is itself a call, a Map inside a Map, an
// owning value moved through, a value with a Drop method mapped and
// passed through, and one passed up with ?.

package main

import "fmt"

func half(n int) int? {
	if n%2 == 0 {
		return Some(n / 2)
	}

	return None
}

func quarter(n int) int? {
	h := half(n)?
	return half(h)
}

func parse(s ref string) Result<int, string> {
	if len(s) == 0 {
		return Err("empty")
	}

	return Ok(len(s))
}

func twice(s ref string) Result<int, string> {
	n := parse(s)?
	return Ok(n * 2)
}

func describe(n int) string {
	v := half(n) ?? return "odd"
	return fmt.Sprint("half ", v)
}

func bump(o mut (int?)) {
	v := o ?? return
	*v += 100
}

// label maps the error of a parse to its length and passes it up.
func label(s ref string) Result<string, int> {
	v := parse(s).MapErr(func(e string) int { return e.Len() })?
	return Ok(fmt.Sprint("ok", v))
}

func twiceText(n int) string {
	return fmt.Sprint(n * 2)
}

// pick returns a function value, and says so, to show the argument of
// Map is evaluated once, after the receiver.
func pick() func(int) string {
	fmt.Println("pick")
	return twiceText
}

struct Loud impl Drop { name string }

func (l mut Loud) Drop() { fmt.Println("drop", l.name) }

func loud(ok bool) Result<Loud, Loud> {
	if ok {
		return Ok(Loud{name: "a"})
	}

	return Err(Loud{name: "b"})
}

func trace(label string, v int) int {
	fmt.Println("eval", label)
	return v
}

func main() {
	fmt.Println(half(8), half(3), quarter(8), quarter(6))
	fmt.Println(twice("abc"), twice(""))

	v := half(3) ?? -1
	w := quarter(12) ?? panic("no")
	fmt.Println(v, w, describe(4), describe(5))

	o := Some(1)
	bump(mut o)
	var none int?
	bump(mut none)
	fmt.Println(o, none)

	if n := half(10) {
		fmt.Println("even half", n)
	} else {
		fmt.Println("odd")
	}

	kind := if v < 0 { "neg" } else if v == 0 { "zero" } else { "pos" }
	fmt.Println(kind)

	match twice("xy") {
		Ok(n) => fmt.Println("ok", n),
		Err(msg) => fmt.Println("err", msg),
	}

	for i := 0; i < 3; i += 1 {
		match half(i) {
			Some(h) => fmt.Println(i, "halves to", h),
			None => fmt.Println(i, "is odd"),
		}
	}

	// Operands are evaluated left to right, whether or not one of them
	// needs statements.
	sum := trace("a", 1) + (half(trace("b", 4)) ?? 0)
	fmt.Println(sum, trace("c", 0) > 0 && (half(trace("d", 2)) ?? 0) > 0)
	fmt.Println(trace("e", 1)-trace("f", 2), Point{x: trace("g", 1), y: trace("h", 2)})

	// Map and MapErr: the function runs on the present or failed case
	// and the other case passes through.
	suffix := "!".Clone()
	fmt.Println(half(8).Map(func(v int) string { return fmt.Sprint(v) + suffix }), half(3).Map(twiceText), half(8).Map(twiceText))
	fmt.Println(parse("abc").Map(twiceText), parse("").Map(twiceText))
	fmt.Println(parse("abc").MapErr(func(e string) int { return e.Len() }), parse("").MapErr(func(e string) int { return e.Len() }))
	fmt.Println(label("ab"), label(""))
	owned := Some("own".Clone())
	fmt.Println(owned.Map(func(s string) int { return s.Len() }), Some("kept".Clone()).Map(func(s string) string { return s }))
	fmt.Println(half(trace("r", 8)).Map(pick()), Some(Some(3)).Map(func(o int?) int { return o.Map(func(v int) int { return v * 10 }) ?? 0 }))

	// A value with a Drop method: the one mapped dies in the closure,
	// the one passed through with the result.
	fmt.Println(loud(true).Map(func(l Loud) int { return l.name.Len() }).IsOk(), loud(false).MapErr(func(l Loud) int { return 2 }).IsErr())
	passed := loud(false).Map(func(l Loud) int { return 1 })
	fmt.Println(passed.IsErr())
}

struct Point {
	x int
	y int
}
