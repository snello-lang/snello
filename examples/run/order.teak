// The sort and time packages written in Teak: Sort on numbers, strings
// and a struct whose Ord is derived, SortBy with an order of the
// program's own, Search and IsSorted; a Duration written as a product
// of a constant, its arithmetic and its readings, a Time built, moved
// and compared, and Sleep measured with Since.

package main

import ("fmt"; "sort"; "time")

struct Score impl Eq, Ord { points int; name string }

func main() {
	nums := []int{5, 3, 8, 1, 4}
	sort.Sort(mut nums)
	fmt.Println(nums, sort.IsSorted(ref nums), sort.Search(ref nums, 4), sort.Search(ref nums, 6), sort.Search(ref nums, 9))
	words := []string{"pear", "apple", "fig"}
	sort.Sort(mut words)
	fmt.Println(words, sort.Search(ref words, "fig"))
	scores := []Score{{points: 7, name: "b"}, {points: 7, name: "a"}, {points: 2, name: "c"}}
	sort.Sort(mut scores)
	fmt.Println(scores)
	sort.SortBy(mut scores, func(a ref Score, b ref Score) bool { return a.name < b.name })
	fmt.Println(scores, sort.IsSorted(ref scores))

	d := 10 * time.Millisecond
	fmt.Println(d, d.Milliseconds(), (d + time.Second).Seconds(), time.Hour.Minutes(), 2*time.Minute > time.Minute)
	t := time.Unix(1700000000, 500)
	later := t.Add(90 * time.Second)
	fmt.Println(later.Sub(t), later.After(t), t.Before(later), t == t.Add(0), later.Unix(), later.UnixNano())
	start := time.Now()
	time.Sleep(2 * time.Millisecond)
	fmt.Println(time.Since(start) >= 2*time.Millisecond, time.Now().After(start))
}
