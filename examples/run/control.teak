// Control flow: if and else-if chains, the three forms of for, continue
// reaching the post statement, break, a named number type, and a swap by
// parallel assignment.

package main

import "fmt"

type Score int

func grade(s Score) string {
	if s >= 90 {
		return "A"
	} else if s >= 80 {
		return "B"
	}

	return "C"
}

func main() {
	for i := 0; i < 3; i += 1 {
		if i == 1 {
			continue
		}

		fmt.Println(i, grade(Score(70+i*12)))
	}

	n := 0
	for n < 5 {
		n += 2
	}

	for {
		n -= 1
		if n == 0 {
			break
		}
	}

	x, y := 1, 2
	x, y = y, x
	fmt.Println(n, x, y, !(x > y) && y != 0)
}
