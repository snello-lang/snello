// Numbers: recursion, integer and float arithmetic, a sized integer that
// doubles past 32 bits, conversions between number types.

package main

import "fmt"

func fib(n int) int {
	if n < 2 {
		return n
	}

	return fib(n-1) + fib(n-2)
}

func main() {
	sum := 0
	for i := 0; i < 10; i += 1 {
		sum += fib(i)
	}

	fmt.Println(fib(10), sum, 7/2, 7%2, -3, 2.5*2, 1.0/3.0)

	var big i64 = 1
	for i := 0; i < 40; i += 1 {
		big *= 2
	}

	fmt.Println(big, u8(255), 'a', f64(3)/2 == 1.5)
}
