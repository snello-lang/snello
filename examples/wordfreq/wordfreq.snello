// Word frequency count over a file.
//
// Tests owned strings versus borrowed slices of them, maps with owned
// keys, and sorting in place through a mut borrow.

package wordfreq

import ("fmt"; "os"; "sort"; "strings")

struct Count { word string; n int }

func main() {
    text := os.ReadToString("input.txt").Expect("read input")

    counts := map[string]int{}
    // Fields returns an iterator over borrows into `text`, not a slice:
    // an owned slice cannot hold borrows, but an iterator is itself a
    // borrow and may. A map needs owned keys, and ToLower returns a new
    // owned string, so each word is copied exactly once.
    for w := range strings.Fields(ref text) {
        counts[strings.ToLower(w)] += 1
    }

    // Consume the map into a slice.
    list := []Count{}
    for k, v := range counts {
        list.Push(Count{word: k, n: v})
    }
    sort.SortBy(mut list, func(a ref Count, b ref Count) bool {
        return a.n > b.n || (a.n == b.n && a.word < b.word)
    })

    for _, c := range list[:min(10, len(list))] {
        fmt.Printf("%6d %s\n", c.n, c.word)
    }
}
