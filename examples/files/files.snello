// File copying with deterministic cleanup.
//
// Tests Drop versus defer, and that a closed file cannot be used again
// because Close consumes it; then the rest a program does with files: a
// log opened to append to, directories made and renamed, and a
// directory listed with what the system says of each name.

package files

import ("fmt"; "io"; "os"; "path/filepath")

// os.File implements Drop: going out of scope closes the descriptor. An
// explicit Close() consumes the file and reports the error, which Drop
// cannot. The idiom: call Close() when you care about the error, rely on
// Drop when you do not.

func Copy(src ref string, dst ref string) Result<i64, io.Error> {
    in := os.Open(src)?                     // owned; closed by Drop on every exit path
    out := os.Create(dst)?

    n := io.Copy(mut out, mut in)?          // both lent mutably for the duration of the copy

    out.Sync()?
    out.Close()?                            // consumes out; using it below is a compile error
    return Ok(n)                            // in is closed here by Drop
}

// A temp directory that removes itself. Drop runs on normal exit, early
// return, and panic unwinding.
struct TempDir impl Drop { path string }

func NewTempDir() Result<TempDir, io.Error> {
    p := os.MkdirTemp("", "snello")?
    return Ok(TempDir{path: p})
}

func (t mut TempDir) Drop() { os.RemoveAll(ref t.path) }

// Log adds a line to a file, making it first when it is not there: the
// flags of OpenFile say how it is opened, and 0600 who may read it.
func Log(path ref string, line ref string) Result<(), io.Error> {
    f := os.OpenFile(path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0o600)?
    f.WriteString(line)?
    f.WriteString("\n")?
    return f.Close()
}

// List prints what a directory holds, in the order ReadDir gives, by
// name: the entry says what kind of file it is, and Stat the rest.
func List(dir ref string) Result<(), io.Error> {
    for _, e := range ref os.ReadDir(dir)? {
        if e.IsDir() {
            fmt.Printf("  %s/\n", e.Name())
            continue
        }

        fi := os.Stat(ref filepath.Join(dir, e.Name()))?
        fmt.Printf("  %s, %d bytes%s\n", e.Name(), fi.Size(), if fi.Mode().Perm() == 0o600 { ", the owner's alone" } else { "" })
    }

    return Ok(())
}

// Archive moves the copy into a directory made for it, with every
// parent it lacks, and logs each step.
func Archive(root ref string) Result<(), io.Error> {
    log := filepath.Join(root, "copy.log")
    Log(ref log, "copied input.txt")?
    kept := filepath.Join(root, "kept/2026/copies")
    os.MkdirAll(ref kept, 0o755)?
    os.Rename(ref filepath.Join(root, "copy.txt"), ref filepath.Join(ref kept, "input.txt"))?
    Log(ref log, "archived it")?
    fmt.Println("in the directory:")
    List(root)?
    fmt.Println("in kept/2026/copies:")
    List(ref kept)?
    fmt.Printf("the log:\n%s", os.ReadToString(ref log)?)
    fmt.Println("the copy moved:", os.Stat(ref filepath.Join(root, "copy.txt")).IsErr())
    return Ok(())
}

func main() {
    tmp := NewTempDir().Expect("tempdir")
    target := tmp.path + "/copy.txt"       // `+` borrows both sides and returns a new string

    // defer remains for cleanup that is not tied to a value's lifetime.
    defer fmt.Println("done")

    match Copy("input.txt", ref target) {
        Ok(n)  => fmt.Println("copied", n, "bytes"),
        Err(e) => fmt.Println("copy failed:", e),
    }

    match Archive(ref tmp.path) {
        Ok(_)  => {},
        Err(e) => fmt.Println("archive failed:", e),
    }
    // tmp dropped here: directory removed. Then the deferred print runs.
}
