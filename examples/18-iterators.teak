// 18: Closures and iterators.
//
// Tests closure capture (by borrow, by mutable borrow, by move), a lazy
// iterator trait with default adapters, and that a closure holding a
// borrow is itself a borrow: it cannot be stored, returned, or sent.

package iter

import "fmt"

trait Iterator<T> {
    func (it mut Self) Next() T?

    // Default adapters. They consume the iterator they wrap.
    func (it Self) Map<U>(f func(T) U) MapIter<Self, T, U> {
        return MapIter{inner: it, f: f}
    }
    func (it Self) Filter(keep func(ref T) bool) FilterIter<Self, T> {
        return FilterIter{inner: it, keep: keep}
    }
    func (it mut Self) Collect() []T {
        out := []T{}
        for { out.Push(it.Next() ?? break) }
        return out
    }
}

struct Range impl Iterator<int> { cur, end int }

func (r mut Range) Next() int? {
    if r.cur >= r.end { return None }
    r.cur += 1
    return Some(r.cur - 1)
}

struct MapIter<I: Iterator<T>, T, U> impl Iterator<U> {
    inner I
    f     func(T) U
}

func (m mut MapIter<I, T, U>) Next() U? { return m.inner.Next().Map(m.f) }

struct FilterIter<I: Iterator<T>, T> impl Iterator<T> {
    inner I
    keep  func(ref T) bool
}

func (f mut FilterIter<I, T>) Next() T? {
    for {
        v := f.inner.Next() ?? return None
        if f.keep(ref v) { return Some(v) }
    }
}

// A closure captures each variable in the weakest mode that its body
// needs: ref if it only reads, mut if it assigns, move if it consumes it.
// This closure captures `offset` by copy (int is Copy), so it holds no
// borrow and can be returned.
func adder(offset int) func(int) int {
    return func(x int) int { return x + offset }
}

func main() {
    evens := Range{0, 5}.Map(adder(10)).Filter(func(x ref int) bool { return x % 2 == 0 }).Collect()
    fmt.Println(evens)                // [10 12 14]

    // This closure assigns to `total`, so it captures a mut borrow of it.
    // `add` is therefore a borrow: it can be called here but not stored
    // in a struct, returned, or passed to `spawn`. The borrow ends when `add`
    // goes out of scope, and `total` is readable again.
    total := 0
    add := func(x int) { total += x }
    for _, x := range evens { add(x) }
    fmt.Println(total)                // 36

    // Passing a closure to `spawn` requires it to own everything it
    // captures, so `names` is moved in.
    names := []string{"a", "b"}
    spawn func() { fmt.Println(names) }()
    // fmt.Println(names)             // error: names was moved into the task
}
