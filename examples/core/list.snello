// Core 2: a stack and a ring queue.
//
// The core version of 06-linked-list.teak with the element types fixed
// to string and int. Stresses: `*Node?` as the owned link, `take` moving
// a value out of a field, a partial move out of a heap node about to be
// dropped, and a method returning a borrow into its receiver.

package list

import "fmt"

struct Node {
    value string
    next  *Node?                 // owned pointer, or None
}

// Zero value: head None, len 0, so `Stack{}` is an empty stack.
struct Stack {
    head *Node?
    len  int
}

func (s mut Stack) Push(v string) {
    // `take` moves the old head out and leaves None behind, so it can be
    // moved into the new node with no copy and no placeholder value.
    old := take(mut s.head)
    s.head = Some(&Node{value: v, next: old})       // &x allocates x on the heap
    s.len += 1
}

func (s mut Stack) Pop() string? {
    n := take(mut s.head) ?? return None
    s.head = n.next                   // moving a field out of the owned node n
    s.len -= 1                        // is allowed because n is dropped at the
    return Some(n.value)              // end of this function
}

// Returns a borrow into the receiver. The caller holds it for as long as
// it holds the receiver borrow, which ends at the next mutation of the
// stack. This is the one way a borrow may be returned.
func (s ref Stack) Peek() ref string? {
    n := s.head ?? return None
    return Some(ref n.value)
}

// A linked queue needs a tail link, which would be a second owner of the
// last node. A ring buffer has no such link and is faster anyway.
struct QueueFull {}

struct Queue {
    buf  []int?
    head int
    len  int
}

func NewQueue(cap int) Queue {
    return Queue{buf: make([]int?, cap), head: 0, len: 0}
}

func (q mut Queue) Push(v int) Result<(), QueueFull> {
    if q.len == len(q.buf) { return Err(QueueFull{}) }
    q.buf[(q.head + q.len) % len(q.buf)] = Some(v)
    q.len += 1
    return Ok(())
}

func (q mut Queue) Pop() int? {
    if q.len == 0 { return None }
    v := take(mut q.buf[q.head])
    q.head = (q.head + 1) % len(q.buf)
    q.len -= 1
    return v
}

func main() {
    s := Stack{}
    s.Push("a")
    s.Push("b")
    fmt.Println(s.Peek())    // Some("b")
    fmt.Println(s.Pop())     // Some("b")
    fmt.Println(s.Pop())     // Some("a")
    fmt.Println(s.Pop())     // None

    q := NewQueue(2)
    q.Push(1).Expect("room")
    q.Push(2).Expect("room")
    fmt.Println(q.Push(3))   // Err(QueueFull)
    fmt.Println(q.Pop())     // Some(1)
}
