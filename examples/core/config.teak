// Core 8: error handling with Result, a custom error enum, `?` and `??`.
//
// The core version of 09-errors.teak with the predeclared `error` type
// as the cause, the integers parsed by hand, and the map read through
// `Get`. Stresses: `?` across a chain of Results, `??` whose else
// returns, a value moved only on the diverging path and used after, and
// a borrow of a map value held across a second lookup.

package config

import ("fmt"; "os")

enum ConfigError {
    Unreadable(path string, cause error)
    BadValue(key string, text string)
    Missing(key string)
}

func (e ref ConfigError) Error() string {
    return match e {
        Unreadable(p, c) => fmt.Sprintf("cannot read %s: %s", p, c),
        BadValue(k, t)   => fmt.Sprintf("key %s: bad value %q", k, t),
        Missing(k)       => fmt.Sprintf("key %s missing", k),
    }
}

struct Config {
    port    int
    workers int
}

func Load(path string) Result<Config, ConfigError> {
    text := match os.ReadToString(ref path) {
        Ok(t)  => t,
        Err(e) => return Err(Unreadable(path, e)),  // path moves only on this path
    }

    kv := map[string]string{}
    for line := range text.Split("\n") {            // each line is a borrow into text
        if (k, v) := line.SplitOnce("=") {          // binds when Some
            kv.Insert(k.Trim().Clone(), v.Trim().Clone())
        }
    }

    port := parseKey(ref kv, "port")?
    workers := parseKey(ref kv, "workers")?
    return Ok(Config{port: port, workers: workers})
}

func parseKey(kv ref map[string]string, key string) Result<int, ConfigError> {
    text := kv.Get(ref key) ?? return Err(Missing(key))   // key moves only if the else runs
    n := atoi(text) ?? return Err(BadValue(key, text.Clone()))
    return Ok(n)
}

// atoi parses a non-negative decimal by hand; the core suite has no strconv.
func atoi(s ref string) int? {
    if len(s) == 0 { return None }
    n := 0
    for i := 0; i < len(s); i += 1 {
        c := s[i]
        if c < '0' || c > '9' { return None }
        n = n*10 + int(c - '0')
    }
    return Some(n)
}

func main() {
    match Load("app.conf") {
        Ok(c)  => fmt.Println("port", c.port, "workers", c.workers),
        Err(e) => { fmt.Println(e.Error()); os.Exit(1) },
    }
}
