// Rule: an owned container cannot hold a borrow; a slice of borrows has
// no owner to tie them to. Fix: store indexes, or own the strings.

package p

import "fmt"

func main() {
    s := "a"
    xs := []ref string{}                  // ERROR "a slice cannot hold a borrow"
    fmt.Println(len(xs), s)
}