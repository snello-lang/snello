// Rule: nothing can be moved out through a ref; the owner keeps it.
// Fix: return n.value.Clone(), or return ref n.value (see return-ref-receiver).

package p

struct Node { value string }

func value(n ref Node) string {
    return n.value                        // ERROR "cannot move n.value out of a borrow"
}