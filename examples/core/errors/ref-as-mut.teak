// Rule: a borrow can be passed on narrower or equal, never wider. A ref
// cannot become a mut. Fix: take xs as mut.

package p

func push(xs mut []int) { xs.Push(1) }

func fill(xs ref []int) {
    push(xs)                              // ERROR "cannot use xs (ref []int) as mut []int"
}