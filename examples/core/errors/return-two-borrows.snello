// Rule: a returned borrow is tied to one input: the receiver or the only
// borrowed parameter. With two the source is ambiguous. Fix: return a
// clone, or an index saying which one.

package p

func Longest(a ref string, b ref string) ref string {    // ERROR "Longest returns a borrow but has two borrowed parameters"
    if len(a) >= len(b) { return a }
    return b
}