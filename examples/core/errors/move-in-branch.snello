// Rule: a move on one path counts after the paths join. Fix: move on
// every path, or clone in the branch.

package p

import "fmt"

func keep(s string) {}

func main() {
    s := "hello"
    if len(s) > 3 {
        keep(s)
    }
    fmt.Println(s)                        // ERROR "use of moved value s"
}