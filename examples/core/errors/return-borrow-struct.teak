// Rule: a struct holding a borrow is a borrow and cannot be returned,
// stored, or sent. Fix: build the Lexer where it is used (core/calc.teak).

package p

struct Lexer {
    src ref string
    pos int
}

func NewLexer(src ref string) Lexer {     // ERROR "NewLexer cannot return Lexer: it holds a borrow"
    return Lexer{src: src, pos: 0}
}