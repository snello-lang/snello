// Rule: an Arc lends its value for reading only, since another task
// may be reading it at the same moment.
// Fix: put the value in a sync.Mutex or sync.RwLock inside the Arc and
// change it through the guard.

package p

import "sync"

func main() {
    shared := sync.NewArc([]int{})
    shared.Get().Push(1)                  // ERROR "cannot borrow shared.Get() as mut"
}
