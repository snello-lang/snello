// Rule: a ref receiver cannot lend a field as mut; the most common
// beginner error. Fix: func (t mut Tree) Add.

package p

struct Tree { nodes []int }

func (t ref Tree) Add(n int) {
    t.nodes.Push(n)                       // ERROR "cannot borrow t.nodes as mut through a ref receiver"
}