// Rule: assigning an owned value moves it; the old name is dead.
// Fix: s.Clone() if both names are needed, or use t from here on.

package p

import "fmt"

func main() {
    s := "hello"
    t := s
    fmt.Println(s)                        // ERROR "use of moved value s"
    fmt.Println(t)
}