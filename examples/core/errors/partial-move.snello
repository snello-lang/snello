// Rule: a field may be moved out of an owned value only if the whole
// value is never used again. Fix: take(mut n.value), which leaves "" behind.

package p

import "fmt"

struct Node { value string; id int }

func keep(n Node) {}

func main() {
    n := Node{value: "x", id: 1}
    v := n.value
    fmt.Println(v)
    keep(n)                               // ERROR "use of partially moved value n"
}