// Rule: the owner cannot move a value while it is borrowed.

package p

import "fmt"

func keep(s string) {}

func main() {
    s := "a"
    r := ref s
    keep(s)                               // ERROR "cannot move s: s is borrowed"
    fmt.Println(r)
}