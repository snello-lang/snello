// Rule: a channel hands values to other tasks, and a borrow cannot leave
// its task. Fix: send the string itself, or a clone.

package p

import "fmt"

func main() {
    ch := make(chan ref string, 1)        // ERROR "a channel cannot carry a borrow"
    fmt.Println(cap(ch))
}