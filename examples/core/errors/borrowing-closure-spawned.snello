// Rule: a closure bound to a name borrows what it captures, and a
// borrow cannot cross a task boundary.
// Fix: write the closure in the spawn statement, spawn func() { ... }(),
// which moves what it captures into the task.

package p

func main() {
    names := []string{"a", "b"}
    show := func() int { return len(names) }
    spawn show()                          // ERROR "closure show captures names by borrow and cannot be spawned"
}
