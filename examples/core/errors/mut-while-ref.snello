// Rule: while a ref borrow is live, no mut borrow of the same value may
// be created, and a method with a mut receiver creates one. Fix: finish
// with r before pushing, or push first.

package p

import "fmt"

func main() {
    xs := []int{1, 2}
    r := ref xs
    xs.Push(3)                            // ERROR "cannot borrow xs as mut: xs is borrowed as ref"
    fmt.Println(r)
}