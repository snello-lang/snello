// Core 3: a connection state machine.
//
// The core version of 17-state-machine.teak with the socket and the
// clock replaced by plain fields. Stresses: enums carrying different data
// per state, exhaustive match on a tuple with guards, consuming
// transitions that move a value from the old state into the new one, and
// `Drop` running when a state that holds a session is dropped.

package conn

import "fmt"

struct Session impl Drop {
    id string
    fd int
}

// Drop stands in for closing the socket. Every path that drops a state
// holding a Session prints this line exactly once.
func (s mut Session) Drop() { fmt.Println("closing", s.id) }

enum State {
    Closed
    Connecting(attempt int)
    Open(session Session)
    Draining(session Session, ticks int)
    Failed(reason string)
}

enum Event {
    Dial
    Connected(session Session)
    Timeout
    Shutdown
    Fail(msg string)
}

// step consumes the old state and the event and returns the new state.
// Because State is moved in, a Session inside it moves into the next
// state without a copy. Where a state is dropped, its Session is dropped.
func step(s State, ev Event) State {
    return match (s, ev) {
        (Closed, Dial)                       => Connecting(1),
        (Connecting(n), Timeout) if n < 3    => Connecting(n + 1),
        (Connecting(_), Timeout)             => Failed("gave up"),
        (Connecting(_), Connected(sess))     => Open(sess),
        (Open(sess), Shutdown)               => Draining(sess, 5),
        (Draining(_, _), Timeout)            => Closed,          // session dropped here: "closing"
        (Open(_), Fail(m))                   => Failed(m),       // same
        (Failed(_), Dial)                    => Connecting(1),
        (s, _)                               => s,               // ignored event: state moves straight back out
    }
}

func (s ref State) Describe() string {
    return match s {
        Closed            => "closed",
        Connecting(n)     => fmt.Sprintf("connecting (attempt %d)", n),
        Open(sess)        => "open " + sess.id,
        Draining(sess, t) => fmt.Sprintf("draining %s for %d ticks", sess.id, t),
        Failed(r)         => "failed: " + r,
    }
}

func main() {
    s := Closed
    s = step(s, Dial)
    s = step(s, Connected(Session{id: "s1", fd: 3}))
    fmt.Println(s.Describe())        // open s1
    s = step(s, Shutdown)
    s = step(s, Timeout)             // closing s1
    fmt.Println(s.Describe())        // closed
}
