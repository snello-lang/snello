// 02: A concurrent pipeline over channels.
//
// Three stages connected by channels, with the middle stage fanned out to
// several workers. It is the familiar pipeline shape, and the point of
// the example is that ownership does not change it.
//
// Four rules make it memory safe without a GC, and none of them needs an
// annotation:
//
//   1. Sending on a channel MOVES the value. The sender no longer owns it.
//   2. Receiving from a channel gives the receiver ownership. When the
//      received value goes out of scope, it is freed, right there.
//   3. A channel handle is owned. `ch.Clone()` gives another handle on
//      the same channel for another task, and the last handle frees it.
//   4. `spawn f()` moves everything it captures into the new task.
//
// There is no shared mutable state in this file, so there is no lock.

package pipeline

import ("fmt"; "strings")

struct Job {
    id   int
    text string
}

struct Result {
    id    int
    words int
}

// Stage 1: produce jobs.
func produce(n int) <-chan Job {
    out := make(chan Job)
    w := out.Clone()                            // rule 3: a handle for the task
    spawn func() {                              // rule 4: `w` is moved into the task
        defer close(w)
        for i := 0; i < n; i++ {
            job := Job{id: i, text: strings.Repeat("teak ", i)}
            w <- job                         // rule 1: job is moved into the channel
            // job cannot be used here any more; the compiler rejects it
        }
    }()
    return out
}

// Stage 2: count words. Called several times to fan out.
func count(jobs <-chan Job) <-chan Result {
    out := make(chan Result)
    w := out.Clone()
    spawn func() {
        defer close(w)
        for job := range jobs {              // rule 2: this task now owns job
            w <- Result{id: job.id, words: len(strings.Fields(ref job.text))}
        }                                    // job dropped here; its string is freed
    }()
    return out
}

// Stage 3: merge several result channels into one.
func merge(inputs []<-chan Result) <-chan Result {
    out := make(chan Result)
    done := make(chan ())
    n := len(inputs)
    for _, in := range inputs {              // ranging over an owned slice moves each element
        w, d := out.Clone(), done.Clone()
        spawn func() {                          // rule 4: `in`, `w` and `d` are moved into this task
            for r := range in { w <- r }
            d <- ()
        }()
    }
    w := out.Clone()
    spawn func() {
        for i := 0; i < n; i++ { <-done }    // wait for every forwarder
        close(w)
    }()
    return out
}

func main() {
    jobs := produce(10)

    // Fan out: four workers read from the same channel, each on a handle
    // of its own (rule 3).
    workers := []<-chan Result{}
    for i := 0; i < 4; i++ {
        workers.Push(count(jobs.Clone()))
    }

    total := 0
    for r := range merge(workers) {          // `workers` is moved into merge
        total += r.words
    }
    fmt.Println(total)                       // 0+1+2+...+9 = 45
}

// What the compiler rejects, for contrast:
//
//   s := "hello"
//   spawn func() { fmt.Println(s) }()      // ok: s is moved into the task
//   fmt.Println(s)                         // error: s was moved
//
//   m := map[string]int{}
//   spawn func() { m["a"] = 1 }()          // ok on its own: m moved in
//   spawn func() { m["b"] = 2 }()          // error: m was already moved
//
//   spawn func() { use(ref m) }()          // error: a borrow cannot cross `spawn`
//
// Shared mutable state across tasks is covered in 03-http-cache.teak,
// where it is actually needed.
