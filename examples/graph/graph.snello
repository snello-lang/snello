// A directed graph with BFS and shortest paths.
//
// Nodes refer to each other by integer id. The graph is append-only, so a
// plain slice with a NodeID is enough; Arena<T> (the tree example) is for
// structures that also remove. A graph of ids is the shape most graph
// code already has, so the ownership rules cost nothing here. The BFS
// queue is a deque, which pops its front in constant time where a slice
// would move the rest down on every Remove(0).

package graph

import ("deque"; "fmt"; "heap")

type NodeID int

struct Edge impl Copy {
    to     NodeID
    weight int
}

struct Graph {
    labels []string
    adj    [][]Edge              // adj[i] owns the edges leaving node i
}

func New() Graph { return Graph{} }

func (g mut Graph) AddNode(label string) NodeID {
    g.labels.Push(label)
    g.adj.Push([]Edge{})
    return NodeID(len(g.labels) - 1)
}

func (g mut Graph) AddEdge(from, to NodeID, w int) {
    g.adj[from].Push(Edge{to: to, weight: w})
}

// Returns an owned slice; the graph is only borrowed during the call.
func (g ref Graph) BFS(start NodeID) []NodeID {
    seen := make([]bool, len(g.adj))
    order := []NodeID{}
    queue := deque.New<NodeID>()
    queue.PushBack(start)
    seen[start] = true
    for {
        n := queue.PopFront() ?? break
        order.Push(n)
        for _, e := range g.adj[n] {            // g is a borrow, so e is ref Edge
            if !seen[e.to] {
                seen[e.to] = true
                queue.PushBack(e.to)
            }
        }
    }
    return order
}

// Dijkstra with the standard library heap. Items are small Copy structs
// that the heap owns.
struct item impl Copy, Ord { node NodeID; dist int }

func (a ref item) Cmp(b ref item) Ordering { return a.dist.Cmp(b.dist) }

func (g ref Graph) Shortest(from NodeID) []int? {
    dist := make([]int?, len(g.adj))
    h := heap.New<item>()
    dist[from] = Some(0)
    h.Push(item{node: from, dist: 0})
    for cur := h.Pop(); cur != None; cur = h.Pop() {
        cur := cur.Expect("the loop saw Some")
        if dist[cur.node].UnwrapOr(cur.dist) < cur.dist { continue }
        for _, e := range g.adj[cur.node] {
            nd := cur.dist + e.weight
            if nd < dist[e.to].UnwrapOr(nd + 1) {
                dist[e.to] = Some(nd)
                h.Push(item{node: e.to, dist: nd})
            }
        }
    }
    return dist
}

func main() {
    g := New()
    a, b, c := g.AddNode("a"), g.AddNode("b"), g.AddNode("c")
    g.AddEdge(a, b, 1)
    g.AddEdge(b, c, 2)
    g.AddEdge(a, c, 5)
    fmt.Println(g.BFS(a))          // [0 1 2]
    fmt.Println(g.Shortest(a))     // [Some(0) Some(1) Some(3)]
}
