// A group of tasks: several tasks started for handles, waited for
// together, and cancelled together when the first fails. A group of batches is
// waited for and reports every one; a group of a server and a checker
// stops the server when the audit's bug fails it, and Wait says what
// the bug was; and a task that failed is started again by a loop over
// Join, with its limit in plain sight, since the library restarts
// nothing. A batch is three readings, an array, since the frames a
// panic abandons keep the plain memory they held.

package main

import ("fmt"; "task")

// summarize adds up the first want readings of a batch and reports the
// total: a member of a group, run for its effect.
func summarize(batch int, readings [3]int, want int, totals chan<- (int, int)) {
	total := 0
	for i := 0; i < want; i++ {
		total += readings[i]
	}

	totals <- (batch, total)
}

// serve answers requests until the group is cancelled, counting each
// on served: a task that would run forever, whose receive the cancel a
// failure elsewhere makes ends, so that it stops.
func serve(requests <-chan string, served chan<- int) {
	n := 0
	for r := range requests { // ends when cancelled: the program keeps the sending end
		fmt.Println("served", r)
		n += 1
		served <- n
	}

	if task.Cancelled() {
		fmt.Println("server stopping: another task failed")
	}
}

// audit checks a batch once the server has served count requests, and
// prints its total; a batch that asks for a reading it does not have
// is the bug.
func audit(readings [3]int, want int, served <-chan int, count int) {
	for { // each receive waits for the server's next count
		if (<-served).Expect("a count") >= count {
			break
		}
	}

	total := 0
	for i := 0; i < want; i++ {
		total += readings[i]
	}

	fmt.Println("audited", total)
}

// flaky fails on its first two attempts and returns on the third: a
// task a program may choose to start again. Its messages are literals,
// since a panic abandons the plain memory of its frame.
func flaky(attempt int) int {
	if attempt == 1 {
		panic("the first attempt found nothing")
	} else if attempt == 2 {
		panic("the second attempt found nothing")
	}

	return attempt
}

func main() {
	// Batches run as a group: Wait returns once every one has ended.
	totals := make(chan (int, int), 3)
	batches := task.NewGroup()
	batches.Add(spawn summarize(1, [3]int{3, 4, 5}, 3, totals.Clone()))
	batches.Add(spawn summarize(2, [3]int{1, 2, 3}, 2, totals.Clone()))
	batches.Add(spawn summarize(3, [3]int{7, 0, 0}, 1, totals.Clone()))
	match batches.Wait() {
		Ok(_) => fmt.Println("every batch reported,", len(totals), "totals"),
		Err(p) => fmt.Println("a batch failed:", p.Message()),
	}

	// A server and an audit: the audit's bug cancels the group, the
	// server stops, and Wait reports the bug once both have ended.
	requests := make(chan string, 2)
	requests <- "ping".Clone()
	requests <- "status".Clone()
	served := make(chan int, 2)
	g := task.NewGroup()
	g.Add(spawn serve(requests.Clone(), served.Clone()))
	g.Add(spawn audit([3]int{1, 2, 3}, 4, served.Clone(), 2)) // asks for a fourth reading of three
	match g.Wait() {
		Ok(_) => fmt.Println("every task returned"),
		Err(p) => fmt.Println("a task failed:", p.Message()),
	}

	// A task started again: the loop, and its limit, are the program's.
	for attempt := 1; attempt <= 3; attempt++ {
		match (spawn flaky(attempt)).Join() {
			Ok(n) => {
				fmt.Println("succeeded on attempt", n)
				break
			}
			Err(p) => fmt.Println("retrying:", p.Message()),
		}
	}
}
