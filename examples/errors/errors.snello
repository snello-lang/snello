// Error handling with Result, custom error enums, `?`, and `??`.
//
// Tests that errors are ordinary values, with no nil to stand for their
// absence, that `?` keeps the happy path readable and passes an error
// into the variant that holds its type, and that an error prints with
// nothing written.

package config

import ("fmt"; "io"; "os"; "strconv")

// ConfigError lists Error and writes no Error(): the message is the
// value as it prints, `Missing("port")`, and Source() is None. Clone
// is for the LoadError below, whose Source gives a clone of the cause.
enum ConfigError impl Error, Clone {
    Unreadable(cause io.Error)
    BadValue(cause strconv.Error)
    Missing(key string)
}

struct Config {
    port    int
    workers int
}

// LoadError wraps a ConfigError with the path, writing its own message
// and giving the cause through Source, so %+v prints the chain.
struct LoadError impl Error {
    path  string
    cause ConfigError
}

func (e ref LoadError) Error() string { return fmt.Sprintf("load %s", e.path) }
func (e ref LoadError) Source() Error? { return Some(e.cause.Clone()) }

func Load(path string) Result<Config, ConfigError> {
    text := os.ReadToString(ref path)?                     // an io.Error becomes Unreadable(e): the one variant holding an io.Error, which the enum must keep to one

    kv := map[string]string{}
    for line := range text.Lines() {                       // iterator of ref string
        if (k, v) := line.SplitOnce("=") {                 // binds when Some
            kv[k.Trim().Clone()] = v.Trim().Clone()
        }
    }

    port := parseKey(ref kv, "port")?                      // already a ConfigError: passed as it is
    workers := parseKey(ref kv, "workers")?
    return Ok(Config{port: port, workers: workers})
}

func parseKey(kv ref map[string]string, key string) Result<int, ConfigError> {
    text := kv.Get(ref key) ?? return Err(Missing(key))    // `??`: unwrap, or run the else
    n := strconv.Atoi(text)?                               // a strconv.Error becomes BadValue(e)
    return Ok(n)
}

func load(path string) Result<Config, LoadError> {
    return Load(path.Clone()).MapErr(func(e ConfigError) LoadError {  // two fields: the conversion is written
        return LoadError{path: path, cause: e}
    })
}

func main() {
    match Load("app.conf") {
        Ok(c)  => fmt.Println("port", c.port, "workers", c.workers),
        Err(e) => { fmt.Println(e); os.Exit(1) },
    }

    match load("missing.conf") {
        Ok(c)  => fmt.Println("port", c.port),
        Err(e) => fmt.Printf("%v\n%+v\n", e, e),
    }
}
