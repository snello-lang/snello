// 07: Traits with default methods, fields, and mixins.
//
// A trait is a named set of methods, and may also carry default methods
// and fields. A type says which traits it implements on its declaration,
// and its methods are ordinary methods. There are no impl blocks.
//
// A trait name used as a type means "any value implementing it": a boxed
// value with a method table.

package shapes

import ("fmt"; "math")

trait Shape {
    func (s ref Self) Area() f64
    func (s ref Self) Perimeter() f64
    func (s ref Self) Name() ref string
    func (s ref Self) Describe() string {                    // default method
        return fmt.Sprintf("%s with area %.2f", s.Name(), s.Area())
    }
}

// A trait with a field. A type that implements Named gets the field,
// stored inline and set at construction like any other field. The
// field obeys the ownership rules of any struct field: a getter on a
// borrowed Self returns a borrow of it, as a string would move out.
trait Named {
    var name string
    func (n ref Self) Name() ref string { return ref n.name }
}

// A trait that refines another and overrides its default.
trait Logged: Shape {
    func (s ref Self) Describe() string {
        return "[logged] " + super.Describe()
    }
}

struct Circle impl Shape, Named, Logged {
    r f64
}

func (c ref Circle) Area() f64      { return math.Pi * c.r * c.r }
func (c ref Circle) Perimeter() f64 { return 2 * math.Pi * c.r }

struct Rect impl Shape, Named {
    w, h f64
}

func (r ref Rect) Area() f64      { return r.w * r.h }
func (r ref Rect) Perimeter() f64 { return 2 * (r.w + r.h) }
func (r ref Rect) Describe() string   { return "a rectangle" }      // overrides the default

// Which Describe does Circle get? Its own methods first, then the traits
// in its impl list from right to left: Logged, then Named, then
// Shape. So Circle.Describe is Logged's, whose `super` is Shape's default,
// whose Name() is Named's. All resolved at compile time, all direct calls.

// Static dispatch through a bound: one copy of the function per T.
func TotalArea<T: Shape>(xs ref []T) f64 {
    sum := 0.0
    for _, x := range xs { sum += x.Area() }
    return sum
}

// Dynamic dispatch: a slice of Shape values holds any mix of types that
// implement Shape. Each element owns its value.
func PrintAll(xs ref []Shape) {
    for _, x := range xs { fmt.Println(x.Describe()) }
}

func main() {
    circles := []Circle{{r: 1, name: "circle"}, {r: 2, name: "big circle"}}
    fmt.Println(TotalArea(ref circles))

    mixed := []Shape{Circle{r: 1, name: "circle"}, Rect{w: 2, h: 3, name: "rect"}}
    PrintAll(ref mixed)
    // [logged] circle with area 3.14
    // a rectangle
}
