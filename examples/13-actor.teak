// 13: An actor with a mailbox.
//
// The actor pattern is the natural fit for this memory model: the state
// is owned by exactly one task and only messages cross the boundary. No
// locks, no Arc around the state.

package actor

import "fmt"

enum Msg {
    Deposit(amount int)
    Withdraw(amount int, reply chan<- Result<int, string>)
    Balance(reply chan<- int)
    Stop
}

struct Account {
    balance int
    history []int
}

// The actor loop owns `acct`. It was moved in by Spawn and is dropped when
// the loop returns. Nothing else can reach it. Parameters are mutable
// locals, as in Go.
func run(acct Account, inbox <-chan Msg) {
    for m := range inbox {
        match m {
            Deposit(n) => { acct.balance += n; acct.history.Push(n) },
            Withdraw(n, reply) => {
                if n > acct.balance {
                    reply <- Err("insufficient funds")
                } else {
                    acct.balance -= n
                    acct.history.Push(-n)
                    reply <- Ok(acct.balance)
                }
            },
            Balance(reply) => reply <- acct.balance,
            Stop => return,
        }
    }
}

// A handle is a Copy value wrapping a channel. Copying it does not copy
// the actor.
struct Handle impl Copy { inbox chan<- Msg }

func Spawn(initial int) Handle {
    ch := make(chan Msg, 64)
    spawn run(Account{balance: initial}, ch)      // Account is Send: an int and a slice of ints
    return Handle{inbox: ch}
}

func (h Handle) Withdraw(n int) Result<int, string> {
    reply := make(chan Result<int, string>, 1)
    h.inbox <- Withdraw(n, reply)
    return (<-reply).Expect("actor replied")  // the actor always answers before dropping reply
}

func (h Handle) Balance() int {
    reply := make(chan int, 1)
    h.inbox <- Balance(reply)
    return (<-reply).Expect("actor replied")
}

func (h Handle) Deposit(n int) { h.inbox <- Deposit(n) }
func (h Handle) Stop()         { h.inbox <- Stop }

func main() {
    acct := Spawn(100)
    acct.Deposit(50)
    fmt.Println(acct.Withdraw(120))     // Ok(30)
    fmt.Println(acct.Withdraw(100))     // Err("insufficient funds")
    fmt.Println(acct.Balance())         // 30
    acct.Stop()
}
