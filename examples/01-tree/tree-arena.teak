// Version 3: Teak with the standard library arena.Arena<T>. This is the Teak way.
//
// Same idea as tree-slice.teak, but the arena is a library type and the
// index carries a generation counter. Remove frees a node immediately and
// reuses its slot safely: any old arena.Index<Node> for it returns None from
// Get instead of aliasing whatever lives in the slot now.
//
// Compared to tree-slice.teak: no `live` flag, no leaked slots, and stale
// handles are detected instead of trusted. See _docs/design/02-arenas-and-indices.md.

package tree

import ("fmt"; "arena")

struct Node {
    value    string
    parent   arena.Index<Node>?         // None for the root
    children []arena.Index<Node>
}

struct Tree {
    nodes arena.Arena<Node>             // owns every node
    root  arena.Index<Node>
}

func NewTree(value string) Tree {
    nodes := arena.New<Node>()
    root := nodes.Insert(Node{value: value, parent: None, children: []arena.Index<Node>{}})
    return Tree{nodes: nodes, root: root}
}

// mut receiver: exclusive borrow of the tree for the duration of the call.
func (t mut Tree) AddChild(parent arena.Index<Node>, value string) arena.Index<Node> {
    id := t.nodes.Insert(Node{value: value, parent: Some(parent), children: []arena.Index<Node>{}})
    // GetMut returns None for a stale or removed index. A parent handed to
    // us by the caller should be valid, so Expect turns a bug into a panic
    // with a message rather than silent corruption.
    t.nodes.GetMut(parent).Expect("parent exists").children.Push(id)
    return id
}

// Remove detaches a subtree and frees its nodes. Any arena.Index<Node> the
// caller still holds for those nodes becomes stale: Get on it returns None.
func (t mut Tree) Remove(id arena.Index<Node>) {
    node := t.nodes.Remove(id) ?? return         // already gone: nothing to do
    for _, child := range node.children { t.Remove(child) }
    if parent := node.parent {
        if p := t.nodes.GetMut(parent) { p.children.RemoveValue(id) }
    }
}

// ref receiver: shared borrow, cannot mutate.
func (t ref Tree) Path(id arena.Index<Node>) []string {
    path := []string{}
    cur := Some(id)
    for cur != None {
        at := cur ?? break
        n := t.nodes.Get(at) ?? break            // stale index ends the walk
        path.Push(n.value.Clone())               // n is a borrow; the path owns copies
        cur = n.parent
    }
    path.Reverse()
    return path
}

// Depth-first walk with a closure. The closure receives a borrow and
// therefore cannot keep the node after the walk returns.
func (t ref Tree) Walk(id arena.Index<Node>, visit func(ref Node)) {
    n := t.nodes.Get(id) ?? return
    visit(n)
    for _, child := range n.children { t.Walk(child, visit) }
}

func (t ref Tree) Len() int { return t.nodes.Len() }

func main() {
    t := NewTree("root")
    a := t.AddChild(t.root, "a")
    b := t.AddChild(a, "b")
    fmt.Println(t.Path(b))             // [root a b]

    count := 0
    t.Walk(t.root, func(n ref Node) { count += 1 })
    fmt.Println(count)                 // 3

    t.Remove(a)                        // frees a and b
    fmt.Println(t.Len())               // 1
    fmt.Println(t.nodes.Get(b))        // None: b's generation no longer matches

    // Compile error: a borrow escaping into a struct.
    // keep := Holder{node: t.nodes.Get(t.root)?}
}
