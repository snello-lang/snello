// Version 2: Teak with a hand-rolled arena.
//
// Without a GC every value has one owner, so a child cannot hold a pointer
// to its parent: the parent would then have two owners. The fix is to let
// one slice own every node and link nodes by index. This is the idea in
// its simplest form, written by hand so the mechanism is visible.
//
// Compared to tree.go: no pointers, no GC, the whole tree is one
// allocation, and the compiler guarantees nothing is freed twice or used
// after the tree is dropped. What it does not guarantee is that an index
// is still live; see Remove.

package tree

import "fmt"

type NodeID int

type Node struct {
    value    string
    parent   NodeID?               // None for the root
    children []NodeID
    live     bool                  // false after Remove; the slot is kept
}

type Tree struct {
    nodes []Node                   // owns every node
}

func NewTree(value string) Tree {
    return Tree{nodes: []Node{{value: value, parent: None, children: []NodeID{}, live: true}}}
}

func (t mut Tree) AddChild(parent NodeID, value string) NodeID {
    id := NodeID(len(t.nodes))
    t.nodes = append(t.nodes, Node{value: value, parent: Some(parent), children: []NodeID{}, live: true})
    t.nodes[parent].children.Push(id)
    return id
}

// Remove marks a subtree dead. The slots stay allocated, because reusing
// them would let an old NodeID silently point at a new node. That is the
// limitation the standard library Arena fixes with generation counters.
func (t mut Tree) Remove(id NodeID) {
    if !t.nodes[id].live { return }
    t.nodes[id].live = false
    children := t.nodes[id].children.Clone()      // copy out: cannot borrow t.nodes[id] while mutating others
    for _, child := range children { t.Remove(child) }
    if parent := t.nodes[id].parent {
        t.nodes[parent].children.RemoveValue(id)
    }
    t.nodes[id].value = ""                         // drop the payload now, not at tree drop
    t.nodes[id].children = []NodeID{}
}

func (t ref Tree) Path(id NodeID) []string {
    path := []string{}
    cur := Some(id)
    for cur != None {
        n := ref t.nodes[cur?]
        if !n.live { break }
        path = append(path, n.value.Clone())
        cur = n.parent
    }
    path.Reverse()
    return path
}

func (t ref Tree) Walk(id NodeID, visit func(ref Node)) {
    n := ref t.nodes[id]
    if !n.live { return }
    visit(n)
    for _, child := range n.children { t.Walk(child, visit) }
}

func main() {
    t := NewTree("root")
    a := t.AddChild(0, "a")
    b := t.AddChild(a, "b")
    fmt.Println(t.Path(b))             // [root a b]

    count := 0
    t.Walk(0, func(n ref Node) { count += 1 })
    fmt.Println(count)                 // 3

    t.Remove(a)
    fmt.Println(t.Path(b))             // []: b is dead and Path says so
    // But: b's slot is still allocated, and if we reused slots, an old
    // NodeID could alias a new node. The hand-rolled version cannot tell
    // a stale id from a fresh one.
}
