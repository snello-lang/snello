// 08: Generic containers and functions with trait bounds.
//
// Tests: generic structs, bounds, monomorphization, and the choice between
// borrowing and consuming in a generic function.

package generic

import "fmt"

// A growable list. The built-in slice already does this; the point is the
// shape of a generic type with ref and mut methods.
type List<T> struct {
    items []T
}

func (l mut List<T>) Push(v T)         { l.items.Push(v) }
func (l ref List<T>) Len() int         { return len(l.items) }
func (l ref List<T>) Get(i int) ref T? {
    if i < len(l.items) { return Some(ref l.items[i]) }
    return None
}

// Map consumes the input list. Each element is moved into f, so f may
// consume it; nothing is cloned.
func Map<T, U>(l List<T>, f func(T) U) List<U> {
    out := List<U>{}
    for _, v := range l.items { out.Push(f(v)) }    // ranging over an owned slice moves
    return out
}

// Filter also consumes: elements that pass are moved to the output, the
// rest are dropped. A borrowing Filter that returned List<ref T> is
// rejected by the compiler, because a List is an owned struct and cannot
// hold borrows. To filter without consuming, collect indices instead.
func Filter<T>(l List<T>, keep func(ref T) bool) List<T> {
    out := List<T>{}
    for _, v := range l.items {
        if keep(ref v) { out.Push(v) }
    }
    return out
}

// A bound with two traits. Returns an owned copy of the maximum.
func MaxBy<T: Ord + Clone>(xs ref []T) T? {
    if len(xs) == 0 { return None }
    best := ref xs[0]
    for _, x := range xs {
        if x.Cmp(best) == Greater { best = x }
    }
    return Some(best.Clone())
}

// A generic type may implement a trait conditionally on its parameters.
type Pair<A: Copy, B: Copy> struct impl Copy { a A; b B }

func main() {
    l := List<int>{}
    for i := 0; i < 5; i++ { l.Push(i) }
    doubled := Map(l, func(x int) int { return x * 2 })        // l moved; using l now is an error
    evens := Filter(doubled, func(x ref int) bool { return x % 4 == 0 })
    fmt.Println(evens.items)              // [0 4 8]
    fmt.Println(MaxBy(ref evens.items))   // Some(8)

    p := Pair{a: 1, b: 2.0}
    q := p                                // Copy: both usable
    fmt.Println(p.a + q.a)
}
