// A program of two files, main.snello and report.snello, with a
// package of its own beside it, shapes, imported by its directory's
// name under the root snello.mod marks: a struct, an enum, a trait and
// the generic functions of the package used across the boundary. Built
// with snello build examples/packaged, which names the binary
// after the directory.
package main

import ("fmt"; "shapes")

func main() {
	c := shapes.Circle{Radius: 1}
	r := shapes.Rect{W: 2, H: 3}
	fmt.Println(c.Name(), r.Name())
	fmt.Println(shapes.Largest(ref c, ref r))
	fmt.Println(shapes.Describe(kindOf(ref c)), shapes.Describe(kindOf(ref r)), kindOf(ref r) == shapes.Square)
	fmt.Println(report(ref c), report(ref r))
	fmt.Println(shapes.Area(c) > 3, shapes.Area(r), reports.Load())
}
