// Malformed statements. Each body goes on after the fault.

package p

func f(xs []int, x int) {
    spawn x                                 // ERROR "expression in spawn must be a function call"
    for i += range xs {}                    // ERROR "'range' needs ':=' or '='"
    a, b                                    // ERROR "expected ':=' or '=', found 'newline'"
    if a + b := x {}                        // ERROR "expected a name, a tuple or a variant pattern before ':='"
    )                                       // ERROR "expected statement, found ')'"
    for a, b, c := range xs {}              // ERROR "range allows at most two variables"
    if a { x } else y                       // ERROR "expected 'if' or '{', found 'y'"
    x := 1 y := 2                           // ERROR "expected ';' or newline, found 'y'"
    g(x)
}
