// Malformed expressions and types.

package p

func f() {
    x := g(a                                // ERROR "expected ')', found 'newline'"
    y := T{a: }                             // ERROR "expected expression, found '}'"
    z := if c { 1 }                         // ERROR "expected 'else', found 'newline'"
    w := a.b.c<T>{}                         // ERROR "expected '(', found '{'"
    var m map[K                             // ERROR "expected ']', found 'newline'"
    var a [n]int                            // ERROR "expected array length, found 'n'"
    var c <-chan<- T                        // ERROR "expected 'chan', found 'T'"
    g(x, y, z, w)
}
