// Control flow: if and else-if chains, the three forms of for, continue
// reaching the post statement, break, also from inside a match, a named
// number type, and a swap by parallel assignment.

package main

import "fmt"

type Score int

enum Step { Go; Stop }

func grade(s Score) string {
	if s >= 90 {
		return "A"
	} else if s >= 80 {
		return "B"
	}

	return "C"
}

func main() {
	for i := 0; i < 3; i += 1 {
		if i == 1 {
			continue
		}

		fmt.Println(i, grade(Score(70+i*12)))
	}

	n := 0
	for n < 5 {
		n += 2
	}

	for {
		n -= 1
		if n == 0 {
			break
		}
	}

	x, y := 1, 2
	x, y = y, x
	fmt.Println(n, x, y, !(x > y) && y != 0)

	// A condition and a post statement that call run on every pass, and
	// continue still reaches the post statement.
	hits := 0
	for i := 0; i < limit(3); i = step(i) {
		if i == 1 {
			continue
		}

		hits += i
	}

	fmt.Println(hits)

	// A break inside a match ends the loop around it: a match is not a
	// loop, and neither is a select.
	taken := 0
	for _, s := range []Step{Go, Go, Stop, Go} {
		match s {
			Stop => break,
			Go => taken += 1,
		}
	}

	fmt.Println(taken)

	// Deferred calls run at return, last deferred first, with their
	// arguments as they were at the defer; a mut receiver is lent, not
	// copied, so the call changes it.
	fmt.Println(ordered(2), tally())
}

func ordered(n int) int {
	defer fmt.Println("third")
	defer fmt.Println("second", n)
	n += 10
	if n > 5 {
		defer fmt.Println("first", n)
		return n
	}

	return 0
}

struct Tally {
	n int
}

func (t mut Tally) Add(v int) { t.n += v }

func tally() int {
	t := Tally{n: 1}
	defer t.Add(5)
	t.Add(1)
	return t.n
}

func limit(n int) int { return n }

func step(i int) int { return i + 1 }
