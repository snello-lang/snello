// select: a receive from whichever channel is ready, a default when
// none is, a send case that goes when there is room, a send on an
// unbuffered channel that goes only once a receiver waits for it, a
// bare receive, a choice among several ready cases, and a break inside
// a case that ends the loop around the select, and a select of ten
// cases, more than fit in its own frame. The tasks hand over one
// value at a time, so the order of what main prints does not depend on
// which task ran first, and a sum does not depend on the choice.

package main

import "fmt"

func feed(data chan<- int, quit chan<- ()) {
	for i := 1; i <= 5; i++ {
		data <- i // taken before the next is offered: nothing waits in data when quit closes
	}

	close(quit)
}

func take(u <-chan string, ready chan<- (), got chan<- string) {
	ready <- ()
	got <- (<-u).Expect("a word")
}

func main() {
	data := make(chan int)
	quit := make(chan ())
	spawn feed(data.Clone(), quit.Clone())
	sum := 0
	for {
		select {
		case v := <-data:
			sum += v.Expect("a number")
		case <-quit:
			break // ends the for: a select is not a loop
		}
	}

	fmt.Println("sum", sum)

	empty := make(chan int)
	select {
	case v := <-empty:
		fmt.Println("unexpected", v)
	default:
		fmt.Println("nothing ready")
	}

	out := make(chan string, 1)
	for i := 0; i < 2; i++ {
		select {
		case out <- "word".Clone():
			fmt.Println("sent")
		default:
			fmt.Println("full")
		}
	}

	fmt.Println((<-out).Expect("the word"))

	// Two channels ready at once: whichever is chosen, six selects take
	// every value, and a bare receive drops the word it took.
	left := make(chan int, 3)
	right := make(chan int, 3)
	words := make(chan string, 1)
	for i := 1; i <= 3; i++ {
		left <- i
		right <- i * 10
	}

	words <- "dropped".Clone()
	total := 0
	for i := 0; i < 7; i++ {
		select {
		case v := <-left:
			total += v.Expect("left")
		case v := <-right:
			total += v.Expect("right")
		case <-words:
		}
	}

	fmt.Println("total", total)

	u := make(chan string)
	select {
	case u <- "nobody".Clone(): // no receiver waits: the send does not go
		fmt.Println("unexpected")
	default:
		fmt.Println("no receiver")
	}

	ready := make(chan ())
	got := make(chan string)
	spawn take(u.Clone(), ready.Clone(), got.Clone())
	<-ready
	for {
		select {
		case u <- "handed".Clone(): // only once the receiver waits on u
			break
		default:
		}
	}

	fmt.Println((<-got).Expect("handed over"))

	// A select of more cases than fit in its own frame, which takes its
	// working space from the system: it waits on ten channels until a
	// task sends on the last.
	c0 := make(chan int)
	c1 := make(chan int)
	c2 := make(chan int)
	c3 := make(chan int)
	c4 := make(chan int)
	c5 := make(chan int)
	c6 := make(chan int)
	c7 := make(chan int)
	c8 := make(chan int)
	c9 := make(chan int)
	spawn send(c9.Clone(), 99)
	select {
	case v := <-c0:
		fmt.Println("case 0", v ?? -1)
	case v := <-c1:
		fmt.Println("case 1", v ?? -1)
	case v := <-c2:
		fmt.Println("case 2", v ?? -1)
	case v := <-c3:
		fmt.Println("case 3", v ?? -1)
	case v := <-c4:
		fmt.Println("case 4", v ?? -1)
	case v := <-c5:
		fmt.Println("case 5", v ?? -1)
	case v := <-c6:
		fmt.Println("case 6", v ?? -1)
	case v := <-c7:
		fmt.Println("case 7", v ?? -1)
	case v := <-c8:
		fmt.Println("case 8", v ?? -1)
	case v := <-c9:
		fmt.Println("case 9", v ?? -1)
	}
}

// send sends v on c.
func send(c chan<- int, v int) {
	c <- v
}
