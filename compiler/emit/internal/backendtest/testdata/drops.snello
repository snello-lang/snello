// Drops: where values die. A Drop method prints its name, so the order
// of the lines is the order the compiler releases values in: at the
// end of a scope, last declared first; before a return, break or
// continue; at the end of a match arm for what the arm bound, and
// after the match for what no arm took; and at the end of a statement
// for a value no variable holds. A moved value is never dropped twice.
// A take through a borrow a call returned runs the call once, and a
// borrow of a temporary keeps it to the end of its statement.

package main

import "fmt"

struct Res impl Drop { name string }

func (r mut Res) Drop() { fmt.Println("drop", r.name) }

func keep(s string) {}

struct Slot { v string? }

// first lends the first slot, and says so, to show it runs once.
func first(ss mut []Slot) mut Slot {
	fmt.Println("first")
	return mut ss[0]
}

// pick returns one of its two arguments; the other dies with the match.
// The first arm binds both by value, but a failed guard leaves them in
// place for the next arm.
func pick(c bool, a Res, b Res) Res {
	return match (a, b) {
		(x, y) if c => { fmt.Println("both", x.name, y.name); x },
		(x, _)      => x,
	}
}

// early leaves a loop three ways: continue, return and falling off the
// end, dropping the pass's locals each time.
func early(xs []string) int {
	for i, x := range xs {
		r := Res{name: x.Clone()}
		if i == 1 { return len(r.name) }
		if i == 0 { continue }
		fmt.Println("never", r.name)
	}
	return -1
}

func main() {
	s := "a".Clone()
	if len(s) > 0 { keep(s) } else { fmt.Println(s) }  // moved on one path only

	fmt.Println(pick(false, Res{name: "a"}, Res{name: "b"}).name)  // b dies in the match, a after the print
	fmt.Println(pick(true, Res{name: "c"}, Res{name: "d"}).name)

	fmt.Println(early([]string{"x".Clone(), "yy".Clone(), "zzz".Clone()}))

	m := map[string]string{"k".Clone(): "v1".Clone()}
	m.Insert("k".Clone(), "v2".Clone())      // the old value and the duplicate key are freed
	m["k".Clone()] = "v3".Clone()
	for k, v := range m { fmt.Println(k, v) }

	rs := []Res{Res{name: "p"}}
	rs.Push(Res{name: "q"})
	if last := rs.Pop() { fmt.Println("popped", last.name) }  // last dies at the end of the body
	fmt.Println(len(rs))

	t := "t".Clone()
	g := func() { keep(t) }                   // the closure owns t: it moved it
	g()

	u := "u".Clone()
	defer keep(u)                             // moved into the deferred call

	acc := ""
	for i := 0; i < 3; i += 1 { acc += "x"; if i == 1 { break } }
	fmt.Println(acc)

	words := []string{"w".Clone()}
	clone := words.Clone()                    // each string copied; both slices own theirs
	fmt.Println(clone, words)

	o := Some("o".Clone())
	if v := o { fmt.Println(v) }

	ss := []Slot{Slot{v: Some("sv".Clone())}}
	fmt.Println(take(mut first(mut ss).v) ?? "none".Clone())   // first runs once
	fmt.Println((ref Res{name: "tmp".Clone()}).name)           // a borrow of a temporary: it dies with the statement
	d := Res{name: "blank".Clone()}
	_ = d                                     // dropped here, once: _ = d moves d
	e1, e2 := Res{name: "e1".Clone()}, Res{name: "e2".Clone()}
	_, kept := e1, e2                         // e1 dropped here; kept owns e2
	fmt.Println(kept.name)
	cs := []Res{Res{name: "c1".Clone()}, Res{name: "c2".Clone()}}
	cs.Clear()                                // each element dropped, in order
	fmt.Println(len(cs))
	fmt.Println("end")                        // then rs, with p inside, is dropped
}
