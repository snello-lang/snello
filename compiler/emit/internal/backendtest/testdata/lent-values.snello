// Values lent where a borrow is wanted, followed through the steps that
// make them: a variant's ref field given an owned variable lends it,
// which is still the variable's, used after and dropped once; Some
// given one for an option of a borrow lends it too; a string chosen
// among literals is lent through a call and kept past its statement,
// its bytes being the program's; an element of a tuple made here holds
// what that element lends, a parameter's borrow, which is returned,
// beside an element borrowing a value made here, used within its
// statement; a value read through a borrow of a local is returned by
// value; and a borrow read out of a local, through a borrow of it, a
// field, an element, a part matched through a borrow, an element ranged
// over through one or a tuple taken apart through one, is returned,
// what the local holds being the parameter's, kept in a variable first
// or read through two borrows; a borrow written ref of a borrow variable
// or a field holding one, which passes the borrow on; the result of a
// borrow variable passed where a ref is wanted, its borrow copied; a
// ref of a borrow variable, which is its borrow copied; a
// struct of borrows rebuilt from its own fields field by field; and a mut
// view of a slice given to a call within its statement, passed on
// through a call and a generic call, an element of it returned, and the
// view kept in variables and an option, changed through each, past the
// block that made it, through ?? and a call's tuple, and a slice walked
// by a view in a loop's post statement and its body; and a struct
// holding a mut borrow moved before what it borrows changes, and a
// deferred print of a tuple holding a borrow. The borrows the same steps would carry past their owners are refused,
// testdata/errors/lent-through-values.snello.

package main

import "fmt"

struct Span {
	text ref string
	at   int
}

struct Two {
	a ref string
	b ref string
}

enum Held {
	Holder(ref string)
	Empty
}

enum Both {
	Pair(ref string, int)
	Nothing
}

func show(h ref Held) string {
	return match h {
		Holder(t) => t.Clone(),
		Empty => "empty",
	}
}

func id(x ref string) ref string {
	return x
}

func made() string {
	return "made here".Clone()
}

func chosen(c bool) ref string {
	return id(if c { "alpha" } else { "beta" })
}

func first(p ref string) ref string {
	match (p, ref made()) {
		(a, b) => {
			fmt.Println(len(b))
			return a
		},
	}
}

func copied(p ref string) Span {
	x := Span{text: p, at: 5}
	r := ref x
	return *r
}

func field(p ref string) ref string {
	sp := Span{text: p, at: 1}
	r := ref sp
	x := r.text
	return x
}

func element(p ref string) ref string {
	parts := p.Split(",")
	x := parts[1]
	return x
}

func matched(p ref string) ref string {
	h := Pair(p, 2)
	r := ref h
	return match r {
		Pair(x, n) => x,
		_ => "none",
	}
}

func optional(p ref string) ref string {
	o := Some(p)
	return match ref o {
		Some(x) => x,
		None => "none",
	}
}

func ranged(p ref string) ref string {
	parts := p.Split(",")
	for x := range ref parts {
		return *x
	}

	return "none"
}

func apart(p ref string) ref string {
	t := (p, 1)
	r := ref t
	a, b := *r
	return a
}

func kept(p ref string) ref string {
	o := Some(p)
	m := match ref o {
		Some(x) => x,
		None => "none",
	}

	return m
}

func twice(p ref string) ref string {
	parts := p.Split(",")
	r := ref parts
	q := ref r
	x := q[0]
	return x
}

func passedOn(p ref string) ref string {
	sp := Span{text: p, at: 1}
	r := ref sp
	return ref r.text
}

func viaLocal(xs ref []int) ref []int {
	ys := xs
	return ref ys
}

func inner(x ref string) ref string {
	return x
}

func outer(p ref string) ref string {
	var y ref string = p
	return inner(y)
}

func slot(p ref string) string {
	var x ref string = p
	var rr ref string = ref x // a ref of a borrow variable is its borrow, copied
	return rr.Clone()
}

func rebuilt(p ref string) string {
	var t Two = Two{a: p, b: "lit"}
	{
		y := "inner".Clone()
		t.b = y
		t = Two{a: t.b, b: t.a}
		t.a = "q"
	}

	return t.a.Clone() + " " + t.b.Clone()
}

func inc(xs mut []int) {
	for i := 0; i < len(xs); i += 1 {
		xs[i] += 10
	}
}

func passOn(xs mut []int) mut []int {
	return xs
}

func sameOf<T>(x T) T {
	return x
}

func firstOf(x mut []int) mut int {
	return mut x[0]
}

func second(s mut []int) mut int {
	return firstOf(mut s[1:])
}

func pairOf(x mut []int) (mut []int, int) {
	return (x, 1)
}

func walked() string {
	xs := []int{1, 2, 3, 4, 5}
	ys := []int{0}
	var r mut []int = mut ys
	if len(xs) > 2 {
		r = mut xs[1:] // the header outlives the if, in a slot of the function
	}

	r[0] += 100
	var o (mut []int)? = None
	k := o ?? mut xs[3:]
	k[0] += 1000
	for v := mut xs; len(v) > 3; v = mut v[1:] {
		v[0] += 10
	}

	w := mut xs
	for len(w) > 4 {
		w[0] += 20
		w = mut w[1:]
	}

	var last mut []int = mut ys
	for i := 0; i < 3; i += 1 {
		last, _ = pairOf(mut xs[i:])
	}

	last[0] += 5000
	return fmt.Sprint(xs)
}

struct Keeper {
	r mut string
	n int
}

func moved() string {
	xs := []string{"first".Clone()}
	h := Keeper{r: mut xs[0], n: 1}
	g := h
	*g.r += "!"
	xs.Push("second".Clone())
	t := (ref xs[1], 2)
	defer fmt.Println("deferred", t)
	return fmt.Sprint(xs)
}

func views() string {
	xs := []int{1, 2, 3, 4}
	inc(mut xs[2:])
	inc(passOn(mut xs[1:]))
	inc(sameOf<mut []int>(mut xs[3:]))
	*second(mut xs) += 100
	v := mut xs[2:]
	v[1] += 1000
	w := v
	inc(w)
	var r mut []int = mut xs
	r = mut xs[3:]
	inc(r)
	o := Some(mut xs[0:1])
	if s := o {
		inc(s)
	}

	return fmt.Sprint(xs)
}

func main() {
	s := "hello, world".Clone()
	h := Holder(s)
	fmt.Println(show(h))
	fmt.Println(s)
	var o (ref string)? = Some(s)
	fmt.Println(o ?? "none")
	k := id(if len(s) > 3 { "long" } else { "short" })
	fmt.Println(k, chosen(false))
	fmt.Println(first(s))
	sp := copied(s)
	fmt.Println(sp.text, sp.at)
	q := "left,right".Clone()
	fmt.Println(field(q), element(q), matched(q), optional(q), ranged(q), apart(q))
	fmt.Println(kept(q), twice(q))
	xs := []int{4, 5, 6}
	fmt.Println(passedOn(q), viaLocal(xs)[1], outer(q), slot(q), rebuilt(q))
	fmt.Println(views())
	fmt.Println(walked())
	fmt.Println(moved())
}
