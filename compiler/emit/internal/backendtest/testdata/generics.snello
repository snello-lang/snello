// Generics, compiled one copy per instance: a generic list with ref and
// mut methods and a generic method of its own, generic functions with
// inferred and written type arguments, a generic enum matched on, a
// generic struct literal, a list of lists, a list of a Drop type whose
// elements are freed with it, and a generic function returning a
// borrow, and a generic type with a Drop method of its own.

package main

import "fmt"

struct List<T> {
	items []T
}

func (l mut List<T>) Push(v T)         { l.items.Push(v) }
func (l ref List<T>) Len() int         { return len(l.items) }
func (l ref List<T>) Get(i int) ref T? {
	if i < len(l.items) {
		return Some(ref l.items[i])
	}

	return None
}

func (l ref List<T>) Conv<U>(f func(ref T) U) List<U> {
	out := List<U>{}
	for _, v := range ref l.items {
		out.Push(f(v))
	}

	return out
}

func Map<T, U>(l List<T>, f func(T) U) List<U> {
	out := List<U>{}
	for _, v := range l.items {
		out.Push(f(v))
	}

	return out
}

func Filter<T>(l List<T>, keep func(ref T) bool) List<T> {
	out := List<T>{}
	for _, v := range l.items {
		if keep(ref v) {
			out.Push(v)
		}
	}

	return out
}

func Empty<T>() List<T> { return List<T>{} }

func First<T>(xs ref []T) ref T? {
	if len(xs) == 0 {
		return None
	}

	return Some(ref xs[0])
}

enum Tree<T> {
	Leaf(v T)
	Branch(left *Tree<T>, right *Tree<T>)
}

func sum(t ref Tree<int>) int {
	return match t {
		Leaf(v) => v,
		Branch(l, r) => sum(l) + sum(r),
	}
}

struct Pair<A, B> {
	a A
	b B
}

struct Res impl Drop {
	name string
}

func (r mut Res) Drop() { fmt.Println("drop", r.name) }

struct Box<T> impl Drop {
	v   T
	tag string
}

func (b mut Box<T>) Drop() { fmt.Println("drop box", b.tag) }

func main() {
	l := List<int>{}
	for i := 0; i < 5; i += 1 {
		l.Push(i)
	}

	doubled := Map(l, func(x int) int { return x * 2 })
	evens := Filter(doubled, func(x ref int) bool { return x % 4 == 0 })
	fmt.Println(evens.items, evens.Len())
	if v := evens.Get(1) {
		fmt.Println(v)
	}

	words := evens.Conv(func(x ref int) string { return fmt.Sprint("n", x) })
	halves := evens.Conv(func(x ref int) int { return x / 2 })
	fmt.Println(words.items, halves.items)

	var e List<string> = Empty()
	e.Push("x")
	fmt.Println(e.items, Empty<f64>().Len())

	t := Branch(&Leaf(1), &Branch(&Leaf(2), &Leaf(3)))
	fmt.Println(sum(t))

	p := Pair{a: 1, b: "one"}
	q := Pair<bool, Pair<int, string>>{a: true, b: p}
	fmt.Println(q.a, q.b.a, q.b.b)

	nested := List<List<int>>{}
	nested.Push(evens)
	fmt.Println(nested.Len(), nested.items[0].items)

	if s := First(ref words.items) {
		fmt.Println(s)
	}

	rs := List<Res>{}
	rs.Push(Res{name: "a"})
	rs.Push(Res{name: "b"})
	fmt.Println(rs.Len())

	boxed := Box<int>{v: 1, tag: "int"}
	named := Box<string>{v: "s", tag: "string"}
	fmt.Println(boxed.v, named.v)
}
