// Maps: literals, insertion by index and by Insert, reading a missing
// key as the zero value, += on an entry, Get, GetMut, Contains, Remove,
// Clone, range in insertion order, a tuple as a key, a map declared
// without a value, and growth with removals.

package main

import "fmt"

struct Count {
	word string
	n int
}

func tally(words []string) map[string]int {
	counts := map[string]int{}
	for _, w := range words {
		counts[w] += 1
	}

	return counts
}

func main() {
	m := map[string]int{"one": 1, "two": 2}
	m.Insert("three", 3)
	m["four"] = 4
	m["one"] += 10
	fmt.Println(m, len(m), m["two"], m["missing"], len(m))
	// Get lends into m, which Remove changes: the borrows are turned into
	// text first, as one call may not hold a borrow of m while it changes m.
	fmt.Println(fmt.Sprint(m.Get("three"), m.Get("nope")), m.Contains("four"), m.Remove("two"), m.Remove("two"), m)
	if v := m.GetMut("four") {
		*v *= 100
	}

	fmt.Println(m["four"])
	for k, v := range m {
		fmt.Println(k, v)
	}

	counts := tally([]string{"a", "b", "a", "c", "a", "b"})
	list := []Count{}
	for k, v := range ref counts { // through a borrow: the map keeps its entries
		list.Push(Count{word: k.Clone(), n: v})
	}

	fmt.Println(list, counts.Clone())

	var empty map[int]bool
	fmt.Println(empty, len(empty), empty[3], empty.Contains(3))
	empty[3] = true
	fmt.Println(empty)

	pairs := map[(int, int)]string{}
	pairs[(1, 2)] = "a"
	pairs[(2, 1)] = "b"
	fmt.Println(pairs[(1, 2)], pairs[(2, 1)], pairs[(3, 3)] == "", pairs)
	big := map[int]int{}
	for i := 0; i < 1000; i += 1 {
		big[i*7] = i
	}

	for i := 0; i < 1000; i += 2 {
		big.Remove(i * 7)
	}

	fmt.Println(len(big), big[7], big[14], big[993*7])
	double(mut counts)
	fmt.Println(counts)

	lists := map[string][]int{}
	lists["a"].Push(1) // a new entry is made for a method that changes it
	lists["a"].Push(2)
	fmt.Println(lists, len(lists["b"]), lists)

	reals := map[f64]string{}
	reals[0.0] = "zero"
	fmt.Println(reals[-0.0], reals.Contains(0.5))
}

func double(m mut map[string]int) {
	for _, v := range m {
		*v *= 2
	}
}
