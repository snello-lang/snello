// Maps: literals, insertion by index and by Insert, reading a missing
// key as the zero value, += and ++ on an entry, a write through an entry
// into the map, array or struct it holds, making the entry when its key
// is new, Get, GetMut, Contains, Remove,
// Clone, Retain, range in insertion order, a tuple as a key, a map
// declared without a value, and growth with removals.

package main

import "fmt"

struct Count {
	word string
	n int
}

func tally(words []string) map[string]int {
	counts := map[string]int{}
	for _, w := range words {
		counts[w] += 1
	}

	return counts
}

func main() {
	m := map[string]int{"one": 1, "two": 2}
	m.Insert("three", 3)
	m["four"] = 4
	m["one"] += 10
	fmt.Println(m, len(m), m["two"], m["missing"], len(m))
	// Get lends into m, which Remove changes: the borrows are turned into
	// text first, as one call may not hold a borrow of m while it changes m.
	fmt.Println(fmt.Sprint(m.Get("three"), m.Get("nope")), m.Contains("four"), m.Remove("two"), m.Remove("two"), m)
	if v := m.GetMut("four") {
		*v *= 100
	}

	fmt.Println(m["four"])
	for k, v := range m {
		fmt.Println(k, v)
	}

	counts := tally([]string{"a", "b", "a", "c", "a", "b"})
	list := []Count{}
	for k, v := range ref counts { // through a borrow: the map keeps its entries
		list.Push(Count{word: k.Clone(), n: v})
	}

	fmt.Println(list, counts.Clone())

	var empty map[int]bool
	fmt.Println(empty, len(empty), empty[3], empty.Contains(3))
	empty[3] = true
	fmt.Println(empty)

	pairs := map[(int, int)]string{}
	pairs[(1, 2)] = "a"
	pairs[(2, 1)] = "b"
	fmt.Println(pairs[(1, 2)], pairs[(2, 1)], pairs[(3, 3)] == "", pairs)
	big := map[int]int{}
	for i := 0; i < 1000; i += 1 {
		big[i*7] = i
	}

	for i := 0; i < 1000; i += 2 {
		big.Remove(i * 7)
	}

	fmt.Println(len(big), big[7], big[14], big[993*7])
	double(mut counts)
	fmt.Println(counts)

	lists := map[string][]int{}
	lists["a"].Push(1) // a new entry is made for a method that changes it
	lists["a"].Push(2)
	fmt.Println(lists, len(lists["b"]), lists)

	reals := map[f64]string{}
	reals[0.0] = "zero"
	fmt.Println(reals[-0.0], reals.Contains(0.5))

	seen := map[string]int{}
	seen["x"]++ // a new entry, counted from zero
	seen["x"]++
	seen["y"]--
	fmt.Println(seen)

	nested := map[string]map[string]int{}
	nested["a"] = map[string]int{}
	nested["a"]["b"]++
	nested["new"]["c"] = 1 // the outer entry is made
	arrays := map[string][3]int{}
	arrays["k"][1] = 7
	arrays["k"][2]++
	fmt.Println(nested, arrays)
	holders := map[string]Holder{}
	holders["h"].xs[0] = 4
	holders["h"].m["z"]++
	fmt.Println(holders["h"].xs, holders["h"].m)
	// Retain: the entries kept keep their order and may be changed, the
	// rest are dropped at their places; an emptied map takes new entries.
	ages := map[string]int{"ann": 31, "bob": 17, "cid": 45, "dee": 12}
	ages.Retain(func(name ref string, age mut int) bool {
		*age += 1
		return *age >= 18
	})
	fmt.Println(ages, len(ages))
	ages.Insert("eve", 22)
	ages.Retain(func(name ref string, age mut int) bool { return name.HasPrefix("e") })
	fmt.Println(ages)
	ages.Retain(func(name ref string, age mut int) bool { return false })
	fmt.Println(ages, len(ages), ages.Contains("eve"))
	ages["fay"] = 1
	fmt.Println(ages)
	owned := map[string][]string{"a": []string{"x"}, "b": []string{"y", "z"}, "c": []string{}}
	owned.Retain(func(k ref string, v mut []string) bool { return len(v) == 1 })
	fmt.Println(owned)
	tags := map[int](){}
	tags.Insert(1, ())
	tags.Insert(2, ())
	tags.Insert(3, ())
	tags.Retain(func(k ref int, _ mut ()) bool { return *k != 2 })
	fmt.Println(len(tags), tags.Contains(2), tags.Contains(3))
}

struct Holder { xs [2]int; m map[string]int }

func double(m mut map[string]int) {
	for _, v := range m {
		*v *= 2
	}
}
