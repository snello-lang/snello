// Sockets: a server task listening on this machine alone, at a port
// the system picks, and answering each line in upper case, a client
// dialing it, bufio over a connection, the end of a connection seen as
// a read of nothing, the error of dialing a port nothing listens on,
// worded as Go words it and of Kind Refused, the Errors of a port out
// of range and of a name with no address, a dial with no host, a read
// into a buffer with no room, a listener and a dial on IPv6 and the
// addresses they print, a name listened on and dialed, whose
// addresses the dial tries in turn, and an IPv4 client of a listener on
// every address of both families, whose address prints as IPv4.

package main

import (
	"bufio"
	"fmt"
	"io"
	"net"
	"strconv"
)

// serve answers one connection line by line, in upper case, until the
// client closes its side, then tells main how many lines it saw.
func serve(l net.Listener, done chan int) {
	conn := l.Accept().Expect("accept")
	lines := 0
	r := bufio.NewReader(mut conn)
	for {
		line := r.ReadString('\n').Expect("read") ?? break
		r.Get().WriteString(ref line.ToUpper()).Expect("write") // the Reader holds conn: it lends it back to write
		lines += 1
	}

	done <- lines
}

func main() {
	l := net.Listen("127.0.0.1", 0).Expect("listen")
	port := l.Port()
	done := make(chan int)
	spawn serve(l, done.Clone())

	c := net.Dial("127.0.0.1", port).Expect("dial")
	r := bufio.NewReader(mut c)
	for _, word := range []string{"snello", "native"} {
		r.Get().WriteString(ref (word.Clone() + "\n")).Expect("write")
		fmt.Println(r.ReadString('\n').Expect("read").Expect("a reply").Trim())
	}

	c.Close().Expect("close")
	fmt.Println("served", <-done ?? 0)

	match net.Dial("127.0.0.1", 1) {
		Ok(_) => fmt.Println("connected"),
		Err(e) => fmt.Println(e, e.Kind() == io.Refused),
	}

	fmt.Println(message(net.Listen("127.0.0.1", 70000)))
	fmt.Println(message(net.Dial("127.0.0.1", -1)))
	match net.Dial("nosuch.invalid", 80) {
		Ok(_) => fmt.Println("connected"),
		Err(e) => fmt.Println(e.Error().HasPrefix("dial tcp: lookup nosuch.invalid: ")), // no such host, or no name server reached; std/net's tests hold the wording
	}

	l2 := net.Listen("127.0.0.1", 0).Expect("listen")
	d := net.Dial("", l2.Port()).Expect("dial with no host") // this machine, as in Go
	a := l2.Accept().Expect("accept")
	empty := []byte{}
	fmt.Println(d.Read(mut empty), a.Close().IsOk()) // a buf with no room reads nothing, at once

	l6 := net.Listen("::1", 0).Expect("listen on IPv6")
	at6 := strconv.Itoa(l6.Port())
	c6 := net.Dial("::1", l6.Port()).Expect("dial IPv6")
	a6 := l6.Accept().Expect("accept on IPv6")
	fmt.Println(l6.Addr() == "[::1]:" + at6, c6.RemoteAddr() == l6.Addr(), c6.LocalAddr() == a6.RemoteAddr(), a6.LocalAddr() == l6.Addr())
	fmt.Println(message(net.Dial("::1", 1)))

	ln := net.Listen("localhost", 0).Expect("listen on a name") // its first IPv4 address
	cn := net.Dial("localhost", ln.Port()).Expect("dial a name") // ::1 first where localhost has it, refused, then 127.0.0.1
	fmt.Println(ln.Addr() == "127.0.0.1:" + strconv.Itoa(ln.Port()), cn.RemoteAddr() == ln.Addr())
	found := net.LookupHost("localhost").Expect("lookup")
	fmt.Println(found.Contains("127.0.0.1") || found.Contains("::1"), net.LookupHost("::1"))

	le := net.Listen("", 0).Expect("listen on every address")
	at := strconv.Itoa(le.Port())
	ce := net.Dial("127.0.0.1", le.Port()).Expect("dial IPv4 into both families")
	ae := le.Accept().Expect("accept IPv4")
	fmt.Println(le.Addr() == "[::]:" + at, ae.LocalAddr() == "127.0.0.1:" + at, ae.RemoteAddr() == ce.LocalAddr())
}

// message gives what an operation reported: ok, or its Error's message.
func message<T>(r Result<T, io.Error>) string {
	return match r {
		Ok(_) => "ok".Clone(),
		Err(e) => e.Error(),
	}
}
