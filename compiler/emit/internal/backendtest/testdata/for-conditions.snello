// A for loop's condition is evaluated on every pass, whatever writing it
// takes: a map read by a key computed or held in a variable the body
// changes, in a three-part loop and a loop on a condition alone, and the
// length of a slice of a slice or of a string from an index the body
// moves.

package main

import "fmt"

func main() {
	m := map[int]int{0: 0, 1: 1, 2: 2, 3: 3}
	i, n := 0, 0
	for ; m[i + 1] < 3 && n < 10; i++ {
		n++
	}

	fmt.Println("computed key", n)
	ms := map[string]int{"a": 0, "b": 5}
	k := "a".Clone()
	c := 0
	for ; ms[k] < 3 && c < 10; c++ {
		k = "b".Clone()
	}

	fmt.Println("key in a variable", c)
	j, w := 0, 0
	for w < 10 && m[j + 1] < 3 {
		j++
		w++
	}

	fmt.Println("condition alone", w)
	xs := []int{1, 2, 3}
	p, q := 0, 0
	for ; len(xs[p:]) > 0 && q < 10; p++ {
		q++
	}

	fmt.Println("slice of a slice", q)
	s := "abc"
	r, t := 0, 0
	for len(s[r:]) > 0 && t < 10 {
		r++
		t++
	}

	fmt.Println("slice of a string", t)
}
