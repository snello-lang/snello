// A group of tasks: members added by their handles and waited for
// together, Wait Ok once every member returned, the first panic among
// them when one failed, the members cancelled by that panic so that one
// waiting ends, a member that returns cancelling no one, a group of a
// thousand members, a group of none, and what a failed member owned
// dropped before Wait returns.

package main

import ("fmt"; "task")

// bug is what the failing member panics with; many is the size of the
// large group.
const bug = "a member's bug"
const many = 1000

// A Note says, when dropped, that it was.
struct Note impl Drop {
	out chan ()
}

func (n mut Note) Drop() { n.out <- () }

// tick sends n once and returns.
func tick(out chan int, n int) { out <- n }

// crash fails with the bug, dropping its note on the way out; the bug
// is a literal, since a panic abandons the plain memory of its frame.
func crash(note Note) { panic(bug) }

// stopWhenCancelled waits to receive on a channel of its own, which
// nothing sends on and which never ends, so that only a cancel wakes
// it, and sends 1 once it is told it was cancelled.
func stopWhenCancelled(out chan int) {
	quiet := make(chan ())
	if (<-quiet).IsNone() && task.Cancelled() {
		out <- 1
	}
}

// report sends whether the member starts cancelled.
func report(out chan bool) { out <- task.Cancelled() }

// fails panics with the message: one of several members failing at
// once.
func fails(message string) { panic(message) }

func main() {
	// Every member returns.
	out := make(chan int, 3)
	g := task.NewGroup()
	for i := 1; i <= 3; i++ {
		g.Add(spawn tick(out.Clone(), i))
	}

	match g.Wait() {
		Ok(_) => fmt.Println("three returned, sent", len(out)),
		Err(p) => fmt.Println("failed:", p.Message()),
	}

	// One member fails: its note is dropped, the group is cancelled,
	// the member waiting until then ends, and Wait reports the panic.
	dropped := make(chan (), 1)
	stopped := make(chan int, 1)
	g = task.NewGroup()
	g.Add(spawn stopWhenCancelled(stopped.Clone()))
	g.Add(spawn crash(Note{out: dropped.Clone()}))
	match g.Wait() {
		Ok(_) => fmt.Println("every member returned"),
		Err(p) => fmt.Println("failed:", p.Message(), "stopped", len(stopped), "dropped", len(dropped)),
	}

	// Three members fail at once: one panic is kept.
	g = task.NewGroup()
	g.Add(spawn fails("first"))
	g.Add(spawn fails("second"))
	g.Add(spawn fails("third"))
	match g.Wait() {
		Ok(_) => fmt.Println("every member returned"),
		Err(p) => {
			m := p.Message()
			fmt.Println("three failed, one kept:", m == "first" || m == "second" || m == "third")
		},
	}

	// A member that returns cancels no one: one added after it starts
	// uncancelled.
	one := make(chan int, 1)
	cancelled := make(chan bool, 1)
	g = task.NewGroup()
	g.Add(spawn tick(one.Clone(), 4))
	_ = <-one
	g.Add(spawn report(cancelled.Clone()))
	_ = g.Wait()
	fmt.Println("a return cancels no one:", !(<-cancelled).Expect("a report"))

	// A thousand members, and none.
	sent := make(chan int, many)
	g = task.NewGroup()
	for i := 0; i < many; i++ {
		g.Add(spawn tick(sent.Clone(), i))
	}

	match g.Wait() {
		Ok(_) => fmt.Println("a thousand returned, sent", len(sent)),
		Err(p) => fmt.Println("failed:", p.Message()),
	}

	match task.NewGroup().Wait() {
		Ok(_) => fmt.Println("none returned"),
		Err(p) => fmt.Println("failed:", p.Message()),
	}
}
