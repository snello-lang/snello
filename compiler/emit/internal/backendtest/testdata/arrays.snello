// Arrays in the backend: an array of strings written to, printed,
// cloned inside a struct and dropped with every element released; an
// array of arrays; an array copied whole and changed apart; a struct
// holding an array compared field by field through its own Eq; and a
// range over an array in every form, by value, ref and mut, of a
// variable, a package variable, a field and a call's result, an owned
// one consumed element by element with each dropped once, those left
// after a break included.

package main

import "fmt"

struct Grid impl Clone { cells [2][2]int; name string }

struct Pair impl Eq { a [2]int }

func (p ref Pair) Eq(o ref Pair) bool { return p.a[0] == o.a[0] && p.a[1] == o.a[1] }

struct Tok impl Drop { n int }

func (t mut Tok) Drop() { fmt.Println("drop", t.n) }

var digits = [3]int{1, 2, 3}

func toks() [3]Tok { return [3]Tok{Tok{n: 1}, Tok{n: 2}, Tok{n: 3}} }

func ranges() {
	sum := 0
	for _, d := range digits {
		sum += d
	}

	for i, d := range ref digits {
		sum += i * d
	}

	words := [2]string{"a".Clone(), "b".Clone()}
	for _, w := range mut words {
		*w = *w + "!"
	}

	for i, w := range ref words {
		fmt.Println(i, w)
	}

	p := Pair{a: [2]int{5, 6}}
	for _, x := range mut p.a {
		*x *= 10
	}

	for _, x := range ref p.a {
		sum += x
	}

	fmt.Println(sum, words)
	ts := toks()
	for _, t := range ts {
		fmt.Println("got", t.n)
		if t.n == 2 {
			break
		}
	}

	for i, t := range toks() {
		if i == 0 {
			continue
		}

		fmt.Println("got", t.n)
	}
}

func main() {
	var words [3]string
	words[0] = "a".Clone()
	words[1] = "bb".Clone()
	words[2] = "ccc".Clone()
	fmt.Println(words, len(words), words[2].Len())
	words[1] = "x".Clone() // the old element is dropped

	g := Grid{cells: [2][2]int{}, name: "g".Clone()}
	g.cells[1][0] = 7
	h := g.Clone()
	h.cells[1][0] = 8
	fmt.Println(g.cells, h.cells, g.cells[1][0] + h.cells[1][0])

	var nums [4]int
	copy := nums
	nums[3] = 9
	fmt.Println(nums, copy, cap(nums))

	p := Pair{a: [2]int{}}
	q := p
	fmt.Println(p == q)
	q.a[1] = 1
	fmt.Println(p == q)
	ranges()
}
