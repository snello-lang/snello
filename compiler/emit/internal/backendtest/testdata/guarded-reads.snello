// A read that writes statements of its own runs only where it is
// evaluated: behind && and || when the left side decides, and in its
// turn among a call's arguments. A map read saves its key, a slice of a
// slice is made in a temporary, and an element or a field of a value
// built in place is read from the temporary it is saved in.

package main

import "fmt"

struct P { a int; b int }

func inc(n mut int) int {
	*n += 1
	return 0
}

func two(a int, b int) int { return a * 10 + b }

func main() {
	m := map[int]int{0: 1, 1: 2}
	xs := []int{}
	if len(xs) > 0 && m[xs[0]] == 1 {
		fmt.Println("map read ran")
	}

	if len(xs) > 0 && ([2]int{xs[0], 1})[1] == 1 {
		fmt.Println("array element ran")
	}

	if len(xs) > 0 && (P{a: xs[0], b: 1}).b == 1 {
		fmt.Println("field ran")
	}

	if len(xs) > 1 && xs[1:][0] == 1 {
		fmt.Println("slice ran")
	}

	ok := len(xs) == 0 || m[xs[0] + 1] == 1
	fmt.Println("guards held", ok)
	i := 0
	fmt.Println(two(inc(mut i), m[i + 0]))
	j := 0
	ys := []int{5, 6, 7}
	fmt.Println(two(inc(mut j), ys[j:][0]))
}
