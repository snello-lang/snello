// Rule: a deferred call of the printing functions or of a built-in,
// fmt.Println(s), print(s), saves its arguments when the defer runs, a
// view of each, and reads them when the function returns,
// so what a saved view sees cannot be given a new value, moved away or
// dropped before then; a Copy value, an int, is saved whole and may
// change, and one that holds a borrow, a struct of a ref field or a
// tuple of one, holds what it borrows until the call runs. Fix: print a clone, defer fmt.Println(s.Clone()), or defer a
// closure that prints the value as it is then, defer func() { ... }().

package p

import "fmt"

func printed() {
    s := "old".Clone()
    defer fmt.Println(s)
    s = "new".Clone()                       // ERROR "cannot assign to s: s is borrowed by the deferred call"
}

func builtin() {
    s := "old".Clone()
    defer print(s)
    s = "new".Clone()                       // ERROR "cannot assign to s: s is borrowed by the deferred call"
}

func inner() {
    {
        w := "w".Clone()
        defer fmt.Println(w)                // ERROR "cannot keep a borrow of w in the deferred call: w is dropped at the end of its block"
    }
}

func copied() {
    n := 1
    defer fmt.Println(n)
    n = 2
}

struct Ref {
    r ref string
    n int
}

func heldField() {
    a := "first".Clone()
    c := Ref{r: ref a, n: 1}
    defer fmt.Println(c.r)
    a = "second".Clone()                    // ERROR "cannot assign to a: a is borrowed by the deferred call"
}

func heldTuple() {
    a := "first".Clone()
    t := (ref a, 2)
    defer print(t)
    a = "second".Clone()                    // ERROR "cannot assign to a: a is borrowed by the deferred call"
}
