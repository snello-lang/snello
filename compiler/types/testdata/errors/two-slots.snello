// Rule: two mut borrows into one slice are rejected because the compiler
// cannot prove the indexes differ. Fix: copy the needed values out first,
// as examples/lru/lru.snello and examples/tree/tree-slice.snello do.

package p

struct Entry { prev int; next int }

func relink(xs mut []Entry, i int, j int) {
    a := mut xs[i]
    b := mut xs[j]                        // ERROR "cannot borrow xs[j] as mut: xs is already borrowed as mut"
    a.next = j
    b.prev = i
}