// Rule: a conversion between a declared type and its underlying type
// gives the value itself under the other name, so it moves a value
// that is not Copy, as passing it by value does; a borrow converted is a
// view, a borrow of the other type, which owns nothing to give. Fix: use
// the converted value, convert a clone, Name(s.Clone()), or return the
// view as a borrow.

package p

type Name string

struct P { x int; s string }

type P2 P

func used(n Name) string {
	s := string(n)
	print(n)                           // ERROR "use of moved value n"
	return s
}

func whole(p P) P2 {
	q := P2(p)
	print(p.s)                         // ERROR "use of moved value p"
	return q
}

func borrowed(n ref Name) string {
	return string(n)                   // ERROR "cannot use a value of type ref string as string in return"
}
