// Rule: a closure given to spawn moves every variable it mentions into
// the task; the function that spawned it cannot use them afterwards.
// Fix: clone before the spawn, or send the value back on a channel.

package p

import "fmt"

func main() {
    s := "hello"
    spawn func() { fmt.Println(s) }()
    fmt.Println(s)                        // ERROR "use of moved value s"
}
