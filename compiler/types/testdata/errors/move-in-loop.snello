// Rule: a value declared outside a loop and moved inside it is gone on
// the second iteration. Fix: clone it inside the loop, or move it after.

package p

func keep(s string) {}

func main() {
    s := "hello"
    for i := 0; i < 3; i += 1 {
        keep(s)                           // ERROR "s moved in a previous iteration of the loop"
    }
}

func ranged(xs []int) {
    s := "hello"
    for _, x := range xs {
        keep(s)                           // ERROR "s moved in a previous iteration of the loop"
        print(x)
    }
    print(len(s))                         // ERROR "use of moved value s"
}

func broken() {
    s := "hello"
    for {
        keep(s)
        break
    }
    print(len(s))                         // ERROR "use of moved value s"
}


func inited() {
    for s := "x".Clone(); true; {
        keep(s)                           // ERROR "s moved in a previous iteration of the loop"
    }
}

func posted() {
    for s := "x".Clone(); true; keep(s) {   // ERROR "s moved in a previous iteration of the loop"
        print(len(s))                     // ERROR "use of moved value s"
    }
}
