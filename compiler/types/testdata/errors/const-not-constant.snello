// Rule: a constant's value is computed by the compiler, from literals,
// other constants, the operators and the conversions between number
// types. A call runs when the program does, a variable can change, an
// element is read from memory, and none of them is known to the
// compiler; a constant also needs a value to have one. Fix: make it a
// var, which takes any value, var n = size(), or compute it from
// constants alone.

package p

func size() int { return 4 }

var count = 2

const fromCall = size() + 1                 // ERROR "size() is not constant"
const fromVar = count * 2                   // ERROR "count is not constant"
const fromLen = len("abc")                  // ERROR "len(...) is not constant"
const toString = string('A')                // ERROR "string(...) is not constant"
const missing int                           // ERROR "const missing needs a value"

struct Point { x int; y int }

const Origin = Point{x: 0, y: 0}
const Again = Origin                        // ERROR "Origin is not constant: a struct constant is no part of a constant expression"
const Pair = [2]int{1, 2}                   // ERROR "a constant is a number, a bool, a string or a struct of them, not a [2]int"
const List = []int{1, 2}                    // ERROR "a constant is a number, a bool, a string or a struct of them, not a []int"

func f() {
    n := 3
    const local = n + 1                     // ERROR "n is not constant"
    print(local)
}
