// Rule: an iterator over a collection's items, and every adapter over
// it, holds the collection's borrow, and the collection outlives it.
// Fix: keep the collection for as long as the iterator is pulled from.

package p

import ("deque"; "fmt"; "iter")

func double(x ref int) int { return *x * 2 }

func main() {
    a := deque.New<int>()
    it := a.Iter().Map(double)
    {
        d := deque.New<int>()
        d.PushBack(1)
        it = d.Iter().Map(double)           // ERROR "cannot keep a borrow of d in it: d is dropped at the end of its block"
    }
    fmt.Println(it.Count())
}

func sliced() {
    none := []int{}
    it := iter.Over(ref none)
    {
        xs := []int{1, 2, 3}
        it = iter.Over(ref xs)                // ERROR "cannot keep a borrow of xs in it: xs is dropped at the end of its block"
    }

    fmt.Println(it.Count())
}
