// Package bytes has Buffer, a growable run of bytes that is written to
// at its end and read from its front: the structure an encoder writes
// into and a decoder reads from, an io.Writer and an io.Reader both.
//
// The searches and comparisons over bytes are methods of []byte,
// b.Equal(o) and b.Find(sub), so this package has only the Buffer.
package bytes

import ("fmt"; "io"; "unicode/utf8")

// What a Buffer's last call read, kept in its lastRead field so that
// UnreadByte and UnreadRune know what they may put back: nothing, or
// bytes; a positive value is the width of the rune ReadRune read.
const lastReadNone int = 0
const lastReadBytes int = -1

// A Buffer holds bytes written to it until they are read. Its zero
// value is an empty Buffer ready to use:
//
//	var b bytes.Buffer
//	b.WriteString("hello")
//	c := b.ReadByte() // Some('h')
//
// It owns its bytes and is passed mut to be written to or read from,
// and it implements io.Writer, io.Reader and fmt.Stringer, so
// fmt.Fprintf writes into it, io.Copy reads from it, and fmt.Println
// prints what it holds.
//
// It is one slice, written at its end and read from an index into it.
// What was read is dropped when the slice is full and the bytes not
// read yet fill at most half of it, and the whole of it once
// everything was read, so that a Buffer used as a queue neither grows
// without a bound nor moves its bytes on every write.
struct Buffer impl io.Writer, io.Reader, fmt.Stringer {
	buf      []byte
	off      int // the bytes before off have been read
	lastRead int // what the last call read: lastReadNone, lastReadBytes, or the width of the rune ReadRune read
}

// NewBuffer returns a Buffer holding buf, which it takes and owns from
// then on: the bytes of buf are the first to read, and the writes after
// them go on the same slice, so its spare capacity is used before the
// Buffer allocates.
func NewBuffer(buf []byte) Buffer {
	return Buffer{buf: buf, off: 0, lastRead: lastReadNone}
}

// NewBufferString returns a Buffer holding a copy of the bytes of s,
// which it only reads: one allocation of len(s) bytes.
func NewBufferString(s ref string) Buffer {
	return Buffer{buf: []byte(s), off: 0, lastRead: lastReadNone}
}

// Bytes lends the bytes not read yet, with nothing copied, for as long
// as nothing else is asked of the Buffer: the borrow keeps the Buffer
// lent, so the compiler refuses a write or a read while the slice is
// in use.
func (b ref Buffer) Bytes() ref []byte {
	return b.buf[b.off:]
}

// String returns the bytes not read yet as a new string, which the
// caller owns: one allocation and a copy. The Buffer keeps the bytes,
// still to be read.
func (b ref Buffer) String() string {
	return string(b.buf[b.off:])
}

// Len returns how many bytes are not read yet.
func (b ref Buffer) Len() int {
	return len(b.buf) - b.off
}

// Cap returns the capacity of the Buffer's slice: how many bytes it
// holds without allocating, the bytes already read among them, since
// dropping them frees room, not capacity.
func (b ref Buffer) Cap() int {
	return cap(b.buf)
}

// Available returns how many bytes can be written before the Buffer
// allocates or moves what it holds: the room after the bytes written,
// read or not. Grow(n) makes it at least n.
//
//	if b.Available() < len(rec) { b.Grow(len(rec)) }
func (b ref Buffer) Available() int {
	return cap(b.buf) - len(b.buf)
}

// Truncate keeps the first n bytes not read yet and drops the rest, as
// a slice's Truncate does: an n at or past Len keeps them all, and an n
// of zero or less drops them all and empties the Buffer, as Reset
// does. It ends what UnreadByte and UnreadRune can put back.
func (b mut Buffer) Truncate(n int) {
	b.lastRead = lastReadNone
	if n <= 0 {
		b.Reset()
		return
	}

	if n < b.Len() {
		b.buf.Truncate(b.off + n)
	}
}

// Reset empties the Buffer, read bytes and unread ones, and keeps its
// memory for what is written next.
func (b mut Buffer) Reset() {
	b.buf.Clear()
	b.off = 0
	b.lastRead = lastReadNone
}

// Grow makes room for n more bytes, so that writing them does not
// allocate again: first by dropping the bytes already read, when that
// is enough, and otherwise in at most one allocation. An n of zero or
// less, or one no int can add to the length, does nothing. Like a
// write, it ends what UnreadByte and UnreadRune can put back.
//
//	b.Grow(len(head) + len(body)) // two writes that allocate nothing
func (b mut Buffer) Grow(n int) {
	b.lastRead = lastReadNone
	if n > 0 {
		b.dropReadBytes(n)
		reserve(mut b.buf, n)
	}
}

// Write appends a copy of the bytes of p, which it only reads, and
// returns their count. A Buffer takes every byte, so it never fails and
// the result is always Ok(len(p)). It is io.Writer's method.
func (b mut Buffer) Write(p ref []byte) Result<int, io.Error> {
	b.lastRead = lastReadNone
	b.dropReadBytes(len(p))
	b.buf.Extend(p)
	return Ok(len(p))
}

// WriteString appends the bytes of s, which it only reads, in one copy
// that grows the buffer at most once.
func (b mut Buffer) WriteString(s ref string) {
	b.lastRead = lastReadNone
	b.dropReadBytes(s.Len())
	appendString(mut b.buf, s)
}

// WriteByte appends the one byte c, as it is: a byte of 0x80 or more is
// no rune of its own, and WriteRune writes a rune.
func (b mut Buffer) WriteByte(c byte) {
	b.lastRead = lastReadNone
	b.dropReadBytes(1)
	b.buf.Push(c)
}

// WriteRune appends the UTF-8 bytes of r, one to four of them, and
// those of utf8.RuneError, U+FFFD, for a value that is not a code
// point: a negative one, a surrogate or one past utf8.MaxRune.
func (b mut Buffer) WriteRune(r rune) {
	b.lastRead = lastReadNone
	b.dropReadBytes(utf8.UTFMax)
	utf8.AppendRune(mut b.buf, r)
}

// Read copies the bytes not read yet that fit into p, which is lent mut
// and only written to, and returns how many: zero once every byte was
// read, which is the end of a Buffer, as io.Reader says. It never
// fails, so the result is always Ok. It is io.Reader's method.
func (b mut Buffer) Read(p mut []byte) Result<int, io.Error> {
	b.lastRead = lastReadNone
	if b.Len() == 0 {
		b.Reset()
		return Ok(0)
	}

	n := copyBytes(mut p, b.buf[b.off:])
	b.off += n
	if n > 0 {
		b.lastRead = lastReadBytes
	}

	return Ok(n)
}

// Next reads the next n bytes and lends them, with nothing copied, for
// as long as nothing else is asked of the Buffer: fewer when fewer are
// left, and none for an n of zero or less.
//
//	header := b.Next(4) // the first four bytes, read
func (b mut Buffer) Next(n int) ref []byte {
	b.lastRead = lastReadNone
	n = min(max(n, 0), b.Len())
	from := b.off
	b.off += n
	if n > 0 {
		b.lastRead = lastReadBytes
	}

	return b.buf[from:b.off]
}

// ReadByte reads the next byte and returns it, or None once every byte
// was read.
func (b mut Buffer) ReadByte() byte? {
	b.lastRead = lastReadNone
	if b.Len() == 0 {
		b.Reset()
		return None
	}

	c := b.buf[b.off]
	b.off++
	b.lastRead = lastReadBytes
	return Some(c)
}

// ReadRune reads the next rune and returns it with how many bytes it
// took, one to four, or None once every byte was read. A byte that does
// not start a valid UTF-8 sequence reads as utf8.RuneError, U+FFFD, of
// width one, as a range over a string reads it.
//
//	if (r, n) := b.ReadRune() { ... }
func (b mut Buffer) ReadRune() (rune, int)? {
	b.lastRead = lastReadNone
	if b.Len() == 0 {
		b.Reset()
		return None
	}

	r, n := utf8.DecodeRune(b.buf[b.off:])
	b.off += n
	b.lastRead = n
	return Some((r, n))
}

// UnreadRune puts back the rune the last call read, when that call was
// ReadRune, so that the next read gives it again, and returns true.
// After any other call it returns false and changes nothing; a second
// UnreadRune in a row returns false.
func (b mut Buffer) UnreadRune() bool {
	if b.lastRead == lastReadNone || b.lastRead == lastReadBytes {
		return false
	}

	b.off -= b.lastRead
	b.lastRead = lastReadNone
	return true
}

// UnreadByte puts back the last byte the last call read, when that call
// read one, Read, Next, ReadByte, ReadRune, ReadBytes or ReadString,
// and returns true. After any other call, a write or Grow among them,
// it returns false and changes nothing; a second UnreadByte in a row
// returns false.
func (b mut Buffer) UnreadByte() bool {
	if b.lastRead == lastReadNone {
		return false
	}

	b.lastRead = lastReadNone
	b.off--
	return true
}

// ReadBytes reads up to and including the first delim and returns what
// it read, delim included, as a new slice the caller owns; when no
// delim is left it returns the bytes left, and None once every byte
// was read. It copies the bytes it returns.
//
//	line := b.ReadBytes('\n') ?? return
func (b mut Buffer) ReadBytes(delim byte) ([]byte)? {
	return match b.findLineEnd(delim) {
		Some(end) => {
			line := b.buf[b.off:end].Clone()
			b.off = end
			Some(line)
		},
		None => None,
	}
}

// ReadString reads up to and including the first delim and returns what
// it read, delim included, as a new string the caller owns; when no
// delim is left it returns the bytes left, and None once every byte
// was read. It is ReadBytes giving a string.
func (b mut Buffer) ReadString(delim byte) string? {
	return match b.findLineEnd(delim) {
		Some(end) => {
			line := string(b.buf[b.off:end])
			b.off = end
			Some(line)
		},
		None => None,
	}
}

// dropReadBytes drops what was read before n more bytes are written:
// all of the slice when every byte was read; and when the slice is
// full, the bytes not read yet move to its start only if that leaves it
// at least half empty. Otherwise the slice grows, as any slice does, so
// that a move of m bytes always makes room for m more, and a queue with
// a long backlog does not move it on every write.
func (b mut Buffer) dropReadBytes(n int) {
	if b.off == 0 {
		return
	}

	m := b.Len()
	if m == 0 {
		b.buf.Clear()
		b.off = 0
		return
	}

	if n > cap(b.buf)-len(b.buf) && n <= cap(b.buf)/2-m {
		end := len(b.buf)
		slide(mut b.buf, b.off, end)
		b.buf.Truncate(m)
		b.off = 0
	}
}

// findLineEnd returns where the next line ends, just past the first
// delim or at the end of what is left, or None once every byte was
// read, and marks the read for UnreadByte.
func (b mut Buffer) findLineEnd(delim byte) int? {
	b.lastRead = lastReadNone
	if b.Len() == 0 {
		b.Reset()
		return None
	}

	b.lastRead = lastReadBytes
	i := indexByte(b.buf[b.off:], delim)
	if i < 0 {
		return Some(len(b.buf))
	}

	return Some(b.off + i + 1)
}

// copyBytes copies the bytes of src that fit to the start of dst and
// returns how many. The runtime provides it, by memmove.
func copyBytes(dst mut []byte, src ref []byte) int

// indexByte returns the index of the first c in p, or -1. The runtime
// provides it, by memchr.
func indexByte(p ref []byte, c byte) int

// appendString appends the bytes of s to b in one copy, growing b
// once. The runtime provides it.
func appendString(b mut []byte, s ref string)

// reserve makes room in b for n more bytes, in at most one allocation.
// The runtime provides it.
func reserve(b mut []byte, n int)

// slide moves the bytes b[lo:hi] to the start of b. The runtime
// provides it.
func slide(b mut []byte, lo int, hi int)
