// Package fmt prints values and formats text.
//
// Its functions take arguments of any type, and the compiler writes the
// printing itself, choosing by the type of each argument: an integer
// prints as its digits; a float in the shortest form that reads back as
// it, with an exponent from a million up, 1e+06, and as +Inf, -Inf or
// NaN, as Go prints them; a string as its text, a bool as true or
// false, a struct as its fields, an enum value as its variant, an
// option as Some(x) or None, a Result as Ok(x) or Err(e), a value whose
// type implements Error as its message, and one whose type implements
// Stringer as what its String returns. The format of Printf is a
// string literal or a constant declared as one: it is read when the
// program is compiled and checked against the arguments then,
// so a verb that does not fit its argument is a compile error and
// nothing is formatted at run time. The functions are declared here
// without bodies; the compiler provides them.
//
// A format is text with verbs, each taking the next argument: %v prints
// any value as Println does; %d an integer, and %x, %X, %o and %b the
// same in base sixteen, with small letters or capitals, eight and two,
// a negative number as a minus sign and its digits, -ff; %x and %X
// also print the bytes of a string or a []u8, two digits each; %c
// prints an integer as the character it is; %s a string, or a value
// whose type implements Error or Stringer; %q the same in double
// quotes, escaped as Go's strconv.Quote escapes it, or an integer as
// the rune it is, in single quotes; %f a float with six decimals, %.2f
// with two; %e a float with an exponent, 1.234568e+03; %g a float in
// the shortest form, as %v prints one; %t a bool; %% is a percent sign.
// A precision is the digits of a float after the point with %f and %e
// and in all with %g and %v, %.3v, the characters of a string with %s,
// %q and %v, %.2s, and the least digits of an integer with %d, %x, %X,
// %o and %b, %.3d. A width pads with spaces on the left, %6d, or on
// the right after a minus, %-6s; a value already as wide is printed
// whole. A zero before the width pads a number with zeros after its
// sign instead, %05d, %02x and %08.3f; the minus flag overrides it, and
// so does a precision on an integer. A width and a precision are
// 1000000 at most. Only %v, %s and %q print a value as its Error or
// String method returns it: every other verb prints the value itself,
// %g the float and %x the string's own bytes. The format is a string
// literal and reads as many arguments as it has verbs; fmt takes no
// other verb or flag.
//
// Every argument is lent for the call: printing a value leaves it with
// its owner.
package fmt

import "io"

// A Stringer is a type that prints as its own text: Println, Sprint and
// the verbs %v, %s and %q print a value of a type that lists Stringer
// after impl as what its String returns, as Go's fmt prints a
// fmt.Stringer.
trait Stringer {
	func (s ref Self) String() string
}

// Println prints its arguments to the standard output separated by
// spaces, then a newline.
func Println(args ...ref any)

// Printf prints its arguments to the standard output as the format
// says. It adds no newline; the format writes its own, "\n".
func Printf(format ref string, args ...ref any)

// Sprint returns its arguments as text, with a space between two
// operands when neither is a string, as Println separates them.
func Sprint(args ...ref any) string

// Sprintf returns its arguments formatted as the format says.
func Sprintf(format ref string, args ...ref any) string

// Fprint writes its arguments to w, with a space between two operands
// when neither is a string, as Sprint joins them, with one call of its
// Write; w is any io.Writer, lent mut. A failure to write is not
// reported.
func Fprint<W: io.Writer>(w mut W, args ...ref any)

// Fprintln writes its arguments to w, separated by spaces and ended by
// a newline, with one call of its Write; w is any io.Writer, lent mut:
// fmt.Fprintln(mut os.Stderr(), "error:", e). A failure to write is not
// reported.
func Fprintln<W: io.Writer>(w mut W, args ...ref any)

// Fprintf writes its arguments to w as the format says, with one call
// of its Write; w is any io.Writer, lent mut. A failure to write is not
// reported.
func Fprintf<W: io.Writer>(w mut W, format ref string, args ...ref any)
