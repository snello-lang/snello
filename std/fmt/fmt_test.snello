package fmt_test

import ("expect"; "fmt"; "io"; "os"; "strconv"; "testing")

// A Point prints as its own text, through Stringer.
struct Point impl fmt.Stringer {
	x int
	y int
}

// A Heat is a Stringer declared over a float.
type Heat f64 impl fmt.Stringer

// A Tag is a Stringer declared over a string.
type Tag string impl fmt.Stringer

// A Level is a Stringer declared over an integer.
type Level int impl fmt.Stringer

// A Money formats itself: %d prints the cents as a number, every other
// verb the amount in dollars, under the verb's width and flags.
struct Money impl fmt.Formatter {
	cents int
}

// A Probe is a Formatter that writes what its Format was given, and a
// Stringer that is never asked.
type Probe string impl fmt.Formatter, fmt.Stringer

// A Fail is an error that lists Formatter and writes no Error(): its
// message is what its Format writes.
struct Fail impl Error, fmt.Formatter {
	code int
}

// A Word is a Formatter over text with characters of two bytes, which
// Pad counts as one each.
type Word string impl fmt.Formatter

// A Signed is a number whose text carries its sign, a plus included.
type Signed int impl fmt.Formatter

// A Silent is a Formatter whose Format writes nothing.
struct Silent impl fmt.Formatter {}

// A Price holds a Formatter in a field.
struct Price {
	item string
	cost Money
}

// A sink is an io.Writer that keeps what it was given and counts the
// calls of its Write.
struct sink impl io.Writer {
	text   []byte
	writes int
}

// String writes the point as (x, y).
func (p ref Point) String() string { return fmt.Sprintf("(%d, %d)", p.x, p.y) }

// String gives the text every verb a string takes prints.
func (h ref Heat) String() string { return "hot" }

// String gives the text every verb a string takes prints.
func (t ref Tag) String() string { return "TAG" }

// String gives the text every verb a string takes prints.
func (l ref Level) String() string { return "low" }

// Format writes the cents with PadNumber for %d and the dollars with Pad
// for every other verb.
func (m ref Money) Format(f mut fmt.State, verb rune) {
	if verb == 'd' {
		f.PadNumber(ref strconv.Itoa(m.cents))
		return
	}

	f.Pad(ref fmt.Sprintf("$%d.%02d", m.cents/100, m.cents%100))
}

// Format writes the verb, the text and what the State holds.
func (p ref Probe) Format(f mut fmt.State, verb rune) {
	fmt.Fprintf(mut f, "<%c:%s>", verb, string(p))
	if w := f.Width() {
		fmt.Fprintf(mut f, "w%d", w)
	}

	if prec := f.Precision() {
		fmt.Fprintf(mut f, "p%d", prec)
	}

	if f.Minus() {
		f.WriteString("-")
	}

	if f.Zero() {
		f.WriteRune('0')
	}
}

// String is never asked: Format comes first.
func (p ref Probe) String() string { return "never" }

// Format writes the failure's code.
func (e ref Fail) Format(f mut fmt.State, verb rune) {
	f.WriteString("fail ")
	f.WriteString(ref strconv.Itoa(e.code))
}

// Format pads the word as %s would.
func (w ref Word) Format(f mut fmt.State, verb rune) { f.Pad(string(w)) }

// Format pads the number with its sign, through PadNumber, byte by byte
// through WriteByte for the sign.
func (n ref Signed) Format(f mut fmt.State, verb rune) {
	if int(n) >= 0 {
		f.PadNumber(ref fmt.Sprintf("+%d", int(n)))
		return
	}

	f.PadNumber(ref strconv.Itoa(int(n)))
}

// Format writes nothing.
func (s ref Silent) Format(f mut fmt.State, verb rune) {}

// show prints a Formatter under a width through a type parameter.
func show<T: fmt.Formatter>(v ref T) string { return fmt.Sprintf("[%5v]", v) }

// Write keeps the bytes and counts the call.
func (s mut sink) Write(p ref []byte) Result<int, io.Error> {
	for _, b := range p { s.text.Push(b) }
	s.writes++
	return Ok(len(p))
}

// Sprint joins its operands with a space where neither is a string, and
// prints a Stringer as its String.
func TestSprint() {
	expect.Equal(ref fmt.Sprint("a", 1, true), "a1 true")
	expect.Equal(ref fmt.Sprint(1, 2), "1 2")
	expect.Equal(ref fmt.Sprint(Point{x: 1, y: 2}), "(1, 2)")
}

// The common verbs, with a width, a precision and the minus flag.
func TestSprintf() {
	expect.Equal(ref fmt.Sprintf("%d-%s|%5.2f|%q|%v", 3, "x", 2.0, "q", Point{x: 0, y: 9}), "3-x| 2.00|\"q\"|(0, 9)")
	expect.Equal(ref fmt.Sprintf("%-4d|%4s|", 7, "ab"), "7   |  ab|")
}

// Integers in bases sixteen, eight and two: a negative one as a minus
// sign and its digits, a precision as the least digits, and a width on
// either side.
func TestBases() {
	expect.Equal(ref fmt.Sprintf("%x %X %o %b", 255, 255, 8, 5), "ff FF 10 101")
	expect.Equal(ref fmt.Sprintf("%x %b %x", -255, i8(-128), u64(18446744073709551615)), "-ff -10000000 ffffffffffffffff")
	expect.Equal(ref fmt.Sprintf("%.4x|%.0x|%6X|%-6o|", 255, 0, 255, 8), "00ff||    FF|10    |")
}

// %x and %X print the bytes of a string or a []u8, two digits each.
func TestHexBytes() {
	expect.Equal(ref fmt.Sprintf("%x %X", "hi\xff", "hi"), "6869ff 6869")
	expect.Equal(ref fmt.Sprintf("%x %X %x", []u8{0, 15, 255}, []u8{171}, ""), "000fff AB ")
}

// %c prints a code point as its character, and a number that is no
// Unicode scalar value as U+FFFD.
func TestChar() {
	expect.Equal(ref fmt.Sprintf("%c%c%c", 'A', 0xE9, 0x1F642), "Aé🙂")
	expect.Equal(ref fmt.Sprintf("%c %c %c", -1, 0xD800, 0x110000), "\uFFFD \uFFFD \uFFFD")
}

// %e with and without a precision, a subnormal and a large exponent,
// and %g in the shortest form of an f64 and of an f32.
func TestExponent() {
	expect.Equal(ref fmt.Sprintf("%e %.2e %.0e", 1234.5678, 0.0, 5.0), "1.234568e+03 0.00e+00 5e+00")
	expect.Equal(ref fmt.Sprintf("%e %.3e %e", 1e-310, 9.9996, 1e100), "1.000000e-310 1.000e+01 1.000000e+100")
	expect.Equal(ref fmt.Sprintf("%g %g %g %.3g", 0.1, f32(0.1), 1e21, 1234.5678), "0.1 0.1 1e+21 1.23e+03")
}

// A zero before the width pads a number with zeros after its sign, the
// minus flag and an integer's precision override it, and an infinity or
// a NaN is padded with spaces.
func TestZeroFlag() {
	expect.Equal(ref fmt.Sprintf("%05d %05d %02x %08b", 42, -42, 7, 5), "00042 -0042 07 00000101")
	expect.Equal(ref fmt.Sprintf("%08.3f %08.3f %010.2e %06v %06v", 3.14159, -3.14159, 1234.5, 7, -2.5), "0003.142 -003.142 001.23e+03 000007 -002.5")
	expect.Equal(ref fmt.Sprintf("%-05d|%06.3d|%03d", 42, 42, 123456), "42   |   042|123456") // the minus flag and a precision override it
	zero := 0.0
	expect.Equal(ref fmt.Sprintf("%06f|%06v", 1/zero, zero/zero), "  +Inf|   NaN")       // nothing to put zeros before
}

// The verbs a string takes, %v, %s, %q, %x and %X, print a value as its
// String, whatever its type is declared over; every other verb prints
// the value itself.
func TestVerbsPrintTheValue() {
	expect.Equal(ref fmt.Sprintf("%v %s %q %v", Heat(1.5), Tag("ab"), Tag("ab"), Level(7)), "hot TAG \"TAG\" low")
	expect.Equal(ref fmt.Sprintf("%g %.3g %e %f %08g", Heat(1.5), Heat(1.5), Heat(1.5), Heat(1.5), Heat(1.5)), "1.5 1.5 1.500000e+00 1.500000 000001.5")
	expect.Equal(ref fmt.Sprintf("%x %X %x", Tag("ab"), Tag("ab"), Level(255)), "544147 544147 6c6f77")
	expect.Equal(ref fmt.Sprintf("%d %o %b %05d %c", Level(7), Level(8), Level(5), Level(7), Level(65)), "7 10 101 00007 A")
}

// A Formatter prints what its Format writes, for every verb, with Pad
// honouring the width, the precision and the minus flag as %s does and
// PadNumber the width and the flags as %d does; fmt pads nothing more.
func TestFormatter() {
	m := Money{cents: 150}
	expect.Equal(ref fmt.Sprintf("[%8v] [%-8v] [%d] [%08d] [%.3v] [%v] [%s]", m, m, m, m, m, m, m), "[   $1.50] [$1.50   ] [150] [00000150] [$1.] [$1.50] [$1.50]")
	expect.Equal(ref fmt.Sprintf("[%-6d] [%06d] [%6d] [%d]", Money{cents: -5}, Money{cents: -5}, Money{cents: -5}, Money{cents: -5}), "[-5    ] [-00005] [    -5] [-5]")
	expect.Equal(ref fmt.Sprintf("[%2v] [%-2v]", m, m), "[$1.50] [$1.50]") // a text already as wide is written whole
	expect.Equal(ref fmt.Sprintf("[%4v] [%.2v] [%-4.1v]", Word("héé"), Word("héé"), Word("héé")), "[ héé] [hé] [h   ]") // counted in characters, not bytes
	expect.Equal(ref fmt.Sprintf("[%6d] [%06d] [%-6d]", Signed(42), Signed(42), Signed(42)), "[   +42] [+00042] [+42   ]") // a plus sign is a sign too
	expect.Equal(ref fmt.Sprintf("[%v] [%3v]", Silent{}, Silent{}), "[] []") // a Format that writes nothing prints nothing, under a width too
}

// The State holds the verb's width, precision and flags, and Format is
// called ahead of String; Println and Sprint give %v with none.
func TestFormatterState() {
	p := Probe("x")
	expect.Equal(ref fmt.Sprintf("%v|%s|%6.2x|%-3q|%08d|%.0f|%t", p, p, p, p, p, p, p), "<v:x>|<s:x>|<x:x>w6p2|<q:x>w3-|<d:x>w80|<f:x>p0|<t:x>")
	expect.Equal(ref fmt.Sprintf("%-08d|%08.3d|%08.3v", p, p, p), "<d:x>w8-|<d:x>w8p3|<v:x>w8p30") // the minus flag overrides the zero flag, and a precision does with an integer's verb; Zero then does not report it
	expect.Equal(ref fmt.Sprint(p), "<v:x>")
	expect.Equal(ref fmt.Sprint(p, p), "<v:x><v:x>") // no space beside an operand declared over string, as beside a string
}

// A Formatter inside a composite prints as %v with no width, quoted in
// a constructor as a string is; a trait value of Formatter prints
// through its table; a derived Error() is what Format writes, and so is
// the message %+v starts with; %q reaches Format as a verb and quotes
// nothing itself.
func TestFormatterInside() {
	m := Money{cents: 150}
	expect.Equal(ref fmt.Sprint(Some(m), []Money{m, Money{cents: 5}}), "Some(\"$1.50\") [$1.50 $0.05]")
	expect.Equal(ref fmt.Sprint(Price{item: "tea", cost: m}), "{tea $1.50}") // a field prints through its Format, unquoted in a struct
	expect.Equal(ref show(ref m), "[$1.50]") // a type parameter bounded by Formatter
	var tv fmt.Formatter = Money{cents: 7}
	expect.Equal(ref fmt.Sprintf("[%6v] %d", tv, tv), "[ $0.07] 7")
	expect.Equal(ref fmt.Sprint(tv, Some(tv)), "$0.07 Some(\"$0.07\")")
	e := Fail{code: 3}
	expect.Equal(ref fmt.Sprintf("%v|%+v|%s|%q", e, e, e, e), "fail 3|fail 3|fail 3|fail 3")
	expect.Equal(ref e.Error(), "fail 3")
}

// A State is an io.Writer, so Fprintf writes into it; and a Formatter
// is written to a writer as any value is, with one call of its Write.
func TestFormatterWriter() {
	s := sink{text: []byte{}, writes: 0}
	fmt.Fprintf(mut s, "%5v;%d", Money{cents: 150}, Money{cents: 2})
	expect.Equal(ref string(s.text), "$1.50;2")
	expect.Equal(ref s.writes, ref 1)
}

// Fprint writes its text with one call of the writer's Write, even with
// no arguments.
func TestFprint() {
	s := sink{text: []byte{}, writes: 0}
	fmt.Fprint(mut s, "a", 1, 2, "b", 2.5, true)
	expect.Equal(ref string(s.text), "a1 2b2.5 true") // a space between two operands when neither is a string
	expect.Equal(ref s.writes, ref 1)
	fmt.Fprint(mut s)
	expect.Equal(ref s.writes, ref 2)
}

// Each printing function writes to the standard output, as the test's
// output shows.
func TestPrint() {
	fmt.Println("printed by the fmt tests", 1)
	fmt.Printf("%s %d\n", "and", 2)
	fmt.Fprintln(mut os.Stdout(), "to", "stdout")
	fmt.Fprintf(mut os.Stdout(), "%3d\n", 5)
	fmt.Fprint(mut os.Stdout(), "and", 3, "\n")
}

// Sprintf of a short format with two verbs.
func BenchmarkSprintf() {
	for testing.Loop() { _ = fmt.Sprintf("%d:%s", 42, "x") }
}

// Sprintf of a Formatter under a width, its Format padding with Pad.
func BenchmarkFormatter() {
	m := Money{cents: 150}
	for testing.Loop() { _ = fmt.Sprintf("[%8v]", m) }
}

// Sprintf of a Formatter as %d, its Format padding with PadNumber.
func BenchmarkFormatterNumber() {
	m := Money{cents: 150}
	for testing.Loop() { _ = fmt.Sprintf("%d", m) }
}

// Sprint of a Formatter, its Format given %v with no width.
func BenchmarkFormatterSprint() {
	m := Money{cents: 150}
	for testing.Loop() { _ = fmt.Sprint(m) }
}
