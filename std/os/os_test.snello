package os_test

import ("expect"; "io"; "os"; "testing")

func TestArgsCoresStreams() {
	expect.True(len(os.Args) > 0)
	expect.True(os.Cores() > 0)
	expect.Equal(os.Stdin().Name(), "/dev/stdin")
	expect.Equal(os.Stdout().Name(), "/dev/stdout")
	expect.Equal(os.Stderr().Name(), "/dev/stderr")
}

func TestFiles() {
	dir := testing.TempDir()
	path := dir.Join("notes.txt")
	f := expect.IsOk(os.Create(ref path))
	expect.Equal(f.Name(), ref path)
	expect.Equal(ref expect.IsOk(f.WriteString("hello ")), ref 6)
	expect.Equal(ref expect.IsOk(f.Write(ref []byte{119, 111, 114, 108, 100})), ref 5)
	expect.IsOk(f.Sync())
	expect.IsOk(f.Close())
	expect.Equal(ref expect.IsOk(os.ReadToString(ref path)), "hello world")
	r := expect.IsOk(os.Open(ref path))
	buf := make([]byte, 5)
	expect.Equal(ref expect.IsOk(r.Read(mut buf)), ref 5)
	expect.Equal(ref buf[0], ref byte(104))
	expect.IsOk(os.WriteString(ref path, "replaced"))
	expect.Equal(ref expect.IsOk(os.ReadToString(ref path)), "replaced")
	expect.IsOk(os.Remove(ref path))
	e := expect.IsErr(os.Open(ref path))
	expect.True(e.Kind() == io.NotExist)
	expect.Contains(ref e.Error(), "no such file")
}

func TestSeek() {
	dir := testing.TempDir()
	path := dir.Join("seek.txt")
	expect.IsOk(os.WriteString(ref path, "hello world"))
	f := expect.IsOk(os.Open(ref path))
	expect.Equal(ref expect.IsOk(f.Seek(io.End(-5))), ref u64(6))
	expect.Equal(ref expect.IsOk(f.Seek(io.Current(0))), ref u64(6))
	buf := make([]byte, 5)
	expect.Equal(ref expect.IsOk(f.Read(mut buf)), ref 5)
	expect.True(buf.Equal(ref []byte("world")))
	expect.Equal(ref expect.IsOk(f.Seek(io.Start(0))), ref u64(0))
	expect.Equal(ref expect.IsOk(f.Read(mut buf)), ref 5)
	expect.True(buf.Equal(ref []byte("hello")))
	expect.Equal(ref expect.IsOk(f.Seek(io.Start(100))), ref u64(100)) // past the end is allowed
	expect.Equal(ref expect.IsOk(f.Read(mut buf)), ref 0)
	before := expect.IsErr(f.Seek(io.Current(-1000)))
	expect.Contains(ref before.Error(), "seek ")
	expect.Contains(ref before.Error(), "invalid argument")
	expect.IsErr(f.Seek(io.Start(18446744073709551615))) // past what a position holds
	in := os.Stdin()
	if in.Seek(io.Current(0)).IsErr() { // a pipe or a terminal has no position; a file redirected in has one
		expect.Contains(ref expect.IsErr(in.Seek(io.Current(0))).Error(), "seek /dev/stdin")
	}
}

func TestDirs() {
	dir := testing.TempDir()
	inner := expect.IsOk(os.MkdirTemp(dir.Path(), "work"))
	expect.HasPrefix(ref inner, dir.Path())
	expect.IsOk(os.WriteString(ref (inner.Clone() + "/a.txt"), "a"))
	expect.IsOk(os.RemoveAll(ref inner))
	expect.IsErr(os.Open(ref (inner.Clone() + "/a.txt")))
}

func BenchmarkReadToString() {
	dir := testing.TempDir()
	path := dir.Join("bench.txt")
	expect.IsOk(os.WriteString(ref path, "some text to read back"))
	testing.ResetTimer()
	for testing.Loop() { _ = os.ReadToString(ref path) }
}
