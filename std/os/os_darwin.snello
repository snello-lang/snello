// The user's directories on macOS: the Library's, under the home.
package os

import ("io"; "path/filepath")

// UserConfigDir returns the directory for the user's configuration
// files, in a string of its own, where a program keeps its own under a
// directory named for it: on macOS Library/Application Support under
// the home; on Linux the XDG_CONFIG_HOME of the environment, or
// .config under the home; on Windows the AppData of the environment.
// It fails when the home is not defined; the directory is not checked
// to exist.
//
//	dir := filepath.Join(ref os.UserConfigDir()?, "myapp")
func UserConfigDir() Result<string, io.Error> {
	home := UserHomeDir()?
	return Ok(filepath.Join(ref home, "Library/Application Support"))
}

// UserCacheDir returns the directory for the user's cached files, in a
// string of its own, where a program keeps its own under a directory
// named for it: on macOS Library/Caches under the home; on Linux the
// XDG_CACHE_HOME of the environment, or .cache under the home; on
// Windows the LocalAppData of the environment. It fails as
// UserConfigDir does.
func UserCacheDir() Result<string, io.Error> {
	home := UserHomeDir()?
	return Ok(filepath.Join(ref home, "Library/Caches"))
}
