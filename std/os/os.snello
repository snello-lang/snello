// Package os is the program's view of its system: files and
// directories, the three standard streams, the command line, the
// environment, and the way out.
//
// Every function that can fail returns a Result<T, io.Error>, so a
// failure is passed up with ? or handled with a match on Ok and Err.
// A path is given as a string and may not hold a zero byte, which the
// system would read as its end; such a path fails as an invalid
// argument.
package os

import ("fmt"; "io"; "math/rand"; "path/filepath"; "time")

// The error numbers the package reports of its own accord, where the
// system was not asked: each is the same number on every system Snello
// runs on.
const eexist int = 17  // file exists
const enoent int = 2   // no such file or directory
const enotdir int = 20 // not a directory
const einval int = 22  // invalid argument

// tempTries is how many names MkdirTemp and CreateTemp try before giving
// up on a directory where every name drawn is taken.
const tempTries = 10000

// maxLinks is how many symbolic links EvalSymlinks follows in one path
// before it gives up on a chain that may loop: a bound above any
// system's own, which is 40 on Linux and 32 on macOS.
const maxLinks = 255

// globMeta are the bytes that make an element of a pattern a pattern,
// which Glob matches against a directory's names.
const globMeta = "*?["

// The flags of OpenFile: one of O_RDONLY, O_WRONLY and O_RDWR says how
// the file is opened, and the rest are added to it with |. The numbers
// are Snello's own and the same on every system, where the system's
// own differ from one to the next.
const O_RDONLY int = 0   // open for reading only
const O_WRONLY int = 1   // open for writing only
const O_RDWR int = 2     // open for reading and writing
const O_APPEND int = 8   // every write goes to the end of the file
const O_CREATE int = 64  // make the file when it does not exist
const O_EXCL int = 128   // with O_CREATE: fail when the file exists
const O_SYNC int = 256   // every write waits for the device
const O_TRUNC int = 512  // empty the file when it is opened

// The bits of a FileMode above its nine of permissions: one for each
// kind of file that is not a regular one, and three for how a file
// runs. The letter is what String prints for the bit.
const ModeDir FileMode = 0x80000000        // d: a directory
const ModeSymlink FileMode = 0x08000000    // L: a symbolic link
const ModeDevice FileMode = 0x04000000     // D: a device file
const ModeNamedPipe FileMode = 0x02000000  // p: a named pipe
const ModeSocket FileMode = 0x01000000     // S: a socket
const ModeSetuid FileMode = 0x00800000     // u: runs as its owner
const ModeSetgid FileMode = 0x00400000     // g: runs as its group
const ModeCharDevice FileMode = 0x00200000 // c: with ModeDevice, a character device
const ModeSticky FileMode = 0x00100000     // t: the sticky bit
const ModeIrregular FileMode = 0x00080000  // ?: a file of a kind nothing else names

// ModeType is the bits that say what kind of file it is, and ModePerm
// the permissions.
const ModeType FileMode = 0x8f280000
const ModePerm FileMode = 0o777

// How FileMode.String writes a mode: modeLetters has a letter for each
// bit from the top one, topModeBit, down, the letter at i standing for
// bit topModeBit - i; permLetters has one for each of the permBits
// bits of permissions, from the owner's read down to the others'
// execute; noBitLetter stands for a bit that is not set.
const modeLetters = "dalTLDpSugct?"
const permLetters = "rwxrwxrwx"
const noBitLetter byte = '-'
const topModeBit = 31
const permBits = 9

// The descriptors of the three standard streams, and the names their
// Files carry, which an Error on one shows as its path.
const stdinFD = 0
const stdoutFD = 1
const stderrFD = 2
const stdinName = "/dev/stdin"
const stdoutName = "/dev/stdout"
const stderrName = "/dev/stderr"

// closedFD is the descriptor of a File that Close has closed, so that
// Drop has nothing left to do.
const closedFD = -1

// failedInRead is what the runtime's readToString and readFile store
// when the path opened and the read of it failed, so that the Error
// names the read; they store 0 when the open failed.
const failedInRead = 1

// The places Seek counts from, as the runtime's seek takes them, named
// as the system names them: the start of the file, the current
// position, and the end.
const seekSet = 0
const seekCur = 1
const seekEnd = 2

// The element of a path that names the directory it is in, which
// RemoveAll refuses as a path's last, and the byte it is.
const currentDir = "."
const dotByte byte = '.'

// packedModeSize is how many bytes of the runtime's readDir hold an
// entry's FileMode, lowest first, before its name.
const packedModeSize = 4

// envPWD is the environment variable a shell keeps the path of the
// current directory in, as the user reached it.
const envPWD = "PWD"

// Args is the command line: the program's name first, then its
// arguments, as the shell split them. The runtime fills it before main
// runs, and it is read only: a program that wants to change it copies
// it first.
//
//	for _, arg := range ref os.Args[1:] { fmt.Println(arg) }
var Args []string

// A File is an open file, or one of the standard streams. It
// implements io.Reader and io.Writer, so it is what io.Copy and
// fmt.Fprintln write to, io.Seeker, so a program reading a format of
// its own moves about in it, and io.ReaderAt and io.WriterAt, so it is
// read and written at an offset with the position left alone.
//
// A File implements Drop: when it goes out of scope, on every path out
// of its function, its descriptor is closed. Close consumes the File
// and reports a failure to close, which Drop cannot; so a program that
// cares about that failure calls Close, and one that does not lets the
// File go. A File is not Copy: it is moved, or lent with ref and mut.
//
// Its reads and writes are the system's, with nothing held back in
// memory: each call is one system call, or as many as a write of all
// of its bytes takes, so a program that reads or writes in small
// pieces wraps the File in a bufio.Reader or a bufio.Writer.
struct File impl Drop, io.Reader, io.Writer, io.Seeker, io.ReaderAt, io.WriterAt {
	fd        int
	name      string
	stream    bool // one of the three standard streams, which stay open for the program's life
	appending bool // opened with O_APPEND: every write goes to the end, so no write takes an offset
}

// A FileMode is a file's kind and its permissions: the permissions in
// the low nine bits, as the system writes them, 0644, and a bit for
// each kind of file that is not a regular one, ModeDir, ModeSymlink and
// the rest. It is a number, copied as one, and its bits are tested
// with & or with its methods. It prints as ls prints a mode:
//
//	fmt.Println(os.ModeDir | 0o755) // drwxr-xr-x
//
// Windows keeps no such permissions and has no umask: a file made
// without the owner's write bit is read-only, the rest of the bits
// given are not kept, and a mode read back is made from the read-only
// flag, 0444 for a read-only file, 0666 for any other, and 0777 for a
// directory, 0555 for a read-only one.
type FileMode u32 impl fmt.Stringer

// A FileInfo is what the system says of a file at one moment: its
// name, size, mode and the time it was last changed. Stat and Lstat
// return one; it owns its name, and it is not updated when the file
// changes after.
struct FileInfo {
	name    string
	size    i64
	mode    FileMode
	modTime time.Time
	dev     u64 // the device and the file's number on it, which name the file whatever its path
	ino     u64
}

// A DirEntry is one name in a directory, as ReadDir returns it: the
// name and the kind of file it is, which reading the directory gives
// without asking about each file. Stat or Lstat of the name says the
// rest.
struct DirEntry {
	name string
	typ  FileMode // the bits of its kind alone
}

// OpenOptions says how Open opens a file, each way a field a literal
// names, the rest taking their defaults: reading alone, and a file made
// with permissions 0666 before the umask.
//
//	o := os.OpenOptions{Write: true, Append: true, Create: true}
//	f := o.Open(ref path)?
//
// Append implies Write. Create, Truncate and Exclusive need Write or
// Append, and Truncate cannot go with Append, so a file opened for
// reading alone is never made or emptied.
struct OpenOptions {
	Read      bool = true      // open for reading
	Write     bool             // open for writing
	Append    bool             // every write goes to the end of the file
	Create    bool             // make the file when it does not exist
	Truncate  bool             // empty the file when it is opened
	Exclusive bool             // make the file, failing when it exists
	Perm      FileMode = 0o666 // the permissions of a file it makes
}

// A Walk is what a function given to WalkDir answers after each file:
// go on, skip the directory just given, or the rest of the one holding
// the file given, skip everything left, or stop with an error, which
// WalkDir returns.
enum Walk {
	// Continue goes on to the next file.
	Continue

	// SkipDir leaves out the directory just given, or, after a file, the
	// files left in its directory.
	SkipDir

	// SkipAll leaves out every file left; WalkDir then returns Ok.
	SkipAll

	// Stop ends the walk, and WalkDir returns the error.
	Stop(io.Error)
}

// Exit ends the program at once with code as its status, 0 for success
// and anything else, 1 by custom, for a failure the shell sees. Nothing
// after the call runs, no Drop and no deferred call, and the compiler
// knows that, as it knows it of panic: a match arm or an if branch may
// end in Exit where a value is wanted. What fmt printed is written out
// first. The compiler provides it.
//
//	if len(os.Args) < 2 {
//		fmt.Println("usage: grep PATTERN [FILE]")
//		os.Exit(2)
//	}
func Exit(code int)

// Cores returns the number of processors the program may run on: the
// ones it is allowed by taskset or a container on Linux, the ones in
// the process's affinity mask on Windows, which a job object or start
// /affinity limits, within the processor group the process runs in,
// and the ones online on macOS. It is the count the runtime starts a worker for,
// so a pool of that many tasks keeps every core busy. The runtime
// provides it.
func Cores() int

// Stdin returns a handle on the standard input, open for reading.
//
// The three streams are functions and not package variables, since a
// package variable is never lent mut and a Read or a Write needs a
// mut: each call gives a fresh File on the descriptor, which costs no
// allocation and no system call, lent for one call or held in a local
// for a bufio.Reader:
//
//	r := bufio.NewReader(mut os.Stdin())
//
// Dropping it never closes the descriptor, and two tasks writing
// through two handles share no memory, which is what the descriptor
// already guarantees.
func Stdin() File {
	return File{fd: stdinFD, name: stdinName, stream: true, appending: false}
}

// Stdout returns a handle on the standard output, open for writing, a
// fresh File as Stdin is, which dropping never closes.
//
//	fmt.Fprintln(mut os.Stdout(), "done")
//
// Nothing is held back: what fmt prints and what is written here go to
// the output at once, in the order they were made, interleaved rightly
// with Stderr, and a prompt without a newline shows before the program
// reads its answer. A program that writes much in small pieces wraps
// it in a bufio.Writer.
func Stdout() File {
	return File{fd: stdoutFD, name: stdoutName, stream: true, appending: false}
}

// Stderr returns a handle on the standard error output, open for
// writing, a fresh File as Stdin is, which dropping never closes. It
// is where a program reports what went wrong, apart from its output:
//
//	fmt.Fprintln(mut os.Stderr(), "grep:", e)
func Stderr() File {
	return File{fd: stderrFD, name: stderrName, stream: true, appending: false}
}

// Open opens the file path names for reading and returns it, a File
// the caller owns, which closes when it goes out of scope. path is
// only read; the File keeps a copy of it, for Name and its Errors.
//
//	f := os.Open("/etc/hosts")?
//
// A missing file is an Error of Kind io.NotExist, "open /x: no such
// file or directory", and one the program may not read an Error of
// Kind io.Permission. A directory opens, and fails at its first Read.
func Open(path ref string) Result<File, io.Error> {
	fd := 0
	code := open(path, mut fd)
	if code != 0 {
		return Err(io.Errno("open", path, code))
	}

	return Ok(File{fd: fd, name: path.Clone(), stream: false, appending: false})
}

// Create opens the file path names for writing, and for reading back
// what was written, and returns it, a File the caller owns. A file
// that does not exist is made, with permissions 0666 before the umask;
// one that does is emptied first. path is only read; the File keeps a
// copy of it.
//
//	f := os.Create(ref out)?
//	f.WriteString("hello\n")?
//
// A directory on the path that does not exist is an Error of Kind
// io.NotExist, and one the program may not write in an Error of Kind
// io.Permission, with Op "open".
func Create(path ref string) Result<File, io.Error> {
	fd := 0
	code := create(path, mut fd)
	if code != 0 {
		return Err(io.Errno("open", path, code))
	}

	return Ok(File{fd: fd, name: path.Clone(), stream: false, appending: false})
}

// OpenFile opens the file path names as flag says and returns it, a
// File the caller owns. flag is O_RDONLY, O_WRONLY or O_RDWR with any
// of O_APPEND, O_CREATE, O_EXCL, O_SYNC and O_TRUNC added by |; perm is
// the permissions of a file it makes, before the umask, and is not
// used otherwise. path is only read; the File keeps a copy of it. Open
// and Create are the two commonest calls of it, and OpenOptions says
// the same with names:
//
//	flag := os.O_WRONLY | os.O_APPEND | os.O_CREATE
//	log := os.OpenFile(ref path, flag, 0o644)?
//
// A flag the package does not name, or O_WRONLY and O_RDWR together,
// is an invalid argument; a file that O_EXCL finds is an Error of Kind
// io.Exists, and a missing one without O_CREATE of Kind io.NotExist,
// all with Op "open".
func OpenFile(path ref string, flag int, perm FileMode) Result<File, io.Error> {
	fd := 0
	code := openFile(path, flag, u32(perm), mut fd)
	if code != 0 {
		return Err(io.Errno("open", path, code))
	}

	return Ok(File{fd: fd, name: path.Clone(), stream: false, appending: flag&O_APPEND != 0})
}

// ReadToString reads the whole of the file path names into one string
// and returns it, the caller's own. It reads into one block of the
// size the file reports, which the string takes with no copy, so a
// file is read in one allocation; a file that reports no size, a pipe,
// is read into a block that grows. The bytes are taken as they are,
// so a file that is not UTF-8 gives a string that is not either.
//
//	text := os.ReadToString("notes.txt")?
//
// An Error's Op says which step failed: "open", for a missing file,
// of Kind io.NotExist, or "read" for a path that opens but cannot be
// read, as a directory cannot, "read /tmp: is a directory".
func ReadToString(path ref string) Result<string, io.Error> {
	text := ""
	inRead := 0
	code := readToString(path, mut text, mut inRead)
	if code != 0 {
		op := if inRead == failedInRead { "read" } else { "open" }
		return Err(io.Errno(op, path, code))
	}

	return Ok(text)
}

// WriteString writes s to the file path names, which is made with
// permissions 0666 before the umask when it does not exist and emptied
// when it does; ReadToString reads it back. Both are only read. It
// opens, writes and closes the file, and reports the first of the
// three that fails, with its Op: "open", "write" or "close".
//
//	os.WriteString("out.txt", ref report)?
func WriteString(path ref string, s ref string) Result<(), io.Error> {
	f := Create(path)?
	f.WriteString(s)?
	return f.Close()
}

// ReadFile reads the whole of the file path names as bytes and returns
// them, the caller's own, read into one block of the size the file
// reports, as ReadToString reads text. An Error's Op says which step
// failed: "open", or "read" for a path that opens but cannot be read,
// as a directory cannot.
//
//	data := os.ReadFile(ref path)?
func ReadFile(path ref string) Result<[]byte, io.Error> {
	data := []byte{}
	inRead := 0
	code := readFile(path, mut data, mut inRead)
	if code != 0 {
		op := if inRead == failedInRead { "read" } else { "open" }
		return Err(io.Errno(op, path, code))
	}

	return Ok(data)
}

// WriteFile writes data to the file path names, which is made with the
// permissions perm, before the umask, when it does not exist, and
// emptied when it does, its permissions kept. path and data are only
// read. It opens, writes and closes the file, and reports the first of
// the three that fails, with its Op.
//
//	os.WriteFile("key.bin", ref key, 0o600)?
func WriteFile(path ref string, data ref []byte, perm FileMode) Result<(), io.Error> {
	f := OpenFile(path, O_WRONLY|O_CREATE|O_TRUNC, perm)?
	f.Write(data)?
	return f.Close()
}

// MkdirTemp makes a new directory, with permissions 0700, and returns
// its path, a string of its own. The directory is under dir, or under
// the system's temporary directory, TempDir, when dir is empty. Its
// name is pattern with its last * replaced by a random number, or with
// the number after it when it has no *, so "build-*.tmp" gives
// build-2817162.tmp; a name taken already is tried again with another
// number. Both are only read. The caller removes the directory, with
// RemoveAll, when it is done:
//
//	dir := os.MkdirTemp("", "build-*")?
//	build(ref dir)?
//	os.RemoveAll(ref dir)?
//
// A pattern holding a separator, a slash, or on Windows a backslash
// too, is refused, "mkdirtemp build/*: pattern contains path
// separator", and a dir that does not exist is reported by its stat:
// "stat /tmp/gone: no such file or directory".
func MkdirTemp(dir ref string, pattern ref string) Result<string, io.Error> {
	if hasSeparator(pattern) {
		return Err(io.NewError("mkdirtemp", pattern.Clone(), "pattern contains path separator", io.Other))
	}

	under := tempUnder(dir)
	prefix, suffix := tempParts(ref under, pattern)
	for try := 0; try < tempTries; try++ {
		name := tempName(ref prefix, ref suffix)
		code := mkdir(ref name, 0o700)
		if code == 0 {
			return Ok(name)
		}

		if code != eexist {
			return Err(tempFailed("mkdirtemp", ref under, ref prefix, ref suffix, code))
		}
	}

	return Err(tempFailed("mkdirtemp", ref under, ref prefix, ref suffix, eexist))
}

// Remove removes the file path names, or the directory when it is
// empty; path is only read. A path that names nothing is an Error of
// Kind io.NotExist, "remove /x: no such file or directory", and a
// directory with something in it one of "directory not empty";
// RemoveAll removes a directory and all it holds.
func Remove(path ref string) Result<(), io.Error> {
	code := remove(path)
	if code != 0 {
		return Err(io.Errno("remove", path, code))
	}

	return Ok(())
}

// RemoveAll removes the file path names, or the directory and
// everything under it, however deep; path is only read. A path that
// names nothing is nothing to remove, not a failure. A symbolic link
// is removed, not followed.
//
//	os.RemoveAll(ref dir)?
//
// A path whose last element is ".", as "." or "dir/." are, and on
// Windows "dir\\." too, is refused before anything is removed,
// "RemoveAll .: invalid argument": the directory it names cannot be
// removed from inside itself. A failure part way leaves what was not
// yet removed, and names the entry it failed on and the call that
// failed: "unlinkat /tmp/d/locked/f: permission denied".
func RemoveAll(path ref string) Result<(), io.Error> {
	if endsInCurrentDir(path) {
		return Err(io.Errno("RemoveAll", path, einval))
	}

	failed := ""
	op := ""
	code := removeAll(path, mut failed, mut op)
	if code != 0 {
		return Err(io.Errno(op, failed, code))
	}

	return Ok(())
}

// Stat returns what the system says of the file path names: its name,
// size, mode and the time it was last changed, as a FileInfo of its
// own. A symbolic link is followed, so the FileInfo is of the file it
// leads to; Lstat is of the link. path is only read. It makes one
// system call and copies the last element of path.
//
//	fi := os.Stat(ref path)?
//	fmt.Println(fi.Name(), fi.Size())
//
// A path that names nothing is an Error of Kind io.NotExist, "stat
// /x: no such file or directory".
func Stat(path ref string) Result<FileInfo, io.Error> {
	var fi FileInfo
	code := statInto(path, true, mut fi)
	if code != 0 {
		return Err(io.Errno("stat", path, code))
	}

	return Ok(fi)
}

// Lstat is Stat that does not follow a symbolic link: the FileInfo is
// of the link itself, whose Mode has ModeSymlink set. For any other
// file it is Stat. A path that names nothing is an Error of Kind
// io.NotExist, "lstat /x: no such file or directory".
func Lstat(path ref string) Result<FileInfo, io.Error> {
	var fi FileInfo
	code := statInto(path, false, mut fi)
	if code != 0 {
		return Err(io.Errno("lstat", path, code))
	}

	return Ok(fi)
}

// ReadDir returns the names in the directory path names, sorted by
// name, byte by byte, each with the kind of file it is, as DirEntry
// values of their own; the entries . and .. are left out. path is only
// read. It reads the directory whole, asking about a file only where
// the directory does not give its kind, and sorts the names in O(n log
// n) for n of them.
//
//	for _, e := range ref os.ReadDir(ref dir)? {
//		fmt.Println(e.Name())
//	}
//
// A path that names nothing is an Error of Kind io.NotExist, and one
// that is not a directory is "open PATH: not a directory".
func ReadDir(path ref string) Result<[]DirEntry, io.Error> {
	packed := []byte{} // each entry: the bytes of its FileMode, lowest first, its name, a zero byte
	op := ""
	code := readDir(path, mut packed, mut op)
	if code != 0 {
		return Err(io.Errno(op, path, code))
	}

	entries := []DirEntry{}
	at := 0
	for at < len(packed) {
		typ := u32(packed[at]) | u32(packed[at+1])<<8 | u32(packed[at+2])<<16 | u32(packed[at+3])<<24
		end := at + packedModeSize
		for packed[end] != 0 {
			end++
		}

		entries.Push(DirEntry{name: string(packed[at+packedModeSize:end]), typ: FileMode(typ)})
		at = end + 1
	}

	entries.SortBy(func(a ref DirEntry, b ref DirEntry) bool { return a.name < b.name })
	return Ok(entries)
}

// Mkdir makes the directory path names, with the permissions perm,
// before the umask; path is only read. Its parent must exist, and the
// directory must not: a path taken already is an Error of Kind
// io.Exists, "mkdir /tmp/a: file exists", and a missing parent one of
// Kind io.NotExist. MkdirAll makes the parents too.
//
//	os.Mkdir("out", 0o755)?
func Mkdir(path ref string, perm FileMode) Result<(), io.Error> {
	code := mkdir(path, u32(perm))
	if code != 0 {
		return Err(io.Errno("mkdir", path, code))
	}

	return Ok(())
}

// MkdirAll makes the directory path names and every parent of it that
// does not exist, each with the permissions perm, before the umask;
// path is only read. On Windows a parent is found at either
// separator, and a volume, C: or \\server\share, is never made. A path
// that is a directory already is no failure, so a program calls it
// without asking first; one that is a file, or that passes through
// one, is "mkdir PATH: not a directory". It stats
// the path once when it is there, and makes one call per missing
// directory otherwise.
//
//	os.MkdirAll("out/logs/2026", 0o755)?
func MkdirAll(path ref string, perm FileMode) Result<(), io.Error> {
	var fi FileInfo
	if statInto(path, true, mut fi) == 0 { // the fast path: it is there
		if fi.IsDir() {
			return Ok(())
		}

		return Err(io.Errno("mkdir", path, enotdir))
	}

	// The parent first: the path without its last element and the
	// separators around it.
	i := path.Len() - 1
	for i >= 0 && filepath.IsSeparator(path[i]) {
		i--
	}

	for i >= 0 && !filepath.IsSeparator(path[i]) {
		i--
	}

	if i > filepath.VolumeName(path).Len() { // a parent that is more than the root or the volume, which are there
		MkdirAll(path[0:i], perm)?
	}

	match Mkdir(path, perm) {
		Ok(_) => return Ok(()),
		Err(e) => {
			// A directory another task made meanwhile, or a path
			// ending in a separator or a dot, is there already.
			if statInto(path, false, mut fi) == 0 && fi.IsDir() {
				return Ok(())
			}

			return Err(e)
		},
	}
}

// Rename renames the file or directory from to to, moving it when to
// is in another directory of the same file system, and replacing a
// file that to names; both are only read.
//
//	os.Rename(ref tmp, ref final)? // a write made whole at once
//
// A to that is a directory is refused as "file exists", of Kind
// io.Exists, unless it is from itself under another spelling. A from
// that names nothing is an Error of Kind io.NotExist, "rename FROM TO:
// no such file or directory".
func Rename(from ref string, to ref string) Result<(), io.Error> {
	var target FileInfo
	if statInto(to, false, mut target) == 0 && target.IsDir() {
		var source FileInfo
		code := statInto(from, false, mut source)
		if code != 0 {
			return Err(io.Errno("rename", ref (from + " " + to), code))
		}

		if from == to || source.dev != target.dev || source.ino != target.ino {
			return Err(io.Errno("rename", ref (from + " " + to), eexist))
		}
	}

	code := rename(from, to)
	if code != 0 {
		return Err(io.Errno("rename", ref (from + " " + to), code))
	}

	return Ok(())
}

// Chmod sets the permissions of the file path names to mode's: its
// nine permission bits, and ModeSetuid, ModeSetgid and ModeSticky
// where the system keeps them; the bits of the file's kind are not
// read. path is only read; a symbolic link is followed.
//
//	os.Chmod(ref script, 0o755)?
//
// On Windows, which keeps no permissions, the owner's write bit alone
// counts: a mode without it makes the file read-only, one with it
// writable, as FileMode says. A path that names nothing is an Error of
// Kind io.NotExist, "chmod /x: no such file or directory".
func Chmod(path ref string, mode FileMode) Result<(), io.Error> {
	code := chmod(path, u32(mode))
	if code != 0 {
		return Err(io.Errno("chmod", path, code))
	}

	return Ok(())
}

// Chtimes sets the time the file path names was last read, atime, and
// last changed, mtime; a time given as None is left as it is, so a
// program sets one without reading the other first. The system keeps
// a time to the precision it has, nanoseconds on Linux and macOS and
// hundreds of nanoseconds on Windows, and Stat reads back what it
// kept. path is only read; a symbolic link is followed.
//
//	os.Chtimes(ref path, None, Some(time.Now()))? // touch
//
// A path that names nothing is an Error of Kind io.NotExist, "chtimes
// /x: no such file or directory".
func Chtimes(path ref string, atime time.Time?, mtime time.Time?) Result<(), io.Error> {
	var asec i64 = 0
	var ansec i64 = 0
	var msec i64 = 0
	var mnsec i64 = 0
	if a := atime {
		asec = a.Unix()
		ansec = i64(a.Nanosecond())
	}

	if m := mtime {
		msec = m.Unix()
		mnsec = i64(m.Nanosecond())
	}

	code := chtimes(path, atime.IsSome(), asec, ansec, mtime.IsSome(), msec, mnsec)
	if code != 0 {
		return Err(io.Errno("chtimes", path, code))
	}

	return Ok(())
}

// Truncate sets the size of the file path names to size bytes: a
// longer file loses its end, a shorter one grows with zero bytes.
// path is only read. A size below zero is refused as an invalid
// argument before the system is asked.
//
//	os.Truncate(ref log, 0)? // empty it
//
// A path that names nothing is an Error of Kind io.NotExist,
// "truncate /x: no such file or directory".
func Truncate(path ref string, size i64) Result<(), io.Error> {
	if size < 0 {
		return Err(io.Errno("truncate", path, einval))
	}

	code := truncate(path, size)
	if code != 0 {
		return Err(io.Errno("truncate", path, code))
	}

	return Ok(())
}

// Link makes newname a hard link to the file oldname names: a second
// name for the same file, which lives while either name does. Both
// are only read. A directory cannot be linked.
//
//	os.Link(ref data, ref backup)?
//
// A newname taken already is an Error of Kind io.Exists, "link OLD
// NEW: file exists", and an oldname that names nothing one of Kind
// io.NotExist.
func Link(oldname ref string, newname ref string) Result<(), io.Error> {
	code := link(oldname, newname)
	if code != 0 {
		return Err(io.Errno("link", ref (oldname + " " + newname), code))
	}

	return Ok(())
}

// Symlink makes newname a symbolic link to oldname: a file that holds
// the text oldname, which Open and Stat follow and Lstat and Readlink
// do not. oldname need not exist, and is kept as written, relative to
// the link's own directory when it is relative. Both are only read.
//
//	os.Symlink("current.log", ref link)?
//
// On Windows a link to a directory is made as a directory link, which
// takes the target to exist when the link is made, and making a link
// takes the user's right to, which developer mode gives. A newname
// taken already is an Error of Kind io.Exists, "symlink OLD NEW: file
// exists".
func Symlink(oldname ref string, newname ref string) Result<(), io.Error> {
	code := symlink(oldname, newname)
	if code != 0 {
		return Err(io.Errno("symlink", ref (oldname + " " + newname), code))
	}

	return Ok(())
}

// Readlink returns the text the symbolic link path names holds, as
// Symlink wrote it, in a string of its own; path is only read. A path
// that is no symbolic link is refused as an invalid argument,
// "readlink /x: invalid argument", and one that names nothing is an
// Error of Kind io.NotExist.
//
//	target := os.Readlink(ref link)?
func Readlink(path ref string) Result<string, io.Error> {
	target := ""
	code := readlink(path, mut target)
	if code != 0 {
		return Err(io.Errno("readlink", path, code))
	}

	return Ok(target)
}

// Abs returns the absolute form of path, a new string: path itself
// cleaned when it is absolute, and otherwise the current directory
// with path joined to it, as filepath.Join joins and cleans; no link
// is followed, and the file need not exist; an empty path is the
// current directory. On Windows a path that starts at a root with no
// drive, \tmp, is on the current directory's drive, and one on another
// drive without a root,
// "D:notes.txt", is refused as an invalid argument, since that drive's
// current directory is the system's alone. path is only read.
//
//	full := os.Abs("docs/notes.txt")?
//
// It fails when the current directory cannot be read, as Getwd fails.
func Abs(path ref string) Result<string, io.Error> {
	if filepath.IsAbs(path) {
		return Ok(filepath.Clean(path))
	}

	wd := Getwd()?
	if path.Len() == 0 { // the current directory itself
		return Ok(wd)
	}

	return abs(path, ref wd)
}

// EvalSymlinks returns the path with every symbolic link in it
// followed, a new string: what the file system reaches when it reads
// path, element by element, a link's text spliced in where the link is,
// an absolute link starting the path over; the result is clean, and
// relative when path is and no link made it absolute. Every element
// must exist. path is only read.
//
//	real := os.EvalSymlinks(ref link)?
//
// A path that names nothing is an Error of Kind io.NotExist, as Lstat
// reports it, and a chain of more than 255 links an Error, "evalsymlinks
// PATH: too many links".
func EvalSymlinks(path ref string) Result<string, io.Error> {
	if path.Len() == 0 {
		return Ok(path.Clone())
	}

	// The path is read element by element into dest, the volume and the
	// root, when the path starts at one, first; a link replaces what is
	// left of the path with its text and the rest, and the reading goes
	// on from there.
	rest := path.Clone()
	volLen := filepath.VolumeName(ref rest).Len()
	if volLen < rest.Len() && filepath.IsSeparator(rest[volLen]) {
		volLen++
	}

	dest := rest[0:volLen].Clone()
	links := 0
	start := volLen
	for start < rest.Len() {
		for start < rest.Len() && filepath.IsSeparator(rest[start]) {
			start++
		}

		end := start
		for end < rest.Len() && !filepath.IsSeparator(rest[end]) {
			end++
		}

		if end == start { // separators alone are left
			break
		}

		if end-start == 1 && rest[start] == dotByte {
			start = end
			continue
		}

		if end-start == 2 && rest[start] == dotByte && rest[start+1] == dotByte {
			// Back up to the element before, which is no link, having
			// been followed already; with nothing before, or a ".." kept
			// before, this ".." is kept too.
			r := dest.Len() - 1
			for r >= volLen && !filepath.IsSeparator(dest[r]) {
				r--
			}

			kept := r < volLen || (dest.Len()-(r+1) == 2 && dest[r+1] == dotByte && dest[r+2] == dotByte)
			if kept {
				if dest.Len() > volLen {
					dest = dest + string(filepath.Separator)
				}

				dest = dest + ".."
			} else {
				dest = dest[0:r].Clone()
			}

			start = end
			continue
		}

		if dest.Len() > volLen && !filepath.IsSeparator(dest[dest.Len()-1]) {
			dest = dest + string(filepath.Separator)
		}

		dest = dest + rest[start:end]
		fi := Lstat(ref dest)?
		if fi.Mode()&ModeSymlink == 0 {
			if !fi.Mode().IsDir() && end < rest.Len() {
				return Err(io.Errno("evalsymlinks", path, enotdir))
			}

			start = end
			continue
		}

		links++
		if links > maxLinks {
			return Err(io.NewError("evalsymlinks", path.Clone(), "too many links", io.Other))
		}

		link := Readlink(ref dest)?
		after := rest[end:].Clone()
		rest = link + after
		linkVolLen := filepath.VolumeName(ref link).Len()
		if linkVolLen > 0 { // a link to a path with a volume starts over there
			if linkVolLen < link.Len() && filepath.IsSeparator(link[linkVolLen]) {
				linkVolLen++
			}

			volLen = linkVolLen
			dest = link[0:volLen].Clone()
			start = volLen
		} else if link.Len() > 0 && filepath.IsSeparator(link[0]) { // a link to an absolute path starts over at the root
			volLen = 1
			dest = link[0:1].Clone()
			start = 1
		} else { // a link to a relative path is read where the link is: its element goes
			r := dest.Len() - 1
			for r >= volLen && !filepath.IsSeparator(dest[r]) {
				r--
			}

			if r < volLen {
				dest = dest[0:volLen].Clone()
			} else {
				dest = dest[0:r].Clone()
			}

			start = 0
		}
	}

	return Ok(filepath.Clean(ref dest))
}

// WalkDir walks the tree under root, giving each file and directory to
// visit, the directory before what it holds and the entries of a
// directory in the order of their names: the root first, by its Lstat,
// then each entry as ReadDir lists it, with no link followed. visit is
// given the path, root with the elements under it joined on, and the
// entry, or the error that stopped the walk from reading a directory,
// and answers how to go on, a Walk; a directory it cannot read is given
// a second time with the error, after its own visit, and left out when
// visit answers Continue. The walk is done once, each directory read
// once, and stops at Stop, whose error it returns.
//
//	os.WalkDir(ref root, func(path ref string, found Result<ref os.DirEntry, io.Error>) os.Walk {
//		match found {
//			Ok(e) => {
//				if e.IsDir() && e.Name() == ".git" {
//					return os.SkipDir
//				}
//
//				fmt.Println(path)
//			},
//			Err(e) => fmt.Println("unreadable:", e),
//		}
//
//		return os.Continue
//	})?
//
// A root that names nothing is given to visit with its error, and the
// walk ends as visit answers: Continue returns Ok.
func WalkDir(root ref string, visit func(path ref string, found Result<ref DirEntry, io.Error>) Walk) Result<(), io.Error> {
	match Lstat(root) {
		Ok(fi) => {
			entry := DirEntry{name: fi.name.Clone(), typ: fi.mode.Type()}
			_ = walk(root, ref entry, visit)?
			return Ok(())
		},
		Err(e) => {
			match visit(root, Err(e)) {
				Stop(failure) => return Err(failure),
				_ => return Ok(()),
			}
		},
	}
}

// Glob returns the paths of the files that fit pattern, as
// filepath.Match fits a name, in the order of their names, each a new
// string: the elements up to the first with a *, ? or [ name the
// directory to start in, and each element from there is matched
// against the names of the directories reached so far, so
// "src/*/main.snello" lists each package's main file. No file fitting
// is an empty slice, and a directory that cannot be read is skipped, as
// a shell skips it; a pattern that cannot be read is an error, as Match
// reports it. The pattern is read in one pass, however many elements it
// has. pattern is only read.
//
//	for _, name := range ref os.Glob("*.log")? {
//		os.Remove(ref name)?
//	}
func Glob(pattern ref string) Result<[]string, io.Error> {
	_ = filepath.Match(pattern, "")? // a bad pattern is reported whatever is on disk
	volLen := filepath.VolumeName(pattern).Len()
	first := firstMeta(pattern, volLen)
	if first == pattern.Len() {
		match Lstat(pattern) {
			Ok(_) => return Ok([]string{pattern.Clone()}),
			Err(_) => return Ok([]string{}),
		}
	}

	dirs := []string{cleanGlobDir(pattern[0:first])}
	start := first
	for start <= pattern.Len() && len(dirs) > 0 {
		end := start
		for end < pattern.Len() && !filepath.IsSeparator(pattern[end]) {
			end++
		}

		found := []string{}
		for _, d := range ref dirs {
			found = glob(d, pattern[start:end], found)?
		}

		dirs = found
		start = end + 1
	}

	return Ok(dirs)
}

// CreateTemp makes a new file under dir, or the system's temporary
// directory when dir is empty, open for reading and writing, with
// permissions 0600, named by pattern: the pattern with its last *
// replaced by a random number, or followed by one when it has none,
// so the name is one no file had. The caller removes the file when it
// is done with it; Name gives its path. dir and pattern are only
// read.
//
//	f := os.CreateTemp("", "upload-*.bin")?
//	defer os.Remove(f.Name())
//
// A pattern holding a separator is refused, "createtemp up/*: pattern
// contains path separator", and a dir that does not exist is reported
// by its stat, "stat /tmp/gone: no such file or directory".
func CreateTemp(dir ref string, pattern ref string) Result<File, io.Error> {
	if hasSeparator(pattern) {
		return Err(io.NewError("createtemp", pattern.Clone(), "pattern contains path separator", io.Other))
	}

	under := tempUnder(dir)
	prefix, suffix := tempParts(ref under, pattern)
	for try := 0; try < tempTries; try++ {
		name := tempName(ref prefix, ref suffix)
		fd := 0
		code := openFile(ref name, O_RDWR|O_CREATE|O_EXCL, 0o600, mut fd)
		if code == 0 {
			return Ok(File{fd: fd, name: name, stream: false, appending: false})
		}

		if code != eexist {
			return Err(tempFailed("open", ref under, ref prefix, ref suffix, code))
		}
	}

	return Err(tempFailed("open", ref under, ref prefix, ref suffix, eexist))
}

// Executable returns the path of the running program's file, absolute:
// what the system says started the program, not the name it was
// started by, so a program finds the files beside itself with
// filepath.Dir. On Linux and macOS a link to the program is resolved;
// on Windows the path is the one the program was started by, made
// absolute. The system is asked once, on
// the first call, since the program's file does not change while it
// runs, and the path is kept for the program's life: the string
// returned is lent from that block, with nothing copied, as a string
// literal is.
//
//	exe := os.Executable()?
//	assets := filepath.Join(filepath.Dir(ref exe), "assets")
//
// It fails when the system cannot say, "executable: ...", which no
// supported system does for a program started from a file.
func Executable() Result<string, io.Error> {
	path := ""
	code := executable(mut path)
	if code != 0 {
		return Err(syscallError("executable", code))
	}

	return Ok(path)
}

// Getwd returns the path of the current directory, a string of its
// own: the PWD of the environment when it is an absolute path that
// names the current directory, which is the path the user came by,
// through a symbolic link or not, and what the system says otherwise. It stats the two to compare
// them, and asks the system only when they differ.
//
//	wd := os.Getwd()?
//
// It fails when the current directory cannot be stated or no longer
// exists, "getwd: no such file or directory".
func Getwd() Result<string, io.Error> {
	dir := Getenv(envPWD)
	if filepath.IsAbs(dir) {
		var dot FileInfo
		code := statInto(currentDir, true, mut dot)
		if code != 0 {
			return Err(io.Errno("stat", currentDir, code))
		}

		var named FileInfo
		if statInto(ref dir, true, mut named) == 0 && named.dev == dot.dev && named.ino == dot.ino {
			return Ok(dir)
		}
	}

	out := ""
	code := getcwd(mut out)
	if code != 0 {
		return Err(syscallError("getwd", code))
	}

	return Ok(out)
}

// Chdir makes the directory path names the current one, which a path
// that does not start with a separator is read from; path is only
// read. It is for the whole program, every task of it, as the system
// has one current directory per process, so a program with many tasks
// prefers whole paths. A path that names nothing is an Error of Kind
// io.NotExist, "chdir /x: no such file or directory".
//
//	os.Chdir(ref dir)?
func Chdir(path ref string) Result<(), io.Error> {
	code := chdir(path)
	if code != 0 {
		return Err(io.Errno("chdir", path, code))
	}

	return Ok(())
}

// Hostname returns the name the system gives the machine, a string of
// its own, "build-01" or "laptop.local". It fails only when the system
// does, "hostname: " and the reason.
func Hostname() Result<string, io.Error> {
	name := ""
	code := hostname(mut name)
	if code != 0 {
		return Err(syscallError("hostname", code))
	}

	return Ok(name)
}

// Getpid returns the number of the program's process, the one ps and
// kill know it by, and Task Manager on Windows. The runtime provides it.
func Getpid() int

// Getppid returns the process id of the program's parent, the shell or
// the program that started it. The runtime provides it.
func Getppid() int

// TempDir returns the directory for temporary files: the TMPDIR of the
// environment, or /tmp when it is unset or empty, and on Windows the
// system's, which GetTempPathW finds from TMP, TEMP or the user's
// profile, without the separator it ends in. It is not checked to
// exist, and nothing is made; MkdirTemp makes a directory of one's own
// under it. The runtime provides it.
func TempDir() string

// Getenv returns the value of the environment variable key, and an
// empty string when it is not set; LookupEnv tells an empty value from
// none. key is only read, and on Windows matched with no regard to its
// case, as the system matches it.
//
//	home := os.Getenv("HOME")
//
// The environment is a copy the runtime makes of the one the program
// was started with and keeps under a lock, so any task may read it
// while another sets a variable; a read finds the variable through an
// index, in constant time. Setenv and Unsetenv change that copy: what
// the program reads after, and not what a C library bound to it reads,
// which is the environment the program was started with.
//
// A variable the program started with is lent from a block that lives
// as long as the program, with nothing copied, as a string literal is;
// one the program set is returned as a copy, since a later Setenv
// frees its bytes.
func Getenv(key ref string) string {
	value := ""
	_ = lookupEnv(key, mut value)
	return value
}

// LookupEnv returns the value of the environment variable key, or None
// when it is not set: a variable set to nothing is Some(""). key is
// only read, and the value is lent or copied as Getenv's is.
//
//	editor := os.LookupEnv("EDITOR") ?? "vi"
func LookupEnv(key ref string) string? {
	value := ""
	if lookupEnv(key, mut value) {
		return Some(value)
	}

	return None
}

// Setenv sets the environment variable key to value, in the program's
// copy of the environment, for every task of it; both are only read,
// and copied. A key that is empty or holds an = or a zero byte, and a
// value that holds a zero byte, are refused: "setenv: invalid
// argument". A later Getenv of key sees value.
//
//	os.Setenv("LANG", "C")?
func Setenv(key ref string, value ref string) Result<(), io.Error> {
	code := setenv(key, value)
	if code != 0 {
		return Err(syscallError("setenv", code))
	}

	return Ok(())
}

// Unsetenv unsets the environment variable key in the program's copy
// of the environment; key is only read, and one that is not set is
// nothing to unset. It never fails. The runtime provides it.
func Unsetenv(key ref string)

// Environ returns the environment as it is at one moment, a string per
// variable as KEY=value, in a slice made once for their count: a
// variable the program started with lent as Getenv lends it, and one
// the program set as a copy.
//
//	for _, kv := range ref os.Environ() { fmt.Println(kv) }
func Environ() []string {
	vars := []string{}
	environ(mut vars)
	return vars
}

// Name returns the path the file was opened with, or the name of the
// stream, /dev/stdout; it is what an Error on the file carries as its
// Path. It is a borrow of the File's own string, with nothing copied.
func (f ref File) Name() ref string {
	return ref f.name
}

// Read fills buf from the file, from its front and at the file's
// position, with as much as one read gives, at most len(buf), and
// returns how many bytes it wrote; zero at the end of the file, and
// for an empty buf. It is one system call, which blocks until the
// system answers. It is io.Reader's method.
//
//	n := f.Read(mut buf)?
//
// A file open for writing only fails, "read /x: bad file descriptor",
// and so does a directory, "read /tmp: is a directory".
func (f mut File) Read(buf mut []byte) Result<int, io.Error> {
	n := 0
	code := read(f.fd, buf, mut n)
	if code != 0 {
		return Err(io.Errno("read", ref f.name, code))
	}

	return Ok(n)
}

// Write writes all of buf to the file, at its position or at its end
// for a file opened with O_APPEND, and returns how many bytes it
// wrote, the length of buf; buf is only read. It asks the system as
// often as it takes to write every byte. It is io.Writer's method. A
// write that fails partway, on a disk that filled, has written the
// Error's Written() bytes, and a file open for reading only fails with
// none written.
func (f mut File) Write(buf ref []byte) Result<int, io.Error> {
	n := 0
	code := write(f.fd, buf, mut n)
	if code != 0 {
		return Err(io.Errno("write", ref f.name, code).WithWritten(n))
	}

	return Ok(n)
}

// WriteString writes all of s to the file and returns how many bytes
// it wrote, the length of s, as Write does with bytes, and with no
// copy of s; it fails as Write fails.
//
//	f.WriteString("line\n")?
func (f mut File) WriteString(s ref string) Result<int, io.Error> {
	n := 0
	code := writeString(f.fd, s, mut n)
	if code != 0 {
		return Err(io.Errno("write", ref f.name, code).WithWritten(n))
	}

	return Ok(n)
}

// ReadAt reads into buf from the file at the offset off, counted in
// bytes from the start, and returns how many bytes it read, asking the
// system as often as it takes to fill buf: fewer than buf holds only at
// the end of the file, and none at or past it, however far past. The
// file's position, where Read and Write go on, stays where it was, so
// several readers read one file at once. It is io.ReaderAt's method.
//
//	n := f.ReadAt(mut record, 64 * i)?
func (f ref File) ReadAt(buf mut []byte, off u64) Result<int, io.Error> {
	n := 0
	code := pread(f.fd, buf, off, mut n)
	if code != 0 {
		return Err(io.Errno("read", ref f.name, code))
	}

	return Ok(n)
}

// WriteAt writes all of buf to the file at the offset off, counted in
// bytes from the start, and returns how many bytes it wrote, the length
// of buf; a write past the end leaves a gap of zero bytes. The file's
// position stays where it was. It is io.WriterAt's method, and fails as
// Write fails, with the Error's Written() bytes written. A file opened
// with O_APPEND takes no offset, since every write of it goes to the
// end, and the systems disagree on which wins: WriteAt fails on it with
// "invalid use of WriteAt on file opened with O_APPEND".
func (f mut File) WriteAt(buf ref []byte, off u64) Result<int, io.Error> {
	if f.appending {
		return Err(io.NewError("write", f.name.Clone(), "invalid use of WriteAt on file opened with O_APPEND", io.Other))
	}

	n := 0
	code := pwrite(f.fd, buf, off, mut n)
	if code != 0 {
		return Err(io.Errno("write", ref f.name, code).WithWritten(n))
	}

	return Ok(n)
}

// Seek moves the file's position, where the next Read and Write begin,
// to where pos says, and returns the new position, counted in bytes
// from the start. It is io.Seeker's method:
//
//	f.Seek(io.Start(0))?            // back to the start
//	size := f.Seek(io.End(0))?      // to the end, which is the size
//	at := f.Seek(io.Current(0))?    // where it is, not moving
//
// A position past the end is allowed, and a write there leaves a gap
// that reads as zero bytes. A position before the start fails as an
// invalid argument, as does one past what a position holds, 2^63 - 1;
// a stream that has no position, a pipe or a terminal, fails as an
// illegal seek.
func (f mut File) Seek(pos io.SeekFrom) Result<u64, io.Error> {
	at := u64(0)
	code := match pos {
		io.Start(n) => seek(f.fd, seekSet, i64(n), mut at), // past 2^63 - 1 it wraps below zero, which the system refuses
		io.Current(n) => seek(f.fd, seekCur, n, mut at),
		io.End(n) => seek(f.fd, seekEnd, n, mut at),
	}

	if code != 0 {
		return Err(io.Errno("seek", ref f.name, code))
	}

	return Ok(at)
}

// Sync asks the system to write what it holds in memory of the file to
// the device, and waits until it has, so that what was written
// survives a crash or a loss of power. It is slow, a wait on the
// device, and is called where that matters, before a rename that
// makes a file whole.
func (f mut File) Sync() Result<(), io.Error> {
	code := syncFile(f.fd)
	if code != 0 {
		return Err(io.Errno("sync", ref f.name, code))
	}

	return Ok(())
}

// Stat returns what the system says of the open file, a FileInfo whose
// Name is the last element of the path the file was opened by: its
// size now, which a write through another File changes too. The
// receiver is lent.
//
//	size := f.Stat()?.Size()
func (f ref File) Stat() Result<FileInfo, io.Error> {
	var size i64 = 0
	var mode u32 = 0
	var sec i64 = 0
	var nsec i64 = 0
	var dev u64 = 0
	var ino u64 = 0
	code := fstat(f.fd, mut size, mut mode, mut sec, mut nsec, mut dev, mut ino)
	if code != 0 {
		return Err(io.Errno("stat", ref f.name, code))
	}

	return Ok(fileInfo(ref f.name, size, mode, sec, nsec, dev, ino))
}

// Truncate sets the size of the open file to size bytes, as
// os.Truncate does by a path: a longer file loses its end, a shorter
// one grows with zero bytes; the position for the next Read or Write
// does not move. The file must be open for writing. A size below zero
// is refused as an invalid argument before the system is asked.
//
//	f.Truncate(0)?
func (f mut File) Truncate(size i64) Result<(), io.Error> {
	if size < 0 {
		return Err(io.Errno("truncate", ref f.name, einval))
	}

	code := ftruncate(f.fd, size)
	if code != 0 {
		return Err(io.Errno("truncate", ref f.name, code))
	}

	return Ok(())
}

// Close takes the file, closes it, and reports a failure to: on some
// file systems a write's failure shows only then. A closed file cannot
// be used again: the compiler refuses a use after Close as a use of a
// moved value. A program that does not care for the failure lets the
// File go out of scope, and Drop closes it.
//
//	f.Close()?
func (f File) Close() Result<(), io.Error> {
	code := closeFile(f.fd)
	f.fd = closedFD
	if code != 0 {
		return Err(io.Errno("close", ref f.name, code))
	}

	return Ok(())
}

// Drop closes the descriptor when the File goes out of scope, unless
// it is a standard stream, which stays open for the program's life, or
// Close already closed it. A failure to close is lost; a program that
// cares calls Close.
func (f mut File) Drop() {
	if !f.stream && f.fd >= 0 {
		closeFile(f.fd)
	}
}

// IsDir reports whether m is a directory's mode: whether ModeDir is
// set.
func (m FileMode) IsDir() bool {
	return m & ModeDir != 0
}

// IsRegular reports whether m is a regular file's mode: whether no bit
// of ModeType, no kind, is set.
func (m FileMode) IsRegular() bool {
	return m & ModeType == 0
}

// Perm returns the permissions of m, its low nine bits, with the bits
// of its kind and of how it runs cleared: 0o755 of drwxr-xr-x.
func (m FileMode) Perm() FileMode {
	return m & ModePerm
}

// Type returns the bits of m that say what kind of file it is, its
// bits of ModeType: ModeDir for a directory, 0 for a regular file.
func (m FileMode) Type() FileMode {
	return m & ModeType
}

// String returns the mode as ls writes it: a letter for each bit above
// the permissions that is set, "d" for ModeDir and the letters the
// constants show, or a dash when none is, then the nine permissions,
// "drwxr-xr-x", "-rw-r--r--", "Lrwxrwxrwx". It allocates the string
// it returns.
func (m ref FileMode) String() string {
	bits := u32(*m)
	buf := []byte{}
	for i := 0; i < modeLetters.Len(); i++ {
		if bits & (u32(1) << u32(topModeBit-i)) != 0 {
			buf.Push(modeLetters[i])
		}
	}

	if len(buf) == 0 {
		buf.Push(noBitLetter)
	}

	for i := 0; i < permBits; i++ {
		if bits & (u32(1) << u32(permBits-1-i)) != 0 {
			buf.Push(permLetters[i])
		} else {
			buf.Push(noBitLetter)
		}
	}

	return string(buf)
}

// Name returns the last element of the path the FileInfo was asked
// for, as filepath.Base reads it: "notes.txt" of "/tmp/notes.txt",
// and on Windows of "C:\tmp\notes.txt" too, or the root for the root.
// It is a
// borrow of the FileInfo's own string, with nothing copied.
func (fi ref FileInfo) Name() ref string {
	return ref fi.name
}

// Size returns the file's length in bytes; what a directory's is
// depends on the system.
func (fi ref FileInfo) Size() i64 {
	return fi.size
}

// Mode returns the file's kind and permissions; for Lstat of a
// symbolic link, ModeSymlink is set.
func (fi ref FileInfo) Mode() FileMode {
	return fi.mode
}

// ModTime returns when the file's contents were last changed, as the
// system records it, to the nanosecond where it keeps that.
func (fi ref FileInfo) ModTime() time.Time {
	return fi.modTime
}

// IsDir reports whether the file is a directory, as Mode().IsDir()
// does.
func (fi ref FileInfo) IsDir() bool {
	return fi.mode.IsDir()
}

// Name returns the entry's name, the last element of its path, with no
// directory before it. It is a borrow of the DirEntry's own string,
// with nothing copied.
func (e ref DirEntry) Name() ref string {
	return ref e.name
}

// IsDir reports whether the entry is a directory. A symbolic link to a
// directory is not, since it is not followed.
func (e ref DirEntry) IsDir() bool {
	return e.typ.IsDir()
}

// Type returns the bits of the entry's kind: ModeDir for a directory,
// ModeSymlink for a symbolic link, which is not followed, and none for
// a regular file. The permissions are not among them; Stat of the
// name gives those.
func (e ref DirEntry) Type() FileMode {
	return e.typ
}

// Open opens the file path names as o says and returns it, a File the
// caller owns, as OpenFile does with the flags o stands for; o and path
// are only read.
//
//	o := os.OpenOptions{Write: true, Create: true, Perm: 0o600}
//	f := o.Open(ref path)?
//
// Options that open the file for neither reading nor writing, that ask
// to make or empty a file opened for reading alone, or that empty a
// file appended to, are an invalid argument, with Op "open", and the
// file is not touched. Otherwise it fails as OpenFile fails.
func (o ref OpenOptions) Open(path ref string) Result<File, io.Error> {
	write := o.Write || o.Append
	if !o.Read && !write || !write && (o.Create || o.Truncate || o.Exclusive) || o.Truncate && o.Append {
		return Err(io.Errno("open", path, einval))
	}

	flag := if o.Read && write { O_RDWR } else if write { O_WRONLY } else { O_RDONLY }
	if o.Append {
		flag |= O_APPEND
	}

	if o.Create || o.Exclusive {
		flag |= O_CREATE
	}

	if o.Exclusive {
		flag |= O_EXCL
	}

	if o.Truncate {
		flag |= O_TRUNC
	}

	return OpenFile(path, flag, o.Perm)
}

// statInto fills fi with what the system says of path, following a
// symbolic link when follow is set, and returns the system's error
// number, zero on success; fi is left as it was on a failure.
func statInto(path ref string, follow bool, fi mut FileInfo) int {
	var size i64 = 0
	var mode u32 = 0
	var sec i64 = 0
	var nsec i64 = 0
	var dev u64 = 0
	var ino u64 = 0
	code := stat(path, follow, mut size, mut mode, mut sec, mut nsec, mut dev, mut ino)
	if code == 0 {
		*fi = fileInfo(path, size, mode, sec, nsec, dev, ino)
	}

	return code
}

// fileInfo is the FileInfo of what the system said of the file at path,
// named by the last element of the path.
func fileInfo(path ref string, size i64, mode u32, sec i64, nsec i64, dev u64, ino u64) FileInfo {
	return FileInfo{name: filepath.Base(path).Clone(), size: size, mode: FileMode(mode), modTime: time.Unix(sec, nsec), dev: dev, ino: ino}
}

// walk gives the entry at path to visit and, for a directory it may
// enter, the entries under it, each walked in turn; it answers for the
// directory holding the entry: Continue, SkipDir when visit asked for
// the rest of that directory to be left out, or SkipAll, and a Stop's
// error as its own. A directory that cannot be read is given to visit
// a second time, with the error, and left out when visit answers
// Continue or SkipDir.
func walk(path ref string, entry ref DirEntry, visit func(path ref string, found Result<ref DirEntry, io.Error>) Walk) Result<Walk, io.Error> {
	match visit(path, Ok(entry)) {
		Continue => {},
		SkipDir => {
			if entry.IsDir() { // the directory just given is left out, and its siblings go on
				return Ok(Continue)
			}

			return Ok(SkipDir) // after a file: the rest of its directory
		},
		SkipAll => return Ok(SkipAll),
		Stop(failure) => return Err(failure),
	}

	if !entry.IsDir() {
		return Ok(Continue)
	}

	entries := []DirEntry{}
	match ReadDir(path) {
		Ok(listed) => entries = listed,
		Err(e) => {
			match visit(path, Err(e)) {
				SkipAll => return Ok(SkipAll),
				Stop(failure) => return Err(failure),
				_ => return Ok(Continue),
			}
		},
	}

	for _, e := range ref entries {
		under := filepath.Join(path, e.Name())
		match walk(ref under, e, visit)? {
			Continue => {},
			SkipDir => break,
			_ => return Ok(SkipAll),
		}
	}

	return Ok(Continue)
}

// glob adds to matches the files in dir whose names fit pattern, in the
// order ReadDir lists them, joined to dir; a dir that cannot be read or
// is no directory adds nothing.
func glob(dir ref string, pattern ref string, matches []string) Result<[]string, io.Error> {
	out := matches
	match Stat(dir) {
		Ok(fi) => {
			if !fi.IsDir() {
				return Ok(out)
			}
		},
		Err(_) => return Ok(out),
	}

	match ReadDir(dir) {
		Ok(entries) => {
			for _, e := range ref entries {
				if filepath.Match(pattern, e.Name())? {
					out.Push(filepath.Join(dir, e.Name()))
				}
			}
		},
		Err(_) => {},
	}

	return Ok(out)
}

// firstMeta returns where the first element of the pattern that holds
// a *, ? or [ starts, past the volume, or the pattern's length when
// none does.
func firstMeta(pattern ref string, volLen int) int {
	for i := volLen; i < pattern.Len(); i++ {
		if globMeta.IndexByte(pattern[i]).IsSome() {
			for i > volLen && !filepath.IsSeparator(pattern[i-1]) {
				i--
			}

			return i
		}
	}

	return pattern.Len()
}

// cleanGlobDir is the part of a pattern before its first element with a
// metacharacter, as Glob starts from it: the current directory for
// none, a root as it is, "/" and on Windows "C:\\", a drive alone as
// its current directory, "C:.", and any other without the separator it
// ends in, so that the matches are joined to it as written.
func cleanGlobDir(dir ref string) string {
	volLen := filepath.VolumeName(dir).Len()
	if dir.Len() == 0 {
		return ".".Clone()
	}

	if volLen+1 == dir.Len() && filepath.IsSeparator(dir[dir.Len()-1]) { // a root, with or without its drive
		return dir.Clone()
	}

	if volLen == dir.Len() { // a drive alone
		return dir + "."
	}

	return dir[0 : dir.Len()-1].Clone()
}

// tempUnder is the directory a temporary name is made under: dir, or
// the system's temporary directory when dir is empty.
func tempUnder(dir ref string) string {
	if dir.Len() == 0 {
		return TempDir()
	}

	return dir.Clone()
}

// tempParts splits a pattern into the prefix a temporary name starts
// with, the directory and the pattern up to its last *, joined with a
// separator unless the directory ends in one, and the suffix after the
// *, empty when the pattern has none; both are new strings.
func tempParts(under ref string, pattern ref string) (string, string) {
	star := pattern.Len()
	if i := pattern.LastIndexByte('*') {
		star = i
	}

	prefix := under.Clone()
	if under.Len() > 0 && !filepath.IsSeparator(under[under.Len()-1]) {
		prefix = prefix + string(filepath.Separator)
	}

	suffix := ""
	if star < pattern.Len() {
		suffix = pattern[star+1:].Clone()
	}

	return (prefix + pattern[0:star], suffix)
}

// tempName is one name to try: the prefix, a random number and the
// suffix.
func tempName(prefix ref string, suffix ref string) string {
	return prefix + fmt.Sprint(rand.Int()) + suffix
}

// tempFailed is the error of a temporary name that could not be made,
// with the error number code: a directory that is missing is reported
// by its stat, since the parent may be what is missing, and anything
// else by the pattern of the names tried, "open /tmp/up-*.bin: file
// exists".
func tempFailed(op string, under ref string, prefix ref string, suffix ref string, code int) io.Error {
	if code == enoent {
		var fi FileInfo
		if statInto(under, true, mut fi) == enoent {
			return io.Errno("stat", under, enoent)
		}
	}

	return io.Errno(op, ref (prefix + "*" + suffix), code)
}

// hasSeparator reports whether p holds a separator of the system's.
func hasSeparator(p ref string) bool {
	for i := 0; i < p.Len(); i++ {
		if filepath.IsSeparator(p[i]) {
			return true
		}
	}

	return false
}

// endsInCurrentDir reports whether the last element of p is ".", as in
// "." and "dir/.", and on Windows after a backslash too.
func endsInCurrentDir(p ref string) bool {
	n := p.Len()
	return n > 0 && p[n-1] == dotByte && (n == 1 || filepath.IsSeparator(p[n-2]))
}

// syscallError is the Error of a system call that was on no path,
// from the system's error number, worded with the call and the reason
// alone: "setenv: invalid argument".
func syscallError(op string, code int) io.Error {
	e := io.Errno(op, "", code)
	return io.NewError(e.Op.Clone(), "", e.Msg.Clone(), e.Kind())
}

// open opens path for reading and stores its descriptor in fd. The
// runtime provides it, as it does every function below; each that
// returns an int returns the system's error number, zero on success,
// and stores its results through its last parameters.
func open(path ref string, fd mut int) int

// create opens path for reading and writing, made 0666 before the
// umask when it does not exist and emptied when it does, and stores
// its descriptor in fd.
func create(path ref string, fd mut int) int

// readToString reads the file path whole into out, storing in inRead
// failedInRead when the read failed and 0 when the open did.
func readToString(path ref string, out mut string, inRead mut int) int

// removeAll removes path and all it holds; on a failure, failed holds
// the entry it failed on and op the call that failed.
func removeAll(path ref string, failed mut string, op mut string) int

// remove removes a file or an empty directory.
func remove(path ref string) int

// read reads from the descriptor fd into buf and stores how many bytes
// in n.
func read(fd int, buf mut []byte, n mut int) int

// write writes all of buf to the descriptor fd and stores in n how
// many bytes it wrote, all of them or those before a failure.
func write(fd int, buf ref []byte, n mut int) int

// writeString writes all of s to the descriptor fd, as write does.
func writeString(fd int, s ref string, n mut int) int

// pread reads from the descriptor fd at the offset off into buf, leaving
// the position where it was, and stores how many bytes in n.
func pread(fd int, buf mut []byte, off u64, n mut int) int

// pwrite writes all of buf to the descriptor fd at the offset off,
// leaving the position where it was, and stores in n how many bytes it
// wrote, all of them or those before a failure.
func pwrite(fd int, buf ref []byte, off u64, n mut int) int

// syncFile waits until the device holds what was written to fd.
func syncFile(fd int) int

// closeFile closes the descriptor fd.
func closeFile(fd int) int

// seek moves the position of fd by off from where whence says,
// seekSet, seekCur or seekEnd, and stores the new position in at.
func seek(fd int, whence int, off i64, at mut u64) int

// openFile opens path with the package's flags and the permissions
// perm, for a file it makes, and stores its descriptor in fd.
func openFile(path ref string, flag int, perm u32, fd mut int) int

// readFile reads the file path whole into out, storing in inRead
// failedInRead when the read failed and 0 when the open did.
func readFile(path ref string, out mut []byte, inRead mut int) int

// stat stores the size, the FileMode, the time of the last change in
// seconds and nanoseconds since 1970, and the device and file numbers
// of path, following a symbolic link when follow is set.
func stat(path ref string, follow bool, size mut i64, mode mut u32, sec mut i64, nsec mut i64, dev mut u64, ino mut u64) int

// readDir stores the entries of the directory path in out, each as
// the packedModeSize bytes of its FileMode, its name and a zero byte;
// on a failure, op names the call that failed.
func readDir(path ref string, out mut []byte, op mut string) int

// mkdir makes the directory path with the permissions perm.
func mkdir(path ref string, perm u32) int

// rename renames from to to, as the system does.
func rename(from ref string, to ref string) int

// getcwd stores the path of the current directory in out, as the
// system gives it.
func getcwd(out mut string) int

// chdir makes path the current directory.
func chdir(path ref string) int

// hostname stores the name the system gives the machine in out.
func hostname(out mut string) int

// lookupEnv stores the value of the environment variable key in value
// and reports whether it is set.
func lookupEnv(key ref string, value mut string) bool

// setenv sets the environment variable key to value, returning the
// system's error number for a key or a value it refuses.
func setenv(key ref string, value ref string) int

// environ fills out, a slice that holds nothing, with every variable
// of the environment as KEY=value.
func environ(out mut []string)

// chmod sets the mode of the file at path, its permission, setuid,
// setgid and sticky bits.
func chmod(path ref string, mode u32) int

// chtimes sets the time last read and the time last changed of the file
// at path, each when its flag is set, from seconds and nanoseconds
// since 1970.
func chtimes(path ref string, setAccess bool, asec i64, ansec i64, setChange bool, msec i64, mnsec i64) int

// truncate sets the size of the file at path, and ftruncate of the open
// file fd.
func truncate(path ref string, size i64) int

func ftruncate(fd int, size i64) int

// link makes to a hard link to from, and symlink makes link a symbolic
// link holding target.
func link(from ref string, to ref string) int

func symlink(target ref string, link ref string) int

// readlink stores the text of the symbolic link at path in out.
func readlink(path ref string, out mut string) int

// executable stores the path of the running program's file in out.
func executable(out mut string) int

// fstat is stat of the open file fd.
func fstat(fd int, size mut i64, mode mut u32, sec mut i64, nsec mut i64, dev mut u64, ino mut u64) int
