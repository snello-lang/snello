// The rules of a path on Linux and macOS: package path's, whose
// separator, a slash, is theirs.
package filepath

import ("io"; "path")

// listSeparatorRune separates the paths of a list, a colon.
const listSeparatorRune rune = ':'

// separatorRune is the separator of a Unix path.
const separatorRune rune = '/'

// slash is the separator as a byte, which IsSeparator compares with.
const slash byte = '/'

func clean(p ref string) string { return path.Clean(p) }

func split(p ref string) (ref string, ref string) { return path.Split(p) }

func join(a ref string, b ref string) string { return path.Join(a, b) }

func ext(p ref string) ref string { return path.Ext(p) }

func base(p ref string) ref string { return path.Base(p) }

func isAbs(p ref string) bool { return path.IsAbs(p) }

func dir(p ref string) string { return path.Dir(p) }

// volumeName is the empty string: a Unix path has no volume.
func volumeName(p ref string) ref string { return p[0:0] }

func isSeparator(c byte) bool { return c == slash }

func matchPattern(pattern ref string, name ref string) Result<bool, io.Error> { return path.Match(pattern, name) }

func splitList(list ref string) []string {
	if list.Len() == 0 {
		return []string{}
	}

	out := []string{}
	for dir := range list.Split(":") {
		out.Push(dir.Clone())
	}

	return out
}

func isLocal(p ref string) bool {
	if p.Len() == 0 || isAbs(p) {
		return false
	}

	return !escapes(ref clean(p))
}
