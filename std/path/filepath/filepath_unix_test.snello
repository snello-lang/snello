package filepath_test

import ("expect"; "path/filepath")

// TestUnix checks that every name answers as package path's does on
// Linux and macOS, whose own tests hold the rules, with no volume and a
// slash alone as the separator.
func TestUnix() {
	expect.Equal(ref filepath.Clean("/usr//lib/../bin/"), "/usr/bin")
	expect.Equal(ref filepath.Join("/usr", "lib/snello"), "/usr/lib/snello")
	expect.Equal(ref filepath.Dir("/usr/lib/snello"), "/usr/lib")
	expect.Equal(filepath.Base("/usr/lib/snello"), "snello")
	dir, file := filepath.Split("/tmp/notes.txt")
	expect.Equal(dir, "/tmp/")
	expect.Equal(file, "notes.txt")
	expect.True(filepath.IsAbs("/tmp"))
	expect.False(filepath.IsAbs("tmp"))
	expect.Equal(ref filepath.Separator, ref '/')
	expect.False(filepath.IsSeparator('\\'))
	expect.Equal(filepath.VolumeName("C:/x"), "")
	expect.Equal(ref filepath.Clean("a\\b"), "a\\b") // a backslash is a byte of a name
}

// TestUnixPatterns checks what a backslash is on Linux and macOS: a
// quote in a pattern, and a byte of a name; and that a colon separates
// a list.
func TestUnixPatterns() {
	expect.True(expect.IsOk(filepath.Match("\\*", "*")))
	expect.False(expect.IsOk(filepath.Match("\\*", "a")))
	expect.True(expect.IsOk(filepath.Match("a\\\\b", "a\\b"))) // a quoted backslash is one byte of the name
	expect.True(expect.IsOk(filepath.Match("a\\b", "ab")))       // a quoted b is a b
	expect.Equal(ref filepath.ListSeparator, ref ':')
	expect.EqualSlice(ref filepath.SplitList("/usr/bin:/bin::/sbin"), ref []string{"/usr/bin".Clone(), "/bin".Clone(), "".Clone(), "/sbin".Clone()})
	expect.Equal(ref filepath.ToSlash("a\\b"), "a\\b") // no separator to exchange
	expect.True(filepath.IsLocal("NUL"))                   // no name is reserved
	expect.True(filepath.IsLocal("a:b"))
}
