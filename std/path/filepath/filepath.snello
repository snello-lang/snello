// Package filepath works on the paths of files, with the separator the
// system uses: a slash on Linux and macOS, where its functions are
// package path's, and a backslash on Windows, which takes a slash as a
// separator too and begins a path with its volume, a drive's letter,
// C:, or a share, \\server\share. A program that means a file's path
// says filepath, and one that means a path in a URL says path, whose
// separator is a slash everywhere.
//
// Its functions read and build strings and ask the system nothing: a
// path is cleaned or split as written, whether or not it names a file;
// what asks the system of a path, its absolute form, its links
// resolved, the files under it or the files fitting a pattern, is
// package os's, Abs, EvalSymlinks, WalkDir and Glob. Base, Ext, Split
// and VolumeName lend parts of the path they are given, with nothing
// copied; Clean, Join, Dir, ToSlash and FromSlash return a new string.
package filepath

import "io"

// Separator is what the system puts between the elements of a path: a
// slash, and on Windows a backslash.
const Separator rune = separatorRune

// ListSeparator is what the system puts between the paths of a list,
// the PATH of the environment: a colon, and on Windows a semicolon.
const ListSeparator rune = listSeparatorRune


// Clean returns the shortest path that names what p names, read as
// written, with no link followed: several separators in a row become
// one, an element "." is dropped, an element ".." is dropped with the
// element before it, and ".." at the start of a rooted path is
// dropped. The result ends in a separator only when it is the root,
// and an empty result is ".". On Windows every separator becomes a
// backslash, and the volume stays as it is: a drive alone is that
// drive's current directory, "C:.". p is only read; the result is a new
// string:
//
//	filepath.Clean("/usr//lib/../bin/") // "/usr/bin"; on Windows "\\usr\\bin"
func Clean(p ref string) string {
	return clean(p)
}

// Split cuts p just after its last separator and returns the two
// parts, the directory with its separator and the file, as borrows of
// p with nothing copied, which live as long as p's borrow. A path with
// no separator has an empty directory, but on Windows its volume, and
// one that ends in a separator an empty file; "/tmp/notes.txt" gives
// "/tmp/" and "notes.txt":
//
//	dir, file := filepath.Split(ref p)
func Split(p ref string) (ref string, ref string) {
	return split(p)
}

// Join returns a and b joined with a separator between them, cleaned
// as Clean cleans a path; an empty one is left out, and two empty ones
// give an empty string. On Windows a drive alone takes b as it is,
// "C:" and "notes.txt" giving "C:notes.txt", the file in the drive's
// current directory. Both are only read; the result is a new string.
// More than two are joined two at a time:
//
//	filepath.Join("/usr", "lib/snello") // "/usr/lib/snello"
//	filepath.Join(ref filepath.Join(dir, "a"), "b")
func Join(a ref string, b ref string) string {
	return join(a, b)
}

// Ext returns the extension of p's last element: what follows its last
// dot, the dot included, or "" when the last element has no dot. It is
// a borrow of p, with nothing copied:
//
//	filepath.Ext("notes.txt") // ".txt"
func Ext(p ref string) ref string {
	return ext(p)
}

// Base returns the last element of p, the separators at its end left
// out, as a borrow of p with nothing copied: "." for an empty path, and
// the separator for a path of separators alone, or on Windows of its
// volume alone.
//
//	filepath.Base("/usr/lib/snello") // "snello"
func Base(p ref string) ref string {
	return base(p)
}

// IsAbs reports whether p is absolute: whether it starts at the root,
// with a separator; on Windows whether it starts at a drive's root,
// "C:\\", or is a share's or a device's path, "\\\\server\\share". A path
// that starts with a separator alone, "\\temp", is not absolute on
// Windows: it is on the current drive. p is only read.
func IsAbs(p ref string) bool {
	return isAbs(p)
}

// Dir returns all of p but its last element, cleaned as Clean cleans a
// path: "." when p has no separator, and the root for a path in the
// root; on Windows the volume stays in front. p is only read; the
// result is a new string.
//
//	filepath.Dir("/usr/lib/snello") // "/usr/lib"
func Dir(p ref string) string {
	return dir(p)
}

// VolumeName returns the volume p starts with, as a borrow of p: on
// Windows a drive's letter and colon, "C:", a share,
// "\\\\server\\share", or a device's path, "\\\\?\\C:"; the empty string
// on every other system, and for a path with no volume.
func VolumeName(p ref string) ref string {
	return volumeName(p)
}

// IsSeparator reports whether the byte c separates the elements of a
// path: a slash, and on Windows a backslash too.
func IsSeparator(c byte) bool {
	return isSeparator(c)
}

// Match reports whether name fits pattern, read as a shell reads one:
// a * stands for any run of characters but a separator, including
// none, a ? for any one character but a separator, a class in brackets
// for one of the characters listed or in a range, [a-c] for a, b or c,
// with a ^ after the bracket for one not listed; on Linux and macOS a
// backslash quotes
// the byte after it, so \* is a star, and on Windows, where a backslash
// separates, nothing quotes. The whole name must fit; a separator in
// the name fits only one in the pattern. Both are only read. A pattern
// that cannot be read, a class left open or a range with no end, is an
// error, "match a[: syntax error in pattern", whatever the name.
//
//	filepath.Match("*.go", "main.go")       // Ok(true)
//	filepath.Match("src/*", "src/a/b.go")   // Ok(false): the star stops at a separator
func Match(pattern ref string, name ref string) Result<bool, io.Error> {
	return matchPattern(pattern, name)
}

// SplitList splits a list of paths joined by ListSeparator, the PATH of
// the environment, into its paths, each a new string; an empty list is
// no paths, and an empty path in the list is kept, as the shell keeps
// it for the current directory. On Windows a path in double quotes may
// hold a semicolon, and loses the quotes. list is only read.
//
//	for _, dir := range ref filepath.SplitList(ref os.Getenv("PATH")) { ... }
func SplitList(list ref string) []string {
	return splitList(list)
}

// ToSlash returns p with every separator replaced by a slash, a new
// string; on Linux and macOS, whose separator is the slash, a copy of
// p. FromSlash is its inverse. Both are for a path that crosses
// systems, in a file or a message.
//
//	filepath.ToSlash("a\\b") // "a/b" on Windows
func ToSlash(p ref string) string {
	return replaced(p, byte(Separator), slash)
}

// FromSlash returns p with every slash replaced by the system's
// separator, a new string; on Linux and macOS a copy of p.
//
//	filepath.FromSlash("a/b") // "a\\b" on Windows
func FromSlash(p ref string) string {
	return replaced(p, slash, byte(Separator))
}

// IsLocal reports whether p names a file under the current directory
// alone, however it is read: it is not empty, not absolute, has no
// volume, and reaches no parent of the current directory through "..",
// read as Clean reads it, so "a/../b" is local and "a/../../b" is
// not; on Windows a path with a name the system reserves, "NUL" or
// "COM1", or with a colon, which names a stream, is not local either.
// p is only read. A program that joins a name it was given to a
// directory of its own checks it with IsLocal first.
//
//	filepath.IsLocal("docs/a.txt") // true
//	filepath.IsLocal("../secret")  // false
func IsLocal(p ref string) bool {
	return isLocal(p)
}

// replaced returns a copy of p with every byte that is from made to.
func replaced(p ref string, from byte, to byte) string {
	buf := make([]byte, p.Len())
	for i := 0; i < p.Len(); i++ {
		buf[i] = p[i]
		if buf[i] == from {
			buf[i] = to
		}
	}

	return string(buf)
}

// escapes reports whether the cleaned relative path p reaches above the
// current directory: whether it is "..", or starts with "../", the
// first element of a cleaned path being the only place ".." remains.
func escapes(cleaned ref string) bool {
	return cleaned == ".." || (cleaned.Len() > 2 && cleaned[0] == '.' && cleaned[1] == '.' && isSeparator(cleaned[2]))
}
