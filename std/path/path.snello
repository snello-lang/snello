// Package path works on paths whose elements are separated by slashes,
// as the paths in a URL are, with Go's functions of the same names:
// what a path's last element is, what directory it is in, what it is
// when two are joined, and what the shortest path naming the same
// place is. They read and build strings and ask the system nothing; a
// path that names a file on the system is path/filepath's, which is
// this package under the name Go gives it.
//
// Base, Ext and Split lend parts of the path they are given, with
// nothing copied. Clean, Join and Dir return a new string.
package path

// Clean returns the shortest path that names what p names, by Go's
// rules, applied until none applies:
//
//   - several slashes in a row become one;
//   - an element that is a single dot is dropped;
//   - an element that is two dots is dropped with the element before
//     it, when that is not two dots itself;
//   - two dots at the start of a path that starts with a slash are
//     dropped: /.. is /.
//
// The path ends in a slash only when it is the root, /, and an empty
// result is ".".
func Clean(p ref string) string {
	n := p.Len()
	if n == 0 {
		return "."
	}

	if isClean(p) { // most paths are clean already: one pass that writes nothing, and a copy
		return p.Clone()
	}

	// An element at a time into buf, which is never longer than what
	// was read of p, since every rule drops bytes and none adds any.
	rooted := p[0] == '/'
	buf := make([]byte, n)
	w := 0      // the bytes written
	dotdot := 0 // the output up to here is not gone back over: the root, and the two dots a path starts with
	if rooted {
		buf[0] = '/'
		w = 1
		dotdot = 1
	}

	r := 0
	for r < n {
		if p[r] == '/' { // an empty element
			r++
			continue
		}

		end := r + 1
		for end < n && p[end] != '/' {
			end++
		}

		if end-r == 1 && p[r] == '.' {
			// a single dot: dropped
		} else if end-r == 2 && p[r] == '.' && p[r+1] == '.' {
			if w > dotdot { // go back over the element before
				w--
				for w > dotdot && buf[w] != '/' {
					w--
				}
			} else if !rooted { // nothing to go back over: the two dots stay
				if w > 0 {
					buf[w] = '/'
					w++
				}

				buf[w] = '.'
				buf[w+1] = '.'
				w += 2
				dotdot = w
			}
		} else { // an element: a slash before it when it is not the first, then its bytes
			if w > dotdot || (!rooted && w != 0) {
				buf[w] = '/'
				w++
			}

			for k := r; k < end; k++ {
				buf[w] = p[k]
				w++
			}
		}

		r = end
	}

	if w == 0 {
		return "."
	}

	return string(buf[0:w])
}

// isClean reports whether Clean would return p as it is: no element is
// empty or a single dot, none is two dots but those a path that does
// not start with a slash begins with, and no slash ends it but the
// root's.
func isClean(p ref string) bool {
	n := p.Len()
	if n == 1 {
		return true
	}

	if p[n-1] == '/' {
		return false
	}

	r := 0
	leading := true // only elements of two dots so far, in a path that does not start with a slash
	if p[0] == '/' {
		r = 1
		leading = false
	}

	for r < n {
		if p[r] == '/' {
			return false
		}

		end := r + 1
		for end < n && p[end] != '/' {
			end++
		}

		if p[r] != '.' || end-r > 2 {
			leading = false
		} else if end-r == 1 {
			return false
		} else if p[r+1] != '.' {
			leading = false
		} else if !leading {
			return false
		}

		r = end + 1
	}

	return true
}

// Split cuts p just after its last slash and lends the two parts, the
// directory with its slash and the file: "a/b/c.txt" gives "a/b/" and
// "c.txt". A path with no slash has an empty directory.
func Split(p ref string) (ref string, ref string) {
	i := lastSlash(p)
	return (p[0:i+1], p[i+1:])
}

// Join joins two paths with a slash between them and cleans the result,
// as Go's Join does with its elements: an empty one is left out, and
// two empty ones give an empty string. Three are joined by joining two
// and then the third, path.Join(ref path.Join(a, b), c).
func Join(a ref string, b ref string) string {
	if a.Len() == 0 && b.Len() == 0 {
		return ""
	}

	if a.Len() == 0 {
		return Clean(b)
	}

	return Clean(ref (a + "/" + b)) // an empty b leaves a slash at the end, which Clean drops
}

// Ext lends the extension of p's last element: what follows its last
// dot, the dot included, ".txt", and nothing when it has no dot.
func Ext(p ref string) ref string {
	for i := p.Len() - 1; i >= 0 && p[i] != '/'; i-- {
		if p[i] == '.' {
			return p[i:]
		}
	}

	return ""
}

// Base lends the last element of p, the slashes at its end left out:
// "." for an empty path, and "/" for one of slashes alone.
func Base(p ref string) ref string {
	if p.Len() == 0 {
		return "."
	}

	end := p.Len()
	for end > 0 && p[end-1] == '/' {
		end--
	}

	if end == 0 {
		return "/"
	}

	return p[lastSlash(p[0:end])+1 : end]
}

// IsAbs reports whether p starts with a slash.
func IsAbs(p ref string) bool {
	return p.Len() > 0 && p[0] == '/'
}

// Dir returns all of p but its last element, cleaned: "a/b" for
// "a/b/c.txt", "." when p has no slash, and "/" for a path in the root.
func Dir(p ref string) string {
	// What is before the last slash, without the slashes that end it,
	// which Clean would drop: so a directory that is clean already is
	// copied and no more.
	end := lastSlash(p) + 1
	if end == 0 {
		return "."
	}

	for end > 0 && p[end-1] == '/' {
		end--
	}

	if end == 0 {
		return "/"
	}

	return Clean(p[0:end])
}

// lastSlash returns the index of the last slash of p, or -1.
func lastSlash(p ref string) int {
	for i := p.Len() - 1; i >= 0; i-- {
		if p[i] == '/' {
			return i
		}
	}

	return -1
}
