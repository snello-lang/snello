// Package testing runs a package's tests, the functions named Test in
// its _test.snello files, which snello test builds with a generated
// main that calls Main (_docs/design/09-testing.md). A test is a plain
// function: it passes when it returns, and a failed expectation is a
// panic, which Main catches at the test's boundary and reports with
// its message. Each test runs in a task of its own; one that calls
// Parallel runs beside the other parallel tests after the sequential
// ones, its lines held until it ends. A benchmark is a function named
// Benchmark looping over Loop, run under -bench. It is imported by
// test files alone: nothing of a test reaches a program's binary.
package testing

import ("fmt"; "os"; "sync"; "time")

// A Test is a test by name and function, what the generated main lists;
// a benchmark is listed the same way.
struct Test {
	Name string
	F    func()
}

// A Dir is a directory a test owns, made by TempDir and removed with
// everything in it when the value goes out of scope.
struct Dir impl Drop {
	path string
}

// Path is the directory's path.
func (d ref Dir) Path() ref string { return ref d.path }

// Join is the path of name inside the directory.
func (d ref Dir) Join(name ref string) string { return d.path.Clone() + "/" + name }

func (d mut Dir) Drop() {
	_ = os.RemoveAll(ref d.path)
}

// TempDir makes a directory for the test, under the system's directory
// for such, which its Drop removes.
func TempDir() Dir {
	return Dir{path: os.MkdirTemp("", "snello-test-*").Expect("TempDir")}
}

// A State is one running test's: its name, with its subtests' after a
// /, the lines it logged, whether it failed, whether Skip ended it and
// why, whether it runs in parallel, the lines it printed while it did,
// held until it ends so that parallel tests' lines never mix, and its
// round's channels, the one it reports on and the gate a parallel test
// waits at. A task that is no test's has no State, and so no round to
// report to.
struct State {
	name     string
	logged   string
	failed   bool
	skipped  bool
	reason   string
	parallel bool
	held     string
	done     chan Result
	gate     chan ()
}

// A Result is what a test's task tells Main as it ends, or as it
// turns parallel: its name, whether it passed, and the lines it held.
struct Result {
	name     string
	passed   bool
	parallel bool
	held     string
}

// The registry: a state per running test, by the task it runs on, in a
// lock, as a package variable every task changes must be; it is made on
// first use, since its initializer is a call.
struct Registry {
	states map[int]State
}

var reg = sync.NewMutex(Registry{states: map[int]State{}})

// The flags, as Main read them, stored once before any test runs and
// read by the tests: a configuration, which is what an Atomic holds.
struct Config impl Eq, Clone {
	verbose  bool
	short    bool
	update   bool
	failfast bool
}

var cfg = sync.NewAtomic(Config{verbose: false, short: false, update: false, failfast: false})

// Short reports whether -short was given, for a test to skip its long
// part.
func Short() bool { return cfg.Load().short }

// Update reports whether -update was given, for expect.Golden to write
// the file instead of comparing with it.
func Update() bool { return cfg.Load().update }

func verbose() bool { return cfg.Load().verbose }

func failfast() bool { return cfg.Load().failfast }

// with runs f on the running test's state, under the registry's lock.
func with(f func(st mut State)) {
	g := reg.Lock()
	if st := g.Get().states.GetMut(ref task()) {
		f(st)
	}
}

// say prints a line of the running test's report, or holds it when
// the test runs in parallel.
func say(line ref string) {
	held := false
	with(func(st mut State) {
		if st.parallel {
			st.held += line + "\n"
			held = true
		}
	})
	if !held {
		fmt.Println(line)
	}
}

// Log records a line, with the file and line it was logged from,
// printed under the test's result when it fails or when snello test
// -v is given.
func Log(line ref string) {
	with(func(st mut State) { st.logged += "    " + where() + ": " + line + "\n" })
}

// Logf records a line formatted as fmt.Sprintf formats it. The
// compiler provides it.
func Logf(format ref string, args ...ref any)

// Skip ends the test as skipped, with the reason.
func Skip(why ref string) {
	with(func(st mut State) {
		st.skipped = true
		st.reason = where() + ": " + why
	})
	panic("skip")
}

// Parallel says the test runs beside the other parallel tests of the
// package, after the sequential ones: the test waits here until they
// are done, and Main goes on to the next test meanwhile. It reports
// whether it did: false, changing nothing, when the test runs in
// parallel already, since a second notice would stand in for the
// test's result, or when it is called on a task that is no test's own,
// one a test spawned or a benchmark's, which has no round to tell. The
// channels are taken under the registry's lock and used outside it,
// since a send or a receive may wait, and nothing waits while holding
// the registry.
func Parallel() bool {
	var notice (string, chan Result, chan ())?
	with(func(st mut State) {
		if !st.parallel {
			st.parallel = true
			notice = Some((st.name.Clone(), st.done.Clone(), st.gate.Clone()))
		}
	})
	if (name, done, gate) := notice {
		done <- Result{name: name, passed: true, parallel: true, held: ""}
		<-gate
		return true
	}

	return false
}

// Run runs f as a subtest named after the running test, Parent/name,
// reported on its own: a failure in it ends the subtest and marks the
// test failed, and the test goes on with its next case. The test's
// own lines and state are kept aside while the subtest runs.
func Run(name ref string, f func()) {
	parent := ""
	parentLogged := ""
	parentFailed := false
	with(func(st mut State) {
		parent = st.name.Clone()
		parentLogged = st.logged.Clone()
		parentFailed = st.failed
		st.name = parent.Clone() + "/" + name
		st.failed = false
		st.logged = ""
	})
	ok := run(f)
	with(func(st mut State) {
		st.name = parent.Clone()
		st.logged = parentLogged.Clone()
		st.failed = parentFailed || !ok
	})
}

// run runs f as the running test and reports its result, printing it,
// and returns whether it passed or was skipped; a test whose subtest
// failed has failed.
func run(f func()) bool {
	name := ""
	with(func(st mut State) {
		name = st.name.Clone()
		st.skipped = false
		st.logged = ""
	})
	if verbose() {
		say(ref ("=== RUN   " + name))
	}

	start := time.Now()
	msg := Catch(f)
	took := fmt.Sprintf("(%.2fs)", time.Since(start).Seconds())
	failed := false
	skipped := false
	reason := ""
	logged := ""
	with(func(st mut State) {
		failed = st.failed
		skipped = st.skipped
		reason = st.reason.Clone()
		logged = st.logged.Clone()
	})
	match msg {
		None => {
			if failed {
				say(ref ("--- FAIL: " + name + " " + took))
				sayLogged(ref logged)
				return false
			}

			if verbose() {
				say(ref ("--- PASS: " + name + " " + took))
				sayLogged(ref logged)
			}

			return true
		},
		Some(m) => {
			if skipped {
				say(ref ("--- SKIP: " + name + " " + took))
				sayLogged(ref logged)
				say(ref ("    " + reason))
				return true
			}

			say(ref ("--- FAIL: " + name + " " + took))
			sayLogged(ref logged)
			say(ref ("    " + m))
			return false
		},
	}
}

func sayLogged(logged ref string) {
	for line := range logged.Lines() {
		if line.Len() > 0 {
			say(line)
		}
	}
}

// runTest is a test's task: it registers the test's state, with its
// round's channels, runs it, and reports the result with the lines
// held.
func runTest(t Test, done chan Result, gate chan ()) {
	id := task()
	register(id, ref t.Name, done.Clone(), gate)
	passed := run(t.F)
	held := unregister(id)
	done <- Result{name: t.Name.Clone(), passed: passed, parallel: false, held: held}
}

// register and unregister keep the state of the test running on the
// task id, under the registry's lock; unregister returns the lines the
// test held.
func register(id int, name ref string, done chan Result, gate chan ()) {
	g := reg.Lock()
	r := g.Get()
	r.states[id] = State{name: name.Clone(), logged: "", failed: false, skipped: false, reason: "", parallel: false, held: "", done: done, gate: gate}
}

func unregister(id int) string {
	g := reg.Lock()
	r := g.Get()
	if st := r.states.Remove(ref id) {
		return st.held
	}

	return ""
}

// watchdog ends the program when the tests take longer than d.
func watchdog(d time.Duration) {
	time.Sleep(d)
	fmt.Fprintln(mut os.Stderr(), "panic: tests timed out after", d)
	os.Exit(2)
}

// Loop is the loop of a benchmark, for testing.Loop() { ... }: it
// counts the iterations the runner asked for, timing them, and is
// false once they are done. The benchmark's state, one at a time, is
// the runtime's (runtime/c/testing.c), so that the loop costs one call
// and no lock.
func Loop() bool {
	return benchLoop()
}

// ResetTimer forgets the time and the allocations counted so far,
// after a benchmark's setup.
func ResetTimer() {
	benchReset()
}

// ReportAllocs asks the benchmark's line for its bytes and allocations
// per operation.
func ReportAllocs() {
	benchReport()
}

// runBench runs a benchmark for a count the runner raises until a run
// takes a second, and prints its line: the name, the count, ns/op,
// and with ReportAllocs B/op and allocs/op; a benchmark that fails an
// expectation is reported as a test is, and counts as one failure.
func runBench(b ref Test) int {
	n := 1
	for {
		benchStart(n)
		if msg := Catch(b.F) {
			fmt.Println("--- FAIL: " + b.Name)
			fmt.Println("    " + msg)
			return 1
		}

		if benchNanos() >= 1000000000 || n >= 1000000000 {
			break
		}

		per := benchNanos() / i64(n)
		if per <= 0 {
			per = 1
		}

		next := i64(1200000000) / per
		if next < i64(n)*2 {
			next = i64(n) * 2
		}

		if next > i64(n)*100 {
			next = i64(n) * 100
		}

		n = int(next)
	}

	per := f64(benchNanos()) / f64(n)
	line := fmt.Sprintf("%-24s %10d %12.0f ns/op", b.Name, n, per)
	if per < 100 { // Go prints the decimals of a small cost
		line = fmt.Sprintf("%-24s %10d %12.2f ns/op", b.Name, n, per)
	}

	if benchReported() {
		line += fmt.Sprintf(" %8d B/op %8d allocs/op", benchBytes()/n, benchAllocs()/n)
	}

	fmt.Println(line)
	return 0
}

// next is a random number for -shuffle, an xorshift over the seed.
func next(seed mut i64) i64 {
	*seed ^= *seed << 13
	*seed ^= *seed >> 7
	*seed ^= *seed << 17
	if *seed < 0 {
		return -*seed
	}

	return *seed
}

// Main runs the tests of the package named pkg, as the generated main
// calls it, and exits with 0 when every one passed and 1 otherwise. It
// reads the program's arguments: -v prints every test's lines, -run
// NAME runs the tests whose name holds NAME, -bench NAME the benchmarks
// whose name holds NAME, -count N runs the tests N times, -failfast
// stops at the first failure, -timeout D ends the program after D,
// -shuffle runs the tests in a random order, -short is for the tests
// to ask, and -update is for expect.Golden to write its files.
func Main(pkg ref string, tests []Test) {
	only := ""
	bench := ""
	count := 1
	timeout := time.Duration(0)
	shuffle := false
	flags := Config{verbose: false, short: false, update: false, failfast: false}
	for i := 1; i < len(os.Args); i++ {
		arg := ref os.Args[i]
		more := i+1 < len(os.Args)
		if arg == "-v" {
			flags.verbose = true
		} else if arg == "-short" {
			flags.short = true
		} else if arg == "-update" {
			flags.update = true
		} else if arg == "-failfast" {
			flags.failfast = true
		} else if arg == "-shuffle" {
			shuffle = true
		} else if arg == "-run" && more {
			only = os.Args[i+1].Clone()
			i += 1
		} else if arg == "-bench" && more {
			bench = os.Args[i+1].Clone()
			i += 1
		} else if arg == "-count" && more {
			count = number(ref os.Args[i+1], "-count")
			i += 1
		} else if arg == "-timeout" && more {
			timeout = time.Duration(number(ref os.Args[i+1], "-timeout")) * time.Second
			i += 1
		}
	}

	setFlags(flags)
	if timeout > 0 {
		spawn watchdog(timeout)
	}

	seed := i64(0)
	if shuffle {
		seed = time.Now().UnixNano()
		if seed == 0 {
			seed = 1
		}

		fmt.Println("-shuffle", seed)
	}

	start := time.Now()
	failures := 0
	for c := 0; c < count && (failures == 0 || !failfast()); c++ {
		order := make([]int, 0, len(tests))
		for i := 0; i < len(tests); i++ {
			order.Push(i)
		}

		if shuffle {
			for i := len(order) - 1; i > 0; i-- {
				j := int(next(mut seed) % i64(i+1))
				order.Swap(i, j)
			}
		}

		failures += round(ref tests, ref order, ref only)
	}

	if bench != "" {
		for _, b := range ref tests {
			if b.Name.HasPrefix("Benchmark") && (bench == "." || b.Name.Contains(ref bench)) {
				failures += runBench(b)
			}
		}
	}

	took := fmt.Sprintf("%.3fs", time.Since(start).Seconds())
	if failures > 0 {
		fmt.Println("FAIL")
		fmt.Println("FAIL\t" + pkg + "\t" + took)
		os.Exit(1)
	}

	if verbose() {
		fmt.Println("PASS")
	}

	fmt.Println("ok  \t" + pkg + "\t" + took)
}

// round runs every test once, in the order given: each in a task of
// its own, the sequential ones one at a time, the parallel ones
// together after them, and returns how many failed.
func round(tests ref []Test, order ref []int, only ref string) int {
	done := make(chan Result, len(tests)) // room for every test's report, so that no task waits to report
	gate := make(chan (), 0)              // closed once the sequential tests are done: the parallel ones wait at it
	failures := 0
	waiting := 0
	for _, i := range order {
		t := ref tests[i]
		if !t.Name.HasPrefix("Test") || (only.Len() > 0 && only != "." && !t.Name.Contains(only)) {
			continue
		}

		if failures > 0 && failfast() {
			break
		}

		spawn runTest(Test{Name: t.Name.Clone(), F: t.F}, done.Clone(), gate.Clone())
		if r := <-done {
			if r.parallel {
				waiting += 1
			} else if !r.passed {
				failures += 1
			}
		}
	}

	close(gate)
	for ; waiting > 0; waiting-- {
		if r := <-done {
			fmt.Printf("%s", r.held)
			if !r.passed {
				failures += 1
			}
		}
	}

	return failures
}

// setFlags records the flags, before any test runs.
func setFlags(flags Config) {
	cfg.Store(flags)
}

// number reads a flag's value as a count, ending the program with
// exit code 2 when it is not one, as a flag parser does.
func number(s ref string, flag ref string) int {
	n := 0
	for i := 0; i < s.Len(); i++ {
		d := s[i]
		if d < '0' || d > '9' {
			fmt.Fprintf(mut os.Stderr(), "invalid value %q for %s\n", s, flag)
			os.Exit(2)
		}

		n = n*10 + int(d-'0')
	}

	return n
}

// Catch runs f on the current task and returns the message of the
// panic that ended it, or None when f returned. The values with a Drop
// method f made before the panic are dropped as a panic drops them;
// what the caller holds is untouched. It is what Main catches a failed
// test with and what expect.Panics is built on; a program has no use
// for it, since a panic is a bug and not an error. The compiler
// provides it.
func Catch(f func()) string?

// The runtime provides these: the place of the call being made,
// file:line, which the compiler hands it before every call of Log,
// Logf and Skip and it keeps for the running task; the running task's
// identity; and the benchmark's state, one benchmark at a time
// (runtime/c/testing.c).
func where() string
func task() int
func benchStart(n int)
func benchLoop() bool
func benchReset()
func benchReport()
func benchNanos() i64
func benchAllocs() int
func benchBytes() int
func benchReported() bool
