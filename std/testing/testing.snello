// Package testing runs a package's tests, the functions named Test in
// its _test.snello files, which snello test builds with a generated
// main that calls Main. A test is a plain function: it passes when it
// returns, and a failed expectation is a panic, which Main catches at
// the test's boundary and reports with its message. Each test runs in
// a task of its own; one that calls Parallel runs beside the other
// parallel tests after the sequential ones, its lines held until it
// ends. A benchmark is a function named Benchmark looping over Loop,
// run under -bench. It is imported by test files alone: nothing of a
// test reaches a program's binary.
//
//	func TestSum() {
//		expect.Equal(ref sum(ref []int{1, 2, 3}), ref 6)
//	}
//
//	func BenchmarkSum() {
//		xs := []int{1, 2, 3}
//		for testing.Loop() { _ = sum(ref xs) }
//	}
package testing

import ("fmt"; "os"; "sync"; "time")

// The prefixes of a test's report lines: its start under -v, and its
// result.
const runPrefix = "=== RUN   "
const passPrefix = "--- PASS: "
const failPrefix = "--- FAIL: "
const skipPrefix = "--- SKIP: "

// logIndent sets a logged line, a failure's message and a skip's
// reason under the result line they belong to.
const logIndent = "    "

// The prefixes that make a function of a test file a test or a
// benchmark, and the pattern of -run and -bench that selects every
// one of them.
const testPrefix = "Test"
const benchmarkPrefix = "Benchmark"
const matchAll = "."

// The flags Main reads from the program's arguments.
const flagVerbose = "-v"
const flagShort = "-short"
const flagUpdate = "-update"
const flagFailFast = "-failfast"
const flagShuffle = "-shuffle"
const flagRun = "-run"
const flagBench = "-bench"
const flagCount = "-count"
const flagTimeout = "-timeout"

// skipMessage is the message of the panic Skip ends a test with, which
// the test's State marks as a skip rather than a failure.
const skipMessage = "skip"

// tempDirPattern names the directories TempDir makes, its * replaced
// by a part of the system's choosing that makes the name unique.
const tempDirPattern = "snello-test-*"

// The exit statuses of a test binary: 1 when a test failed, and 2 when
// the run itself could not go on, a flag's value that is no count or a
// timeout.
const exitFailed = 1
const exitBadRun = 2

// How long a benchmark runs: its count of iterations is raised until a
// run takes benchmarkTime, a second in nanoseconds, or reaches
// maxIterations. Each new count aims at benchmarkAim, a little past
// the second so that the next run is likely the last, and grows from
// the last count by minGrowth times at least and maxGrowth times at
// most. A cost per operation below decimalsBelow nanoseconds is
// printed with two decimals.
const benchmarkTime i64 = 1_000_000_000
const maxIterations int = 1_000_000_000
const benchmarkAim i64 = 1_200_000_000
const minGrowth i64 = 2
const maxGrowth i64 = 100
const decimalsBelow f64 = 100

// registry is the state of every running test, by the task it runs on,
// in a lock, as a package variable every task changes must be; it is
// made on first use, since its initializer is a call.
var registry = sync.NewMutex(Registry{states: map[int]State{}})

// config is the flags, as Main read them, stored once before any test
// runs and read by the tests: a configuration, which is what an Atomic
// holds.
var config = sync.NewAtomic(Config{verbose: false, short: false, update: false, failfast: false})

// A Test is a test by name and function, what the generated main
// lists; a benchmark is listed the same way. Name is the function's
// name, TestSum or BenchmarkSum, and F the function, which takes
// nothing and returns nothing.
struct Test {
	Name string
	F    func()
}

// A Dir is a directory a test owns, made by TempDir and removed with
// everything in it when the value goes out of scope.
struct Dir impl Drop {
	path string
}

// A State is one running test's: its name, with its subtests' after a
// /, the lines it logged, whether it failed, whether Skip ended it and
// why, whether it runs in parallel, the lines it printed while it did,
// held until it ends so that parallel tests' lines never mix, and its
// round's channels, the one it reports on and the gate a parallel test
// waits at. A task that is no test's has no State, and so no round to
// report to.
struct State {
	name     string
	logged   string
	failed   bool
	skipped  bool
	reason   string
	parallel bool
	held     string
	done     chan Result
	gate     chan ()
}

// A Result is what a test's task tells Main as it ends, or as it
// turns parallel: its name, whether it passed, whether it turned
// parallel, and the lines it held.
struct Result {
	name     string
	passed   bool
	parallel bool
	held     string
}

// A Registry is the state of each running test, by the identity of the
// task it runs on.
struct Registry {
	states map[int]State
}

// A Config is the flags Main read: -v, -short, -update and -failfast.
struct Config impl Eq, Clone {
	verbose  bool
	short    bool
	update   bool
	failfast bool
}

// TempDir makes a new, empty directory for the test, under the
// system's directory for temporary files, with a name no other run
// shares, and returns it owned: the Dir's Drop removes the directory
// and everything in it when the test lets go of it. A directory that
// cannot be made fails the test.
//
//	dir := testing.TempDir()
//	path := dir.Join("data.txt")
func TempDir() Dir {
	return Dir{path: os.MkdirTemp("", tempDirPattern).Expect("TempDir")}
}

// Path returns the directory's path, lent for as long as the Dir is.
func (d ref Dir) Path() ref string { return ref d.path }

// Join returns the path of name inside the directory, d's path, a /
// and name, as a new string the caller owns. It only builds the path:
// nothing is made on disk.
func (d ref Dir) Join(name ref string) string { return d.path.Clone() + "/" + name }

// Drop removes the directory and everything in it. It runs when the
// Dir goes out of scope, a panic included; a failure to remove is not
// reported, since a test's result does not hang on it.
func (d mut Dir) Drop() {
	_ = os.RemoveAll(ref d.path)
}

// Short reports whether -short was given, for a test to skip its long
// part.
//
//	if testing.Short() { testing.Skip("long") }
func Short() bool { return config.Load().short }

// Update reports whether -update was given, for expect.Golden to write
// its file instead of comparing with it.
func Update() bool { return config.Load().update }

// Log records line, lent, with the file and line it was logged from,
// to be printed under the test's result when the test fails, or under
// snello test -v. On a task that is no test's, one a test spawned, it
// does nothing.
//
//	testing.Log("connected")
func Log(line ref string) {
	runOnState(func(st mut State) { st.logged += logIndent + where() + ": " + line + "\n" })
}

// Logf records a line formatted as fmt.Sprintf formats it, as Log
// records one: the format is a string literal or a constant, checked
// against the arguments when the test is compiled, and the arguments
// are lent. The compiler provides it.
//
//	testing.Logf("read %d bytes", n)
func Logf(format ref string, args ...ref any)

// Skip ends the test as skipped, with the reason why, lent, which is
// printed with the place of the call: the test counts as passed, and
// nothing after the call runs. It never returns.
//
//	testing.Skip("needs a network")
func Skip(why ref string) {
	runOnState(func(st mut State) {
		st.skipped = true
		st.reason = where() + ": " + why
	})

	panic(skipMessage)
}

// Parallel says the test runs beside the other parallel tests of the
// package, after the sequential ones: the test waits here until they
// are done, and Main goes on to the next test meanwhile. Its lines are
// held until it ends, so that two tests' lines never mix. It reports
// whether it did: false, changing nothing, when the test runs in
// parallel already, since a second notice would stand in for the
// test's result, or when it is called on a task that is no test's own,
// one a test spawned or a benchmark's, which has no round to tell.
//
//	func TestSlow() {
//		testing.Parallel()
//		...
//	}
func Parallel() bool {
	// The channels are taken under the registry's lock and used outside
	// it, since a send or a receive may wait, and nothing waits while
	// holding the registry.
	var notice (string, chan Result, chan ())?
	runOnState(func(st mut State) {
		if !st.parallel {
			st.parallel = true
			notice = Some((st.name.Clone(), st.done.Clone(), st.gate.Clone()))
		}
	})

	if (name, done, gate) := notice {
		done <- Result{name: name, passed: true, parallel: true, held: ""}
		<-gate
		return true
	}

	return false
}

// Run runs f as a subtest of the running test, named Parent/name, and
// reports it on its own line: a failure in it ends the subtest and
// marks the test failed, and the test goes on with its next case. The
// test's own lines and state are kept aside while the subtest runs and
// restored after it; name is lent.
//
//	for _, c := range ref cases {
//		testing.Run(ref c.name, func() { check(c) })
//	}
func Run(name ref string, f func()) {
	parent := ""
	parentLogged := ""
	parentFailed := false
	runOnState(func(st mut State) {
		parent = st.name.Clone()
		parentLogged = st.logged.Clone()
		parentFailed = st.failed
		st.name = parent.Clone() + "/" + name
		st.failed = false
		st.logged = ""
	})

	ok := runAndReport(f)
	runOnState(func(st mut State) {
		st.name = parent.Clone()
		st.logged = parentLogged.Clone()
		st.failed = parentFailed || !ok
	})
}

// Loop is the loop of a benchmark, for testing.Loop() { ... }: it
// counts the iterations the runner asked for, timing them, and is
// false once they are done. The benchmark's state, one benchmark at a
// time, is the runtime's, so that the loop costs one call and no lock.
//
//	for testing.Loop() { _ = parse(ref text) }
func Loop() bool {
	return benchLoop()
}

// ResetTimer forgets the time and the allocations counted so far, so
// that a benchmark's setup before its loop is not counted.
func ResetTimer() {
	benchReset()
}

// ReportAllocs asks for the benchmark's line to show its bytes and
// allocations per operation, B/op and allocs/op, besides its time.
func ReportAllocs() {
	benchReport()
}

// Main runs the tests of the package named pkg, lent, from the list
// tests, which it takes, as the generated main calls it, and exits with
// status 0 when every one passed and 1 otherwise, after a line that
// says which, with the time the run took. It reads the program's
// arguments: -v prints every test's lines, -run NAME runs the tests
// whose name holds NAME, -bench NAME the benchmarks whose name holds
// NAME, . for all, -count N runs the tests N times, -failfast stops at
// the first failure, -timeout D ends the program after D seconds,
// -shuffle runs the tests in a random order, which it prints the seed
// of, -short is for the tests to ask, and -update is for expect.Golden
// to write its files. A flag's value that is no count ends the program
// with status 2.
func Main(pkg ref string, tests []Test) {
	only := ""
	bench := ""
	count := 1
	timeout := time.Duration(0)
	shuffle := false
	flags := Config{verbose: false, short: false, update: false, failfast: false}
	for i := 1; i < len(os.Args); i++ {
		arg := ref os.Args[i]
		hasValue := i+1 < len(os.Args)
		if arg == flagVerbose {
			flags.verbose = true
		} else if arg == flagShort {
			flags.short = true
		} else if arg == flagUpdate {
			flags.update = true
		} else if arg == flagFailFast {
			flags.failfast = true
		} else if arg == flagShuffle {
			shuffle = true
		} else if arg == flagRun && hasValue {
			only = os.Args[i+1].Clone()
			i += 1
		} else if arg == flagBench && hasValue {
			bench = os.Args[i+1].Clone()
			i += 1
		} else if arg == flagCount && hasValue {
			count = parseCount(ref os.Args[i+1], flagCount)
			i += 1
		} else if arg == flagTimeout && hasValue {
			timeout = time.Duration(parseCount(ref os.Args[i+1], flagTimeout)) * time.Second
			i += 1
		}
	}

	setFlags(flags)
	if timeout > 0 {
		spawn exitAfter(timeout)
	}

	seed := i64(0)
	if shuffle {
		seed = time.Now().UnixNano()
		if seed == 0 {
			seed = 1
		}

		fmt.Println(flagShuffle, seed)
	}

	start := time.Now()
	failures := 0
	for c := 0; c < count && (failures == 0 || !isFailFast()); c++ {
		order := make([]int, 0, len(tests))
		for i := 0; i < len(tests); i++ {
			order.Push(i)
		}

		if shuffle {
			for i := len(order) - 1; i > 0; i-- {
				j := int(nextRandom(mut seed) % i64(i+1))
				order.Swap(i, j)
			}
		}

		failures += runRound(ref tests, ref order, ref only)
	}

	if bench != "" {
		for _, b := range ref tests {
			if b.Name.HasPrefix(benchmarkPrefix) && (bench == matchAll || b.Name.Contains(ref bench)) {
				failures += runBenchmark(b)
			}
		}
	}

	took := fmt.Sprintf("%.3fs", time.Since(start).Seconds())
	if failures > 0 {
		fmt.Println("FAIL")
		fmt.Println("FAIL\t" + pkg + "\t" + took)
		os.Exit(exitFailed)
	}

	if isVerbose() {
		fmt.Println("PASS")
	}

	fmt.Println("ok  \t" + pkg + "\t" + took)
}

// Catch runs f on the current task and returns the message of the
// panic that ended it, or None when f returned. The values with a Drop
// method f made before the panic are dropped as a panic drops them;
// what the caller holds is untouched. It is what Main catches a failed
// test with and what expect.Panics is built on; a program has no use
// for it, since a panic is a bug and not an error. The compiler
// provides it.
//
//	msg := testing.Catch(func() { panic("boom") }) // Some("boom")
func Catch(f func()) string?

// isVerbose reports whether -v was given.
func isVerbose() bool { return config.Load().verbose }

// isFailFast reports whether -failfast was given.
func isFailFast() bool { return config.Load().failfast }

// runOnState runs f on the running test's state, under the registry's
// lock, and does nothing on a task that is no test's.
func runOnState(f func(st mut State)) {
	g := registry.Lock()
	if st := g.Get().states.GetMut(ref task()) {
		f(st)
	}
}

// reportLine prints a line of the running test's report, or holds it
// when the test runs in parallel.
func reportLine(line ref string) {
	held := false
	runOnState(func(st mut State) {
		if st.parallel {
			st.held += line + "\n"
			held = true
		}
	})

	if !held {
		fmt.Println(line)
	}
}

// runAndReport runs f as the running test and reports its result,
// printing it, and returns whether it passed or was skipped; a test
// whose subtest failed has failed.
func runAndReport(f func()) bool {
	name := ""
	runOnState(func(st mut State) {
		name = st.name.Clone()
		st.skipped = false
		st.logged = ""
	})

	if isVerbose() {
		reportLine(ref (runPrefix + name))
	}

	start := time.Now()
	msg := Catch(f)
	took := fmt.Sprintf("(%.2fs)", time.Since(start).Seconds())
	failed := false
	skipped := false
	reason := ""
	logged := ""
	runOnState(func(st mut State) {
		failed = st.failed
		skipped = st.skipped
		reason = st.reason.Clone()
		logged = st.logged.Clone()
	})

	match msg {
		None => {
			if failed {
				reportLine(ref (failPrefix + name + " " + took))
				reportLogged(ref logged)
				return false
			}

			if isVerbose() {
				reportLine(ref (passPrefix + name + " " + took))
				reportLogged(ref logged)
			}

			return true
		},
		Some(m) => {
			if skipped {
				reportLine(ref (skipPrefix + name + " " + took))
				reportLogged(ref logged)
				reportLine(ref (logIndent + reason))
				return true
			}

			reportLine(ref (failPrefix + name + " " + took))
			reportLogged(ref logged)
			reportLine(ref (logIndent + m))
			return false
		},
	}
}

// reportLogged reports each line a test logged, leaving out the empty
// ones.
func reportLogged(logged ref string) {
	for line := range logged.Lines() {
		if line.Len() > 0 {
			reportLine(line)
		}
	}
}

// runTest is a test's task: it registers the test's state, with its
// round's channels, runs it, and reports the result with the lines
// held.
func runTest(t Test, done chan Result, gate chan ()) {
	id := task()
	register(id, ref t.Name, done.Clone(), gate)
	passed := runAndReport(t.F)
	held := unregister(id)
	done <- Result{name: t.Name.Clone(), passed: passed, parallel: false, held: held}
}

// register keeps the state of the test named name running on the task
// id, with its round's channels, under the registry's lock.
func register(id int, name ref string, done chan Result, gate chan ()) {
	g := registry.Lock()
	r := g.Get()
	r.states[id] = State{name: name.Clone(), logged: "", failed: false, skipped: false, reason: "", parallel: false, held: "", done: done, gate: gate}
}

// unregister drops the state of the test running on the task id, under
// the registry's lock, and returns the lines the test held.
func unregister(id int) string {
	g := registry.Lock()
	r := g.Get()
	if st := r.states.Remove(ref id) {
		return st.held
	}

	return ""
}

// exitAfter ends the program, with status 2 and a message, when the
// tests take longer than d.
func exitAfter(d time.Duration) {
	time.Sleep(d)
	fmt.Fprintln(mut os.Stderr(), "panic: tests timed out after", d)
	os.Exit(exitBadRun)
}

// runBenchmark runs a benchmark for a count the runner raises until a
// run takes a second, and prints its line: the name, the count, ns/op,
// and with ReportAllocs B/op and allocs/op; a benchmark that fails an
// expectation is reported as a test is, and counts as one failure.
func runBenchmark(b ref Test) int {
	n := 1
	for {
		benchStart(n)
		if msg := Catch(b.F) {
			fmt.Println(failPrefix + b.Name)
			fmt.Println(logIndent + msg)
			return 1
		}

		if benchNanos() >= benchmarkTime || n >= maxIterations {
			break
		}

		per := benchNanos() / i64(n)
		if per <= 0 {
			per = 1
		}

		next := benchmarkAim / per
		if next < i64(n) * minGrowth {
			next = i64(n) * minGrowth
		}

		if next > i64(n) * maxGrowth {
			next = i64(n) * maxGrowth
		}

		n = int(next)
	}

	per := f64(benchNanos()) / f64(n)
	line := fmt.Sprintf("%-24s %10d %12.0f ns/op", b.Name, n, per)
	if per < decimalsBelow { // a small cost shows its decimals
		line = fmt.Sprintf("%-24s %10d %12.2f ns/op", b.Name, n, per)
	}

	if benchReported() {
		line += fmt.Sprintf(" %8d B/op %8d allocs/op", benchBytes()/n, benchAllocs()/n)
	}

	fmt.Println(line)
	return 0
}

// nextRandom steps seed, an xorshift over it, and returns the new seed
// with its sign cleared, a random number for -shuffle.
func nextRandom(seed mut i64) i64 {
	*seed ^= *seed << 13
	*seed ^= *seed >> 7
	*seed ^= *seed << 17
	if *seed < 0 {
		return -*seed
	}

	return *seed
}

// runRound runs every test once, in the order given: each in a task of
// its own, the sequential ones one at a time, the parallel ones
// together after them, and returns how many failed.
func runRound(tests ref []Test, order ref []int, only ref string) int {
	done := make(chan Result, len(tests)) // room for every test's report, so that no task waits to report
	gate := make(chan (), 0)              // closed once the sequential tests are done: the parallel ones wait at it
	failures := 0
	waiting := 0
	for _, i := range order {
		t := ref tests[i]
		if !t.Name.HasPrefix(testPrefix) || (only.Len() > 0 && only != matchAll && !t.Name.Contains(only)) {
			continue
		}

		if failures > 0 && isFailFast() {
			break
		}

		spawn runTest(Test{Name: t.Name.Clone(), F: t.F}, done.Clone(), gate.Clone())
		if r := <-done {
			if r.parallel {
				waiting += 1
			} else if !r.passed {
				failures += 1
			}
		}
	}

	close(gate)
	for ; waiting > 0; waiting-- {
		if r := <-done {
			fmt.Printf("%s", r.held)
			if !r.passed {
				failures += 1
			}
		}
	}

	return failures
}

// setFlags records the flags, before any test runs.
func setFlags(flags Config) {
	config.Store(flags)
}

// parseCount reads a flag's value, s, as a count of decimal digits,
// ending the program with status 2 when it is not one, as a flag
// parser does.
func parseCount(s ref string, flag ref string) int {
	n := 0
	for i := 0; i < s.Len(); i++ {
		d := s[i]
		if d < '0' || d > '9' {
			fmt.Fprintf(mut os.Stderr(), "invalid value %q for %s\n", s, flag)
			os.Exit(exitBadRun)
		}

		n = n*10 + int(d-'0')
	}

	return n
}

// where returns the place of the call being made, file:line, which the
// compiler hands the runtime before every call of Log, Logf and Skip
// and the runtime keeps for the running task. The runtime provides it.
func where() string

// task returns the identity of the running task, which keys its test's
// State. The runtime provides it.
func task() int

// benchStart starts a run of the benchmark of n iterations, its time
// and allocations counted from zero. The runtime keeps the state of one
// benchmark at a time and provides it, as it does each of the bench
// functions after it.
func benchStart(n int)

// benchLoop counts one iteration of the benchmark's loop and reports
// whether there is one to run.
func benchLoop() bool

// benchReset forgets the time and the allocations counted so far.
func benchReset()

// benchReport marks the benchmark as one whose line shows its bytes
// and allocations.
func benchReport()

// benchNanos returns the nanoseconds the run took.
func benchNanos() i64

// benchAllocs returns the allocations the run made.
func benchAllocs() int

// benchBytes returns the bytes the run allocated.
func benchBytes() int

// benchReported reports whether ReportAllocs was called in the run.
func benchReported() bool
