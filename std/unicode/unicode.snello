// Package unicode answers questions about a rune from Unicode's own
// tables, at the version the runtime's tables are written from: its
// general category and the classes made of it, whether it is white
// space, its script, and its upper, lower and title case and its case
// folding. A rune is a code point, an i32; a value that is not one is
// in no class, has category Cn and script Unknown, and maps to itself.
//
// Every function takes the rune by value, allocates nothing and costs
// a look-up in the runtime's tables.
package unicode

// MaxRune is the largest code point, U+10FFFF.
const MaxRune rune = 0x10FFFF

// Version is the version of the Unicode standard the tables are written
// from.
const Version string = "18.0.0"

// IsLetter reports whether r is a letter: its general category is one
// of L's, Lu, Ll, Lt, Lm or Lo, so 'a', 'Ж' and '中' are letters and
// '1' and '_' are not. The runtime provides it.
func IsLetter(r rune) bool

// IsTitle reports whether r is a title case letter, general category
// Lt: a digraph such as ǅ that starts a word in title case. The
// runtime provides it.
func IsTitle(r rune) bool

// IsMark reports whether r is a mark, general category M: a combining
// accent such as U+0301, a vowel sign. The runtime provides it.
func IsMark(r rune) bool

// IsNumber reports whether r is a number, general category N: a decimal
// digit, a letter number such as Ⅻ, or another number such as ². The
// runtime provides it.
func IsNumber(r rune) bool

// IsPunct reports whether r is punctuation, general category P: '.',
// ',', '!', a dash, a bracket, a quotation mark. The runtime provides
// it.
func IsPunct(r rune) bool

// IsSymbol reports whether r is a symbol, general category S: a math,
// currency, modifier or other symbol, an emoji among them, such as '+',
// '$' and '😀'. The runtime provides it.
func IsSymbol(r rune) bool

// IsControl reports whether r is a control character, general category
// Cc: U+0000 to U+001F and U+007F to U+009F, '\n' and '\t' among them.
// The runtime provides it.
func IsControl(r rune) bool

// IsGraphic reports whether r is graphic: a letter, mark, number,
// punctuation, symbol or space separator, Zs, such as U+00A0, the
// no-break space. IsPrint is the same with the ASCII space as its one
// space. The runtime provides it.
func IsGraphic(r rune) bool

// IsPrint reports whether r is printable: a letter, a mark, a number,
// a punctuation or a symbol, or the ASCII space, and no other space;
// %q escapes every other rune. The runtime provides it.
func IsPrint(r rune) bool

// IsDigit reports whether r is a decimal digit, general category Nd:
// '0' to '9', and the digits of every other script, such as '٣'.
// DigitValue gives its value. The runtime provides it.
func IsDigit(r rune) bool

// IsSpace reports whether r has Unicode's White_Space property: ' ',
// '\t', '\n', '\r', '\v', '\f', U+0085, U+00A0 and the spaces and
// separators past them, the runes strings.Fields splits at and Trim
// cuts. The runtime provides it.
func IsSpace(r rune) bool

// IsUpper reports whether r is upper case: Unicode's derived property
// Uppercase, the letters of category Lu and the runes Unicode counts as
// upper case beside them, such as Ⓐ. Category(r) == "Lu" asks for the
// letters alone. The runtime provides it.
func IsUpper(r rune) bool

// IsLower reports whether r is lower case: Unicode's derived property
// Lowercase, the letters of category Ll and the runes counted beside
// them, such as ª and ⓐ. The runtime provides it.
func IsLower(r rune) bool

// IsAlphabetic reports whether r is alphabetic: Unicode's derived
// property Alphabetic, every letter and the marks and numbers that
// write words, such as a Devanagari vowel sign or Ⅻ. IsLetter asks for
// the letters alone. The runtime provides it.
func IsAlphabetic(r rune) bool

// IsEmoji reports whether r has Unicode's Emoji property: 😀 and ❤, and
// also the digits and # and *, which form keycap emoji. The runtime
// provides it.
func IsEmoji(r rune) bool

// IsIDStart reports whether r can start an identifier, by Unicode's
// XID_Start, the form of ID_Start that stays closed under NFKC, as
// annex 31 recommends: a letter of any script, 'a', 'é', 'π', but not
// a digit or '_'. The runtime provides it.
func IsIDStart(r rune) bool

// IsIDContinue reports whether r can go on an identifier, by
// XID_Continue: a letter, a digit, a combining mark or a connector such
// as '_'. The runtime provides it.
func IsIDContinue(r rune) bool

// DigitValue returns the value of r when it is a decimal digit, 0 to 9,
// of any script, and None for a rune that is not one, a letter number
// such as Ⅻ or a superscript such as ² among them; NumericValue gives
// those.
//
//	unicode.DigitValue('7') // Some(7)
//	unicode.DigitValue('٣') // Some(3), ARABIC-INDIC DIGIT THREE
func DigitValue(r rune) int? {
	d := digit(r)
	if d < 0 {
		return None
	}

	return Some(d)
}

// NumericValue returns the numeric value Unicode gives r, as an f64: 7
// for '7', 12 for Ⅻ, 0.5 for ½, and 5 for the ideograph 五, whose value
// Unihan gives. It returns None for a rune with no numeric value, a
// letter or a space among them.
func NumericValue(r rune) f64? {
	var num i64 = 0
	var den i64 = 1
	if !numeric(r, mut num, mut den) {
		return None
	}

	return Some(f64(num) / f64(den))
}

// ToUpper returns r in upper case, by Unicode's simple case mapping,
// one rune to one: 'a' is 'A', and ß, whose upper case is two runes,
// stays ß; strings.ToUpper maps a whole string by the full mapping. A
// rune with no upper case is returned as it is. The runtime provides
// it.
func ToUpper(r rune) rune

// ToLower returns r in lower case, by Unicode's simple case mapping,
// one rune to one: 'A' is 'a'. A rune with no lower case is returned as
// it is. The runtime provides it.
func ToLower(r rune) rune

// ToTitle returns r in title case, by Unicode's simple case mapping,
// which is the upper case for every rune but the digraphs: ǆ is ǅ, not
// Ǆ. A rune with no title case is returned as it is. The runtime
// provides it.
func ToTitle(r rune) rune

// CaseFold returns r's simple case folding, statuses C and S of
// Unicode's CaseFolding.txt: every rune of a class that differs only
// in case maps to the same one, so two runes are equal ignoring case
// when they fold to the same rune, 'K', 'k' and the Kelvin sign U+212A
// among them. strings.EqualIgnoreCase compares whole strings by the
// full folding, where ß is ss. The runtime provides it.
func CaseFold(r rune) rune

// Category returns the two letters of r's general category: Lu for an
// uppercase letter, Nd for a decimal digit, Cn for a code point Unicode
// has not assigned and for a value that is not a code point. The
// runtime provides it.
func Category(r rune) string

// Script returns r's script by Unicode's name for it: Latin, Han,
// Cyrillic, Common for a rune of many scripts such as a digit or '!',
// Inherited for a mark that takes its letter's, and Unknown for an
// unassigned code point. The runtime provides it.
func Script(r rune) string

// ScriptCode returns r's script by its four-letter code, ISO 15924's:
// Latn, Hani, Cyrl, Zyyy for Common, Zinh for Inherited, Zzzz for
// Unknown. The runtime provides it.
func ScriptCode(r rune) string

// InScript reports whether r's script is the one named, by its name,
// Latin, or its four-letter code, Latn; a name that is no script's
// gives false. name is only read.
//
//	unicode.InScript('ж', "Cyrillic") // true
//	unicode.InScript('ж', "Cyrl")     // true
//
// The runtime provides it.
func InScript(r rune, name ref string) bool

// digit returns the value of r as a decimal digit, 0 to 9, or -1 for a
// rune that is not one. The runtime provides it.
func digit(r rune) int

// numeric writes the numeric value of r as the fraction num / den and
// reports whether r has one. The runtime provides it.
func numeric(r rune, num mut i64, den mut i64) bool
