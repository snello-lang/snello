// Package norm puts a string in one of Unicode's four normalization
// forms, so that text written two ways compares equal: é as one rune,
// U+00E9, or as e and a combining accent, U+0065 U+0301. NFD
// decomposes every rune and NFC composes it again; NFKD and NFKC also
// replace a compatibility character by its plain form, ﬁ by fi and ² by
// 2. The forms are annex 15 of the standard, over the runtime's tables.
package norm

// A Form is one of the four normalization forms.
enum Form impl Copy, Eq {
	// NFC: canonical decomposition, then canonical composition; the
	// form most text is written in, and the one to compare by.
	NFC

	// NFD: canonical decomposition, every mark after its letter in
	// canonical order.
	NFD

	// NFKC: compatibility decomposition, then canonical composition.
	NFKC

	// NFKD: compatibility decomposition.
	NFKD
}

// String returns s in the form f, as a new string the caller owns; s is
// only read. A byte that is not UTF-8 becomes U+FFFD, as a range over s
// reads it, so a string with one is in no form. Two strings that are
// the same text written two ways are equal once both are in the same
// form.
//
//	norm.String(norm.NFC, "é") == "é" // true
//	norm.String(norm.NFKC, "ﬁ²")                 // "fi2"
func String(f Form, s ref string) string {
	return normalize(s, formCode(f))
}

// IsNormalString reports whether s is in the form f already, so that
// String would return it unchanged. s is only read: by the standard's
// quick check, which reads the string once and allocates nothing, and
// by normalizing it only when the quick check cannot tell.
func IsNormalString(f Form, s ref string) bool {
	return isNormal(s, formCode(f))
}

// formCode returns the number the runtime knows the form f by.
func formCode(f Form) int {
	return match f {
		NFC => 0,
		NFD => 1,
		NFKC => 2,
		NFKD => 3,
	}
}

// normalize returns s in the form numbered form. The runtime provides
// it.
func normalize(s ref string, form int) string

// isNormal reports whether s is in the form numbered form already. The
// runtime provides it.
func isNormal(s ref string, form int) bool
