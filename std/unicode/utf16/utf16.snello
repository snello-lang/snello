// Package utf16 reads and writes runes in UTF-16, the encoding Windows
// and many file formats hold text in: a rune below U+10000 is one unit
// of 16 bits, and one above it two, a surrogate pair. An unpaired
// surrogate reads as U+FFFD, the replacement character.
//
// Encode and Decode work on units, []u16; EncodeBytes and DecodeBytes
// on the bytes of a file or a message, in either byte order.
package utf16

// replacementCharacter is U+FFFD, read for an unpaired surrogate and
// written for a value that is not a code point.
const replacementCharacter rune = 0xFFFD

// maxRune is the largest code point, U+10FFFF.
const maxRune rune = 0x10FFFF

// The surrogates: a high one, U+D800 to U+DBFF, then a low one, U+DC00
// to U+DFFF, carry the 20 bits of a rune past U+FFFF, less
// firstPairedRune, ten bits each, the bits surrogateMask keeps.
// surrogateEnd is the first rune past them.
const highSurrogateMin rune = 0xD800
const lowSurrogateMin rune = 0xDC00
const surrogateEnd rune = 0xE000
const firstPairedRune rune = 0x10000
const surrogateMask rune = 0x3FF

// The byte-order mark, U+FEFF, as the unit that starts a text, and its
// two bytes, high then low, which say the order: high first is big
// endian, low first little endian.
const byteOrderMark u16 = 0xFEFF
const byteOrderMarkHigh byte = 0xFE
const byteOrderMarkLow byte = 0xFF

// An Order is the order a 16-bit unit's two bytes are written in.
enum Order impl Copy, Eq {
	// BigEndian writes the high byte first, UTF-16BE.
	BigEndian

	// LittleEndian writes the low byte first, UTF-16LE, as Windows
	// does.
	LittleEndian
}

// IsSurrogate reports whether r is a surrogate, U+D800 to U+DFFF, which
// UTF-16 uses in pairs and which is no rune of its own.
func IsSurrogate(r rune) bool {
	return r >= highSurrogateMin && r < surrogateEnd
}

// RuneLen returns how many 16-bit units r takes, one below U+10000 and
// two from it on, or -1 for a value that is not a code point or is a
// surrogate.
func RuneLen(r rune) int {
	if r < 0 || r > maxRune || IsSurrogate(r) {
		return -1
	}

	if r < firstPairedRune {
		return 1
	}

	return 2
}

// EncodeRune returns the surrogate pair of r, high then low, and
// (U+FFFD, U+FFFD) for a rune below U+10000, which takes one unit, or
// a value that is not a code point.
//
//	hi, lo := utf16.EncodeRune('😀') // 0xD83D, 0xDE00
func EncodeRune(r rune) (rune, rune) {
	if r < firstPairedRune || r > maxRune {
		return (replacementCharacter, replacementCharacter)
	}

	r -= firstPairedRune
	return (highSurrogateMin + (r >> 10) & surrogateMask, lowSurrogateMin + r & surrogateMask)
}

// DecodeRune returns the rune the surrogate pair r1, r2 holds, and
// U+FFFD when they are not a high and then a low surrogate.
//
//	utf16.DecodeRune(0xD83D, 0xDE00) // '😀'
func DecodeRune(r1 rune, r2 rune) rune {
	if r1 >= highSurrogateMin && r1 < lowSurrogateMin && r2 >= lowSurrogateMin && r2 < surrogateEnd {
		return (r1 - highSurrogateMin) << 10 | (r2 - lowSurrogateMin) + firstPairedRune
	}

	return replacementCharacter
}

// AppendRune appends the UTF-16 units of r to p, one or two, and
// U+FFFD's one for a value that is not a code point or is a surrogate.
// p is lent mut and grows as Push grows it.
func AppendRune(p mut []u16, r rune) {
	n := RuneLen(r)
	if n == 1 {
		p.Push(u16(r))
		return
	}

	if n < 0 {
		p.Push(u16(replacementCharacter))
		return
	}

	r1, r2 := EncodeRune(r)
	p.Push(u16(r1))
	p.Push(u16(r2))
}

// EncodeBytes returns s as UTF-16 bytes in the order o, in a new slice
// the caller owns, after a byte-order mark, U+FEFF, when bom is true. s
// is only read; a byte of it that is not UTF-8 is written as U+FFFD, as
// a range over s reads it.
//
//	utf16.EncodeBytes("hi", utf16.LittleEndian, true)
//	// FF FE 68 00 69 00
func EncodeBytes(s ref string, o Order, bom bool) []byte {
	units := []u16{}
	if bom {
		units.Push(byteOrderMark)
	}

	for _, r := range s {
		AppendRune(mut units, r)
	}

	out := []byte{}
	for _, u := range ref units {
		hi, lo := byte(u >> 8), byte(u & 0xFF)
		if o == BigEndian {
			out.Push(hi)
			out.Push(lo)
		} else {
			out.Push(lo)
			out.Push(hi)
		}
	}

	return out
}

// DecodeBytes returns the string the UTF-16 bytes p hold in the order
// o, as a new string in UTF-8. A byte-order mark at the start says the
// order instead, overriding o, and is dropped; an unpaired surrogate,
// and a last byte without its pair, read as U+FFFD. p is only read.
func DecodeBytes(p ref []byte, o Order) string {
	order := o
	at := 0
	if len(p) >= 2 && p[0] == byteOrderMarkHigh && p[1] == byteOrderMarkLow {
		order = BigEndian
		at = 2
	} else if len(p) >= 2 && p[0] == byteOrderMarkLow && p[1] == byteOrderMarkHigh {
		order = LittleEndian
		at = 2
	}

	units := []u16{}
	for at + 1 < len(p) {
		if order == BigEndian {
			units.Push(u16(p[at]) << 8 | u16(p[at + 1]))
		} else {
			units.Push(u16(p[at + 1]) << 8 | u16(p[at]))
		}

		at += 2
	}

	runes := Decode(ref units)
	if at < len(p) {
		runes.Push(replacementCharacter)
	}

	return string(runes)
}

// Encode returns the UTF-16 units of the runes s, in a new slice the
// caller owns: one unit for a rune below U+10000, a surrogate pair for
// one above it, and U+FFFD's unit for a value that is not a code point
// or is a surrogate. s is only read.
func Encode(s ref []rune) []u16 {
	out := []u16{}
	for _, r := range s {
		AppendRune(mut out, r)
	}

	return out
}

// Decode returns the runes the UTF-16 units s hold, in a new slice the
// caller owns: a surrogate pair is one rune, and each unit of an
// unpaired surrogate is U+FFFD. s is only read.
//
//	utf16.Decode(ref []u16{0x68, 0xD83D, 0xDE00}) // 'h', '😀'
func Decode(s ref []u16) []rune {
	out := []rune{}
	i := 0
	for i < len(s) {
		r := rune(s[i])
		if r >= highSurrogateMin && r < lowSurrogateMin && i + 1 < len(s) {
			if d := DecodeRune(r, rune(s[i + 1])); d != replacementCharacter {
				out.Push(d)
				i += 2
				continue
			}
		}

		if IsSurrogate(r) {
			out.Push(replacementCharacter)
		} else {
			out.Push(r)
		}

		i += 1
	}

	return out
}
