// Package rc gives one value several owners within a task. An Rc<T> is
// a handle on a value that lives until the last handle to it is
// dropped: Clone makes another handle, not another value, and the
// count of handles says when the value goes. A Weak<T> is a handle that
// does not keep the value alive, for a link back to a value another
// handle owns; it is upgraded to an Rc when the value is still there,
// and answers None when it is not.
//
// An Rc lends its value for reading to every handle at once, with Get.
// It lends it for changing, with GetMut, only while it is the one
// handle, strong and weak, since a change through one handle while
// another reads is what the borrow rules forbid; a value that must be
// changed while shared is built from parts that are not shared, or
// kept in an arena. That rule also means a cycle of handles cannot be
// built, since the link that would close it is set through GetMut on a
// handle that is no longer alone, and a lock, the other way to change a
// shared value, holds only what may be sent, which an Rc may not; so a
// value in an Rc is always released. An Rc is for one task: its count
// is a plain number, and it is not sent to another task. The memory of
// the value is released by the last handle, Rc or Weak, to go.
//
// Neither handle has a zero value: each implements Drop, so var r
// Rc<T> is refused, and an Rc comes only from New or Clone, a Weak only
// from Downgrade or Clone. A link that may point at nothing, the parent
// of a tree's root, is a Weak<T>?.
package rc

import "fmt"

// A cell is what the handles on one value share: the value, gone once
// the last Rc goes, and the two counts. The counts are plain numbers,
// changed by whichever handle is cloned or dropped, so a cell and the
// handles on it stay in the task that made them: the local field says
// so to the compiler, which refuses to send a handle to another task
// or to capture one in a spawn.
struct cell<T> {
	_      local
	strong int
	weak   int
	value  T?
}

// An Rc is a handle on a shared value, one of its owners. It is moved,
// cloned for another owner, and lent with ref; when it goes out of
// scope the count goes down, and the value with it when the count
// reaches zero. It prints as the value it holds.
struct Rc<T> impl Clone, Drop, fmt.Stringer {
	p *cell<T>?
}

// A Weak is a handle that does not own the value: a link back to a
// value other handles own, broken when they are gone. It is moved,
// cloned and lent as an Rc is, and prints as the value while it is
// there.
struct Weak<T> impl Clone, Drop, fmt.Stringer {
	p *cell<T>?
}

// String returns the text of the value, as fmt prints it, so that an
// Rc, and a struct holding one, print as the value they share.
func (r ref Rc<T>) String() string {
	return text(ref r.p, "rc.Rc()")
}

// String returns the text of the value while it is there, as an Rc
// prints, and rc.Weak() once it is gone.
func (w ref Weak<T>) String() string {
	return text(ref w.p, "rc.Weak()")
}

// text returns the text of the value a cell holds, or none when the
// cell is gone or holds none.
func text<T>(p ref (*cell<T>?), none string) string {
	if c := ref p {
		if v := ref c.value {
			return fmt.Sprint(v)
		}
	}

	return none
}

// New puts v in a new shared cell and returns the first handle on it.
func New<T>(v T) Rc<T> {
	return Rc<T>{p: Some(&cell<T>{strong: 1, weak: 0, value: Some(v)})}
}

// Get lends the value for reading, for as long as the Rc is lent.
func (r ref Rc<T>) Get() ref T {
	if p := ref r.p {
		if v := ref p.value {
			return v
		}
	}

	panic("rc: an Rc without its value: a broken invariant of the package") // an Rc holds its cell and the value until its Drop, which runs once
}

// GetMut lends the value for changing when this is the only handle on
// it, strong or weak, and None otherwise.
func (r mut Rc<T>) GetMut() mut T? {
	if p := mut r.p {
		if p.strong == 1 && p.weak == 0 {
			return match mut p.value {
				Some(v) => Some(v),
				None => None,
			}
		}
	}

	return None
}

// Clone returns another handle on the same value; the value is not
// copied.
func (r ref Rc<T>) Clone() Rc<T> {
	q := retain(r.p) ?? return Rc<T>{p: None}
	q.strong++
	return Rc<T>{p: Some(q)}
}

// Downgrade returns a Weak handle on the value, which does not keep it
// alive.
func (r ref Rc<T>) Downgrade() Weak<T> {
	q := retain(r.p) ?? return Weak<T>{p: None}
	q.weak++
	return Weak<T>{p: Some(q)}
}

// StrongCount returns how many Rc handles the value has, this one
// included.
func (r ref Rc<T>) StrongCount() int {
	if p := ref r.p {
		return p.strong
	}

	return 0
}

// WeakCount returns how many Weak handles the value has.
func (r ref Rc<T>) WeakCount() int {
	if p := ref r.p {
		return p.weak
	}

	return 0
}

// Drop gives up this handle: the value is dropped with the last Rc, and
// the cell released with the last handle of either kind.
func (r mut Rc<T>) Drop() {
	p := take(mut r.p) ?? return // dropped already
	p.strong--
	if p.strong > 0 {
		leak(p)
		return
	}

	// The last owner: the value goes. Dropping it may drop Weaks on this
	// cell, its last one included, so this handle counts as one more Weak
	// until the value is gone, and the cell outlives the value's drop.
	p.weak++
	_ = take(mut p.value)
	p.weak--
	if p.weak == 0 {
		return // no handle left: p goes out of scope here and frees the cell
	}

	leak(p)
}

// Upgrade returns an Rc on the value when it is still there, and None
// when its last Rc is gone.
func (w ref Weak<T>) Upgrade() Rc<T>? {
	if p := ref w.p {
		if p.strong > 0 {
			q := retain(w.p) ?? return None
			q.strong++
			return Some(Rc<T>{p: Some(q)})
		}
	}

	return None
}

// Clone returns another Weak handle on the same value.
func (w ref Weak<T>) Clone() Weak<T> {
	q := retain(w.p) ?? return Weak<T>{p: None}
	q.weak++
	return Weak<T>{p: Some(q)}
}

// Drop gives up this handle; the cell is released when it was the
// last handle of either kind.
func (w mut Weak<T>) Drop() {
	p := take(mut w.p) ?? return // dropped already
	p.weak--
	if p.strong == 0 && p.weak == 0 {
		return // the last handle: p goes out of scope here and frees the cell
	}

	leak(p)
}

// retain returns an owned copy of the pointer a handle holds, for a new
// handle on the same cell, or None for a handle whose Drop has run. The
// caller raises the count the new handle is counted in.
func retain<T>(p ref (*cell<T>?)) *cell<T>? {
	if q := ref p {
		return Some(alias(q))
	}

	return None
}

// The compiler provides these two, the one unsafe step reference
// counting needs. alias returns a second owned copy of the pointer a
// borrow lends, which costs nothing: a borrow of a pointer and the
// pointer are the same word in the compiled program. leak takes a
// pointer and frees nothing, so the cell outlives the handle that held
// it. Neither is reachable from a program, and the counts are what
// make them safe here.
func alias<T>(p ref *cell<T>) *cell<T>
func leak<T>(p *cell<T>)
