// Package rc gives one value several owners within a task. An Rc<T> is
// a handle on a value that lives until the last handle to it is
// dropped: Clone makes another handle, not another value, and the
// count of handles says when the value goes. A Weak<T> is a handle that
// does not keep the value alive, for a link back to a value another
// handle owns; it is upgraded to an Rc when the value is still there,
// and answers None when it is not.
//
// An Rc lends its value for reading to every handle at once, with Get.
// It lends it for changing, with GetMut, only while it is the one
// handle, strong and weak, since a change through one handle while
// another reads is what the borrow rules forbid; a value that must be
// changed while shared is built from parts that are not shared, or
// kept in an arena. That rule also means a cycle of handles cannot be
// built, since the link that would close it is set through GetMut on a
// handle that is no longer alone, and a lock, the other way to change a
// shared value, holds only what may be sent, which an Rc may not; so a
// value in an Rc is always released. An Rc is for one task: its count
// is a plain number, and it is not sent to another task. The memory of
// the value is released by the last handle, Rc or Weak, to go.
//
// Neither handle has a zero value: each implements Drop, so var r
// Rc<T> is refused, and an Rc comes only from New or Clone, a Weak only
// from Downgrade or Clone. A link that may point at nothing, the parent
// of a tree's root, is a Weak<T>?.
package rc

import "fmt"

// goneText is how a Weak prints once the value it pointed at is gone.
const goneText = "rc.Weak()"

// An Rc is a handle on a shared value, one of its owners. It is moved,
// cloned for another owner, and lent with ref; when it goes out of
// scope the count goes down, and the value with it when the count
// reaches zero. It prints as the value it holds. It holds its cell by
// address, since no one handle owns it, and carries a pointer to the
// cell's type, so that it stays in its task as the cell does and a
// value may hold a handle on a cell of its own type.
//
//	a := rc.New(config)
//	b := a.Clone() // a second owner of the same config
//	fmt.Println(b.Get().name)
struct Rc<T> impl Clone, Drop, fmt.Stringer {
	cell     int         // the address of the shared cell, which no one handle owns
	cellType [0]*cell<T> // holds nothing: it gives the handle the cell's type, so that it stays in its task as the cell does, and a pointer, so that a value may hold a handle on a cell of its own type
}

// A Weak is a handle that does not own the value: a link back to a
// value other handles own, broken when they are gone. It is moved,
// cloned and lent as an Rc is, and prints as the value while it is
// there. It keeps the cell's memory, not the value: the memory goes
// with the last handle of either kind.
//
//	parent := node.Downgrade()
//	p := parent.Upgrade() ?? return // the parent is gone
struct Weak<T> impl Clone, Drop, fmt.Stringer {
	cell     int         // the address of the shared cell, which no one handle owns
	cellType [0]*cell<T> // holds nothing: it gives the handle the cell's type, so that it stays in its task as the cell does, and a pointer, so that a value may hold a handle on a cell of its own type
}

// A cell is what the handles on one value share: the value and the two
// counts. The value is there while any Rc is, and gone once the last
// Rc goes, which the strong count says, so the cell holds it with no
// tag beside it. The counts are plain numbers, changed by whichever
// handle is cloned or dropped, so a cell and the handles on it stay in
// the task that made them: the local field says so to the compiler,
// which refuses to send a handle to another task or to capture one in
// a spawn.
struct cell<T> {
	_      local
	strong int
	weak   int
	value  T
}

// New puts v in a new shared cell and returns the first handle on it,
// with a strong count of one and no Weak. It takes v, owned: the value
// lives in the cell until the last Rc on it is dropped. It allocates
// the cell, once; Clone allocates nothing.
//
//	shared := rc.New([]string{"a".Clone()})
func New<T>(v T) Rc<T> {
	return Rc<T>{cell: rawNew<cell<T>>(cell<T>{strong: 1, weak: 0, value: v}), cellType: [0]*cell<T>{}}
}

// String returns the text of the value, as fmt prints it, so that an
// Rc, and a struct holding one, print as the value they share. It
// allocates the string it returns.
func (r ref Rc<T>) String() string {
	return fmt.Sprint(r.Get())
}

// Get lends the value for reading, for as long as the Rc is lent. Every
// handle may lend it at once; none copies it.
//
//	n := len(shared.Get())
func (r ref Rc<T>) Get() ref T {
	return ref rawMut<cell<T>, Rc<T>>(r.cell, r).value
}

// GetMut lends the value for changing when this is the only handle on
// it, strong or weak, for as long as the Rc is lent mut, and returns
// None when another Rc or any Weak shares it: a change while another
// handle can read the value is refused, not raced.
//
//	if v := r.GetMut() {
//		*v += 1
//	}
func (r mut Rc<T>) GetMut() mut T? {
	c := rawMut<cell<T>, Rc<T>>(r.cell, r)
	if c.strong != 1 || c.weak != 0 {
		return None
	}

	return Some(mut c.value)
}

// Clone returns another handle on the same value and counts it: the
// value is not copied and nothing is allocated.
func (r ref Rc<T>) Clone() Rc<T> {
	rawMut<cell<T>, Rc<T>>(r.cell, r).strong++
	return Rc<T>{cellType: [0]*cell<T>{}, cell: r.cell}
}

// Downgrade returns a Weak handle on the value, which does not keep it
// alive: once the last Rc is dropped, the Weak's Upgrade returns None.
// It counts the Weak and allocates nothing.
//
//	child.parent = Some(parent.Downgrade())
func (r ref Rc<T>) Downgrade() Weak<T> {
	rawMut<cell<T>, Rc<T>>(r.cell, r).weak++
	return Weak<T>{cellType: [0]*cell<T>{}, cell: r.cell}
}

// StrongCount returns how many Rc handles the value has, this one
// included.
func (r ref Rc<T>) StrongCount() int {
	return rawMut<cell<T>, Rc<T>>(r.cell, r).strong
}

// WeakCount returns how many Weak handles the value has.
func (r ref Rc<T>) WeakCount() int {
	return rawMut<cell<T>, Rc<T>>(r.cell, r).weak
}

// Drop gives up this handle: the value is dropped with the last Rc, and
// the cell's memory released with the last handle of either kind. The
// compiler calls it when the Rc goes out of scope.
func (r mut Rc<T>) Drop() {
	c := rawMut<cell<T>, Rc<T>>(r.cell, r)
	c.strong--
	if c.strong > 0 {
		return
	}

	// The last owner: the value goes. Dropping it may drop Weaks on this
	// cell, its last one included, so this handle counts as one more Weak
	// until the value is gone, and the cell outlives the value's drop.
	c.weak++
	_ = moveOut<T>(mut c.value)
	c.weak--
	if c.weak == 0 {
		rawFree(r.cell)
	}
}

// TryUnwrap takes the value out of the Rc when this is its only Rc, and
// gives the Rc back otherwise, so that nothing is lost either way: a
// value shared while it was built and owned outright after. It takes
// the Rc, owned; Ok holds the value, owned by the caller from then on,
// and Err the same Rc, untouched, when another Rc shares the value. A
// Weak on the value finds it gone, as it does after the last Rc is
// dropped. It copies nothing.
//
//	v := shared.TryUnwrap() ?? return
func (r Rc<T>) TryUnwrap() Result<T, Rc<T>> {
	c := rawMut<cell<T>, Rc<T>>(r.cell, ref r)
	if c.strong != 1 {
		return Err(r)
	}

	c.strong = 0
	v := moveOut<T>(mut c.value)
	last := c.weak == 0
	at := r.cell
	leak(r) // its count is spent and its value taken: its Drop must not run
	if last {
		rawFree(at)
	}

	return Ok(v)
}

// String returns the text of the value while it is there, as an Rc
// prints, and rc.Weak() once it is gone. It allocates the string it
// returns.
func (w ref Weak<T>) String() string {
	c := rawMut<cell<T>, Weak<T>>(w.cell, w)
	if c.strong == 0 {
		return goneText
	}

	return fmt.Sprint(ref c.value)
}

// Upgrade returns a new Rc on the value when it is still there, which
// keeps it alive for as long as that Rc lives, and None when its last
// Rc is gone. It allocates nothing.
//
//	if p := w.Upgrade() {
//		fmt.Println(p.Get())
//	}
func (w ref Weak<T>) Upgrade() Rc<T>? {
	c := rawMut<cell<T>, Weak<T>>(w.cell, w)
	if c.strong == 0 {
		return None
	}

	c.strong++
	return Some(Rc<T>{cellType: [0]*cell<T>{}, cell: w.cell})
}

// Clone returns another Weak handle on the same value and counts it;
// nothing is copied or allocated.
func (w ref Weak<T>) Clone() Weak<T> {
	rawMut<cell<T>, Weak<T>>(w.cell, w).weak++
	return Weak<T>{cellType: [0]*cell<T>{}, cell: w.cell}
}

// Drop gives up this handle; the cell's memory is released when it was
// the last handle of either kind. The compiler calls it when the Weak
// goes out of scope.
func (w mut Weak<T>) Drop() {
	c := rawMut<cell<T>, Weak<T>>(w.cell, w)
	c.weak--
	if c.strong == 0 && c.weak == 0 {
		rawFree(w.cell)
	}
}

// The functions below have no body: the compiler writes them for this
// package alone, the steps of reference counting the language refuses
// elsewhere, which the counts make safe here.

// rawNew moves a cell into a block of its own and returns its address.
func rawNew<C>(c C) int

// rawMut lends the cell at an address, a mut through a ref, for as long
// as the handle h is lent, its fields read in place, since the counts
// are this task's alone.
func rawMut<C, H>(at int, h ref H) mut C

// rawFree frees the block of a cell whose value is gone.
func rawFree(at int)

// moveOut moves the value out of the cell and leaves its place to
// nothing, which the strong count, at zero from then on, says no one
// reads.
func moveOut<T>(v mut T) T

// leak gives a handle up without its Drop, when its count is already
// spent.
func leak<H>(h H)
