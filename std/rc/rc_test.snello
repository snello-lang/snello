package rc_test

import ("expect"; "fmt"; "rc"; "testing")

struct Node { name string }

func TestCounts() {
	r := rc.New(Node{name: "root".Clone()})
	expect.Equal(ref r.StrongCount(), ref 1)
	expect.Equal(ref r.WeakCount(), ref 0)
	s := r.Clone()
	expect.Equal(ref r.StrongCount(), ref 2)
	expect.Equal(ref s.Get().name, "root")
	w := r.Downgrade()
	expect.Equal(ref r.WeakCount(), ref 1)
	u := expect.IsSome(w.Upgrade())
	expect.Equal(ref u.StrongCount(), ref 3)
}

func TestGetMut() {
	r := rc.New(1)
	if v := r.GetMut() {
		*v = 2
	}
	expect.Equal(ref *r.Get(), ref 2)
	s := r.Clone()
	expect.True(r.GetMut().IsNone())
	expect.Equal(ref *s.Get(), ref 2)
}

func TestWeakOutlives() {
	w := rc.New("gone".Clone()).Downgrade()
	expect.IsNone(w.Upgrade())
	w2 := w.Clone()
	expect.IsNone(w2.Upgrade())
	expect.Contains(ref fmt.Sprint(w), "Weak")
	expect.Contains(ref fmt.Sprint(rc.New(3)), "3")
}

func BenchmarkClone() {
	r := rc.New(1)
	for testing.Loop() { _ = r.Clone() }
}

func TestTryUnwrapAlone() {
	r := rc.New([]string{"kept".Clone()})
	xs := match r.TryUnwrap() { // no other handle, no Weak: the cell is freed and the value comes out
		Ok(v) => v,
		Err(_) => []string{},
	}
	expect.Equal(ref len(xs), ref 1)
	expect.Equal(ref xs[0], "kept")
}

func TestTryUnwrap() {
	a := rc.New("only".Clone())
	{
		b := a.Clone()
		a = match a.TryUnwrap() { // shared: the handle comes back
			Ok(v) => { expect.Fail("unwrapped a shared value"); rc.New(v) },
			Err(r) => r,
		}
		expect.Equal(ref a.StrongCount(), ref 2)
		expect.Equal(ref b.StrongCount(), ref 2)
	}

	w := a.Downgrade()
	v := match a.TryUnwrap() { // alone: the value comes out
		Ok(v) => v,
		Err(r) => { expect.Fail("kept the only handle"); r.Get().Clone() },
	}
	expect.Equal(ref v, "only")
	expect.IsNone(w.Upgrade()) // the value is gone from the cell
}
