package math_test

import ("expect"; "math"; "testing")

// The square root, exact for a perfect square and for zero.
func TestSqrt() {
	expect.Equal(ref math.Sqrt(16.0), ref 4.0)
	expect.Equal(ref math.Sqrt(0.0), ref 0.0)
	expect.True(math.Abs(math.Sqrt(2.0)*math.Sqrt(2.0)-2.0) < 1e-12)
}

// Abs drops the sign, and Min and Max pick the smaller and the larger
// of two ordinary numbers.
func TestAbsMinMax() {
	expect.Equal(ref math.Abs(-2.5), ref 2.5)
	expect.Equal(ref math.Abs(2.5), ref 2.5)
	expect.Equal(ref math.Min(1.0, 2.0), ref 1.0)
	expect.Equal(ref math.Max(1.0, 2.0), ref 2.0)
	expect.Equal(ref math.Min(-0.5, 3.0), ref -0.5)
}

// Pi holds the digits a float holds.
func TestPi() {
	expect.True(math.Pi > 3.14159)
	expect.True(math.Pi < 3.1416)
}

// near reports whether got is within a few units in the last place of
// want, the precision the system's math library gives.
func near(got f64, want f64) bool {
	return math.Abs(got - want) <= 4e-15 * math.Max(1.0, math.Abs(want))
}

// E and Ln2 agree with the library's Exp and Log, and the float limits
// are the edges of their types: past the largest is an infinity, below
// the smallest is zero.
func TestConstants() {
	expect.True(near(math.E, math.Exp(1.0)))
	expect.True(near(math.Ln2, math.Log(2.0)))
	expect.True(math.MaxFloat64 > 1e308 && math.MaxFloat64 * 2.0 == math.Inf(1))
	expect.True(math.SmallestNonzeroFloat64 > 0.0 && math.SmallestNonzeroFloat64 / 2.0 == 0.0)
	expect.True(f64(math.MaxFloat32) > 3.4e38 && f64(math.SmallestNonzeroFloat32) < 1.5e-45)
}

// The integer limits hold their values, each in its own type, and one
// past a limit wraps in that type.
func TestLimits() {
	expect.Equal(ref math.MaxInt, ref 9223372036854775807)
	expect.Equal(ref math.MinInt, ref -9223372036854775808)
	expect.Equal(ref int(math.MaxInt8), ref 127)
	expect.Equal(ref int(math.MinInt8), ref -128)
	expect.Equal(ref int(math.MaxInt16), ref 32767)
	expect.Equal(ref int(math.MinInt16), ref -32768)
	expect.Equal(ref int(math.MaxInt32), ref 2147483647)
	expect.Equal(ref int(math.MinInt32), ref -2147483648)
	expect.Equal(ref int(math.MaxInt64), ref math.MaxInt)
	expect.Equal(ref int(math.MinInt64), ref math.MinInt)
	expect.Equal(ref int(math.MaxUint8), ref 255)
	expect.Equal(ref int(math.MaxUint16), ref 65535)
	expect.Equal(ref int(math.MaxUint32), ref 4294967295)
	expect.Equal(ref math.MaxUint64 + 1, ref 0) // one past the largest wraps to zero
	expect.Equal(ref math.MaxUint + 1, ref 0)
	a := math.MaxInt8
	a += 1
	expect.Equal(ref a, ref math.MinInt8) // a limit has its own type, and wraps in it
}

// Floor, Ceil, Trunc and Round on halves and fractions of either sign,
// a half going away from zero, and an infinity, a NaN and a negative
// zero kept.
func TestRounding() {
	expect.Equal(ref math.Floor(2.5), ref 2.0)
	expect.Equal(ref math.Floor(-2.5), ref -3.0)
	expect.Equal(ref math.Ceil(2.5), ref 3.0)
	expect.Equal(ref math.Ceil(-2.5), ref -2.0)
	expect.Equal(ref math.Trunc(2.9), ref 2.0)
	expect.Equal(ref math.Trunc(-2.9), ref -2.0)
	expect.Equal(ref math.Round(2.5), ref 3.0)   // a half goes away from zero
	expect.Equal(ref math.Round(-2.5), ref -3.0)
	expect.Equal(ref math.Round(2.4), ref 2.0)
	expect.Equal(ref math.Round(0.49999999999999994), ref 0.0)
	expect.Equal(ref math.Floor(math.Inf(-1)), ref math.Inf(-1))
	expect.True(math.IsNaN(math.Ceil(math.NaN())))
	expect.True(math.Signbit(math.Ceil(-0.5))) // -0
}

// The remainder has the sign of the first operand, and is NaN for a
// zero divisor or an infinite dividend.
func TestMod() {
	expect.Equal(ref math.Mod(7.0, 3.0), ref 1.0)
	expect.Equal(ref math.Mod(-7.0, 3.0), ref -1.0) // the sign of the first
	expect.Equal(ref math.Mod(7.0, -3.0), ref 1.0)
	expect.Equal(ref math.Mod(5.5, 2.0), ref 1.5)
	expect.Equal(ref math.Mod(3.0, math.Inf(1)), ref 3.0)
	expect.True(math.IsNaN(math.Mod(1.0, 0.0)))
	expect.True(math.IsNaN(math.Mod(math.Inf(1), 2.0)))
}

// Pow, Cbrt, Hypot and Exp on ordinary arguments and on the special
// cases IEEE 754 sets for them.
func TestPowers() {
	expect.True(near(math.Pow(2.0, 10.0), 1024.0))
	expect.True(near(math.Pow(2.0, -1.0), 0.5))
	expect.True(near(math.Pow(-2.0, 3.0), -8.0))
	expect.Equal(ref math.Pow(math.NaN(), 0.0), ref 1.0) // anything to the power zero is one
	expect.Equal(ref math.Pow(0.0, -1.0), ref math.Inf(1))
	expect.True(math.IsNaN(math.Pow(-8.0, 0.5)))
	expect.True(near(math.Cbrt(27.0), 3.0)) // within a unit in the last place, as the system computes it
	expect.True(near(math.Cbrt(-8.0), -2.0))
	expect.True(near(math.Hypot(3.0, 4.0), 5.0))
	expect.True(near(math.Hypot(3e200, 4e200) / 1e200, 5.0)) // no overflow on the way
	expect.Equal(ref math.Hypot(math.Inf(-1), math.NaN()), ref math.Inf(1))
	expect.Equal(ref math.Exp(0.0), ref 1.0)
	expect.Equal(ref math.Exp(math.Inf(-1)), ref 0.0)
	expect.True(near(math.Exp(2.0), 7.38905609893065))
}

// The three logarithms on ordinary arguments, -Inf for zero, NaN for a
// negative argument and +Inf for +Inf.
func TestLogarithms() {
	expect.Equal(ref math.Log(1.0), ref 0.0)
	expect.True(near(math.Log(10.0), 2.302585092994046))
	expect.True(near(math.Log2(8.0), 3.0))
	expect.True(near(math.Log10(1000.0), 3.0))
	expect.Equal(ref math.Log(0.0), ref math.Inf(-1))
	expect.True(math.IsNaN(math.Log(-1.0)))
	expect.True(math.IsNaN(math.Log2(-1.0)))
	expect.Equal(ref math.Log10(math.Inf(1)), ref math.Inf(1))
}

// The circular and hyperbolic functions and their inverses at known
// angles, Atan2 in each quadrant, and NaN outside a domain.
func TestTrigonometry() {
	expect.Equal(ref math.Sin(0.0), ref 0.0)
	expect.Equal(ref math.Cos(0.0), ref 1.0)
	expect.Equal(ref math.Tan(0.0), ref 0.0)
	expect.True(near(math.Sin(math.Pi / 6.0), 0.5))
	expect.True(near(math.Cos(math.Pi / 3.0), 0.5))
	expect.True(near(math.Tan(math.Pi / 4.0), 1.0))
	expect.True(near(math.Asin(1.0), math.Pi / 2.0))
	expect.True(near(math.Acos(-1.0), math.Pi))
	expect.True(near(math.Atan(1.0), math.Pi / 4.0))
	expect.True(near(math.Atan2(1.0, -1.0), 3.0 * math.Pi / 4.0)) // the quadrant the signs say
	expect.True(near(math.Atan2(-1.0, -1.0), -3.0 * math.Pi / 4.0))
	expect.Equal(ref math.Atan2(0.0, 1.0), ref 0.0)
	expect.True(math.IsNaN(math.Asin(2.0)))
	expect.True(math.IsNaN(math.Acos(-2.0)))
	expect.True(math.IsNaN(math.Sin(math.Inf(1))))
	expect.Equal(ref math.Sinh(0.0), ref 0.0)
	expect.Equal(ref math.Cosh(0.0), ref 1.0)
	expect.Equal(ref math.Tanh(math.Inf(1)), ref 1.0)
	expect.True(near(math.Sinh(1.0), 1.1752011936438014))
	expect.True(near(math.Cosh(1.0), 1.5430806348152437))
	expect.True(near(math.Tanh(1.0), 0.7615941559557649))
}

// Inf, NaN, IsNaN and IsInf with each sign: a NaN equals nothing,
// itself included.
func TestInfAndNaN() {
	expect.True(math.Inf(1) > math.MaxFloat64)
	expect.True(math.Inf(0) > math.MaxFloat64)
	expect.True(math.Inf(-1) < -math.MaxFloat64)
	nan := math.NaN()
	expect.True(nan != nan)
	expect.True(math.IsNaN(nan))
	expect.False(math.IsNaN(1.0))
	expect.False(math.IsNaN(math.Inf(1)))
	expect.True(math.IsInf(math.Inf(1), 1))
	expect.True(math.IsInf(math.Inf(1), 0))
	expect.False(math.IsInf(math.Inf(1), -1))
	expect.True(math.IsInf(math.Inf(-1), -1))
	expect.True(math.IsInf(math.Inf(-1), 0))
	expect.False(math.IsInf(math.Inf(-1), 1))
	expect.False(math.IsInf(math.MaxFloat64, 0))
	expect.False(math.IsInf(nan, 0))
}

// Signbit reads the sign bit, a negative zero's included, and Copysign
// gives a magnitude the sign of another value.
func TestSigns() {
	expect.True(math.Signbit(-1.0))
	expect.True(math.Signbit(math.Copysign(0.0, -1.0))) // negative zero
	expect.True(math.Signbit(math.Inf(-1)))
	expect.False(math.Signbit(0.0))
	expect.False(math.Signbit(1.0))
	expect.Equal(ref math.Copysign(3.0, -1.0), ref -3.0)
	expect.Equal(ref math.Copysign(-3.0, 1.0), ref 3.0)
	expect.Equal(ref math.Copysign(3.0, math.Inf(-1)), ref -3.0)
	expect.Equal(ref math.Sqrt(math.Inf(1)), ref math.Inf(1))
	expect.True(math.IsNaN(math.Sqrt(-1.0)))
}

// Sqrt in a loop where each result feeds the next call.
func BenchmarkSqrt() {
	x := 2.0
	for testing.Loop() { x = math.Sqrt(x + 1.0) }
}

// Floor in a loop where each result feeds the next call.
func BenchmarkFloor() {
	x := 0.5
	for testing.Loop() { x = math.Floor(x + 1.5) }
}

// Pow in a loop where each result feeds the next call.
func BenchmarkPow() {
	x := 1.0001
	for testing.Loop() { x = math.Pow(x, 0.999) + 0.5 }
}

// The bits of a float and back: the encoding of one, a negative zero,
// the smallest subnormal, and a round trip through both widths.
func TestFloatBits() {
	expect.Equal(ref math.Float64bits(1.0), ref u64(0x3ff0000000000000))
	expect.Equal(ref math.Float64bits(-0.0), ref u64(0x8000000000000000))
	expect.Equal(ref math.Float64bits(math.SmallestNonzeroFloat64), ref u64(1))
	expect.Equal(ref math.Float64frombits(0x4000000000000000), ref 2.0)
	expect.Equal(ref math.Float64frombits(math.Float64bits(math.Pi)), ref math.Pi)
	expect.Equal(ref math.Float32bits(f32(1.0)), ref u32(0x3f800000))
	expect.Equal(ref math.Float32frombits(0x40000000), ref f32(2.0))
	expect.True(math.IsNaN(math.Float64frombits(0x7ff8000000000001)))
	bits := math.Float64bits // as a value
	expect.Equal(ref bits(0.5), ref u64(0x3fe0000000000000))
}

// Frexp and Ldexp take a float apart into a fraction and a power of two
// and put it together, with the special cases settled.
func TestFrexpLdexp() {
	frac, exp := math.Frexp(8)
	expect.Equal(ref frac, ref 0.5)
	expect.Equal(ref exp, ref 4)
	frac, exp = math.Frexp(-0.75)
	expect.Equal(ref frac, ref -0.75)
	expect.Equal(ref exp, ref 0)
	frac, exp = math.Frexp(0)
	expect.Equal(ref frac, ref 0.0)
	expect.Equal(ref exp, ref 0)
	frac, exp = math.Frexp(math.Inf(1))
	expect.True(math.IsInf(frac, 1))
	expect.Equal(ref exp, ref 0)
	frac, exp = math.Frexp(math.NaN())
	expect.True(math.IsNaN(frac))
	expect.Equal(ref exp, ref 0)
	frac, exp = math.Frexp(math.SmallestNonzeroFloat64)
	expect.Equal(ref frac, ref 0.5)
	expect.Equal(ref exp, ref -1073)
	expect.Equal(ref math.Ldexp(0.5, 4), ref 8.0)
	expect.Equal(ref math.Ldexp(frac, exp), ref math.SmallestNonzeroFloat64)
	expect.True(math.IsInf(math.Ldexp(1, 5000), 1))
	expect.Equal(ref math.Ldexp(1, -5000), ref 0.0)
	expect.True(math.IsInf(math.Ldexp(-1, 9223372036854775807), -1)) // an exponent past any int the library takes
	expect.Equal(ref math.Ldexp(1, -9223372036854775808), ref 0.0)
}

// Modf splits a float into its whole part and its fraction, both with
// its sign; Remainder and FMA are the IEEE operations.
func TestModfRemainderFMA() {
	whole, frac := math.Modf(-2.5)
	expect.Equal(ref whole, ref -2.0)
	expect.Equal(ref frac, ref -0.5)
	whole, frac = math.Modf(3)
	expect.Equal(ref whole, ref 3.0)
	expect.Equal(ref frac, ref 0.0)
	whole, frac = math.Modf(math.Inf(-1))
	expect.True(math.IsInf(whole, -1))
	expect.True(math.IsNaN(frac))
	whole, frac = math.Modf(math.NaN())
	expect.True(math.IsNaN(whole))
	expect.True(math.IsNaN(frac))
	expect.Equal(ref math.Remainder(7, 4), ref -1.0) // 7 is nearer to 8 than to 4
	expect.Equal(ref math.Remainder(5, 2), ref 1.0)  // a tie goes to the even multiple, 4
	expect.Equal(ref math.Remainder(-7, 4), ref 1.0)
	expect.True(math.IsNaN(math.Remainder(1, 0)))
	expect.True(math.IsNaN(math.Remainder(math.Inf(1), 2)))
	expect.Equal(ref math.Remainder(3, math.Inf(1)), ref 3.0)
	expect.Equal(ref math.FMA(2, 3, 4), ref 10.0)
	expect.Equal(ref math.FMA(0.1, 10, -1), ref 5.551115123125783e-17) // rounded once: the product's excess over one survives, where 0.1*10 - 1 written out is 0
}

// The exponentials, logarithms and hyperbolic functions near their
// hard points, and the gamma and error functions at known values.
func TestMoreFunctions() {
	expect.Equal(ref math.Expm1(0), ref 0.0)
	expect.True(math.Abs(math.Expm1(1e-10)-1.00000000005e-10) < 1e-25)
	expect.Equal(ref math.Expm1(math.Inf(-1)), ref -1.0)
	expect.Equal(ref math.Log1p(0), ref 0.0)
	expect.True(math.Abs(math.Log1p(1e-10)-9.9999999995e-11) < 1e-25)
	expect.True(math.IsInf(math.Log1p(-1), -1))
	expect.True(math.IsNaN(math.Log1p(-2)))
	expect.Equal(ref math.Exp2(10), ref 1024.0)
	expect.Equal(ref math.Exp2(-1), ref 0.5)
	expect.Equal(ref math.Asinh(0), ref 0.0)
	expect.True(math.Abs(math.Asinh(1)-0.881373587019543) < 1e-15)
	expect.Equal(ref math.Acosh(1), ref 0.0)
	expect.True(math.IsNaN(math.Acosh(0.5)))
	expect.True(math.Abs(math.Acosh(2)-1.3169578969248166) < 1e-15)
	expect.Equal(ref math.Atanh(0), ref 0.0)
	expect.True(math.IsInf(math.Atanh(1), 1))
	expect.True(math.IsInf(math.Atanh(-1), -1))
	expect.True(math.IsNaN(math.Atanh(2)))
	expect.True(math.Abs(math.Atanh(0.5)-0.5493061443340548) < 1e-15)
	expect.Equal(ref math.Gamma(5), ref 24.0)
	expect.Equal(ref math.Gamma(1), ref 1.0)
	expect.True(math.Abs(math.Gamma(0.5)-1.7724538509055159) < 1e-15) // the square root of pi
	expect.True(math.IsInf(math.Gamma(0), 1))
	expect.True(math.IsInf(math.Gamma(-0.0), -1))
	expect.True(math.IsNaN(math.Gamma(-2)))
	expect.True(math.IsNaN(math.Gamma(math.Inf(-1))))
	expect.True(math.IsInf(math.Gamma(math.Inf(1)), 1))
	expect.True(math.IsInf(math.Gamma(172), 1)) // past the largest double
	lg, sign := math.Lgamma(5)
	expect.True(math.Abs(lg-math.Log(24)) < 1e-14)
	expect.Equal(ref sign, ref 1)
	lg, sign = math.Lgamma(-0.5) // the gamma function is negative between -1 and 0
	expect.True(math.Abs(lg-1.2655121234846454) < 1e-14)
	expect.Equal(ref sign, ref -1)
	lg, sign = math.Lgamma(-1.5) // and positive between -2 and -1
	expect.Equal(ref sign, ref 1)
	lg, sign = math.Lgamma(-2.5)
	expect.Equal(ref sign, ref -1)
	lg, sign = math.Lgamma(0)
	expect.True(math.IsInf(lg, 1))
	expect.Equal(ref sign, ref 1)
	lg, sign = math.Lgamma(-3)
	expect.True(math.IsInf(lg, 1))
	expect.Equal(ref sign, ref 1)
	lg, sign = math.Lgamma(math.Inf(1))
	expect.True(math.IsInf(lg, 1))
	lg, sign = math.Lgamma(math.NaN())
	expect.True(math.IsNaN(lg))
	expect.Equal(ref sign, ref 1)
	expect.Equal(ref math.Erf(0), ref 0.0)
	expect.Equal(ref math.Erf(math.Inf(1)), ref 1.0)
	expect.Equal(ref math.Erf(math.Inf(-1)), ref -1.0)
	expect.True(math.Abs(math.Erf(1)-0.8427007929497149) < 1e-15)
	expect.True(math.Abs(math.Erf(-1)+0.8427007929497149) < 1e-15)
	expect.Equal(ref math.Erfc(0), ref 1.0)
	expect.Equal(ref math.Erfc(math.Inf(1)), ref 0.0)
	expect.Equal(ref math.Erfc(math.Inf(-1)), ref 2.0)
	expect.True(math.Erfc(26) > 0 && math.Erfc(26) < 1e-290) // where 1 - Erf(26) would be zero
	// One value in each range of the ported algorithms.
	expect.Equal(ref math.Erf(0.5), ref 0.5204998778130465)   // below 0.84375
	expect.Equal(ref math.Erf(1), ref 0.8427007929497149)     // 0.84375 to 1.25
	expect.Equal(ref math.Erf(3), ref 0.9999779095030014)     // 1.25 to 6, above 1/0.35
	expect.Equal(ref math.Erfc(3), ref 2.2090496998585438e-05)
	expect.Equal(ref math.Erfc(-0.5), ref 1.5204998778130465)
	expect.Equal(ref math.Gamma(-0.5), ref -3.5449077018110318) // the recurrence from below zero
	expect.Equal(ref math.Gamma(-2.5), ref -0.9453087204829419)
	expect.Equal(ref math.Gamma(-40.5), ref -6.031660822178509e-49) // the reflection formula with Stirling's
	expect.Equal(ref math.Gamma(171), ref 7.257415615308e+306)      // Stirling's, split before the power overflows
	expect.Equal(ref math.Gamma(1e-10), ref 9.999999999422785e+09)  // near zero
	lg, sign = math.Lgamma(-40.5) // the reflection formula
	expect.Equal(ref lg, ref -111.02964715732847)
	expect.Equal(ref sign, ref -1)
	lg, sign = math.Lgamma(100) // the asymptotic series, 8 to 2^58
	expect.Equal(ref lg, ref 359.13420536957545)
	lg, sign = math.Lgamma(1e20)
	expect.Equal(ref lg, ref 4.5051701859880917e+21)
	lg, sign = math.Lgamma(-0.0)
	expect.True(math.IsInf(lg, 1))
	expect.Equal(ref sign, ref 1)
	expect.Equal(ref math.Asinh(1e300), ref 691.4686750787736) // past 2^28: log(2x)
	expect.Equal(ref math.Asinh(3), ref 1.8184464592320668)    // above 2
	expect.True(math.IsInf(math.Asinh(math.Inf(1)), 1))
	expect.True(math.IsInf(math.Asinh(math.Inf(-1)), -1))
	expect.Equal(ref math.Atanh(0.999), ref 3.8002011672501994) // at and above 0.5
	expect.True(math.IsInf(math.Expm1(math.Inf(1)), 1))
	expect.True(math.IsInf(math.Acosh(math.Inf(1)), 1))
	expect.Equal(ref math.Ldexp(-1, -5000), ref -0.0)
	expect.True(math.Signbit(math.Ldexp(-1, -5000))) // an underflow keeps the sign
}

// Nextafter steps to the neighbouring float, Pow10 is exact over the
// whole range of a double, and Dim is the positive difference.
func TestNextafterPow10Dim() {
	expect.Equal(ref math.Nextafter(1, 2), ref 1.0000000000000002)
	expect.Equal(ref math.Nextafter(1, 0), ref 0.9999999999999999)
	expect.Equal(ref math.Nextafter(1, 1), ref 1.0)
	expect.Equal(ref math.Nextafter(0, 1), ref math.SmallestNonzeroFloat64)
	expect.Equal(ref math.Nextafter(math.MaxFloat64, math.Inf(1)), ref math.Inf(1))
	expect.True(math.IsNaN(math.Nextafter(1, math.NaN())))
	expect.True(math.IsNaN(math.Nextafter(math.NaN(), 1)))
	expect.Equal(ref math.Pow10(0), ref 1.0)
	expect.Equal(ref math.Pow10(3), ref 1000.0)
	expect.Equal(ref math.Pow10(22), ref 1e22)
	expect.Equal(ref math.Pow10(308), ref 1e308)
	expect.Equal(ref math.Pow10(-5), ref 1e-5)
	expect.Equal(ref math.Pow10(-323), ref 1e-323)
	expect.Equal(ref math.Pow10(-324), ref 0.0)
	expect.True(math.IsInf(math.Pow10(309), 1))
	expect.True(math.IsInf(math.Pow10(9223372036854775807), 1))
	expect.Equal(ref math.Pow10(-9223372036854775808), ref 0.0)
	expect.Equal(ref math.Dim(5, 3), ref 2.0)
	expect.Equal(ref math.Dim(3, 5), ref 0.0)
	expect.Equal(ref math.Dim(3, 3), ref 0.0)
	expect.True(math.IsNaN(math.Dim(math.Inf(1), math.Inf(1))))
	expect.True(math.IsNaN(math.Dim(math.Inf(-1), math.Inf(-1))))
	expect.True(math.IsNaN(math.Dim(1, math.NaN())))
	expect.True(math.IsNaN(math.Dim(math.NaN(), 1)))
	expect.Equal(ref math.Dim(math.Inf(1), 1), ref math.Inf(1))
}

// BenchmarkExpm1 measures e^x - 1 near zero.
func BenchmarkExpm1() {
	for testing.Loop() { _ = math.Expm1(1e-5) }
}

// BenchmarkGamma measures the gamma function of a non-integer.
func BenchmarkGamma() {
	for testing.Loop() { _ = math.Gamma(4.5) }
}

// BenchmarkFloat64bits measures a copy of a float's bits and back.
func BenchmarkFloat64bits() {
	x := 1.5
	for testing.Loop() { x = math.Float64frombits(math.Float64bits(x) + 1) }
}
