// Package bits counts and moves the bits of the unsigned integer
// types: LeadingZeros, TrailingZeros, OnesCount, RotateLeft, Reverse
// and Len, each for uint and, with the width in its name, for u8, u16,
// u32 and u64, and ReverseBytes for uint, u16, u32 and u64; and it
// works on two words at once: Add64, Sub64 and Mul64, the sum with its
// carry, the difference with its borrow and the two halves of a
// product, and Div64, a 128-bit number divided.
//
// Every function but Div64 is one instruction of the processor's, or a
// few, which the compiler writes in place of a call: none is a call
// when the program runs, and the bodies Add64, Sub64 and Mul64 have
// here serve a program that keeps one as a value and calls it through
// the value. Div64 checks its arguments and divides in the runtime.
// Each function is defined for every argument, zero included, and none
// panics. Each takes its arguments by value, since the integers are
// Copy, allocates nothing and runs in constant time.
//
//	n := bits.OnesCount8(0b1011_0000) // 3
package bits

// LeadingZeros returns the number of zero bits above the highest one
// bit of x, a uint of 64 bits: 0 when the top bit is set, and 64 for a
// zero x, which has no one bit at all. Width minus LeadingZeros is
// Len.
//
//	bits.LeadingZeros(1) // 63
func LeadingZeros(x uint) int

// LeadingZeros8 returns the number of zero bits above the highest one
// bit of the u8 x, and 8 for a zero x.
//
//	bits.LeadingZeros8(1) // 7
func LeadingZeros8(x u8) int

// LeadingZeros16 returns the number of zero bits above the highest one
// bit of the u16 x, and 16 for a zero x.
func LeadingZeros16(x u16) int

// LeadingZeros32 returns the number of zero bits above the highest one
// bit of the u32 x, and 32 for a zero x.
func LeadingZeros32(x u32) int

// LeadingZeros64 returns the number of zero bits above the highest one
// bit of the u64 x, and 64 for a zero x.
func LeadingZeros64(x u64) int

// TrailingZeros returns the number of zero bits below the lowest one
// bit of x, a uint of 64 bits: 0 for an odd x, and 64 for a zero x,
// which has no one bit at all. For a nonzero x it is the exponent of
// the largest power of two that divides x.
//
//	bits.TrailingZeros(8) // 3
func TrailingZeros(x uint) int

// TrailingZeros8 returns the number of zero bits below the lowest one
// bit of the u8 x, and 8 for a zero x.
//
//	bits.TrailingZeros8(128) // 7
func TrailingZeros8(x u8) int

// TrailingZeros16 returns the number of zero bits below the lowest one
// bit of the u16 x, and 16 for a zero x.
func TrailingZeros16(x u16) int

// TrailingZeros32 returns the number of zero bits below the lowest one
// bit of the u32 x, and 32 for a zero x.
func TrailingZeros32(x u32) int

// TrailingZeros64 returns the number of zero bits below the lowest one
// bit of the u64 x, and 64 for a zero x.
func TrailingZeros64(x u64) int

// OnesCount returns the number of one bits in x, a uint of 64 bits,
// from 0 for zero to 64 for a uint with every bit set: the population
// count, which the processor counts in one instruction where it has
// one.
//
//	bits.OnesCount(0b1011) // 3
func OnesCount(x uint) int

// OnesCount8 returns the number of one bits in the u8 x, from 0 to 8.
//
//	bits.OnesCount8(255) // 8
func OnesCount8(x u8) int

// OnesCount16 returns the number of one bits in the u16 x, from 0 to
// 16.
func OnesCount16(x u16) int

// OnesCount32 returns the number of one bits in the u32 x, from 0 to
// 32.
func OnesCount32(x u32) int

// OnesCount64 returns the number of one bits in the u64 x, from 0 to
// 64.
func OnesCount64(x u64) int

// RotateLeft returns x, a uint of 64 bits, rotated left by k bits: the
// bits leaving at the top come back at the bottom, so none is lost. A
// negative k rotates right by -k, and a k of 64 or more, or of -64 or
// less, turns as k modulo 64 does, so every k is a rotation.
//
//	bits.RotateLeft(1, 63)  // 1 << 63
//	bits.RotateLeft(1, -1)  // 1 << 63 as well
func RotateLeft(x uint, k int) uint

// RotateLeft8 returns the u8 x rotated left by k bits, the bits
// leaving at the top coming back at the bottom; a negative k rotates
// right by -k, and k turns modulo 8.
//
//	bits.RotateLeft8(0x81, 1) // 0x03
func RotateLeft8(x u8, k int) u8

// RotateLeft16 returns the u16 x rotated left by k bits, the bits
// leaving at the top coming back at the bottom; a negative k rotates
// right by -k, and k turns modulo 16.
func RotateLeft16(x u16, k int) u16

// RotateLeft32 returns the u32 x rotated left by k bits, the bits
// leaving at the top coming back at the bottom; a negative k rotates
// right by -k, and k turns modulo 32.
func RotateLeft32(x u32, k int) u32

// RotateLeft64 returns the u64 x rotated left by k bits, the bits
// leaving at the top coming back at the bottom; a negative k rotates
// right by -k, and k turns modulo 64.
func RotateLeft64(x u64, k int) u64

// Reverse returns x, a uint of 64 bits, with its bits in the opposite
// order: bit 0 becomes bit 63, bit 1 bit 62, and so on. Reversing
// twice gives x back.
//
//	bits.Reverse(1) // 1 << 63
func Reverse(x uint) uint

// Reverse8 returns the u8 x with its bits in the opposite order, bit 0
// becoming bit 7.
//
//	bits.Reverse8(0x0f) // 0xf0
func Reverse8(x u8) u8

// Reverse16 returns the u16 x with its bits in the opposite order, bit
// 0 becoming bit 15.
func Reverse16(x u16) u16

// Reverse32 returns the u32 x with its bits in the opposite order, bit
// 0 becoming bit 31.
func Reverse32(x u32) u32

// Reverse64 returns the u64 x with its bits in the opposite order, bit
// 0 becoming bit 63.
func Reverse64(x u64) u64

// Len returns the number of bits needed to write x, a uint of 64 bits:
// one more than the position of its highest one bit, and 0 for zero,
// which needs none. It is 64 minus LeadingZeros(x).
//
//	bits.Len(255) // 8
//	bits.Len(256) // 9
func Len(x uint) int

// Len8 returns the number of bits needed to write the u8 x, from 0 for
// zero to 8.
func Len8(x u8) int

// Len16 returns the number of bits needed to write the u16 x, from 0
// for zero to 16.
func Len16(x u16) int

// Len32 returns the number of bits needed to write the u32 x, from 0
// for zero to 32.
func Len32(x u32) int

// Len64 returns the number of bits needed to write the u64 x, from 0
// for zero to 64.
func Len64(x u64) int

// ReverseBytes returns x, a uint of 64 bits, with its bytes in the
// opposite order: the lowest byte becomes the highest. It turns a
// number between the two byte orders, one instruction.
//
//	bits.ReverseBytes(0x0102) // 0x0201000000000000
func ReverseBytes(x uint) uint

// ReverseBytes16 returns the u16 x with its two bytes swapped.
func ReverseBytes16(x u16) u16

// ReverseBytes32 returns the u32 x with its bytes in the opposite order.
func ReverseBytes32(x u32) u32

// ReverseBytes64 returns the u64 x with its bytes in the opposite order.
func ReverseBytes64(x u64) u64

// Add64 returns the sum of x, y and carry, which is 0 or 1, and the
// carry out of the sum, 0 or 1: the sum wraps at 2^64 and the carry
// says it did. A chain of Add64 calls adds numbers of many words, each
// word's carry into the next.
//
//	sum, carry := bits.Add64(x, y, 0)
func Add64(x, y, carry u64) (u64, u64) {
	sum := x + y + carry
	carryOut := ((x & y) | ((x | y) &^ sum)) >> 63 // a carry out when both top bits were set, or one was and the sum's is not
	return (sum, carryOut)
}

// Sub64 returns the difference x - y - borrow, borrow being 0 or 1,
// and the borrow out of it, 0 or 1: the difference wraps below zero
// and the borrow says it did, so a chain of Sub64 calls subtracts
// numbers of many words.
//
//	diff, borrow := bits.Sub64(x, y, 0)
func Sub64(x, y, borrow u64) (u64, u64) {
	diff := x - y - borrow
	borrowOut := ((^x & y) | (^(x ^ y) & diff)) >> 63 // a borrow when y's top bit is set and x's not, or the two are alike and the difference's is set
	return (diff, borrowOut)
}

// Mul64 returns the 128-bit product of x and y as its high and low
// halves, one multiply instruction; the low half alone is x * y.
//
//	hi, lo := bits.Mul64(x, y)
func Mul64(x, y u64) (u64, u64) {
	lo := u64(0)
	hi := mul64(x, y, mut lo)
	return (hi, lo)
}

// Div64 divides the 128-bit number whose halves are hi and lo by y and
// returns the quotient and the remainder, or None when y is zero or
// the quotient does not fit 64 bits, which is when hi is not below y.
//
//	quo, rem := bits.Div64(hi, lo, y) ?? return
func Div64(hi, lo, y u64) (u64, u64)? {
	if y == 0 || y <= hi {
		return None
	}

	rem := u64(0)
	quo := div64(hi, lo, y, mut rem)
	return Some((quo, rem))
}

// mul64 returns the high half of the 128-bit product of x and y and
// stores the low half. The runtime provides it.
func mul64(x, y u64, lo mut u64) u64

// div64 returns the quotient of the 128-bit number hi, lo by y, which
// is not zero and above hi, and stores the remainder. The runtime
// provides it.
func div64(hi, lo, y u64, rem mut u64) u64
