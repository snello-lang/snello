package bits_test

import ("expect"; "math/bits"; "testing")

// The zeros above the highest one bit, at each width, and the whole
// width for zero.
func TestLeadingZeros() {
	expect.Equal(ref bits.LeadingZeros(0), ref 64) // zero has the width in zeros
	expect.Equal(ref bits.LeadingZeros(1), ref 63)
	expect.Equal(ref bits.LeadingZeros(18446744073709551615), ref 0)
	expect.Equal(ref bits.LeadingZeros8(0), ref 8)
	expect.Equal(ref bits.LeadingZeros8(1), ref 7)
	expect.Equal(ref bits.LeadingZeros8(255), ref 0)
	expect.Equal(ref bits.LeadingZeros16(0), ref 16)
	expect.Equal(ref bits.LeadingZeros16(256), ref 7)
	expect.Equal(ref bits.LeadingZeros32(0), ref 32)
	expect.Equal(ref bits.LeadingZeros32(65536), ref 15)
	expect.Equal(ref bits.LeadingZeros64(0), ref 64)
	expect.Equal(ref bits.LeadingZeros64(4294967296), ref 31)
}

// The zeros below the lowest one bit, at each width, and the whole
// width for zero.
func TestTrailingZeros() {
	expect.Equal(ref bits.TrailingZeros(0), ref 64)
	expect.Equal(ref bits.TrailingZeros(8), ref 3)
	expect.Equal(ref bits.TrailingZeros8(0), ref 8)
	expect.Equal(ref bits.TrailingZeros8(128), ref 7)
	expect.Equal(ref bits.TrailingZeros16(0), ref 16)
	expect.Equal(ref bits.TrailingZeros16(32768), ref 15)
	expect.Equal(ref bits.TrailingZeros32(0), ref 32)
	expect.Equal(ref bits.TrailingZeros32(2147483648), ref 31)
	expect.Equal(ref bits.TrailingZeros64(0), ref 64)
	expect.Equal(ref bits.TrailingZeros64(9223372036854775808), ref 63)
}

// The one bits counted at each width, from none to every bit set.
func TestOnesCount() {
	expect.Equal(ref bits.OnesCount(0), ref 0)
	expect.Equal(ref bits.OnesCount(18446744073709551615), ref 64)
	expect.Equal(ref bits.OnesCount8(255), ref 8)
	expect.Equal(ref bits.OnesCount8(0x5a), ref 4)
	expect.Equal(ref bits.OnesCount16(65535), ref 16)
	expect.Equal(ref bits.OnesCount32(4294967295), ref 32)
	expect.Equal(ref bits.OnesCount64(0x123456789abcdef0), ref 32)
}

// The bits needed to write a number at each width, none for zero and
// one more at each power of two.
func TestLen() {
	expect.Equal(ref bits.Len(0), ref 0)
	expect.Equal(ref bits.Len(1), ref 1)
	expect.Equal(ref bits.Len(255), ref 8)
	expect.Equal(ref bits.Len(256), ref 9)
	expect.Equal(ref bits.Len8(0), ref 0)
	expect.Equal(ref bits.Len8(255), ref 8)
	expect.Equal(ref bits.Len16(65535), ref 16)
	expect.Equal(ref bits.Len32(4294967295), ref 32)
	expect.Equal(ref bits.Len64(18446744073709551615), ref 64)
}

// A rotation brings the bits leaving at one end back at the other; a
// negative count turns right and any count turns modulo the width,
// whether the compiler knows it or not.
func TestRotateLeft() {
	expect.Equal(ref bits.RotateLeft8(0x81, 1), ref 0x03)
	expect.Equal(ref bits.RotateLeft8(0x81, -1), ref 0xc0) // a negative count turns right
	expect.Equal(ref bits.RotateLeft8(0x81, 0), ref 0x81)
	expect.Equal(ref bits.RotateLeft8(0x81, 8), ref 0x81)  // the count is taken modulo the width
	expect.Equal(ref bits.RotateLeft8(0x81, 9), ref 0x03)
	expect.Equal(ref bits.RotateLeft8(0x81, -1000), ref 0x81)
	expect.Equal(ref bits.RotateLeft16(0x8001, 4), ref 0x0018)
	expect.Equal(ref bits.RotateLeft16(0x8001, -4), ref 0x1800)
	expect.Equal(ref bits.RotateLeft32(0xf000000f, 4), ref 0x000000ff)
	expect.Equal(ref bits.RotateLeft32(0xf000000f, -4), ref 0xff000000)
	expect.Equal(ref bits.RotateLeft64(0x8000000000000001, 1), ref 3)
	expect.Equal(ref bits.RotateLeft64(1, 64), ref 1)
	expect.Equal(ref bits.RotateLeft64(1, -1), ref 9223372036854775808)
	expect.Equal(ref bits.RotateLeft(1, 63), ref 9223372036854775808)
	k := 65
	expect.Equal(ref bits.RotateLeft(1, k), ref 2) // a count the compiler does not know
	expect.Equal(ref bits.RotateLeft(1, -k), ref 9223372036854775808)
}

// The bits in the opposite order at each width, and reversing twice
// gives the number back.
func TestReverse() {
	expect.Equal(ref bits.Reverse8(0x01), ref 0x80)
	expect.Equal(ref bits.Reverse8(0x5a), ref 0x5a)
	expect.Equal(ref bits.Reverse8(0x0f), ref 0xf0)
	expect.Equal(ref bits.Reverse16(0x0001), ref 0x8000)
	expect.Equal(ref bits.Reverse16(0x1234), ref 0x2c48)
	expect.Equal(ref bits.Reverse32(0x12345678), ref 0x1e6a2c48)
	expect.Equal(ref bits.Reverse64(1), ref 9223372036854775808)
	expect.Equal(ref bits.Reverse64(0x123456789abcdef0), ref 0x0f7b3d591e6a2c48)
	expect.Equal(ref bits.Reverse(0), ref 0)
	expect.Equal(ref bits.Reverse(bits.Reverse(0xdeadbeef)), ref 0xdeadbeef)
}

// count calls f through its value: a function of the package is one a
// program may keep and hand on.
func count(f func(u64) int, x u64) int { return f(x) }

// A function of the package is a value a program keeps and calls later,
// though the compiler writes each call in place.
func TestAsValues() {
	f := bits.OnesCount64
	expect.Equal(ref count(f, 255), ref 8)
	expect.Equal(ref count(bits.Len64, 255), ref 8)
	expect.Equal(ref count(bits.LeadingZeros64, 0), ref 64)
	expect.Equal(ref count(bits.TrailingZeros64, 0), ref 64)
	g := bits.RotateLeft8
	expect.Equal(ref g(0x81, -1), ref 0xc0)
	h := bits.Reverse16
	expect.Equal(ref h(0x1234), ref 0x2c48)
}

// OnesCount64 in a loop whose input depends on the last result, so that
// no call is folded away.
func BenchmarkOnesCount() {
	var x u64 = 0x123456789abcdef0
	n := 0
	for testing.Loop() {
		n += bits.OnesCount64(x)
		x += u64(n)
	}
}

// ReverseBytes swaps a value's bytes end for end, at each width, and
// twice gives the value back.
func TestReverseBytes() {
	expect.Equal(ref bits.ReverseBytes(0x0102), ref uint(0x0201000000000000))
	expect.Equal(ref bits.ReverseBytes16(0x0102), ref u16(0x0201))
	expect.Equal(ref bits.ReverseBytes32(0x01020304), ref u32(0x04030201))
	expect.Equal(ref bits.ReverseBytes64(0x0102030405060708), ref u64(0x0807060504030201))
	expect.Equal(ref bits.ReverseBytes64(bits.ReverseBytes64(0xdeadbeefcafef00d)), ref u64(0xdeadbeefcafef00d))
	expect.Equal(ref bits.ReverseBytes32(0), ref u32(0))
	r := bits.ReverseBytes16 // as a value
	expect.Equal(ref r(0xff00), ref u16(0x00ff))
}

// Add64 and Sub64 carry and borrow across words: the wrap and its
// report, in both directions, and a chain adding two-word numbers.
func TestAddSub64() {
	sum, carry := bits.Add64(1, 2, 0)
	expect.Equal(ref sum, ref u64(3))
	expect.Equal(ref carry, ref u64(0))
	sum, carry = bits.Add64(18446744073709551615, 1, 0)
	expect.Equal(ref sum, ref u64(0))
	expect.Equal(ref carry, ref u64(1))
	sum, carry = bits.Add64(18446744073709551615, 18446744073709551615, 1)
	expect.Equal(ref sum, ref u64(18446744073709551615))
	expect.Equal(ref carry, ref u64(1))
	sum, carry = bits.Add64(0x8000000000000000, 0x8000000000000000, 0)
	expect.Equal(ref sum, ref u64(0))
	expect.Equal(ref carry, ref u64(1))
	diff, borrow := bits.Sub64(3, 2, 0)
	expect.Equal(ref diff, ref u64(1))
	expect.Equal(ref borrow, ref u64(0))
	diff, borrow = bits.Sub64(0, 1, 0)
	expect.Equal(ref diff, ref u64(18446744073709551615))
	expect.Equal(ref borrow, ref u64(1))
	diff, borrow = bits.Sub64(0, 0, 1)
	expect.Equal(ref diff, ref u64(18446744073709551615))
	expect.Equal(ref borrow, ref u64(1))
	diff, borrow = bits.Sub64(5, 5, 0)
	expect.Equal(ref diff, ref u64(0))
	expect.Equal(ref borrow, ref u64(0))
	// The same through values of the functions, which call the bodies
	// written here, where a direct call is the instruction in place.
	add, sub := bits.Add64, bits.Sub64
	sum, carry = add(18446744073709551615, 1, 0)
	expect.Equal(ref sum, ref u64(0))
	expect.Equal(ref carry, ref u64(1))
	sum, carry = add(18446744073709551615, 18446744073709551615, 1)
	expect.Equal(ref sum, ref u64(18446744073709551615))
	expect.Equal(ref carry, ref u64(1))
	sum, carry = add(1, 2, 1)
	expect.Equal(ref sum, ref u64(4))
	expect.Equal(ref carry, ref u64(0))
	diff, borrow = sub(0, 1, 0)
	expect.Equal(ref diff, ref u64(18446744073709551615))
	expect.Equal(ref borrow, ref u64(1))
	diff, borrow = sub(0, 0, 1)
	expect.Equal(ref diff, ref u64(18446744073709551615))
	expect.Equal(ref borrow, ref u64(1))
	diff, borrow = sub(0x8000000000000000, 1, 1)
	expect.Equal(ref diff, ref u64(0x7ffffffffffffffe))
	expect.Equal(ref borrow, ref u64(0))
	// 2^64 + 5 plus 2^64 + 7, two words each: the low words carry into the high ones.
	lo, c := bits.Add64(5, 7, 0)
	hi, c2 := bits.Add64(1, 1, c)
	expect.Equal(ref lo, ref u64(12))
	expect.Equal(ref hi, ref u64(2))
	expect.Equal(ref c2, ref u64(0))
}

// Mul64 gives the full 128-bit product, and Div64 divides it back,
// refusing a zero divisor and a quotient that does not fit.
func TestMulDiv64() {
	hi, lo := bits.Mul64(1, 1)
	expect.Equal(ref hi, ref u64(0))
	expect.Equal(ref lo, ref u64(1))
	hi, lo = bits.Mul64(18446744073709551615, 18446744073709551615)
	expect.Equal(ref hi, ref u64(18446744073709551614))
	expect.Equal(ref lo, ref u64(1))
	hi, lo = bits.Mul64(0x100000000, 0x100000000)
	expect.Equal(ref hi, ref u64(1))
	expect.Equal(ref lo, ref u64(0))
	hi, lo = bits.Mul64(0xdeadbeefcafef00d, 0x123456789abcdef1)
	quo, rem := expect.IsSome(bits.Div64(hi, lo, 0x123456789abcdef1))
	expect.Equal(ref quo, ref u64(0xdeadbeefcafef00d))
	expect.Equal(ref rem, ref u64(0))
	quo, rem = expect.IsSome(bits.Div64(hi, lo+5, 0x123456789abcdef1))
	expect.Equal(ref quo, ref u64(0xdeadbeefcafef00d))
	expect.Equal(ref rem, ref u64(5))
	quo, rem = expect.IsSome(bits.Div64(0, 100, 7)) // a high half of zero: one division
	expect.Equal(ref quo, ref u64(14))
	expect.Equal(ref rem, ref u64(2))
	quo, rem = expect.IsSome(bits.Div64(1, 0, 3)) // 2^64 / 3
	expect.Equal(ref quo, ref u64(6148914691236517205))
	expect.Equal(ref rem, ref u64(1))
	quo, rem = expect.IsSome(bits.Div64(0x7fffffffffffffff, 18446744073709551615, 0x8000000000000000)) // the largest quotient
	expect.Equal(ref quo, ref u64(18446744073709551615))
	expect.Equal(ref rem, ref u64(0x7fffffffffffffff))
	quo, rem = expect.IsSome(bits.Div64(1, 1, 18446744073709551615)) // a divisor with every bit set, so no shift
	expect.Equal(ref quo, ref u64(1))
	expect.Equal(ref rem, ref u64(2))
	mul := bits.Mul64 // the body, through a value
	hi, lo = mul(18446744073709551615, 2)
	expect.Equal(ref hi, ref u64(1))
	expect.Equal(ref lo, ref u64(18446744073709551614))
	expect.IsNone(bits.Div64(1, 0, 0))  // a zero divisor
	expect.IsNone(bits.Div64(7, 0, 7))  // the quotient would not fit
	expect.IsNone(bits.Div64(8, 0, 7))
}

// BenchmarkMul64 measures a 128-bit product.
func BenchmarkMul64() {
	x := u64(0xdeadbeefcafef00d)
	for testing.Loop() {
		hi, lo := bits.Mul64(x, 0x123456789abcdef1)
		x = hi ^ lo
	}
}

// BenchmarkDiv64 measures a 128-by-64-bit division.
func BenchmarkDiv64() {
	x := u64(12345)
	for testing.Loop() {
		quo, rem := bits.Div64(x & 0xffff, 0xcafef00ddeadbeef, 0x123456789abcdef1) ?? (0, 0)
		x = quo ^ rem
	}
}
