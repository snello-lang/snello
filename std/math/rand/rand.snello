// Package rand draws random numbers: from a generator a program seeds,
// which gives the same numbers for the same seed, and from the
// package's own functions, which give numbers nobody can foretell.
//
//     r := rand.New(1, 2)           // the same numbers on every run
//     roll := r.IntN(6) ?? 0        // 0 to 5
//     pick := rand.IntN(len(xs))    // None when xs is empty
//
// A generator made by New is Go's PCG: the permuted congruential
// generator PCG-DXSM, 128 bits of state, with the numbers Go's
// math/rand/v2 gives for rand.New(rand.NewPCG(seed1, seed2)), so a
// sequence a program records stays the sequence. It is for simulations,
// tests and games, where a run must be repeatable; what it gives can be
// worked out from what it gave, and it is no source of secrets.
//
// The package functions, Int, IntN, Int64, Float64, Shuffle and Perm,
// draw from the runtime's source: ChaCha8 keyed from the system when a
// program first draws, as Go's are, whose numbers cannot be told from
// the ones before. They take no seed and need no lock. A system that
// gives no random bytes, which none Snello runs on does, leaves a key
// made of the clock, and numbers one who knows when the program started
// could work out.
//
// A number below a bound is drawn without the bias a remainder has, by
// Lemire's multiplication with its rare redraw, and a shuffle is Fisher
// and Yates's, both as Go writes them. No function here panics on a
// mistake of its caller's: a bound that leaves nothing to draw from
// gives None, and a count below zero is a count of none. Perm allocates
// the numbers it returns, and a count more than memory holds ends the
// program as any allocation that fails does.
package rand

// A source gives the next 64 random bits. The generator and the
// runtime's source are the two, and every drawing below is written once
// over either.
trait source {
	func (s mut Self) next() u64
}

// Rand is a generator with a seed: two words, the whole of its state.
// It is copied as any struct of plain values is, and a copy goes on
// from where the original was, giving the same numbers: s := r keeps
// the place to replay from. To draw one sequence from several
// functions, lend the generator, mut r.
struct Rand impl source {
	hi u64
	lo u64
}

// New returns a generator seeded with the two words. The same seed
// gives the same numbers, on every system and in every build.
func New(seed1, seed2 u64) Rand {
	return Rand{hi: seed1, lo: seed2}
}

// next steps the state, state*mul + inc over 128 bits, and returns the
// permutation DXSM, double xorshift multiply, of the new state.
func (r mut Rand) next() u64 {
	var lo u64 = 0
	hi := mul64(r.lo, 4865540595714422341, mut lo)
	hi += r.hi * 4865540595714422341 + r.lo * 2549297995355413924
	sum := lo + 1442695040888963407
	if sum < lo { // the carry out of the low half
		hi += 1
	}

	hi += 6364136223846793005
	r.lo = sum
	r.hi = hi

	hi ^= hi >> 32
	hi *= 0xda942042e4dd58b5
	hi ^= hi >> 48
	hi *= sum | 1
	return hi
}

// Int returns a random int that is not negative.
func (r mut Rand) Int() int { return anyInt(r) }

// Int64 returns a random i64 that is not negative.
func (r mut Rand) Int64() i64 { return i64(anyInt(r)) }

// IntN returns a random int from 0 up to, and not including, n, every
// one as likely as another, or None when n is zero or negative and
// there is no such number.
func (r mut Rand) IntN(n int) int? { return intN(r, n) }

// Float64 returns a random f64 from 0 up to, and not including, 1.
func (r mut Rand) Float64() f64 { return float64(r) }

// Shuffle puts the elements of xs in a random order, every order as
// likely as another.
func (r mut Rand) Shuffle<T>(xs mut []T) { shuffle(r, xs) }

// Perm returns the numbers 0 to n-1 in a random order, and no numbers
// when n is zero or negative.
func (r mut Rand) Perm(n int) []int { return perm(r, n) }

// global is the runtime's source, one generator a thread.
struct global impl source {}

func (g mut global) next() u64 { return random() }

// Int returns a random int that is not negative, from the runtime's
// source.
func Int() int {
	g := global{}
	return anyInt(mut g)
}

// Int64 returns a random i64 that is not negative, from the runtime's
// source.
func Int64() i64 {
	g := global{}
	return i64(anyInt(mut g))
}

// IntN returns a random int from 0 up to, and not including, n, from
// the runtime's source, or None when n is zero or negative.
func IntN(n int) int? {
	g := global{}
	return intN(mut g, n)
}

// Float64 returns a random f64 from 0 up to, and not including, 1, from
// the runtime's source.
func Float64() f64 {
	g := global{}
	return float64(mut g)
}

// Shuffle puts the elements of xs in a random order, from the runtime's
// source.
func Shuffle<T>(xs mut []T) {
	g := global{}
	shuffle(mut g, xs)
}

// Perm returns the numbers 0 to n-1 in a random order, from the
// runtime's source, and no numbers when n is zero or negative.
func Perm(n int) []int {
	g := global{}
	return perm(mut g, n)
}

// anyInt clears the sign bit of 64 random bits.
func anyInt<S: source>(s mut S) int {
	return int(s.next() << 1 >> 1)
}

func intN<S: source>(s mut S, n int) int? {
	if n <= 0 {
		return None
	}

	return Some(int(below(s, u64(n))))
}

// float64 is one of the 2^53 values an f64 holds from 0 up to 1, 53
// random bits over 2^53.
func float64<S: source>(s mut S) f64 {
	return f64(s.next() << 11 >> 11) / 9007199254740992.0
}

// below returns a number from 0 up to, and not including, n, which is
// not zero. A power of two keeps the low bits. Any other n takes the
// high half of the 128-bit product of 64 random bits and n, which is
// the bits scaled down to n; the low half says when the product fell
// among the few that would make some numbers likelier than others, and
// those are drawn again. The test against n first spares the division
// almost always, since the low half is rarely below n.
func below<S: source>(s mut S, n u64) u64 {
	if n & (n - 1) == 0 {
		return s.next() & (n - 1)
	}

	var lo u64 = 0
	hi := mul64(s.next(), n, mut lo)
	if lo < n {
		thresh := (0 - n) % n
		for lo < thresh {
			hi = mul64(s.next(), n, mut lo)
		}
	}

	return hi
}

// shuffle is Fisher and Yates's: from the last element down, each is
// exchanged with one drawn from those up to it, itself included.
func shuffle<S: source, T>(s mut S, xs mut []T) {
	for i := len(xs) - 1; i > 0; i-- {
		xs.Swap(i, int(below(s, u64(i + 1))))
	}
}

func perm<S: source>(s mut S, n int) []int {
	p := make([]int, 0, max(n, 0))
	for i := 0; i < n; i++ {
		p.Push(i)
	}

	shuffle(s, mut p)
	return p
}

// random is the next number of the runtime's source, and mul64 the
// 128-bit product of x and y, the high half returned and the low half
// stored in lo. The runtime provides both.
func random() u64
func mul64(x, y u64, lo mut u64) u64
