// Package math has the constants and functions of floating-point
// arithmetic, over f64, and the limits of the number types.
//
// Every function takes and returns an f64, by value, and allocates
// nothing. A program working in another float type converts at the
// call, f64(x), and a literal written as an argument takes the type on
// its own, so math.Min(2, 7) needs no 2.0.
//
// The functions without a body here are the system's math library's,
// called by their names, but for Erf, Erfc, Asinh, Atanh, Gamma and
// Lgamma, which the runtime computes itself from the reference
// algorithms, since the system's are slower. Sqrt, Floor, Ceil, Trunc,
// Round, Mod, Abs and Copysign are exact, the same on every system;
// the others are within a few units in the last place of the true
// result, so their last digits may differ from one system to another. The special cases, an
// infinity, a NaN or a zero as an argument, are those IEEE 754 sets
// and the C standard lists for each function. No function panics: a
// result that has no number is NaN, and one too large for an f64 is
// an infinity.
//
// A limit has the type it is the limit of: MaxInt8 is an i8, and
// MaxUint64 a u64.
package math

// Pi is the ratio of a circle's circumference to its diameter, to the
// precision an f64 holds.
const Pi f64 = 3.14159265358979323846264338327950288

// E is the base of the natural logarithm, Euler's number, to the
// precision an f64 holds.
const E f64 = 2.71828182845904523536028747135266249775724709369995957496696763

// Ln2 is the natural logarithm of 2, to the precision an f64 holds.
const Ln2 f64 = 0.693147180559945309417232121458176568075500134360255254120680009

// MaxFloat64 is the largest finite f64, (2 - 2^-52) * 2^1023; a result
// above it is +Inf.
const MaxFloat64 f64 = 1.79769313486231570814527423731704356798070e+308

// SmallestNonzeroFloat64 is the smallest f64 above zero, 2^-1074, a
// subnormal number.
const SmallestNonzeroFloat64 f64 = 4.9406564584124654417656879286822137236505980e-324

// MaxFloat32 is the largest finite f32, (2 - 2^-23) * 2^127.
const MaxFloat32 f32 = 3.40282346638528859811704183484516925440e+38

// SmallestNonzeroFloat32 is the smallest f32 above zero, 2^-149, a
// subnormal number.
const SmallestNonzeroFloat32 f32 = 1.401298464324817070923729583289916131280e-45

// The largest and the smallest value of each integer type, each of the
// type it is the limit of: MaxInt and MinInt for int, MaxInt8 and
// MinInt8 for i8, and so on. An unsigned type's smallest is zero, so
// only its largest is named. A value past a limit wraps, as the
// arithmetic does.
const MaxInt int = 9223372036854775807
const MinInt int = -9223372036854775808
const MaxInt8 i8 = 127
const MinInt8 i8 = -128
const MaxInt16 i16 = 32767
const MinInt16 i16 = -32768
const MaxInt32 i32 = 2147483647
const MinInt32 i32 = -2147483648
const MaxInt64 i64 = 9223372036854775807
const MinInt64 i64 = -9223372036854775808
const MaxUint uint = 18446744073709551615
const MaxUint8 u8 = 255
const MaxUint16 u16 = 65535
const MaxUint32 u32 = 4294967295
const MaxUint64 u64 = 18446744073709551615

// Sqrt returns the square root of x, exact: the f64 nearest the true
// root. It is NaN for a negative x, +Inf for +Inf, and x itself for a
// zero, -0 included.
//
//	math.Sqrt(2) // 1.4142135623730951
func Sqrt(x f64) f64

// Cbrt returns the cube root of x, which, unlike the square root, has
// the sign of x: Cbrt(-8) is -2. An infinity, a NaN and a zero are
// returned as they are.
func Cbrt(x f64) f64

// Floor returns the greatest whole number not above x, exact:
// Floor(1.5) is 1 and Floor(-1.5) is -2. An infinity, a NaN and a zero
// are returned as they are.
func Floor(x f64) f64

// Ceil returns the least whole number not below x, exact: Ceil(1.5) is
// 2 and Ceil(-1.5) is -1. An infinity, a NaN and a zero are returned as
// they are.
func Ceil(x f64) f64

// Trunc returns x without its fraction, the whole number toward zero,
// exact: Trunc(1.5) is 1 and Trunc(-1.5) is -1. An infinity, a NaN and
// a zero are returned as they are.
func Trunc(x f64) f64

// Round returns the whole number nearest x, a half going away from
// zero, exact: Round(2.5) is 3 and Round(-2.5) is -3. An infinity, a
// NaN and a zero are returned as they are.
func Round(x f64) f64

// Mod returns the remainder of x divided by y, x - n*y for the whole n
// that x/y truncates to, exact: it has the sign of x and is smaller
// than y in magnitude. Mod(7, 3) is 1 and Mod(-7, 3) is -1. It is NaN
// when x is an infinity, y is zero or either is NaN, and x when y is
// an infinity.
func Mod(x, y f64) f64

// Pow returns x to the power y. Pow(x, 0) is 1 for every x, NaN
// included, and Pow(1, y) is 1 for every y; a negative x to a y that
// is not whole is NaN, and a result too large for an f64 is an
// infinity.
//
//	math.Pow(2, 10) // 1024
func Pow(x, y f64) f64

// Exp returns e, the constant E, to the power x: +Inf when the result
// is too large for an f64, which is from about 709.8 up, and 0 when it
// is too small, from about -745.1 down.
func Exp(x f64) f64

// Log returns the natural logarithm of x, the power E is raised to to
// make x. It is -Inf for a zero, NaN for a negative x, and +Inf for
// +Inf.
func Log(x f64) f64

// Log2 returns the logarithm of x to base 2: Log2(8) is 3, within the
// precision the system's library gives. It is -Inf for a zero and NaN
// for a negative x.
func Log2(x f64) f64

// Log10 returns the logarithm of x to base 10: Log10(1000) is 3, within
// the precision the system's library gives. It is -Inf for a zero and
// NaN for a negative x.
func Log10(x f64) f64

// Sin returns the sine of x, an angle in radians. It is NaN for an
// infinity, and a zero keeps its sign.
func Sin(x f64) f64

// Cos returns the cosine of x, an angle in radians. It is NaN for an
// infinity.
func Cos(x f64) f64

// Tan returns the tangent of x, an angle in radians. It is NaN for an
// infinity, and a zero keeps its sign.
func Tan(x f64) f64

// Asin returns the angle, in radians from -Pi/2 to Pi/2, whose sine is
// x. It is NaN for an x outside -1 to 1.
func Asin(x f64) f64

// Acos returns the angle, in radians from 0 to Pi, whose cosine is x.
// It is NaN for an x outside -1 to 1.
func Acos(x f64) f64

// Atan returns the angle, in radians from -Pi/2 to Pi/2, whose tangent
// is x; an infinity gives Pi/2 with its sign.
func Atan(x f64) f64

// Atan2 returns the angle of the point (x, y) from the positive x axis,
// in radians from -Pi to Pi: the arc tangent of y/x in the quadrant the
// signs of the two say, defined where y/x is not, for an x of zero.
// Note the order: y first.
//
//	math.Atan2(1, -1) // 3*Pi/4
func Atan2(y, x f64) f64

// Sinh returns the hyperbolic sine of x, (e^x - e^-x) / 2, an infinity
// with the sign of x when it is too large for an f64.
func Sinh(x f64) f64

// Cosh returns the hyperbolic cosine of x, (e^x + e^-x) / 2, never
// below 1, and +Inf when it is too large for an f64.
func Cosh(x f64) f64

// Tanh returns the hyperbolic tangent of x, Sinh(x) / Cosh(x), from -1
// to 1: an infinity gives 1 with its sign.
func Tanh(x f64) f64

// Hypot returns the square root of p*p + q*q, the length of the
// hypotenuse of a right triangle with legs p and q, without the
// overflow or the underflow the squares would have on the way. It is
// +Inf when either is an infinity, a NaN among them included.
func Hypot(p, q f64) f64

// Inf returns the positive infinity when sign is zero or more, and the
// negative one when it is below zero.
//
//	math.Inf(-1) < -math.MaxFloat64 // true
func Inf(sign int) f64

// NaN returns a value that is not a number, the result IEEE 754 gives
// an operation that has no number, such as 0/0. Test for one with
// IsNaN, since a NaN equals nothing.
func NaN() f64

// IsNaN reports whether x is not a number. A NaN equals nothing, itself
// included, so x == math.NaN() is always false and this is the test.
func IsNaN(x f64) bool

// IsInf reports whether x is an infinity of the sign asked for: the
// positive one when sign is above zero, the negative one when it is
// below, and either when it is zero.
//
//	math.IsInf(math.Inf(-1), 0) // true
func IsInf(x f64, sign int) bool

// Signbit reports whether the sign bit of x is set: true for a negative
// x, -0 and -Inf included, false for a positive one and +0. It reads
// the bit, so it tells -0 from +0, which compare equal.
func Signbit(x f64) bool

// Copysign returns a value with the magnitude of x and the sign of
// sign, exact: Copysign(3, -1) is -3. It reads the sign bit of sign, so
// a -0 or a NaN with its sign bit set counts as negative.
func Copysign(x, sign f64) f64

// Float64bits returns the bits of x as a u64, the IEEE 754 encoding:
// the sign, the exponent and the fraction as the memory holds them,
// which a binary format writes and a hash reads. It is a copy of the
// bits, no conversion.
//
//	math.Float64bits(1.0) // 0x3ff0000000000000
func Float64bits(x f64) u64

// Float64frombits returns the f64 whose bits are b, the inverse of
// Float64bits.
func Float64frombits(b u64) f64

// Float32bits returns the bits of x as a u32, the IEEE 754 encoding of
// a single-precision float.
func Float32bits(x f32) u32

// Float32frombits returns the f32 whose bits are b.
func Float32frombits(b u32) f32

// Frexp breaks x into a fraction and a power of two, x == frac * 2^exp,
// the fraction's magnitude in [0.5, 1); a zero, an infinity and NaN
// come back as they are, with an exponent of zero.
//
//	frac, exp := math.Frexp(8) // 0.5, 4
func Frexp(x f64) (f64, int) {
	exp := 0
	frac := frexp(x, mut exp)
	return (frac, exp)
}

// Ldexp returns frac * 2^exp, the inverse of Frexp: +Inf or -Inf when
// the result is too large, zero when too small, the sign kept.
func Ldexp(frac f64, exp int) f64

// Modf breaks x into its whole part and its fraction, which sum to x
// and both have its sign: Modf(-2.5) is -2, -0.5. An infinity's whole
// part is itself and its fraction NaN; NaN gives NaN twice.
func Modf(x f64) (f64, f64) {
	frac := 0.0
	whole := modf(x, mut frac)
	return (whole, frac)
}

// Remainder returns the IEEE 754 remainder of x divided by y: x less
// the multiple of y nearest to x, a tie going to the even multiple, so
// its magnitude is at most half of y, where Mod's has the sign of x.
// It is NaN when x is an infinity or y is zero, and x when y is an
// infinity.
func Remainder(x, y f64) f64

// FMA returns x*y + z rounded once, as the fused multiply-add
// instruction computes it, where x*y + z written out rounds twice.
func FMA(x, y, z f64) f64

// Expm1 returns e^x - 1, exact for an x near zero, where Exp(x) - 1
// loses its digits to cancellation.
func Expm1(x f64) f64

// Log1p returns the natural logarithm of 1 + x, exact for an x near
// zero, where Log(1 + x) loses its digits to the rounding of the sum.
func Log1p(x f64) f64

// Exp2 returns 2^x.
func Exp2(x f64) f64

// Asinh returns the inverse hyperbolic sine of x.
func Asinh(x f64) f64

// Acosh returns the inverse hyperbolic cosine of x, defined for x at
// least 1; below it NaN.
func Acosh(x f64) f64

// Atanh returns the inverse hyperbolic tangent of x, defined for x
// between -1 and 1; at them an infinity of the sign, beyond them NaN.
func Atanh(x f64) f64

// Gamma returns the gamma function of x, (x-1)! for a positive whole x:
// +Inf for +0 and -Inf for -0, the poles, NaN for a negative whole
// number and for -Inf, +Inf for +Inf.
//
//	math.Gamma(5) // 24
func Gamma(x f64) f64

// Lgamma returns the natural logarithm of the magnitude of the gamma
// function of x, and the sign of the gamma function, -1 or 1: the
// gamma function is negative on (-1, 0), (-3, -2), (-5, -4) and so on,
// between an even whole number that is not positive and the odd one
// below it, and positive elsewhere. At a
// pole, zero or a negative whole number, and at either infinity the
// logarithm is +Inf, as the C standard has it, with the sign 1.
//
//	lg, sign := math.Lgamma(-0.5) // 1.2655..., -1
func Lgamma(x f64) (f64, int) {
	sign := 1
	lg := lgamma(x, mut sign)
	return (lg, sign)
}

// Erf returns the error function of x, the probability that a normal
// deviate lies within x standard deviations times the square root of
// two: -1 at -Inf, 0 at 0, 1 at +Inf.
func Erf(x f64) f64

// Erfc returns the complementary error function, 1 - Erf(x), exact
// where 1 - Erf(x) would lose its digits for a large x.
func Erfc(x f64) f64

// Nextafter returns the f64 next to x in the direction of y: x itself
// when the two are equal, NaN when either is NaN.
//
//	math.Nextafter(1, 2) // 1.0000000000000002
func Nextafter(x, y f64) f64

// Pow10 returns 10^n within one unit in the last place over the whole
// range of a double, 10^-323 to 10^308, and exact for n from 0 to 22,
// where a double holds the power: zero below the range and +Inf above
// it.
//
//	math.Pow10(3) // 1000
func Pow10(n int) f64

// Dim returns x - y when that is positive, and 0 otherwise: the
// positive difference. It is NaN when either is NaN or both are the
// same infinity.
func Dim(x, y f64) f64 {
	v := x - y
	if v <= 0 {
		return 0
	}

	return v // positive, or NaN, which no comparison holds
}

// Abs returns the absolute value of x, exact: x without its sign, so
// +0 for -0, +Inf for -Inf, and NaN for NaN.
//
//	math.Abs(-2.5) // 2.5
func Abs(x f64) f64 {
	if x < 0 || x == 0 && 1/x < 0 {
		return -x
	}

	return x
}

// Min returns the smaller of x and y, with the special cases settled
// so that the result does not depend on the order of the two: -Inf
// when either is -Inf, else NaN when either is NaN, and of two zeros
// -0 is the smaller.
//
//	math.Min(2, math.NaN()) // NaN
func Min(x, y f64) f64 {
	if x < -MaxFloat64 {
		return x
	}

	if y < -MaxFloat64 {
		return y
	}

	if x != x {
		return x
	}

	if y != y {
		return y
	}

	if x == 0 && x == y {
		if 1/x < 0 {
			return x
		}

		return y
	}

	if x < y {
		return x
	}

	return y
}

// Max returns the larger of x and y, with the special cases settled
// so that the result does not depend on the order of the two: +Inf
// when either is +Inf, else NaN when either is NaN, and of two zeros
// +0 is the larger.
//
//	math.Max(math.Inf(1), math.NaN()) // +Inf
func Max(x, y f64) f64 {
	if x > MaxFloat64 {
		return x
	}

	if y > MaxFloat64 {
		return y
	}

	if x != x {
		return x
	}

	if y != y {
		return y
	}

	if x == 0 && x == y {
		if 1/x < 0 {
			return y
		}

		return x
	}

	if x > y {
		return x
	}

	return y
}

// frexp breaks x into a fraction in [0.5, 1), returned, and a power of
// two, stored. The runtime provides it.
func frexp(x f64, exp mut int) f64

// modf breaks x into its whole part, returned, and its fraction,
// stored. The runtime provides it.
func modf(x f64, frac mut f64) f64

// lgamma returns the natural logarithm of the magnitude of the gamma
// function of x and stores the gamma function's sign, -1 or 1. The
// runtime provides it.
func lgamma(x f64, sign mut int) f64
