// Package iter is the iterator trait, its adapters and its consumers.
//
// An iterator is a value a loop pulls items from with Next, one at a
// time, until Next gives None. A collection makes one over its items,
// d.Iter() of a deque, s.Iter() of a set, a.Iter() of an arena; a type
// of the program makes one by writing Next and listing Iterator. An
// adapter wraps an iterator in another that changes what it gives, and
// a consumer pulls every item and returns one answer:
//
//	evens := d.Iter().Filter(isEven).Map(square).Collect()
//	for i, x := range d.Iter().Enumerate() { ... }
//	total := d.Iter().Fold(0, add)
//
// The adapters are Map, Filter, Take, Skip, TakeWhile, SkipWhile,
// FlatMap, Enumerate, Zip and Chain; the consumers Count, Fold, Reduce,
// Any, All, Find, Last, MinBy, MaxBy and Collect. Each is a default
// method of Iterator, so every iterator has them all; Min and Max, which
// ask the items to be Ord, are functions of the package. An iterator
// that can also give its items from the back, a slice's or a deque's,
// lists DoubleEnded as well, with NextBack and the adapter Rev:
//
//	for x := range iter.Over(ref xs).Rev() { ... }
//
// Over makes the iterator over a slice's elements, lending each.
//
// What an iterator borrows. An iterator over a collection's items lends
// them, an Iterator<ref T>, and holds a ref borrow of the collection
// for as long as it lives, so the collection cannot change, move or be
// dropped while it does; an adapter over it holds the same borrow, and
// so does a slice Collect gives of the items. The checker follows the
// borrow through every adapter and consumer, with nothing written and
// nothing checked when the program runs, and lets the collection go
// after the chain's last use.
//
// What it costs. An adapter is a struct of the iterator it wraps and
// its function, made on the stack; nothing is allocated but the slice
// Collect returns. An adapter does no work until it is pulled from, so
// a chain runs as one loop, an item at a time, when a range or a
// consumer pulls from it, and stops as soon as the consumer has its
// answer. Each instance is compiled for its own types, and the calls
// of a chain are written into the loop.
//
// The functions given to the adapters and consumers. A closure given
// to an adapter is kept by it, so it borrows nothing: it captures
// copies of the numbers it reads, or nothing at all. A test that needs
// a string a closure would borrow is written in a loop's body instead.
// Filter, Any, All and Find lend each item to their test, func(ref T)
// bool, which over borrowed items is a ref T too, since a borrow of a
// borrow is a borrow of its target.
//
// range takes any value with a Next method, whether its type lists
// Iterator or not. Listing it gives the type the adapters and lets a
// generic function take it by a bound:
//
//	func sum<I: iter.Iterator<ref int>>(it mut I) int { ... }
package iter

// An Iterator gives items of type T, one per call of Next, and None
// once there are no more; after that, Next keeps giving None. To write
// one, list the trait and write Next; every adapter and consumer below
// comes with it. An iterator that lends its items, an Iterator<ref T>,
// gives borrows of what it walks, never of itself, so an item stays
// good while the iterator moves on, and several may be held at once.
//
//	struct Count impl iter.Iterator<int> {
//		next int
//		end  int
//	}
//
//	func (c mut Count) Next() int? {
//		if c.next >= c.end { return None }
//		c.next++
//		return Some(c.next - 1)
//	}
trait Iterator<T> {
	// Next gives the next item and moves past it, or None once there are
	// no more.
	func (it mut Self) Next() T?

	// Map gives f of each item, in order. f runs once per item, when
	// the item is pulled, and captures nothing by borrow.
	//
	//	lengths := words.Iter().Map(func(w ref string) int { return w.Len() })
	func (it Self) Map<U>(f func(T) U) Map<Self, T, U> {
		return Map{inner: it, f: f}
	}

	// Filter gives the items keep is true of, in order, and drops the
	// rest. keep is lent each item once.
	//
	//	evens := Count{0, 10}.Filter(func(x ref int) bool { return *x % 2 == 0 })
	func (it Self) Filter(keep func(ref T) bool) Filter<Self, T> {
		return Filter{inner: it, keep: keep}
	}

	// Take gives the first n items, or all of them when there are fewer,
	// and pulls nothing after; n of 0 or less gives none.
	//
	//	first := d.Iter().Take(3).Collect()
	func (it Self) Take(n int) Take<Self, T> {
		return Take{inner: it, left: n}
	}

	// Skip drops the first n items and gives the rest; n of 0 or less
	// drops none.
	//
	//	rest := d.Iter().Skip(1).Collect()
	func (it Self) Skip(n int) Skip<Self, T> {
		return Skip{inner: it, left: n}
	}

	// TakeWhile gives the items from the start while keep is true of
	// them, and ends at the first it is false of, which is dropped;
	// nothing after it is pulled.
	//
	//	small := sorted.Iter().TakeWhile(func(x ref int) bool { return *x < 10 })
	func (it Self) TakeWhile(keep func(ref T) bool) TakeWhile<Self, T> {
		return TakeWhile{inner: it, keep: keep, done: false}
	}

	// SkipWhile drops the items from the start while skip is true of
	// them, and gives every item from the first it is false of, that one
	// included, with no further test.
	//
	//	rest := lines.Iter().SkipWhile(isBlank)
	func (it Self) SkipWhile(skip func(ref T) bool) SkipWhile<Self, T> {
		return SkipWhile{inner: it, skip: skip, skipping: true}
	}

	// FlatMap gives, for each item in turn, every item of the iterator f
	// makes of it: all of the first item's iterator, then all of the
	// second's, and so on. f runs once per item, when its iterator is
	// first pulled from, and captures nothing by borrow.
	//
	//	// for ends 1, 2, 3: 0, then 0 1, then 0 1 2
	//	ramps := ends.Iter().FlatMap(func(n ref int) Count { return Count{next: 0, end: *n} })
	func (it Self) FlatMap<J: Iterator<U>, U>(f func(T) J) FlatMap<Self, T, J, U> {
		return FlatMap{inner: it, f: f, cur: None}
	}

	// Enumerate gives each item with its index, counted from 0: (0,
	// first), (1, second), and so on.
	//
	//	for i, w := range words.Iter().Enumerate() { fmt.Println(i, w) }
	func (it Self) Enumerate() Enumerate<Self, T> {
		return Enumerate{inner: it, next: 0}
	}

	// Zip gives the items of this iterator and of other in pairs, first
	// with first, second with second, and ends as soon as either ends.
	//
	//	for name, score := range names.Iter().Zip(scores.Iter()) { ... }
	func (it Self) Zip<J: Iterator<V>, V>(other J) Zip<Self, T, J, V> {
		return Zip{a: it, b: other}
	}

	// Chain gives every item of this iterator, then every item of other,
	// which gives items of the same type.
	//
	//	all := first.Iter().Chain(second.Iter()).Collect()
	func (it Self) Chain<J: Iterator<T>>(other J) Chain<Self, J, T> {
		return Chain{a: it, b: other, onB: false}
	}

	// Count pulls every item and returns how many there were, 0 for
	// none; the items are dropped as they come.
	//
	//	n := d.Iter().Filter(isEven).Count()
	func (it mut Self) Count() int {
		n := 0
		for it.Next().IsSome() {
			n++
		}

		return n
	}

	// Fold pulls every item and combines them into one value, starting
	// from init: f(f(init, first), second) and so on; init when there are
	// none. f takes the running value and the item, and returns the new
	// running value.
	//
	//	total := d.Iter().Fold(0, func(sum int, x ref int) int { return sum + *x })
	func (it mut Self) Fold<A>(init A, f func(A, T) A) A {
		acc := init
		for {
			item := it.Next() ?? break
			acc = f(acc, item)
		}

		return acc
	}

	// Reduce is Fold with the first item as the start: f(f(first,
	// second), third) and so on; the first item alone when it is the
	// only one, and None when there are none. Over borrowed items, map
	// to owned ones first: a function returning one of two borrows
	// cannot be written.
	//
	//	total := Count{0, 10}.Reduce(func(a int, b int) int { return a + b })
	func (it mut Self) Reduce(f func(T, T) T) T? {
		acc := it.Next() ?? return None
		for {
			item := it.Next() ?? break
			acc = f(acc, item)
		}

		return Some(acc)
	}

	// Last pulls every item and returns the last, or None when there are
	// none.
	//
	//	if w := words.Iter().Last() { ... }
	func (it mut Self) Last() T? {
		last := it.Next() ?? return None
		for {
			last = it.Next() ?? break
		}

		return Some(last)
	}

	// MinBy pulls every item and returns the least, as cmp orders them:
	// cmp is lent two items and says whether the first is Less, Equal or
	// Greater. The first of several least items wins; None when there are
	// none. Min does the same for items that are Ord.
	//
	//	shortest := words.Iter().MinBy(func(a ref string, b ref string) Ordering { return a.Len().Cmp(b.Len()) })
	func (it mut Self) MinBy(cmp func(ref T, ref T) Ordering) T? {
		best := it.Next() ?? return None
		for {
			item := it.Next() ?? break
			if cmp(ref item, ref best) == Less {
				best = item
			}
		}

		return Some(best)
	}

	// MaxBy pulls every item and returns the greatest, as cmp orders
	// them. The last of several greatest items wins, so MinBy and MaxBy
	// of two equal items give one each; None when there are none. Max
	// does the same for items that are Ord.
	//
	//	longest := words.Iter().MaxBy(func(a ref string, b ref string) Ordering { return a.Len().Cmp(b.Len()) })
	func (it mut Self) MaxBy(cmp func(ref T, ref T) Ordering) T? {
		best := it.Next() ?? return None
		for {
			item := it.Next() ?? break
			if cmp(ref item, ref best) != Less {
				best = item
			}
		}

		return Some(best)
	}

	// Any reports whether test is true of some item. It stops at the
	// first such item, leaving the iterator just after it; false when
	// there are none.
	//
	//	hasEmpty := words.Iter().Any(func(w ref string) bool { return w.Len() == 0 })
	func (it mut Self) Any(test func(ref T) bool) bool {
		for {
			item := it.Next() ?? break
			if test(ref item) {
				return true
			}
		}

		return false
	}

	// All reports whether test is true of every item. It stops at the
	// first item it is false of, leaving the iterator just after it; true
	// when there are none.
	//
	//	allPositive := d.Iter().All(func(x ref int) bool { return *x > 0 })
	func (it mut Self) All(test func(ref T) bool) bool {
		for {
			item := it.Next() ?? break
			if !test(ref item) {
				return false
			}
		}

		return true
	}

	// Find returns the first item test is true of, or None when there is
	// none. It leaves the iterator just after the item found, so calling
	// it again finds the next.
	//
	//	if w := words.Iter().Find(func(w ref string) bool { return w.HasPrefix("go") }) { ... }
	func (it mut Self) Find(test func(ref T) bool) T? {
		for {
			item := it.Next() ?? break
			if test(ref item) {
				return Some(item)
			}
		}

		return None
	}

	// Collect pulls every item into a new slice, in order; an empty slice
	// for none. Over borrowed items the slice holds the borrows, []ref T,
	// which keeps the collection lent while the slice is used and cannot
	// be stored in owned data; Map with a Clone gives owned items.
	//
	//	names := people.Iter().Map(func(p ref Person) string { return p.Name.Clone() }).Collect()
	func (it mut Self) Collect() []T {
		out := []T{}
		for {
			out.Push(it.Next() ?? break)
		}

		return out
	}
}

// A DoubleEnded iterator gives its items from the back as well as the
// front. Next and NextBack meet in the middle: no item is given twice.
// A slice's iterator (Over) and a deque's are double-ended, and Rev
// turns one round. An adapter over a double-ended iterator is a plain
// Iterator, so turn round first, then adapt: iter.Over(ref xs).Rev().Map(f).
trait DoubleEnded<T>: Iterator<T> {
	// NextBack gives the last item not yet given and moves the back
	// before it, or None once every item has been given from either end.
	func (it mut Self) NextBack() T?

	// Rev gives the items from the back. It is double-ended too, so
	// Rev().Rev() is the original order.
	//
	//	for x := range iter.Over(ref xs).Rev() { ... }
	func (it Self) Rev() Rev<Self, T> {
		return Rev{inner: it}
	}
}

// Min pulls every item of it and returns the least by Cmp, the first of
// several least items, or None when there are none. It is a function
// rather than a method because it asks the items to be Ord, which the
// trait cannot ask of its T; for borrowed items use MinBy.
//
//	lowest := iter.Min(mut scores.Iter())
func Min<I: Iterator<T>, T: Ord>(it mut I) T? {
	best := it.Next() ?? return None
	for {
		item := it.Next() ?? break
		if item.Cmp(ref best) == Less {
			best = item
		}
	}

	return Some(best)
}

// Max pulls every item of it and returns the greatest by Cmp, the last
// of several greatest items, or None when there are none; as Min, a
// function, and MaxBy for borrowed items.
//
//	highest := iter.Max(mut scores.Iter())
func Max<I: Iterator<T>, T: Ord>(it mut I) T? {
	best := it.Next() ?? return None
	for {
		item := it.Next() ?? break
		if item.Cmp(ref best) != Less {
			best = item
		}
	}

	return Some(best)
}

// A Slice is the iterator Over returns: it lends a slice's elements,
// from the front with Next and from the back with NextBack, and keeps
// the slice lent while it lives.
struct Slice<T> impl Iterator<ref T>, DoubleEnded<ref T> {
	xs  ref []T
	i   int // the index of the element Next gives
	end int // one past the index of the element NextBack gives
}

// Over returns an iterator over the elements of xs, lending each. A
// loop ranges over a slice directly; Over is for the adapters, and for
// walking from the back, iter.Over(ref xs).Rev().
//
//	evens := iter.Over(ref xs).Filter(isEven).Count()
func Over<T>(xs ref []T) Slice<T> {
	return Slice<T>{xs: xs, i: 0, end: len(xs)}
}

// Next lends the next element from the front, or None once the front
// has met the back.
func (it mut Slice<T>) Next() ref T? {
	i := it.i
	if i >= it.end {
		return None
	}

	it.i = i + 1
	return Some(ref it.xs[i])
}

// NextBack lends the next element from the back, or None once the back
// has met the front.
func (it mut Slice<T>) NextBack() ref T? {
	if it.end <= it.i {
		return None
	}

	it.end--
	return Some(ref it.xs[it.end])
}

// A Rev is the iterator Rev returns: the wrapped iterator's items from
// the back.
struct Rev<I: DoubleEnded<T>, T> impl Iterator<T>, DoubleEnded<T> {
	inner I
}

// Next gives the wrapped iterator's next item from the back.
func (r mut Rev<I, T>) Next() T? {
	return r.inner.NextBack()
}

// NextBack gives the wrapped iterator's next item from the front.
func (r mut Rev<I, T>) NextBack() T? {
	return r.inner.Next()
}

// A Map is the iterator Map returns: f of each item of the wrapped
// iterator.
struct Map<I: Iterator<T>, T, U> impl Iterator<U> {
	inner I
	f     func(T) U
}

// Next gives f of the wrapped iterator's next item, or None once it
// has no more.
func (m mut Map<I, T, U>) Next() U? {
	item := m.inner.Next() ?? return None
	return Some(m.f(item))
}

// A Filter is the iterator Filter returns: the wrapped iterator's items
// that keep is true of.
struct Filter<I: Iterator<T>, T> impl Iterator<T> {
	inner I
	keep  func(ref T) bool
}

// Next pulls items until keep is true of one and gives it, or None
// once the wrapped iterator has no more.
func (f mut Filter<I, T>) Next() T? {
	for {
		item := f.inner.Next() ?? return None
		if f.keep(ref item) {
			return Some(item)
		}
	}
}

// A Take is the iterator Take returns: at most left more items of the
// wrapped iterator.
struct Take<I: Iterator<T>, T> impl Iterator<T> {
	inner I
	left  int
}

// Next gives the wrapped iterator's next item while the count lasts,
// or None once it is spent or the iterator has no more; a spent Take
// pulls nothing.
func (t mut Take<I, T>) Next() T? {
	if t.left <= 0 {
		return None
	}

	t.left--
	return t.inner.Next()
}

// A Skip is the iterator Skip returns: the wrapped iterator's items
// after the first left of them.
struct Skip<I: Iterator<T>, T> impl Iterator<T> {
	inner I
	left  int
}

// Next drops the items still to skip, on the first call, then gives the
// wrapped iterator's next item, or None once it has no more.
func (s mut Skip<I, T>) Next() T? {
	for s.left > 0 {
		s.left--
		if s.inner.Next().IsNone() {
			return None
		}
	}

	return s.inner.Next()
}

// A TakeWhile is the iterator TakeWhile returns: the wrapped iterator's
// items while keep is true of them.
struct TakeWhile<I: Iterator<T>, T> impl Iterator<T> {
	inner I
	keep  func(ref T) bool
	done  bool // an item keep was false of has been met
}

// Next gives the wrapped iterator's next item while keep is true of
// it; from the first item it is false of, which is dropped, it gives
// None on every call.
func (t mut TakeWhile<I, T>) Next() T? {
	if t.done {
		return None
	}

	item := t.inner.Next() ?? return None
	if t.keep(ref item) {
		return Some(item)
	}

	t.done = true
	return None
}

// A SkipWhile is the iterator SkipWhile returns: the wrapped iterator's
// items from the first that skip is false of.
struct SkipWhile<I: Iterator<T>, T> impl Iterator<T> {
	inner    I
	skip     func(ref T) bool
	skipping bool // no item skip was false of has been met yet
}

// Next drops the items skip is true of and gives the first it is false
// of; after that it gives every item, untested, or None once the
// wrapped iterator has no more.
func (s mut SkipWhile<I, T>) Next() T? {
	for s.skipping {
		item := s.inner.Next() ?? return None
		if !s.skip(ref item) {
			s.skipping = false
			return Some(item)
		}
	}

	return s.inner.Next()
}

// A FlatMap is the iterator FlatMap returns: the items of the iterators
// f makes of the wrapped iterator's items, one iterator after another.
struct FlatMap<I: Iterator<T>, T, J: Iterator<U>, U> impl Iterator<U> {
	inner I
	f     func(T) J
	cur   J? // the iterator being given, None before the first and once the wrapped iterator has no more
}

// Next gives the next item of the iterator being given; when it is
// spent, Next makes the next one with f and gives its first item, or
// None once the wrapped iterator has no more.
func (f mut FlatMap<I, T, J, U>) Next() U? {
	for {
		match mut f.cur {
			Some(c) => {
				if item := c.Next() {
					return Some(item)
				}
			},
			None => {},
		}

		next := f.inner.Next() ?? return None
		f.cur = Some(f.f(next))
	}
}

// An Enumerate is the iterator Enumerate returns: each item of the
// wrapped iterator with its index.
struct Enumerate<I: Iterator<T>, T> impl Iterator<(int, T)> {
	inner I
	next  int // the index of the item the next call gives
}

// Next gives the wrapped iterator's next item with its index, from 0,
// or None once it has no more.
func (e mut Enumerate<I, T>) Next() (int, T)? {
	item := e.inner.Next() ?? return None
	e.next++
	return Some((e.next - 1, item))
}

// A Zip is the iterator Zip returns: the items of two iterators in
// pairs.
struct Zip<I: Iterator<T>, T, J: Iterator<V>, V> impl Iterator<(T, V)> {
	a I
	b J
}

// Next gives the next item of each iterator as a pair, or None once
// either has no more; an item of a pulled when b has none left is
// dropped.
func (z mut Zip<I, T, J, V>) Next() (T, V)? {
	x := z.a.Next() ?? return None
	y := z.b.Next() ?? return None
	return Some((x, y))
}

// A Chain is the iterator Chain returns: the items of a, then those of
// b.
struct Chain<I: Iterator<T>, J: Iterator<T>, T> impl Iterator<T> {
	a   I
	b   J
	onB bool // a has given its last item
}

// Next gives a's next item while a has one, then b's, or None once b
// has no more; once a has ended it is not pulled again.
func (c mut Chain<I, J, T>) Next() T? {
	if !c.onB {
		if item := c.a.Next() {
			return Some(item)
		}

		c.onB = true
	}

	return c.b.Next()
}
