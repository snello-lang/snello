// Package arena holds values of one type in numbered slots and hands out
// an Index to each, so that a tree, a graph or a linked list is written
// as indices into one arena instead of pointers between its parts. The
// arena owns every value; the structure's links are indices, which are
// plain numbers and so are Copy, can be stored anywhere, and give the
// ownership rules nothing to check.
//
// An Index can go stale: the value it named was removed, and its slot
// may hold another value by now. Every slot carries a generation, which
// goes up each time the slot is emptied, and an Index carries the
// generation of its slot when it was issued; a lookup compares the two
// and answers None when they differ, so a stale Index is a value a
// program handles, never a value of a different age. What a pointer
// makes a use after free, an arena makes an Option.
package arena

import "fmt"

// An Index names a value in an Arena of T: the slot and the generation
// the value was put there with. It is Copy, Eq and Hash, so it is
// stored in a struct, a slice or a map, and passed around as a number
// is. An Index into an Arena of one type is not an Index into an Arena
// of another; it is not checked against the Arena it came from, so used
// in another Arena of the same type it may name an unrelated value.
// The zero Index, var i Index<T>, names nothing.
struct Index<T> impl Copy, Eq, Hash {
	slot int
	gen  int
}

// An Arena owns values of T in slots that are reused: Insert puts a
// value in a free slot or at the end, Remove empties one and keeps it
// for the next Insert, so an Arena that churns does not grow without
// bound. Get and GetMut lend a value for as long as the Arena is lent;
// the borrow cannot be stored, but the Index can. An Arena is moved,
// or lent with ref and mut; when it goes out of scope, every value
// still in it is dropped.
struct Arena<T> impl fmt.Stringer {
	slots []slot<T>
	free  []int
	count int
}

// A slot holds a value, or nothing when it is free, and the generation
// it is on: 1 for its first value, one more each time it is emptied.
struct slot<T> {
	value T?
	gen   int
}

// New returns an empty Arena. The type is given when nothing infers
// it: arena.New<Node>().
func New<T>() Arena<T> {
	return Arena<T>{}
}

// Insert puts v in the Arena, which owns it from then on, and returns
// its Index. A slot emptied by Remove is reused before the Arena grows.
func (a mut Arena<T>) Insert(v T) Index<T> {
	a.count++
	if n := a.free.Pop() {
		a.slots[n].value = Some(v)
		return Index<T>{slot: n, gen: a.slots[n].gen}
	}

	a.slots.Push(slot<T>{value: Some(v), gen: 1})
	return Index<T>{slot: len(a.slots) - 1, gen: 1}
}

// Get lends the value i names, or None when i is stale: its value was
// removed, whether or not the slot holds another by now. The borrow
// lasts as long as the Arena's.
func (a ref Arena<T>) Get(i Index<T>) ref T? {
	if !a.live(i) {
		return None
	}

	return match ref a.slots[i.slot].value {
		Some(v) => Some(v),
		None => None,
	}
}

// GetMut lends the value i names for changing, or None when i is
// stale. The Arena is lent mut for as long as the borrow lasts, so two
// values of one Arena are not changed through two borrows at once;
// read the one, then change the other.
func (a mut Arena<T>) GetMut(i Index<T>) mut T? {
	if !a.live(i) {
		return None
	}

	return match mut a.slots[i.slot].value {
		Some(v) => Some(v),
		None => None,
	}
}

// Remove moves the value i names out of the Arena and returns it, or
// None when i is stale. The slot's generation goes up, so i and every
// copy of it are stale from then on, and the slot is free for the next
// Insert.
func (a mut Arena<T>) Remove(i Index<T>) T? {
	if !a.live(i) {
		return None
	}

	v := take(mut a.slots[i.slot].value).Expect("arena: a live slot holds its value")
	a.slots[i.slot].gen++
	a.free.Push(i.slot)
	a.count--
	return Some(v)
}

// Len returns how many values the Arena holds, not counting free
// slots.
func (a ref Arena<T>) Len() int {
	return a.count
}

// String returns the values the Arena holds, in the order of their
// slots, written as a slice of them is printed: arena[a b c]. It is how
// fmt prints an Arena, its free slots and generations left out.
func (a ref Arena<T>) String() string {
	out := "arena["
	sep := ""
	for _, s := range a.slots {
		if v := ref s.value {
			out = out + sep + fmt.Sprint(v)
			sep = " "
		}
	}

	return out + "]"
}

// live reports whether i names a value in the Arena: a slot that
// exists, on the generation i was issued with.
func (a ref Arena<T>) live(i Index<T>) bool {
	return i.slot >= 0 && i.slot < len(a.slots) && a.slots[i.slot].gen == i.gen
}
