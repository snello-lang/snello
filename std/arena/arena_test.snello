package arena_test

import ("arena"; "expect"; "fmt"; "testing")

func TestInsertGetRemove() {
	a := arena.New<string>()
	i := a.Insert("one".Clone())
	j := a.Insert("two".Clone())
	expect.Equal(ref a.Len(), ref 2)
	if v := a.Get(i) { expect.Equal(v, "one") } else { expect.Fail("one is missing") }
	if v := a.Get(j) { expect.Equal(v, "two") } else { expect.Fail("two is missing") }
	expect.True(i != j)
	expect.Equal(ref expect.IsSome(a.Remove(i)), "one")
	expect.True(a.Get(i).IsNone())
	expect.Equal(ref a.Len(), ref 1)
	expect.IsNone(a.Remove(i))
}

func TestGetMut() {
	a := arena.New<int>()
	i := a.Insert(1)
	if v := a.GetMut(i) {
		*v += 41
	}
	if v := a.Get(i) { expect.Equal(v, ref 42) } else { expect.Fail("the slot is empty") }
	expect.Equal(ref fmt.Sprint(a), "arena[42]")
	expect.Equal(ref a.String(), "arena[42]")
}

func BenchmarkInsertRemove() {
	a := arena.New<int>()
	for testing.Loop() {
		i := a.Insert(1)
		_ = a.Remove(i)
	}
}

func TestIter() {
	a := arena.New<string>()
	i := a.Insert("one".Clone())
	j := a.Insert("two".Clone())
	k := a.Insert("three".Clone())
	expect.IsSome(a.Remove(j))
	seen := []string{}
	for idx, v := range a.Iter() {
		expect.True(idx == i || idx == k)
		seen.Push(v.Clone())
	}

	expect.Equal(ref len(seen), ref 2)
	expect.Equal(ref seen[0], "one")
	expect.Equal(ref seen[1], "three")
	n := 0
	for range a.Iter() {
		n++
	}

	expect.Equal(ref n, ref 2)
	empty := arena.New<int>()
	for range empty.Iter() {
		expect.Fail("an empty arena yielded a value")
	}

	l := a.Insert("four".Clone()) // reuses the slot two left, on its next generation
	for idx, v := range a.Iter() {
		if v == "four" {
			expect.True(idx == l)
			expect.True(idx != j) // the stale index names nothing
		}
	}

	expect.True(a.Get(j).IsNone())
	if v := a.Get(l) { expect.Equal(v, "four") } else { expect.Fail("four is missing") }
}
