// Package task keeps a task's failure in the task it happened in. A
// spawn written as an expression, h := spawn f(x), starts the task
// under a mark and gives a Handle on it; Join waits until the task has
// ended and returns what it returned, or the Panic that ended it, whose
// message the program reads. A spawn written as a statement keeps its
// meaning: its panic ends the program. A panic is still a bug and
// Result is still how a failure is handled; the handle limits what a
// bug takes down to the task it is in, so that a server whose task for
// one request fails goes on serving the others.
//
// A handle is a value, not a name for the task: nothing is sent to a
// task through it and no task finds another by it. There is no address,
// no mailbox, no link and no kill. The compiler writes the spawn; this
// package is what the program holds afterwards.
//
// A Group is several tasks started for handles, waited for together:
// Wait returns once every one has ended, with the first panic among
// them, and the first panic cancels the others, so that they stop.
//
// Cancellation and deadlines belong to the task, not to a value the
// program passes along. A task is in a scope, and every task it starts
// is in it too: Within gives the calls of a function and the tasks they
// start a deadline, and a Group is a scope its Cancel ends. A call that
// waits stops waiting once its task's scope is cancelled or its
// deadline has passed, and says so in the form it already has: a call
// that returns a Result fails with an io.Error of Kind io.Cancelled, or
// io.TimedOut for a deadline; a receive gives None and a send drops its
// value, as at a channel's end; time.Sleep returns. Cancelled tells a
// task whose receive gave None that it was cancelled. Join and a
// group's Wait are not cancelled: they wait for tasks that are
// cancelled with the waiter, and end.
package task

import "time"

// A Handle is a task started for one: an owned value that Join takes,
// so a task is joined once, by whoever holds the handle, in any task.
// It has no zero value; one comes only from a spawn. A handle dropped
// without a Join leaves its task running, and the task's result is
// dropped when the task ends.
//
//	h := spawn crunch(data) // task.Handle<int>
//	match h.Join() {
//		Ok(n)  => fmt.Println("result", n),
//		Err(p) => fmt.Println("the task failed:", p.Message()),
//	}
struct Handle<T: Send> {
	done chan Result<T, Panic> // one slot, which the task fills as it ends; the task holds the other handle
}

// A Panic is the failure of a task whose handle contained it: the
// message the panic was raised with, index out of range [7] with length
// 3 for a bug the runtime found, or the text a panic call was given.
struct Panic {
	message string
}

// Join waits until the task has ended and returns what it returned, or
// the Panic that ended it. A task that never ends is never joined: Join
// waits as a receive on a channel no one sends on does, and the
// deadlock report says so when nothing else can run.
func (h Handle<T>) Join() Result<T, Panic> {
	for { // a receive on a task's handle is not cancelled: the task is cancelled with the joiner, and ends
		if r := <-h.done { // the task holds a sending handle until it has sent: a receive waits for its one value
			return r
		}
	}
}

// Message lends the message the failed task's panic was raised with,
// the text panic was given or the runtime's own, "index out of range"
// and the like, for as long as the Panic is lent; nothing is copied.
//
//	if p := h.Join().Err() { fmt.Println("worker failed:", p.Message()) }
func (p ref Panic) Message() ref string { return ref p.message }

// A Group is several tasks started for handles of no result, waited
// for together, and a scope they are cancelled in together. Add puts a
// task in the group, with every task it starts; Cancel cancels them,
// and so does the first member to panic, so that the others stop; and
// Wait returns once every member has ended: Ok when each returned, or
// the first panic among them. A group is a value the function owns,
// made by NewGroup and taken by Wait; it has no zero value.
//
//	g := task.NewGroup()
//	g.Add(spawn serve(listener))
//	g.Add(spawn flush(queue.Clone()))
//	match g.Wait() {
//		Ok(_)  => {},
//		Err(p) => fmt.Println("a task failed:", p.Message()),
//	}
struct Group {
	scope   scope          // the runtime's record of the group's scope, which the members are in
	members []Handle<()> // the members' handles, joined by Wait in turn
}

// A scope is the runtime's record of a group's scope, held while the
// group lives; a member holds it too while it is in it.
struct scope impl Drop {
	handle int
}

func (s mut scope) Drop() { dropScope(s.handle) }

// NewGroup returns a group with no member, ready for Add, whose scope
// is under the one the calling task is in: a cancel or a deadline
// there reaches the group's members too. It allocates the scope once
// for the group's life.
//
//	g := task.NewGroup()
//	g.Add(spawn work(1))
//	g.Wait()?
func NewGroup() Group {
	return Group{scope: scope{handle: newScope()}, members: []Handle<()>{}}
}

// Add puts the task behind h in the group, which Wait then waits for
// and Cancel cancels, with every task it has started, whenever it
// started them. The handle is taken: the group joins the task. A
// member that panics cancels the others, as it fails: the runtime that
// catches the panic does it, so that no task stands by each member.
func (g mut Group) Add(h Handle<()>) {
	adopt(g.scope.handle, ref h.done)
	g.members.Push(h)
}

// Cancel cancels the group's members and every task they started: each
// call they make that waits stops waiting, as the package says, and
// each call they make later that would wait stops at once. A member
// that never waits and never asks Cancelled runs on, and Wait waits
// for it. A second Cancel does nothing.
//
//	g.Cancel() // the server is shutting down
func (g ref Group) Cancel() {
	cancelScope(g.scope.handle)
}

// Wait returns once every member has ended: Ok when each returned, or
// the panic of the first to fail. It takes the group, so a group is
// waited for once; a group dropped without a Wait leaves its members
// running, as a handle dropped leaves its task.
func (g Group) Wait() Result<(), Panic> {
	var failed Panic? = None
	for _, h := range g.members {
		r, first := settle(h, g.scope.handle)
		match r {
			Ok(_) => {},
			Err(p) => {
				// The first to fail is the member the runtime saw fail
				// first among those the group had taken; one that failed
				// before the group took it is first only by its place.
				if first || failed.IsNone() {
					failed = Some(p)
				}
			},
		}
	}

	return match failed {
		Some(p) => Err(p),
		None => Ok(()),
	}
}

// Within runs body with a deadline d from now, which every call body
// makes and every task it starts inherits, and returns Some with what
// body returned, or None when body was cut short: its deadline passed,
// or the scope around it was cancelled, while it ran. A value body
// returns after it was cut short is dropped, so that a sum a cancelled
// receive ended early is never taken for the whole one. A deadline only
// narrows: inside a scope with less time left, the earlier one holds.
// A d of zero or less has passed already.
//
//	page := task.Within(2 * time.Second, func() Result<Page, io.Error> {
//		c := net.Dial(host, 443)? // the dial, the write and the read share the two seconds
//		c.WriteString(request)?
//		return readPage(mut c)
//	})
func Within<T>(d time.Duration, body func() T) T? {
	enter(i64(d))
	defer leave()
	v := body()
	if Cancelled() {
		return None
	}

	return Some(v)
}

// Cancelled reports whether the running task's work is cancelled: its
// group cancelled, or a member of it failed, or a deadline of Within
// passed. A task whose receive gave None asks it to tell a cancel from
// a channel's end, and a task that computes without waiting asks it
// between rounds, since a cancel lands only where a task waits.
//
//	for !task.Cancelled() {
//		step()
//	}
func Cancelled() bool

// settle joins a member of the group whose scope is group, as Join
// does, and reports too whether the member was the first of the
// group's to fail, which the runtime records as the member fails,
// before it hands its result over.
func settle(h Handle<()>, group int) (Result<(), Panic>, bool) {
	for {
		if r := <-h.done { // a receive on a task's handle is not cancelled
			return (r, firstFailed(group, ref h.done))
		}
	}
}

// enter has the running task enter a scope with a deadline d
// nanoseconds from now, under the one it is in, and leave has it go
// back. The runtime provides them.
func enter(d i64)

func leave()

// newScope makes a group's scope under the running task's, and returns
// its handle; dropScope lets the handle go, cancelScope cancels the
// scope, adopt puts in it the task whose handle channel done is, and
// firstFailed reports whether that task was the first of the group's
// to fail. The runtime provides them.
func newScope() int

func dropScope(h int)

func cancelScope(h int)

func adopt(h int, done ref chan Result<(), Panic>)

func firstFailed(h int, done ref chan Result<(), Panic>) bool
