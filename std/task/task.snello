// Package task keeps a task's failure in the task it happened in. A
// spawn written as an expression, h := spawn f(x), starts the task
// under a mark and gives a Handle on it; Join waits until the task has
// ended and returns what it returned, or the Panic that ended it, whose
// message the program reads. A spawn written as a statement keeps its
// meaning: its panic ends the program. A panic is still a bug and
// Result is still how a failure is handled; the handle limits what a
// bug takes down to the task it is in, so that a server whose task for
// one request fails goes on serving the others.
//
// A handle is a value, not a name for the task: nothing is sent to a
// task through it and no task finds another by it. There is no address,
// no mailbox, no link and no kill. The compiler writes the spawn; this
// package is what the program holds afterwards.
//
// A Group is several tasks started for handles, waited for together:
// Wait returns once every one has ended, with the first panic among
// them, and Done is a channel the group closes when one has failed, so
// that the others can stop.
package task

import "sync"

// A Handle is a task started for one: an owned value that Join takes,
// so a task is joined once, by whoever holds the handle, in any task.
// It has no zero value; one comes only from a spawn. A handle dropped
// without a Join leaves its task running, and the task's result is
// dropped when the task ends.
//
//	h := spawn crunch(data) // task.Handle<int>
//	match h.Join() {
//		Ok(n)  => fmt.Println("result", n),
//		Err(p) => fmt.Println("the task failed:", p.Message()),
//	}
struct Handle<T: Send> {
	done chan Result<T, Panic> // one slot, which the task fills as it ends; the task holds the other handle
}

// A Panic is the failure of a task whose handle contained it: the
// message the panic was raised with, index out of range [7] with length
// 3 for a bug the runtime found, or the text a panic call was given.
struct Panic {
	message string
}

// Join waits until the task has ended and returns what it returned, or
// the Panic that ended it. A task that never ends is never joined: Join
// waits as a receive on a channel no one sends on does, and the
// deadlock report says so when nothing else can run.
func (h Handle<T>) Join() Result<T, Panic> {
	for {
		if r := <-h.done { // never closed: a receive waits for the task's one value
			return r
		}
	}
}

// Message lends the message the panic was raised with.
func (p ref Panic) Message() ref string { return ref p.message }

// A Group is several tasks started for handles of no result, waited
// for together and told of the first that failed. Add puts a task in
// the group, Done gives a channel the group closes once the first
// member fails, which a member that should stop then selects on, and
// Wait returns once every member has ended: Ok when each returned, or
// the first panic among them. A group is a value the function owns,
// made by NewGroup and taken by Wait; it has no zero value.
//
//	g := task.NewGroup()
//	g.Add(spawn serve(listener, g.Done()))
//	g.Add(spawn flush(queue.Clone(), g.Done()))
//	match g.Wait() {
//		Ok(_)  => {},
//		Err(p) => fmt.Println("a task failed:", p.Message()),
//	}
struct Group {
	first   sync.Arc<sync.Mutex<Panic?>> // the first panic among the members, kept by the watcher that saw it
	done    chan ()                     // closed by that watcher; Done gives handles on it
	waiting sync.WaitGroup              // counts the watchers, one per member, each out once its member has ended
}

// NewGroup returns a group with no member.
func NewGroup() Group {
	return Group{
		first:   sync.NewArc(sync.NewMutex<Panic?>(None)),
		done:    make(chan ()),
		waiting: sync.NewWaitGroup(),
	}
}

// Add puts the task behind h in the group, which Wait then waits for.
// The handle is taken: the group joins the task.
func (g mut Group) Add(h Handle<()>) {
	g.waiting.Add(1)
	spawn watch(h, g.first.Clone(), g.done.Clone(), g.waiting.Clone())
}

// Done returns a handle on the channel the group closes when one of
// its members fails, and never otherwise: a member that should stop
// when another has failed selects on it, and one that does not is
// waited for. Each call gives a handle to move into a member.
func (g ref Group) Done() <-chan () {
	return g.done.Clone()
}

// Wait returns once every member has ended: Ok when each returned, or
// the first panic among them, whose Done it closed. It takes the group,
// so a group is waited for once; a group dropped without a Wait leaves
// its members running, as a handle dropped leaves its task.
func (g Group) Wait() Result<(), Panic> {
	g.waiting.Wait()
	guard := g.first.Get().Lock()
	return match take(mut *guard.Get()) {
		Some(p) => Err(p),
		None => Ok(()),
	}
}

// watch joins a member for its group: a panic that is the first among
// the members is kept and closes done, under the cell's lock so that
// two members failing at once close it once; then the watcher counts
// itself out.
func watch(h Handle<()>, first sync.Arc<sync.Mutex<Panic?>>, done chan (), waiting sync.WaitGroup) {
	match h.Join() {
		Ok(_) => {},
		Err(p) => {
			guard := first.Get().Lock()
			if guard.Get().IsNone() {
				*guard.Get() = Some(p)
				close(done)
			}
		},
	}

	waiting.Done()
}
