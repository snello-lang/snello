// Package builtin documents what every Snello program has without an
// import: the basic types, Option and Result, the methods of slices,
// maps and strings, the built-in functions and the standard traits.
// The compiler provides every one of them; this file is their
// documentation, and nothing here is compiled. A program does not
// import it, and the import is refused: its names are in scope
// everywhere.
//
// The declarations have no bodies. Their receivers and parameters are
// written as a program would write a call: a slice method on xs mut
// []T lends the slice mut and changes it, one on xs ref []T reads it,
// and a method on a value, Expect on o T?, takes it. T, K, V and E
// stand for the element, key, value and error types of the receiver,
// and U for a type a method's function argument gives back. A test
// under std/ keeps this file in step with the compiler's tables: every
// method here exists with this signature, and every method the
// compiler has is here.
package builtin

// true and false are the two values of bool.
const true bool = true
const false bool = false

// bool is the type of a condition, true or false: what a comparison
// gives and what if, for and && take. It is Copy, Eq and Hash.
type bool bool

// string is immutable text, UTF-8 bytes with a length. It is Eq, Ord,
// Hash and Clone; s[i] is its byte i, s[a:b] a borrow of the bytes a
// to b, and len(s) its length in bytes. A string literal is a view of
// the program's text and owns nothing; Clone makes an owned copy, and
// + makes a new string of two. A string is compared byte by byte, so
// < orders it by its bytes, which for UTF-8 is the order of its code
// points.
//
//	s := "héllo"
//	n := len(s)   // 6: é is two bytes
//	b := s[0]     // 'h', a byte
//	t := s[1:3]   // "é", a borrow of s
type string string

// i8 is the signed integer of 8 bits, from -128 to 127. Like every
// integer type it is Copy, Eq, Ord and Hash and implements Add, Sub,
// Mul, Div, Rem and Neg; arithmetic wraps on overflow, and division by
// zero panics. CheckedAdd and its kin report an overflow instead.
type i8 i8

// i16 is the signed integer of 16 bits, from -32768 to 32767, with the
// traits and the wrapping arithmetic of i8.
type i16 i16

// i32 is the signed integer of 32 bits, with the traits and the
// wrapping arithmetic of i8.
type i32 i32

// i64 is the signed integer of 64 bits, with the traits and the
// wrapping arithmetic of i8; int has its width.
type i64 i64

// u8 is the unsigned integer of 8 bits, from 0 to 255, with the traits
// and the wrapping arithmetic of i8: 255 + 1 is 0. byte is its other
// name.
type u8 u8

// u16 is the unsigned integer of 16 bits, from 0 to 65535, with the
// traits and the wrapping arithmetic of i8.
type u16 u16

// u32 is the unsigned integer of 32 bits, with the traits and the
// wrapping arithmetic of i8.
type u32 u32

// u64 is the unsigned integer of 64 bits, with the traits and the
// wrapping arithmetic of i8: the type of a hash.
type u64 u64

// int is the signed integer of 64 bits: the type of len and cap, of an
// index, and of an integer literal with nothing to say otherwise. It
// has the traits and the wrapping arithmetic of i8, and a converted
// value is written int(x).
type int int

// uint is the unsigned integer of 64 bits, with the traits and the
// wrapping arithmetic of i8.
type uint uint

// byte is u8 under another name, the same type: the element of []byte
// and the type of s[i] on a string. A character literal of one ASCII
// character, 'a', is a byte where a byte is wanted.
type byte u8

// rune is i32 under another name, the same type: a Unicode code point,
// the type of a character literal 'x' with nothing to say otherwise,
// and what a range over a string gives.
type rune i32

// f32 is the IEEE 754 binary floating-point number of 32 bits, Copy,
// Eq and Ord, with the arithmetic traits. Division by zero gives an
// infinity or a NaN, never a panic.
type f32 f32

// f64 is the IEEE 754 binary floating-point number of 64 bits, the
// type of a literal with a point or an exponent in it, 2.5 or 1e9. It
// is Copy, Eq and Ord, with the arithmetic traits; division by zero
// gives an infinity or a NaN, never a panic. A NaN equals nothing,
// itself included; math.IsNaN tests for one.
type f64 f64

// any is the type of a variadic parameter of a library function the
// compiler writes, fmt.Println(args ...ref any), which takes an
// argument of any type by its own type. A program cannot name it.
type any any

// An Option<T>, written T?, is a value of T or nothing: Some(v) or
// None. It is what a lookup that may find nothing returns, and it is
// taken apart by match, by an if binding, if v := opt { ... }, by ??
// with a value or an exit on its right, and by ? in a function that
// returns an Option itself. A borrow may be optional, ref T?, which is
// how a borrow says absence, since no borrow is nil. An Option owns
// its value: taking it apart moves the value out.
//
//	port := cfg.Get("port") ?? return Err(missing("port"))
//	if v := m.Get(ref key) { use(v) }
enum Option<T> {
	Some(v T)
	None
}

// A Result<T, E> is a value of T or an error of E: Ok(v) or Err(e). A
// function that can fail returns one; the caller passes the failure up
// with ?, from a function returning a Result with the same error type,
// or handles it with a match. E is any type; the library's is io.Error,
// and a type implementing Error prints as its message.
//
//	n := strconv.Atoi(ref text)?
//	match os.Open(ref path) {
//		Ok(f) => read(f),
//		Err(e) => fmt.Println("open:", e),
//	}
enum Result<T, E> {
	Ok(v T)
	Err(e E)
}

// An Ordering is what Cmp returns: how the receiver stands to the
// argument, Less when it goes before it, Equal, or Greater when it goes
// after it.
enum Ordering {
	Less
	Equal
	Greater
}

// The forms below are the types, borrows, operators and keywords the
// language writes with its own syntax, which no declaration can name.
// Each comment documents the form it begins with, as a declaration's
// comment does its name.

// []T is a slice: values of T it owns, in order, which grows at its
// end. A literal lists the elements, []int{3, 1, 2}, and make([]T, n)
// builds n zero values, or make([]T, 0, n) reserves the room for n for
// an element with no zero value. len is the number of elements and cap
// the room before the next growth. xs[i] reads or writes an element,
// and an index outside the slice stops the program. xs[lo:hi] lends
// the elements from lo up to hi, a ref []T, or a mut []T reached
// through a mut, whose number stays the slice's to change. Two slices
// do not compare with ==. The methods of a slice are documented in this
// file.

// [N]T is an array: N values of T, its length a constant. var gives N
// zero values, a literal lists them in order, [3]int{1, 2}, leaving the
// rest zero, and a[i] reads or writes one, with a slice's bounds check.
// An array is copied whole on assignment, so a struct of arrays is
// Copy when its elements are, and len and cap are its length. It is not
// a slice: it is not sliced, pushed to or ranged over.

// map[K]V is a map: one value of V for each key of K, which is Eq and
// Hash. It owns its keys and values. A literal lists its entries, or
// none, map[string]int{}, and make(map[K]V) is the empty one. m[k] = v
// stores a value, making the entry when the key is new, and m[k] reads
// one: a key that is not there gives the value type's zero value and
// leaves the map unchanged. A value type with no zero value is read and
// changed through Get and GetMut. len is the number of entries, and
// range walks them in the order they were inserted, the order a map
// prints in. Two maps do not compare with ==. The methods of a map are
// documented in this file.

// chan T is a channel of T, the way tasks hand values to each other:
// c <- v sends v, moving it, and <-c receives one, owned. A chan<- T
// only sends and a <-chan T only receives; make(chan T) makes a
// channel, and make(chan T, n) one that buffers n values. Each task
// holds a handle of its own, ch.Clone() another on the same channel. A
// channel ends when its last sending handle is dropped: a receiver then
// sees None once the values already sent are taken. The methods of a
// channel are documented in this file.

// *T is an owned pointer: the one owner of a T on the heap, made by
// &expr, which moves the value there. It is how a type holds a value of
// itself, a list's next node or a tree's children, and it is lent as
// what it holds: a *Node fits a ref Node parameter.

// ref T is a shared borrow of a T: lent to read for as long as the
// borrow is used, while its owner keeps it. It is written at the
// declaration, func f(v ref T), and may be at the call, f(ref x). Any
// number of ref borrows of a value may live at once, and nothing may
// change the value while one does. A borrow lives inside one function,
// is never stored or sent, and is returned only from the receiver or
// the only borrowed parameter.

// mut T is an exclusive borrow of a T: lent to change for as long as
// the borrow is used, while its owner keeps it. It is written at the
// declaration, func f(v mut T), and at the call of an owned value,
// f(mut x), since a change is worth a word; a borrow passed on and a
// receiver take no keyword. While a value is borrowed mut, nothing else
// may look at it, its owner included. A borrow lives inside one
// function, is never stored or sent, and is returned only from the
// receiver or the only borrowed parameter.

// x? yields the value inside x and returns early with the absent or
// failed case when there is none. The function's result type says
// which: in one returning T?, x? takes an optional and returns None; in
// one returning Result<T, E>, it takes a result and returns its Err,
// whose error type is the function's, or has a place in it: the one
// variant of the function's error enum whose only field has its type,
// or a trait value when the function returns Result<T, Error>.

// x ?? y yields the value inside x when it is Some or Ok, and otherwise
// evaluates y: an expression of the inside's type, or a return, break
// or continue, or a block ending in one. n := cur ?? break. It sits
// below every other operator and groups to the right.

// ch <- v sends v on the channel ch, moving it: after the send, v is
// gone from the sender, and the receiver owns it.

// <-ch receives a value from the channel ch, owned by the receiver: an
// optional, None once the channel has ended and the values already sent
// are taken. A bare <-ch discards what it receives.

// xs ...T, a function's last parameter, takes any number of arguments,
// which the function owns, as a slice; xs ...ref T borrows them for the
// call. f(a, xs...) passes a slice on as the arguments.

// @A, after what it is about, attaches the attribute A to it: a
// constant of a type that lists Attribute, after a field's type and
// default, Port int = 8080 @Usage("the port"), after a variant, or after
// a struct's or an enum's name, its type parameters and what it lists,
// before its body. A function that reflects on the type at compile time
// reads it: encoding/json's @json.Name("port").

// package begins every file, package name: the package the file is a
// part of. A directory is one package, of its .snello files those a
// build for the platform chooses by their names, its test files when it
// is tested, and the package main is a program, whose func main runs.

// import names the packages a file uses, by their paths: import "fmt",
// or several, import ("fmt"; "os"). A path names a package of the
// standard library, of the module's own directories, or of a module it
// requires; its names are reached through the package's name,
// fmt.Println.

// const names a value the compiler computes from literals, other
// constants, the operators and conversions between number types, at
// the top level of a file or inside a function: const KB = 1 << 10.
// The compiler refuses one its type cannot hold, and a package's
// constants may be declared in any order.

// var declares variables with a type written out, var x, y int = 1, 2.
// One declared without a value starts at its type's zero value. A type
// that must always hold something has none: a pointer, a borrow, a
// function, a channel, a type with a Drop, and an array, a tuple or a
// struct that holds one of these, where a slice or a map of them starts
// empty; a variable of it is declared with its value, or as an option,
// var p *int?. A struct with field defaults is made with them, T{},
// and not declared without a value.
// := declares one and infers its type from the value.

// type Name T declares a new type whose values are made as T's are but
// which is a type of its own: a value of one is not one of the other,
// and a conversion, Name(x), makes one from the other. It is the only
// thing type declares.

// struct Name { fields } declares a struct: its fields, each a name and
// a type, one a line or separated by ;, and the traits it implements,
// listed after impl. A literal names its fields, Node{value: v}, or
// gives every field in order, Vec3{1, 2, 3}, and a field may declare a
// default, port int = 8080, which a literal that leaves it out takes.

// enum Name { variants } declares an enum: a value is one of its
// variants, each a name with fields or none, Connecting(attempt int)
// and Closed. A match takes it apart and covers every variant. An enum
// is not a number: it has no iota and no conversion to int.

// trait Name { members } declares a trait: the methods a type that
// implements it has, written with Self as the receiver's type, default
// methods with their bodies, fields, and the traits it refines, trait
// Loud: Shape. A trait used as a type is a value of any type that
// implements it, and as a bound, T: Shape, it says what a type
// parameter can do.

// impl, in a type's declaration, lists the traits the type implements,
// after its name and its type parameters, or after the type it is
// declared over: struct Circle impl Shape { r f64 }, type Celsius f64
// impl fmt.Stringer. A type implements exactly the traits it lists, and
// the compiler checks that it has every method each requires, with the
// signature the trait gives it.

// Self, inside a trait, stands for whatever type implements it: func
// (s ref Self) Area() f64.

// super.M(args), inside a method, a trait's or a type's own, calls the
// next definition of M in the resolution order with the method's own
// receiver: an override that adds to the method it replaces rather than
// starting over.

// func declares a function: its parameters, each a name and a type, ref
// or mut before the type for a borrow, and its results. A method has a
// receiver before its name, func (c mut Canvas) Add(s Shape), and
// func(...) { ... } is a function literal, a value.

// return ends the function and gives its result, return x, several as a
// tuple, return (min, rest). The deferred calls run after the result is
// computed.

// if runs its block when its condition holds, written with no
// parentheses, and the else after it otherwise. if x := f(); x > 0 {
// starts with a statement, and if x := opt { binds the value an
// optional holds and skips the block when there is none. An if used as
// an expression has an else.

// else follows an if's block: the block or the if that runs when the
// condition does not hold.

// match x { arms } compares the value against each arm's pattern in
// order and runs the first that fits, an arm written pattern => body, a
// variant's pattern binding its fields to new names. A match is
// exhaustive: one that misses a case, with no _ arm, does not compile.
// Written with no value, match { cond => body }, it runs the first arm
// whose condition holds. On a type parameter, match T { int => ...,
// struct => ..., _ => ... }, it chooses an arm by the type, the first
// that fits, when the function is compiled for one; its arms need not
// cover every type, and a type no arm takes is refused where the
// function is used with it. It is an expression when every arm yields a
// value.

// for loops: for { forever, for cond { while a condition holds, for i :=
// 0; i < n; i += 1 { with a counter, and with range over a slice, a map,
// a string, a channel or an iterator.

// range, in a for, walks a value: for i, x := range xs a slice's
// indexes and elements, for k, v := range m a map's keys and values in
// the order they were inserted, for i, r := range s a string's runes,
// for x := range ch the values received from a channel until it ends,
// any value with a Next method, an iterator, and in a match on a type
// parameter T, in its arm struct, for f := range fields(T) a struct's
// fields, and in its arm enum, variants(T) an enum's variants, written
// out once for each.

// break ends the innermost loop, wherever it stands inside it: a match
// or a select is not a loop and does not catch it.

// continue goes to the next iteration of the innermost loop, wherever it
// stands inside it: a match or a select is not a loop and does not catch
// it.

// spawn f(x) starts a task running the call, on the language's own
// scheduler, and goes on. The arguments, and the variables a closure
// given to it mentions, cross into the task as every value that crosses
// between tasks does, moved, immutable or atomically shared, and never
// a borrow. As a statement it gives nothing back; where a value is
// wanted, it gives a task.Handle<T>, whose Join waits for the task and
// returns its result, or the panic that ended it.

// defer f(x) runs the call when the enclosing function ends, by a
// return, after the result is computed, or by a panic. The arguments
// are evaluated where the defer stands, but a variable lent to a ref
// parameter is read as it is when the call runs. Several deferred calls
// run last first.

// select { cases } waits for the first of several channel operations
// that can proceed and runs that case; with a default it does not wait.
// When several are ready at once, one is chosen at random, so a busy
// channel cannot starve the others.

// case, in a select, is a channel operation that may be chosen: a
// receive, got := <-ch, which binds the optional the receive yields, a
// bare receive, or a send, ch <- v, with the statements that run when
// it is.

// default, in a select, runs when no case can proceed, so that the
// select does not wait.

// switch is reserved and means nothing: the language has no switch
// statement. match does its work, on a value or, written with no value,
// on conditions.

// _ is the blank name: a value given to it is dropped there, _ = conn
// drops conn, and so is a value declared as it, var _ = conn or
// _, n := pair(), once the statement's values are made, since it binds
// nothing, so a value that is to live to the end of its scope is given
// a name; a value made there whose Drop ends what it borrows, a lock's
// guard, var _ = m.Lock(), is refused, since it would end as it begins,
// and a guard is ended early by dropping its variable, _ = g; a package
// variable cannot be named it, since one is made on first use and
// nothing can use it; and as a pattern it matches anything and binds
// nothing, the arm a match that covers no other case ends with.

// pattern, in a match arm, says which values the arm takes: a literal,
// '+'; a range, both ends included, '0'..='9'; a variant, binding its
// fields, Connecting(n), or with none, Closed; any other name, which
// matches anything and binds it; _, which binds nothing; a tuple, each
// element against its pattern; alternatives, Plus | Minus, any of
// them; and a guard after any of these, Connecting(n) if n < 3, the
// pattern and then a condition. In a match on a type, an arm is a type,
// int or Point, a form of one, []E or E?, alternatives, i8 | i16, a
// trait, any type that implements it, or a kind, struct or enum, and
// takes no guard, since a type is matched by what it is.

// Copy marks a type whose values are copied on assignment and when
// passed, rather than moved: the numbers, bool, a struct or enum that
// lists Copy and whose every field is Copy. A Copy type cannot have a
// Drop method, since a copy would run it twice.
//
//	struct Meters impl Copy { n f64 }
trait Copy {}

// Clone gives an explicit, owned copy of a value that is not Copy: a
// new value its caller owns, as deep as the type's fields are, which
// costs an allocation for each string, slice or map it holds. A struct
// or enum that lists Clone has it derived from its fields when every
// field is Clone; a type may write its own.
trait Clone { func (s ref Self) Clone() Self }

// Eq compares two values for equality, behind == and !=, lending both.
// A struct or enum that lists Eq has it derived from its fields; a
// type that writes Eq and lists Hash writes Hash too, since equal
// values must hash alike.
trait Eq { func (s ref Self) Eq(o ref Self) bool }

// Ord orders values, behind <, <=, > and >=, and refines Eq: Cmp says
// whether the receiver is Less, Equal or Greater than o, lending both.
// A derived Cmp compares field by field, in declaration order. Sort
// orders a slice of an Ord type.
trait Ord: Eq { func (s ref Self) Cmp(o ref Self) Ordering }

// Hash gives a value's hash, a u64, for a map key, and refines Eq:
// equal values give equal hashes. A map's key type must implement
// Hash; a struct or enum that lists it has it derived from its fields.
trait Hash: Eq { func (s ref Self) Hash() u64 }

// Drop runs when a value goes out of scope, on every path out of its
// function, and when a panic ends the program: a file closes itself, a
// handle gives up its count. Drop is lent the value mut, once, just
// before its memory is freed. A type with a Drop method cannot be
// Copy, and a program never calls Drop itself.
trait Drop { func (s mut Self) Drop() }

// Error marks an error type: Error returns its message, a new string,
// lending the value. A value of a type implementing Error prints as
// its message wherever a value is printed, inside an Err(...) as well.
trait Error {
	func (s ref Self) Error() string

	// Source gives the error this one wraps, an owned trait value, or
	// None; a type that writes no Source has it derived as None, and
	// one that writes no Error has the message derived: the value as
	// %v prints it. %+v prints the message and then each source's
	// message after a colon and a space, and ? passes an error into
	// the one variant of the function's error enum holding its type,
	// or into a trait value when the function returns Result<T, Error>.
	func (s ref Self) Source() Error?
}

// Add is the trait behind + on a declared type: a + b calls a.Add(b),
// taking both operands by value. The numbers implement it; + on two
// strings joins them into a new one.
trait Add { func (a Self) Add(o Self) Self }

// Sub is the trait behind binary - on a declared type: a - b calls
// a.Sub(b), taking both operands by value.
trait Sub { func (a Self) Sub(o Self) Self }

// Mul is the trait behind * on a declared type: a * b calls a.Mul(b),
// taking both operands by value.
trait Mul { func (a Self) Mul(o Self) Self }

// Div is the trait behind / on a declared type: a / b calls a.Div(b),
// taking both operands by value. An integer divided by zero panics.
trait Div { func (a Self) Div(o Self) Self }

// Rem is the trait behind % on a declared type: a % b calls a.Rem(b),
// taking both operands by value; an integer's remainder has the sign
// of a.
trait Rem { func (a Self) Rem(o Self) Self }

// Neg is the trait behind unary - on a declared type: -a calls
// a.Neg(), taking the operand by value.
trait Neg { func (a Self) Neg() Self }

// Send marks a type whose values may cross from one task to another:
// captured by a spawn, sent on a channel, received from one. It is
// never listed on a type; the compiler reads it from the structure, and
// a type is Send when every field is. The numbers, bool, string and a
// channel handle are Send; an owned pointer, a slice, a map, an option
// or a result is Send when what it holds is; a borrow never is, as it
// points into a frame of the task that made it; a trait used as a type
// is Send only when the trait refines Send, trait Job: Send; and a type
// parameter only when bounded by it, T: Send. A type that holds a
// local field is not Send.
trait Send {}

// Reflect opens a type to reflection from every package: a reflecting
// function, one that loops over a type's fields with fields(T), reaches
// every field and variant of a type that lists it, and builds it from
// them. Without it, a function reaches the fields its own package can
// name, so a type of another package that keeps a field to itself is
// neither read nor built by reflection.
trait Reflect {}

// Attribute makes a type's constants attributes: @ and a value of it,
// written after a field, Host string @json.Name("host"), after a
// variant, or on a struct or an enum before its body. A struct with no
// fields is written by its name, @json.OmitEmpty. Any package declares
// its own; a reflecting function reads them with attr, when the
// program is compiled, and nothing of them is kept when it runs.
trait Attribute {}

// FieldAttribute is Attribute limited to fields: a type that lists it
// is an attribute of a field, a variant's field included, and is
// refused on a variant or a type, as struct Skip impl FieldAttribute
// {} is. A type may list it with VariantAttribute or TypeAttribute to
// be written on those places too; a type that lists only Attribute is
// written on any of them.
trait FieldAttribute: Attribute {}

// VariantAttribute is Attribute limited to an enum's variants: a type
// that lists it is written after a variant, and refused on a field or
// a type unless it lists their attribute traits too.
trait VariantAttribute: Attribute {}

// TypeAttribute is Attribute limited to types: a type that lists it is
// written on a struct or an enum before its body, and refused on a
// field or a variant unless it lists their attribute traits too.
trait TypeAttribute: Attribute {}

// local is a field that holds nothing and makes the type holding it
// stay in its task: a value of that type is not Send. Only the
// standard library writes it, on a type whose sharing is not safe
// across tasks, as rc.Rc is, whose count of handles is not atomic. A
// program never names it; its handles are refused at the task boundary
// with a message naming the type.
type local local

// len returns the length of x: the elements of a slice or an array,
// the bytes of a string, the entries of a map, or the values buffered
// in a channel and not yet received, in constant time.
//
//	n := len("héllo") // 6, the bytes
func len(x any) int

// cap returns the capacity of x, a slice, an array or a channel: how
// many elements a slice holds before a Push must grow it, or how many
// values a channel buffers before a send blocks.
func cap(x any) int

// make returns a new value of the type given as its first argument: a
// slice of a length and an optional capacity, make([]T, n) or
// make([]T, n, cap), with every element the zero value; a new empty
// map, make(map[K]V); or a channel buffering n values, make(chan T, n),
// unbuffered for an n of zero. It allocates, and the caller owns what
// it returns. A length or a capacity that no memory holds ends the
// program.
//
//	xs := make([]int, 0, 16) // empty, with room for 16
//	done := make(chan bool, 1)
func make<T>(n int) T

// take moves the value out of place, a variable, field or element lent
// mut, and leaves the type's zero value there: None for an Option, ""
// for a string, 0 for a number, an empty slice or map. It returns the
// value the place held, which the caller then owns. It is how a value
// leaves a place that cannot be moved out of, an element or a field
// reached through a borrow, and how a linked structure is rebuilt
// without a placeholder. It copies the value's bytes and allocates
// nothing.
//
//	next := take(mut node.next) // node.next is None from here on
func take<T>(place mut T) T

// replace moves the value out of place, a variable, field or element
// lent mut, and leaves v there, which the place owns from then on; it
// returns the value the place held. It works for every type, where
// take works only for a type with a zero value to leave behind, and
// the place is never empty. It allocates nothing.
//
//	old := replace(mut s.lock, sync.NewMutex(0))
func replace<T>(place mut T, v T) T

// panic prints its message, msg, lent, and ends the program with status
// 2, after the values still owned are dropped. msg is what a ref string
// parameter takes, a string owned or lent; a value of another type, one
// declared over string among them, is refused, so that a panic prints
// the text the program wrote. It never returns, and
// the compiler knows that: a match arm or an if branch may end in a
// panic where a value is wanted. A panic is for a mistake in the
// program itself, never for its input, which an Option or a Result
// reports.
//
//	_ => panic("unreachable: the state machine has no other state"),
func panic(msg ref string)

// print writes its arguments to the standard error, each lent and
// printed as fmt prints it with %v, one after the other with nothing
// between them and no newline after them: print("n=", n, "\n"). It is
// for programs that import nothing and for a quick look while
// debugging; fmt is the library's way to print.
func print(args ...ref any)

// fields gives the fields of a type to a loop, for f := range
// fields(T), in a generic function's arm that matched T as a struct,
// match T { struct => ... }, or the fields of a variant a loop gives,
// fields(c). The compiler writes the loop out once for each field of
// the type the function is compiled for, with f.name the field's name,
// f.type its type and f.default its default, and v.[f] the field of v;
// it is no value, and nothing of it is kept when the program runs, so
// a loop over fields costs what the code written out by hand would.
//
//	for f := range fields(T) { out.WriteString(f.name) }
func fields(t any) any

// variants gives the variants of an enum to a loop, for c := range
// variants(T), or to the arm of a match written once for each variant,
// match v { for c := range variants(T) => ... }, in an arm that
// matched T as an enum; c.name is the variant's name and c(for f :=
// range fields(c) { value }) builds it. As with fields, the compiler
// writes the loop or the arms out, and nothing of it is kept when the
// program runs.
func variants(t any) any

// attr gives the attribute of type A written on x, an A?: Some of it,
// or None when none is written. x is a part a loop over fields or
// variants gives, attr(f, json.Name), or a type parameter an arm
// matched as a struct or an enum, attr(T, Usage). The value is a
// constant in each copy of the loop and each instance of the
// function, and nothing of it is kept when the program runs.
//
//	if attr(f, json.Skip).IsNone() { write(ref v.[f]) }
func attr(x any, a any) any

// refuse refuses the program when it is compiled, with msg, where the
// compiler reaches it: in a generic function, for each type whose
// instance takes the path that holds it, the chain of calls that led
// there named before msg; in any other function, where it is written.
// The compiler decides a match on a type, on attr(x, A), Some when A is
// written on x, and on a part's name, c.name or f.name, against string
// literals, so a refuse in an arm one type takes and another does not
// refuses the one alone. msg is text the compiler knows: string
// constants and parts' names, joined with +. It is no value and never
// runs, so it may stand where any value is wanted.
//
//	match attr(T, json.Tag) {
//		Some(_) => match f.name { "" => refuse("json.Tag needs named fields: " + c.name + " has an unnamed one"), _ => ... },
//		None => ...,
//	}
func refuse(msg ref string) Never

// min returns the least of two or more numbers of one type, a, b and
// the rest, which is the result's type; a literal among them takes the
// type of the others. On floats a NaN among them makes the result NaN,
// and -0 is less than +0.
//
//	lo := min(x, y, 0)
func min<T>(a T, b T, rest ...T) T

// max returns the greatest of two or more numbers of one type, a, b and
// the rest, which is the result's type; a literal among them takes the
// type of the others. On floats a NaN among them makes the result NaN,
// and +0 is greater than -0.
//
//	n := max(len(xs), 1)
func max<T>(a T, b T, rest ...T) T

// Push adds v at the end of the slice, which owns it from then on. The
// slice grows when it is full, by doubling its capacity, so a Push
// costs constant time amortized; a growth moves the elements to a new
// block, which ends any borrow of them.
//
//	xs.Push(4)
func (xs mut []T) Push(v T)

// Pop removes the last element and returns it, owned, or None when the
// slice is empty. It keeps the slice's memory.
//
//	if v := xs.Pop() { use(v) }
func (xs mut []T) Pop() T?

// Insert adds v at index i, which the slice owns from then on, shifting
// the elements from i on up by one, which costs time linear in their
// number; i may be len(xs), which is a Push. An index past that, or
// below zero, panics.
func (xs mut []T) Insert(i int, v T)

// Remove removes the element at index i and returns it, owned, shifting
// the elements after it down by one, which costs time linear in their
// number. An index out of range panics.
func (xs mut []T) Remove(i int) T

// RemoveValue removes the first element equal to v, lent, dropping it,
// and reports whether there was one; the elements after it shift down
// by one. The element type must be Eq, and the search is linear.
func (xs mut []T) RemoveValue(v ref T) bool

// Contains reports whether an element equals v, lent, by a linear
// search. The element type must be Eq.
//
//	if xs.Contains(ref 3) { ... }
func (xs ref []T) Contains(v ref T) bool

// Clear removes every element, dropping each, and keeps the memory for
// the next Push: the length is zero and the capacity is as it was.
func (xs mut []T) Clear()

// Swap exchanges the elements at indexes i and j, moving each into the
// other's place without a copy, so it works for elements that are not
// Copy; an index out of range panics.
func (xs mut []T) Swap(i, j int)

// Reverse reverses the order of the elements in place, allocating
// nothing.
func (xs mut []T) Reverse()

// Sort orders the elements in place, least first by Cmp. The element
// type must be Ord. The sort is stable, so equal elements keep their
// order, takes O(n log n) comparisons, n for input already sorted or
// reversed, and allocates a buffer of half the slice while it runs.
//
//	xs.Sort()
func (xs mut []T) Sort()

// SortBy orders the elements in place by less, which is lent each pair
// it compares and says whether a goes before b; it is stable and costs
// what Sort costs. A less that is not a consistent order leaves the
// elements in an unspecified order, every one of them still there
// once.
//
//	people.SortBy(func(a ref Person, b ref Person) bool { return a.age < b.age })
func (xs mut []T) SortBy(less func(a ref T, b ref T) bool)

// Clone returns a new slice with a clone of every element, which the
// caller owns, allocated at the slice's length. The element type must
// be Clone.
func (xs ref []T) Clone() []T

// Extend appends a clone of every element of ys, growing the slice once
// to its new length: a Clone the element's type writes runs for each,
// and an element with none, a number or a struct of them, is copied as
// its bytes at once. The element type must be Clone; ys is lent.
func (xs mut []T) Extend(ys ref []T)

// Index returns the position of the first element equal to v, lent, or
// None when there is none, by a linear search. The element type must
// be Eq.
func (xs ref []T) Index(v ref T) int?

// First lends the first element, or None when the slice is empty. The
// borrow lives as long as the slice's.
func (xs ref []T) First() ref T?

// Last lends the last element, or None when the slice is empty. The
// borrow lives as long as the slice's.
//
//	top := stack.Last() ?? return None
func (xs ref []T) Last() ref T?

// Truncate drops the elements from index n on and keeps the memory; an
// n at or past the length leaves the slice as it is, and an n of zero
// or less empties it.
func (xs mut []T) Truncate(n int)

// Equal reports whether the two byte slices, b and o, both lent, hold
// the same bytes.
func (b ref []byte) Equal(o ref []byte) bool

// Find returns the offset of the first run of bytes equal to t, lent,
// or None when there is none; an empty t is found at 0. Index finds
// one byte, as it finds one element of any slice.
func (b ref []byte) Find(t ref []byte) int?

// FindLast returns the offset of the last run of bytes equal to t,
// lent, or None when there is none; an empty t is found at len(b).
func (b ref []byte) FindLast(t ref []byte) int?

// Count returns how many runs of bytes equal to t, lent, b holds, none
// overlapping; an empty t counts one more than the UTF-8 sequences in
// b, as the string's Count does.
func (b ref []byte) Count(t ref []byte) int

// HasPrefix reports whether b starts with the bytes of t, lent.
func (b ref []byte) HasPrefix(t ref []byte) bool

// HasSuffix reports whether b ends with the bytes of t, lent.
func (b ref []byte) HasSuffix(t ref []byte) bool

// Trim lends the bytes of b without the white space at either end, the
// runes unicode.IsSpace reports, read as UTF-8; the borrow is b's.
func (b ref []byte) Trim() ref []byte

// TrimSpace lends the bytes of b without the white space at either
// end, as Trim does.
func (b ref []byte) TrimSpace() ref []byte

// TrimPrefix lends the bytes of b after the prefix p, lent, or all of b
// when b does not start with p.
func (b ref []byte) TrimPrefix(p ref []byte) ref []byte

// TrimSuffix lends the bytes of b before the suffix p, lent, or all of
// b when b does not end with p.
func (b ref []byte) TrimSuffix(p ref []byte) ref []byte

// ToUpper returns a new slice with every letter of b, read as UTF-8,
// in upper case, as the string's ToUpper maps it; a byte that is not
// UTF-8 becomes the replacement rune U+FFFD, as it does there.
func (b ref []byte) ToUpper() []byte

// ToLower returns a new slice with every letter of b, read as UTF-8,
// in lower case, as the string's ToLower maps it; a byte that is not
// UTF-8 becomes the replacement rune U+FFFD, as in ToUpper.
func (b ref []byte) ToLower() []byte

// Fields lends the runs of b between white space, the runes
// unicode.IsSpace reports, read as UTF-8, as a slice of views into b;
// nothing is copied.
func (b ref []byte) Fields() []ref []byte

// Lines lends the lines of b, each without its newline and a carriage
// return before it, as a slice of views into b; a last line without a
// newline is a line, and a trailing newline makes no empty one.
func (b ref []byte) Lines() []ref []byte

// Split lends the runs of b between each sep, lent, as a slice of
// views into b; an empty sep splits after every UTF-8 sequence.
func (b ref []byte) Split(sep ref []byte) []ref []byte

// SplitN is Split giving at most n views, the last holding the rest;
// an n of zero or less gives none.
func (b ref []byte) SplitN(sep ref []byte, n int) []ref []byte

// SplitOnce lends the bytes before and after the first sep, lent, or
// returns None when b holds no sep.
func (b ref []byte) SplitOnce(sep ref []byte) (ref []byte, ref []byte)?

// Get lends the value under k, or None when the key is absent. The
// borrow lives as long as the map's, and the lookup costs constant
// time on average. A read m[k] gives the value or the zero value
// instead, and changes nothing.
//
//	if v := m.Get("port") { use(v) }
func (m ref map[K]V) Get(k ref K) ref V?

// GetMut lends the value under k for changing, or None when the key is
// absent; m[k] = v and m[k] += v make the entry when it is missing.
//
//	if n := counts.GetMut(ref word) { *n += 1 }
func (m mut map[K]V) GetMut(k ref K) mut V?

// Insert puts v under k, which the map owns from then on, dropping the
// value that was there; a key already present keeps its place in the
// insertion order a range follows. It costs constant time on average,
// the map growing when it is full.
func (m mut map[K]V) Insert(k K, v V)

// Remove takes the entry under k out and returns its value, owned, or
// None when the key is absent; the key is dropped.
func (m mut map[K]V) Remove(k ref K) V?

// Contains reports whether k has an entry, in constant time on average.
func (m ref map[K]V) Contains(k ref K) bool

// Clone returns a new map with a clone of every key and value, which
// the caller owns. Both types must be Clone.
func (m ref map[K]V) Clone() map[K]V

// GetOrInsert lends the value under k for changing, inserting v under k
// first when the key is absent; when it is present, k and v are
// dropped. The key is hashed and looked for once.
//
//	*counts.GetOrInsert(word.Clone(), 0) += 1
func (m mut map[K]V) GetOrInsert(k K, v V) mut V

// Entry lends the first entry at the place i or after it, with its
// place, or None when there is none: the entries lie in insertion
// order at places from 0, a removed one leaving its place empty until
// the map grows; a place below 0 is 0. A range over the map walks them
// so; Entry is for a type built over a map that walks them itself, as
// set's Iter does, from 0 and from each place found plus one.
func (m ref map[K]V) Entry(i int) (int, ref K, ref V)?

// Retain calls keep once for each entry, in insertion order, and drops
// every entry for which keep returns false; the entries that stay keep
// their order. keep is given the key lent and the value lent mut, so it
// may change a value that stays. The map holds keep for the call alone.
// No key is hashed or compared: an entry dropped is taken out at its
// place.
//
//	counts.Retain(func(word ref string, n mut int) bool { return *n > 1 })
func (m mut map[K]V) Retain(keep func(ref K, mut V) bool)

// Clone returns another handle on the same channel, of the same
// direction, to hand to another task: a channel handle is owned,
// moved by assignment, a call, a capture or a send, and the channel is
// freed with its last handle. A chan T handle sends and receives; one
// moved where a <-chan T or a chan<- T is wanted keeps that end and
// gives the other up. The channel ends when its last sending handle
// is gone: a receive then yields None once the values sent are taken,
// and a range over it ends. Sending, receiving, len, cap, a range and
// a select case borrow the handle, and a ref chan T converts to a ref
// chan<- T or a ref <-chan T. It allocates nothing: the handles share
// one channel and its counts of handles.
//
//	spawn worker(jobs.Clone())
func (ch ref chan T) Clone() chan T

// Clone returns another handle on the same receive-only channel, to
// hand to another receiver, as Clone on a chan T does.
func (ch ref <-chan T) Clone() <-chan T

// Clone returns another handle on the same send-only channel, to hand
// to another sender, as Clone on a chan T does.
func (ch ref chan<- T) Clone() chan<- T

// Open reports whether a receiving handle on the channel remains: a
// send on a channel with none drops its value and goes on, and a
// sender that wants to stop then asks. A chan T handle receives
// itself, so Open on one is true; it is for a chan<- T.
//
//	for w.Open() {
//		w <- next()
//	}
func (ch ref chan<- T) Open() bool

// Open on a chan T is true, since the handle itself receives.
func (ch ref chan T) Open() bool

// Len returns the length of the string in bytes, as len does, in
// constant time.
func (s ref string) Len() int

// Runes returns the string's runes in a new slice of exactly their
// number, read as a range over the string reads them: a byte that does
// not start a valid UTF-8 sequence is U+FFFD. A range over the string
// itself walks the runes without the slice.
func (s ref string) Runes() []rune

// ToUpper returns a new string with every letter in upper case, by
// Unicode's full case mapping: the mappings that hold in every
// language, so ß upper-cases to SS and the string may grow; a byte
// that is not valid UTF-8 becomes the replacement rune U+FFFD.
//
//	"straße".ToUpper() // "STRASSE"
func (s ref string) ToUpper() string

// ToLower returns a new string with every letter in lower case, by
// Unicode's full case mapping, a capital sigma at the end of a word
// lowered to ς; a byte that is not valid UTF-8 becomes the replacement
// rune U+FFFD.
func (s ref string) ToLower() string

// Lines lends the lines of the string, split at each newline and
// without it, nor a carriage return before it; a last line without a
// newline is a line, and a trailing newline does not make an empty
// one. A range over them yields each as a ref string into s, with
// nothing copied but the slice of borrows itself.
//
//	for line := range text.Lines() { ... }
func (s ref string) Lines() []ref string

// Fields lends the words of the string, split around runs of white
// space, the runes Unicode gives the White_Space property, with no
// empty word; a range over them yields each as a ref string into s.
// The result holds borrows, and is ranged over, not kept.
//
//	"  a b\tc ".Fields() // "a", "b", "c"
func (s ref string) Fields() []ref string

// Split lends the pieces of the string between occurrences of sep, as
// Fields does the words: an empty piece where two seps meet, and one
// piece, the whole string, when sep is not there. An empty sep splits
// after every UTF-8 sequence, and gives no pieces of an empty string.
//
//	"a,b,,c".Split(",") // "a", "b", "", "c"
func (s ref string) Split(sep ref string) []ref string

// SplitOnce lends what comes before the first sep and what comes
// after it, or None when sep is not there; both borrow s.
//
//	if (k, v) := line.SplitOnce("=") { set(k, v) }
func (s ref string) SplitOnce(sep ref string) (ref string, ref string)?

// Trim lends the string without the white space at either end, the
// runes Unicode gives the White_Space property, with nothing copied.
// TrimSpace is the same.
func (s ref string) Trim() ref string

// HasPrefix reports whether the string starts with t; every string
// starts with "".
func (s ref string) HasPrefix(t ref string) bool

// HasSuffix reports whether the string ends with t; every string ends
// with "".
func (s ref string) HasSuffix(t ref string) bool

// Contains reports whether the string holds t; every string holds "".
func (s ref string) Contains(t ref string) bool

// Index returns the byte offset of the first t in the string, or None
// when it is not there; an empty t is at 0.
//
//	at := path.Index("/") ?? return None
func (s ref string) Index(t ref string) int?

// LastIndex returns the byte offset of the last t in the string, or
// None when it is not there; an empty t is at the length.
func (s ref string) LastIndex(t ref string) int?

// Count returns how many times t occurs in the string without
// overlapping; an empty t counts the runes plus one, the places
// between them.
func (s ref string) Count(t ref string) int

// Replace returns a new string with the first n occurrences of old
// replaced by new; an n of zero or less replaces none. An empty old
// matches before every rune and at the end.
//
//	"a-b-c".Replace("-", "+", 1) // "a+b-c"
func (s ref string) Replace(old ref string, new ref string, n int) string

// ReplaceAll returns a new string with every occurrence of old
// replaced by new. An empty old matches before every rune and at the
// end.
func (s ref string) ReplaceAll(old ref string, new ref string) string

// TrimPrefix lends the string without p at its start, or the whole
// string when it does not start with p, with nothing copied.
func (s ref string) TrimPrefix(p ref string) ref string

// TrimSuffix lends the string without p at its end, or the whole
// string when it does not end with p, with nothing copied.
//
//	name := file.TrimSuffix(".snello")
func (s ref string) TrimSuffix(p ref string) ref string

// TrimSpace lends the string without the white space at either end, as
// Trim does.
func (s ref string) TrimSpace() ref string

// SplitN lends at most n pieces of the string, cut at sep as Split cuts
// it, the last piece holding the rest; an n of zero or less gives none.
//
//	"k=v=w".SplitN("=", 2) // "k", "v=w"
func (s ref string) SplitN(sep ref string, n int) []ref string

// IsDigit reports whether the byte is an ASCII decimal digit, '0' to
// '9'. A byte above 127 is no digit; text beyond ASCII is read by its
// runes.
func (c ref byte) IsDigit() bool

// IsSpace reports whether the byte is ASCII white space: a space, a
// tab, a newline, a carriage return, a vertical tab or a form feed.
func (c ref byte) IsSpace() bool

// IsLetter reports whether the byte is an ASCII letter of either case.
func (c ref byte) IsLetter() bool

// IsUpper reports whether the byte is an ASCII upper-case letter, 'A'
// to 'Z'.
func (c ref byte) IsUpper() bool

// IsLower reports whether the byte is an ASCII lower-case letter, 'a'
// to 'z'.
func (c ref byte) IsLower() bool

// CheckedAdd returns x + o, or None when the sum does not fit in the
// type, where + would wrap. Every integer type has it, and CheckedSub
// and CheckedMul.
//
//	total := a.CheckedAdd(b) ?? return Err(overflow())
func (x ref int) CheckedAdd(o int) int?

// CheckedSub returns x - o, or None when the difference does not fit
// in the type, where - would wrap.
func (x ref int) CheckedSub(o int) int?

// CheckedMul returns x * o, or None when the product does not fit in
// the type, where * would wrap.
func (x ref int) CheckedMul(o int) int?

// Abs returns the magnitude of a signed integer; the type's minimum,
// whose magnitude does not fit, stays itself, as the arithmetic wraps.
func (x ref int) Abs() int

// Clamp returns the value held between lo and hi: lo when it is less,
// hi when it is more; hi when lo is more than hi. Every integer type
// has it.
//
//	percent := n.Clamp(0, 100)
func (x ref int) Clamp(lo int, hi int) int

// Eq reports whether the string equals o, byte for byte, behind ==.
// The numbers and bool have it too, behind ==, taking the other
// operand by value, as the type is Copy.
func (s ref string) Eq(o ref string) bool

// Cmp compares the string with o byte by byte, behind <, and returns
// Less, Equal or Greater; a prefix comes before the longer string. The
// numbers and bool have it too.
func (s ref string) Cmp(o ref string) Ordering

// Hash returns the string's hash, for a map key: equal strings hash
// alike. The numbers and bool have it too.
func (s ref string) Hash() u64

// Clone returns an owned copy of the string, a new allocation the
// caller owns, as a value to keep beyond the borrow it was read from.
//
//	m.Insert(key.Clone(), v)
func (s ref string) Clone() string

// Expect returns the value inside, or panics with msg when there is
// none. It takes the Option. msg says what was expected, so that the
// panic explains itself.
//
//	f := cfg.Get("file").Expect("the config names a file")
func (o T?) Expect(msg ref string) T

// Unwrap returns the value inside, or panics with "Unwrap on None".
// It takes the Option. Expect, with a message that says what was
// expected, reads better.
func (o T?) Unwrap() T

// UnwrapOr returns the value inside, or v when there is none; v is
// built whether or not it is needed, so o ?? v, which builds it only
// then, is the same thing written shorter. It takes the Option, and
// drops v when the value is there.
func (o T?) UnwrapOr(v T) T

// IsSome reports whether there is a value, without taking it.
func (o ref T?) IsSome() bool

// IsNone reports whether there is no value, without taking the Option.
func (o ref T?) IsNone() bool

// Map applies f to the value when there is one and returns the result
// as an Option, or None when there was none. f may be a closure or a
// function's name, and U is whatever it gives back. It takes the
// Option and moves the value into f.
//
//	n := s.Index(":").Map(func(i int) int { return i + 1 })
func (o T?) Map<U>(f func(v T) U) U?

// AndThen returns f of the value inside, itself an Option, or None
// when there is no value, so that steps that may each find nothing
// chain without a match. It takes the Option.
func (o T?) AndThen<U>(f func(v T) U?) U?

// OrElse returns the Option when it holds a value, else what f gives,
// called only then. It takes the Option.
func (o T?) OrElse(f func() T?) T?

// Expect returns the Ok value, or panics with msg, a colon and the
// error when the Result is an Err. It takes the Result.
//
//	f := os.Open(ref path).Expect("open the config")
func (r Result<T, E>) Expect(msg ref string) T

// Unwrap returns the Ok value, or panics with "Unwrap on Err", a colon
// and the error. It takes the Result.
func (r Result<T, E>) Unwrap() T

// UnwrapOr returns the Ok value, or v when the Result is an Err, which
// is dropped. It takes the Result.
func (r Result<T, E>) UnwrapOr(v T) T

// IsOk reports whether the Result is an Ok, without taking it.
func (r ref Result<T, E>) IsOk() bool

// IsErr reports whether the Result is an Err, without taking it.
func (r ref Result<T, E>) IsErr() bool

// Map applies f to the Ok value and returns the result as a Result
// with the same error type; an Err passes through as it is. It takes
// the Result.
func (r Result<T, E>) Map<U>(f func(v T) U) Result<U, E>

// MapErr applies f to the error and returns a Result with the error
// type f gives back; an Ok passes through as it is. It is how an
// error of one type becomes one of another before ? passes it up.
//
//	r := strconv.Atoi(ref s).MapErr(func(e strconv.Error) string { return e.Error() })
func (r Result<T, E>) MapErr<U>(f func(e E) U) Result<T, U>

// Ok returns the Ok value as an Option, dropping an error, so that a
// failure is read as no value.
//
//	port := strconv.Atoi(ref text).Ok() ?? 80
func (r Result<T, E>) Ok() T?

// Err returns the error as an Option, dropping an Ok value.
func (r Result<T, E>) Err() E?

// AndThen returns f of the Ok value, itself a Result, or the error as
// it is, so that steps that may each fail chain without a match. It
// takes the Result.
func (r Result<T, E>) AndThen<U>(f func(v T) Result<U, E>) Result<U, E>

// UnwrapOrElse returns the Ok value, or f of the error, called only for
// an Err. It takes the Result.
func (r Result<T, E>) UnwrapOrElse(f func(e E) T) T
