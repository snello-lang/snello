// Package strings builds and transforms text.
//
// What a string can do on its own is a method of the string: Len,
// Fields, Lines, Split, SplitN, SplitOnce, Trim, TrimSpace, TrimPrefix,
// TrimSuffix, HasPrefix, HasSuffix, Contains, Index, LastIndex, Count,
// Replace, ReplaceAll, ToUpper, ToLower and Clone. This package has
// what works on more than one string, Join, what builds a new one piece
// by piece, Builder and Repeat, a Reader that hands a string to what
// reads bytes, and the transformations as functions, for a call that
// reads better that way or a function value to pass along.
//
// Every parameter here is a borrow, ref string, but NewReader's and
// NewReplacer's: a call lends its argument and gets a new string back,
// and the argument stays with its owner. NewReader takes the string, so
// that the Reader can be held by what reads it, and NewReplacer copies
// its pairs, so that a Replacer is built once and kept.
package strings

import (
	"io"
	"math"
	"unicode/utf8"
)

// nothingToUnread is the Reader's width of the last rune when no
// ReadRune can be undone.
const nothingToUnread int = -1

// none marks a Replacer's table entry or trie node that stands for no
// pair.
const none int = -1

// The kinds of Replacer, chosen by the shape of the pairs: every old
// string one byte and every new one too, every old string one byte, or
// any longer.
const byteToByte int = 0
const byteToText int = 1
const text int = 2

// byteValues is how many values a byte has, the size of the Replacer's
// tables indexed by a byte.
const byteValues int = 256

// A Builder accumulates text piece by piece and gives it back as one
// string, cheaper than joining with + at every step, which copies the
// whole text each time. Its zero value is ready to use:
//
//	var b strings.Builder
//	b.WriteString("one")
//	b.WriteByte(' ')
//	s := b.String() // "one "
//
// A Builder owns the bytes it holds and is passed mut to be written
// to. Its buffer grows as a slice's does, doubling, so n bytes written
// one piece at a time cost O(n) in all.
struct Builder {
	buf []byte
}

// A Reader reads the bytes of a string it owns, as an io.Reader: what
// reads bytes, bufio or io.Copy, reads a string through it. It owns the
// string, so that bufio can hold it, as a type argument cannot hold a
// borrow; a literal is moved in with nothing copied, and a string the
// caller keeps is cloned into it:
//
//	r := strings.NewReader("one\ntwo")
//	sc := bufio.NewScanner(mut r)
struct Reader impl io.Reader, io.Seeker, io.ReaderAt {
	s             string
	at            int // the bytes before at have been read; Seek may put it past the end
	lastRuneWidth int // the width of the rune the last ReadRune returned, which UnreadRune steps back over, or nothingToUnread
}

// A Replacer replaces several old strings by their new ones in one pass
// over a text: at each position the first pair, in the order given,
// whose old string starts there replaces it, and the pass moves past
// what it replaced, so matches never overlap. It is built once by
// NewReplacer, which copies the pairs, and used as often as wanted:
//
//	esc := strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;") ?? return
//	esc.Replace("a < b & c") // "a &lt; b &amp; c"
//
// Three shapes of pairs take three paths: every old and every new one
// byte, a table of 256 bytes mapped over a copy of the text; every old
// one byte, a table saying which pair a byte is;
// and otherwise a trie of the old strings, its root a table of 256,
// entered only at a byte some old string starts with, found a word at
// a time, the rest of the text copied in runs.
struct Replacer {
	pairs  []pair // old and new, in the order given, owned
	starts []byte // a byteValues table: 1 at each byte an old string starts with
	firsts []byte // the bytes old strings start with, each once, in the order met
	root   []int  // a byteValues table, for the text kind: the trie node one byte from the root, or none
	leaves []int  // a byteValues table, for the text kind: the pair whose old string is that one byte and no longer old string shares it, or none
	table  []int  // a byteValues table, for the one-byte kinds: the pair the byte is, or none
	bytes  []byte // a byteValues table, for the byteToByte kind: what each byte becomes, itself when no pair is it
	nodes  []node // the trie of the old strings from nodes[0], for the text kind
	empty  int    // the first pair whose old string is empty, or none
	kind   int    // byteToByte, byteToText or text
}

// A pair is one replacement: old, what is looked for, and new, what
// takes its place.
struct pair {
	old string
	new string
}

// A node of the trie: the pair whose old string ends here, or none, and
// the edges to the nodes one byte on.
struct node {
	pair  int
	edges []edge
}

// An edge of the trie: the byte it is taken on and the node it leads
// to.
struct edge impl Copy {
	c  byte
	to int
}

// WriteString appends the bytes of s, which it only reads, to the
// builder, in one copy that grows the buffer at most once.
func (b mut Builder) WriteString(s ref string) {
	appendString(mut b.buf, s)
}

// WriteByte appends the one byte c to the builder, as it is: a byte of
// 0x80 or more is no rune of its own, and WriteRune writes a rune.
func (b mut Builder) WriteByte(c byte) {
	b.buf.Push(c)
}

// WriteRune appends the UTF-8 bytes of r to the builder, one to four of
// them, and those of utf8.RuneError, U+FFFD, for a value that is not a
// code point: a negative one, a surrogate or one past utf8.MaxRune.
func (b mut Builder) WriteRune(r rune) {
	utf8.AppendRune(mut b.buf, r)
}

// Len returns the number of bytes written to the builder so far, which
// is the length of what String would return.
func (b ref Builder) Len() int {
	return len(b.buf)
}

// String returns what was written so far as a new string, which the
// caller owns: one allocation and a copy of the bytes. The builder
// keeps its text and may go on; a call after more writes gives the
// longer text.
func (b ref Builder) String() string {
	return string(b.buf)
}

// Bytes lends the bytes written so far, with no copy, for as long as
// the builder is not written to: what an io.Writer is handed.
//
//	w.Write(b.Bytes())?
func (b ref Builder) Bytes() ref []byte {
	return b.buf
}

// Reset empties the builder, ready for new text, and keeps its buffer,
// so that the text written next reuses the memory.
func (b mut Builder) Reset() {
	b.buf.Clear()
}

// Grow makes room for n more bytes, so that writing them does not
// allocate again: at most one allocation, to twice the room or the
// length and n, whichever is more, as a Push grows. An n of zero or
// less, or one no int can add to the length, does nothing.
//
//	b.Grow(len(name) + 2) // then two writes that allocate nothing
func (b mut Builder) Grow(n int) {
	if n > 0 {
		reserve(mut b.buf, n)
	}
}

// NewReader returns a Reader over s from its first byte. It takes s,
// which the Reader owns from then on: a literal moves in with nothing
// copied, and a string the caller keeps is passed as s.Clone().
func NewReader(s string) Reader {
	return Reader{s: s, at: 0, lastRuneWidth: nothingToUnread}
}

// Read copies into buf the bytes not read yet that fit, by memcpy, and
// returns how many: zero at the end of the string, and for an empty
// buf, as io.Reader says. buf is lent mut and only written to; the
// Reader moves past the bytes it copied. Reading a string never fails,
// so the result is always Ok.
func (r mut Reader) Read(buf mut []byte) Result<int, io.Error> {
	r.lastRuneWidth = nothingToUnread
	if r.at >= len(r.s) {
		return Ok(0)
	}

	n := copyString(mut buf, r.s[r.at:])
	r.at += n
	return Ok(n)
}

// ReadByte returns the byte at the position and moves the position one
// byte on, so that the next read starts after it; at the end of the
// string it returns None and the position stays. Reading a string
// cannot fail, so there is no error to check, where bufio.Reader's
// ReadByte gives a Result.
//
//	for {
//		c := r.ReadByte() ?? break
//		...
//	}
func (r mut Reader) ReadByte() byte? {
	r.lastRuneWidth = nothingToUnread
	if r.at >= len(r.s) {
		return None
	}

	c := r.s[r.at]
	r.at++
	return Some(c)
}

// UnreadByte moves the position one byte back, so that the next read
// gives the last byte read again, and reports true. At the start of
// the string, and after a Seek past its end, there is no byte to go
// back over: it returns false and changes nothing.
func (r mut Reader) UnreadByte() bool {
	if r.at <= 0 || r.at > len(r.s) {
		return false
	}

	r.at--
	r.lastRuneWidth = nothingToUnread
	return true
}

// ReadRune returns the rune at the position and its width in bytes,
// and moves the position past it; at the end of the string it returns
// None and the position stays. A byte that is not UTF-8 reads as
// utf8.RuneError of width one, as a range over a string reads it.
//
//	for {
//		c, width := r.ReadRune() ?? break
//		...
//	}
func (r mut Reader) ReadRune() (rune, int)? {
	if r.at >= len(r.s) {
		r.lastRuneWidth = nothingToUnread
		return None
	}

	if c := r.s[r.at]; c < 0x80 {
		r.at++
		r.lastRuneWidth = 1
		return Some((rune(c), 1))
	}

	c, width := utf8.DecodeRuneInString(r.s[r.at:])
	r.at += width
	r.lastRuneWidth = width
	return Some((c, width))
}

// UnreadRune moves the position back over the rune the last call
// returned, so that the next read gives it again, and reports true,
// when that call was ReadRune. After any other call, Read, ReadByte,
// Seek, UnreadByte or a ReadRune that returned None, it returns false
// and changes nothing, since only the width ReadRune measured says how
// far back the rune begins.
func (r mut Reader) UnreadRune() bool {
	if r.lastRuneWidth == nothingToUnread {
		return false
	}

	r.at -= r.lastRuneWidth
	r.lastRuneWidth = nothingToUnread
	return true
}

// Seek moves the position to where pos says, counted from the start,
// from the current position or from the end, and returns the new
// position as bytes from the start. A position before the start fails
// with an io.Error, and one past the end is allowed, as io.Seeker says
// of a file: every read there gives nothing, and Len is zero. A Seek
// forgets the last read, so UnreadByte and UnreadRune after it return
// false.
//
//	r.Seek(io.Start(0))?           // back to the start
//	size := r.Seek(io.End(0))?     // to the end, which is the length
func (r mut Reader) Seek(pos io.SeekFrom) Result<u64, io.Error> {
	at := match pos {
		io.Start(n) => position(n),
		io.Current(n) => i64(r.at).CheckedAdd(n),
		io.End(n) => i64(len(r.s)).CheckedAdd(n),
	}

	moved := at ?? return Err(io.NewError("seek", "", "position beyond what an int counts", io.Other))
	if moved < 0 {
		return Err(io.NewError("seek", "", "negative position", io.Other))
	}

	r.at = int(moved)
	r.lastRuneWidth = nothingToUnread
	return Ok(u64(moved))
}

// ReadAt copies into buf the bytes of the string from the offset off,
// as many as fit, and returns how many: fewer than buf holds at the end
// of the string, and none at or past it. The position the reads use
// stays where it was. It is io.ReaderAt's method and never fails.
func (r ref Reader) ReadAt(buf mut []byte, off u64) Result<int, io.Error> {
	if off >= u64(len(r.s)) {
		return Ok(0)
	}

	return Ok(copyString(mut buf, r.s[int(off):]))
}

// Len returns the number of bytes of the string not read yet: none
// after a Seek past the end.
func (r ref Reader) Len() int {
	if r.at >= len(r.s) {
		return 0
	}

	return len(r.s) - r.at
}

// NewReplacer returns a Replacer of the pairs old, new, old, new in
// oldnew, in that order, which it copies, or None for an odd count. A
// Replacer of no pairs copies the text.
//
//	swap := strings.NewReplacer("a", "b", "b", "a") ?? return
func NewReplacer(oldnew ...ref string) Replacer? {
	if len(oldnew)%2 != 0 {
		return None
	}

	r := Replacer{pairs: make([]pair, 0, len(oldnew)/2), starts: make([]byte, byteValues), firsts: []byte{}, root: []int{}, leaves: []int{}, table: []int{}, bytes: []byte{}, nodes: []node{}, empty: none, kind: text}
	for i := 0; i < len(oldnew); i += 2 {
		r.pairs.Push(pair{old: oldnew[i].Clone(), new: oldnew[i+1].Clone()})
	}

	oneByte := true
	for _, p := range ref r.pairs {
		if len(p.old) != 1 {
			oneByte = false
		}
	}

	if oneByte {
		r.buildTable()
	} else {
		r.buildTrie()
	}

	return Some(r)
}

// Replace returns a new string: s with every match replaced in one
// pass, as the type describes. A Replacer of no pairs returns a copy.
func (r ref Replacer) Replace(s ref string) string {
	if r.kind == byteToByte {
		return r.replaceBytes(s)
	}

	if r.kind == byteToText {
		return r.replaceByteText(s)
	}

	return r.replaceText(s)
}

// Repeat returns a new string of s written n times in a row, and the
// empty string for an n of zero. It returns None for a negative n, or
// one that would make a string longer than an int can count. s is only
// read; the result is made in one allocation of its whole length.
//
//	strings.Repeat("ab", 3) // Some("ababab")
func Repeat(s ref string, n int) string? {
	if n < 0 || s.Len() > 0 && n > math.MaxInt / s.Len() {
		return None
	}

	return Some(repeat(s, n))
}

// Join returns a new string of the parts one after another, with sep
// between every two and none before the first or after the last; an
// empty slice gives the empty string. The parts and sep are only read,
// and the result is made in one allocation of its whole length.
//
//	strings.Join(ref []string{"a", "b", "c"}, ", ") // "a, b, c"
func Join(parts ref []string, sep ref string) string {
	size := 0
	for i, p := range parts {
		if i > 0 {
			size += sep.Len()
		}

		size += p.Len()
	}

	buf := make([]byte, 0, size) // the whole result, allocated once and given to the string
	for i, p := range parts {
		if i > 0 {
			appendString(mut buf, sep)
		}

		appendString(mut buf, p)
	}

	return ownString(buf)
}

// Fields splits s around runs of white space, the runes
// unicode.IsSpace reports, and returns the words, each a borrow into s:
// no word is copied, and only the slice that holds them is allocated.
// The words keep s lent for as long as they live; a string of white
// space alone, or an empty one, gives no word. It is the string's
// Fields method as a function.
//
//	for w := range strings.Fields(ref text) { ... }
func Fields(s ref string) []ref string {
	return s.Fields()
}

// ToLower returns a new string with every letter of s in lower case,
// by Unicode's full case mapping: the mappings that hold in every
// language, and a capital sigma at the end of a word lowered to the
// final form ς, so "ΟΔΥΣΣΕΥΣ" is "οδυσσευς". A rune with no lower case
// is copied as it is.
func ToLower(s ref string) string {
	return s.ToLower()
}

// ToUpper returns a new string with every letter of s in upper case,
// by Unicode's full case mapping, so a rune may become several and the
// string grow: ß upper-cases to SS, ﬁ to FI. A rune with no upper case
// is copied as it is.
func ToUpper(s ref string) string {
	return s.ToUpper()
}

// ToTitle returns a new string of s in title case as Unicode defines
// it: in each word, by the word boundaries of annex 29, the rune that
// starts it in title case and the rest in lower case, by the full case
// mappings, so "straße ﬁx" is "Straße Fix" and "ǆungla" is "ǅungla". A
// word starts at its first letter, number or symbol: a quote before it
// is passed over, "'tis" is "'Tis", and a digit that starts it stays,
// "3RD" is "3rd".
func ToTitle(s ref string) string {
	return toTitle(s)
}

// ToValidUTF8 returns a new string of s with each run of bytes that are
// not UTF-8 replaced by rep, once a run, so that the result is valid
// UTF-8 when rep is; an empty rep drops the runs. Both strings are only
// read.
//
//	strings.ToValidUTF8("a\xff\xfeb", "?") // "a?b"
func ToValidUTF8(s ref string, rep ref string) string {
	return toValidUTF8(s, rep)
}

// IndexFunc returns the byte offset in s of the first rune for which f
// returns true, or -1 when there is none. It calls f on each rune in
// turn, from the start, and stops at the first true; a byte that is not
// UTF-8 is passed to f as utf8.RuneError.
func IndexFunc(s ref string, f func(rune) bool) int {
	for i, r := range s {
		if f(r) {
			return i
		}
	}

	return -1
}

// ContainsFunc reports whether f returns true for any rune of s, as
// IndexFunc finds it.
func ContainsFunc(s ref string, f func(rune) bool) bool {
	return IndexFunc(s, f) >= 0
}

// LastIndexFunc returns the byte offset in s of the last rune for which
// f returns true, or -1 when there is none. It calls f on each rune in
// turn, from the end, and stops at the first true.
func LastIndexFunc(s ref string, f func(rune) bool) int {
	end := len(s)
	for end > 0 {
		r, n := utf8.DecodeLastRuneInString(s[:end])
		end -= n
		if f(r) {
			return end
		}
	}

	return -1
}

// TrimFunc returns s without the runes at either end for which f
// returns true, as a borrow of s, with nothing copied: the result keeps
// s lent for as long as it lives.
//
//	dash := func(r rune) bool { return r == '-' }
//	strings.TrimFunc("--a-b--", dash) // "a-b"
func TrimFunc(s ref string, f func(rune) bool) ref string {
	return TrimRightFunc(TrimLeftFunc(s, f), f)
}

// TrimLeftFunc returns s without the runes at its start for which f
// returns true, as a borrow of s, with nothing copied.
func TrimLeftFunc(s ref string, f func(rune) bool) ref string {
	for i, r := range s {
		if !f(r) {
			return s[i:]
		}
	}

	return s[len(s):]
}

// TrimRightFunc returns s without the runes at its end for which f
// returns true, as a borrow of s, with nothing copied.
func TrimRightFunc(s ref string, f func(rune) bool) ref string {
	end := len(s)
	for end > 0 {
		r, n := utf8.DecodeLastRuneInString(s[:end])
		if !f(r) {
			break
		}

		end -= n
	}

	return s[:end]
}

// FieldsFunc splits s around each run of runes for which f returns true
// and returns the pieces between, each a borrow into s, none of them
// empty: no piece is copied, and only the slice that holds them is
// allocated.
//
//	comma := func(r rune) bool { return r == ',' }
//	strings.FieldsFunc("a,,b", comma) // "a", "b"
func FieldsFunc(s ref string, f func(rune) bool) []ref string {
	out := []ref string{}
	start := -1
	for i, r := range s {
		if f(r) {
			if start >= 0 {
				out.Push(s[start:i])
				start = -1
			}
		} else if start < 0 {
			start = i
		}
	}

	if start >= 0 {
		out.Push(s[start:])
	}

	return out
}

// EqualIgnoreCase reports whether s and t are equal ignoring case, by
// Unicode's full case folding, its default caseless match: Straße and
// STRASSE are equal, as are Σ, σ and ς. A byte that is not UTF-8 reads
// as U+FFFD, so two strings that differ only in such bytes are equal.
// Both strings are only read, and nothing is allocated.
func EqualIgnoreCase(s ref string, t ref string) bool {
	return equalIgnoreCase(s, t)
}

// IndexRune returns the byte offset of the first r in s, or -1 when s
// holds none. A search for utf8.RuneError also finds a byte that starts
// no valid UTF-8 sequence, as a range over s reads one.
func IndexRune(s ref string, r rune) int {
	for i, c := range s {
		if c == r {
			return i
		}
	}

	return -1
}

// ContainsRune reports whether the rune r is in s.
func ContainsRune(s ref string, r rune) bool {
	return IndexRune(s, r) >= 0
}

// Map returns a new string of the runes of s each passed through f, in
// order; a rune for which f returns a negative value is dropped, and a
// value that is not a code point is written as utf8.RuneError.
//
//	strings.Map(func(r rune) rune { return r + 1 }, "abc") // "bcd"
func Map(f func(rune) rune, s ref string) string {
	var b Builder
	for _, r := range s {
		if m := f(r); m >= 0 {
			b.WriteRune(m)
		}
	}

	return b.String()
}

// position is the i64 a position counted from the start is, or None
// past what an int counts.
func position(n u64) i64? {
	if n > u64(math.MaxInt) {
		return None
	}

	return Some(i64(n))
}

// buildTable fills the tables of the one-byte kinds: each byte's pair,
// the first pair in the order given winning, and the kind, byteToByte
// when every new string is one byte too, with the table of what each
// byte becomes, so that the pass over the text is one lookup a byte.
func (r mut Replacer) buildTable() {
	r.table = make([]int, 0, byteValues)
	r.bytes = make([]byte, 0, byteValues)
	for i := 0; i < byteValues; i++ {
		r.table.Push(none)
		r.bytes.Push(byte(i))
	}

	r.kind = byteToByte
	for i := 0; i < len(r.pairs); i++ {
		c := r.pairs[i].old[0]
		if r.table[int(c)] != none {
			continue // an earlier pair has the byte
		}

		r.table[int(c)] = i
		r.start(c)
		if len(r.pairs[i].new) == 1 {
			r.bytes[int(c)] = r.pairs[i].new[0]
		} else {
			r.kind = byteToText
		}
	}
}

// buildTrie makes the trie of the old strings for the text kind: each
// old string a path of bytes from the root, the pair recorded at its
// last node, the first pair in the order given winning a node that two
// share; an empty old string is recorded apart, since it matches
// everywhere.
func (r mut Replacer) buildTrie() {
	r.nodes = []node{node{pair: none, edges: []edge{}}}
	r.root = make([]int, 0, byteValues)
	r.leaves = make([]int, 0, byteValues)
	for i := 0; i < byteValues; i++ {
		r.root.Push(none)
		r.leaves.Push(none)
	}

	for i := 0; i < len(r.pairs); i++ {
		n := len(r.pairs[i].old)
		if n == 0 {
			if r.empty == none {
				r.empty = i
			}

			continue
		}

		at := 0
		for j := 0; j < n; j++ {
			c := r.pairs[i].old[j]
			if j == 0 {
				r.start(c)
			}

			at = r.step(at, c)
		}

		if r.nodes[at].pair == none {
			r.nodes[at].pair = i
		}
	}

	for c := 0; c < byteValues; c++ { // a one-byte old string that shares its byte with no longer one is answered from the root
		if at := r.root[c]; at != none && len(r.nodes[at].edges) == 0 {
			r.leaves[c] = r.nodes[at].pair
		}
	}
}

// start records c as a byte some old string starts with: in the table
// and, the first time, in the list.
func (r mut Replacer) start(c byte) {
	if r.starts[int(c)] == 0 {
		r.starts[int(c)] = 1
		r.firsts.Push(c)
	}
}

// step returns the node the edge for c leads to from the node at, made
// when there is none yet: from the root by its table, below it by the
// node's edges.
func (r mut Replacer) step(at int, c byte) int {
	if at == 0 {
		if to := r.root[int(c)]; to != none {
			return to
		}
	} else {
		for _, e := range ref r.nodes[at].edges {
			if e.c == c {
				return e.to
			}
		}
	}

	to := len(r.nodes)
	r.nodes.Push(node{pair: none, edges: []edge{}})
	if at == 0 {
		r.root[int(c)] = to
	} else {
		r.nodes[at].edges.Push(edge{c: c, to: to})
	}

	return to
}

// lookup finds the pair whose old string starts at offset i of s, the
// first in the order given among those that do, and returns it with
// the length matched, or none and zero when none starts there: the
// root's tables take the first byte, answering a one-byte old string
// that shares it with no longer one at once, the edges each byte after.
func (r ref Replacer) lookup(s ref string, i int) (int, int) {
	if i >= len(s) {
		return (none, 0)
	}

	c := int(s[i])
	if p := r.leaves[c]; p != none {
		return (p, 1)
	}

	at := r.root[c]
	if at == none {
		return (none, 0)
	}

	best := none
	length := 0
	for j := i + 1; ; j++ {
		n := ref r.nodes[at]
		if n.pair != none && (best == none || n.pair < best) {
			best = n.pair
			length = j - i
		}

		if j == len(s) {
			break
		}

		next := none
		for _, e := range ref n.edges {
			if e.c == s[j] {
				next = e.to
				break
			}
		}

		if next == none {
			break
		}

		at = next
	}

	return (best, length)
}

// replaceBytes maps each byte of a copy of s through the table of what
// it becomes: one lookup a byte, with no branch, and nothing to look
// ahead for.
func (r ref Replacer) replaceBytes(s ref string) string {
	b := []byte(s)
	mapBytes(mut b, ref r.bytes)
	return ownString(b)
}

// replaceByteText writes s into a builder, skipping to each mapped
// byte a word at a time, the runs between copied whole and each mapped
// byte's new string in its place.
func (r ref Replacer) replaceByteText(s ref string) string {
	var b Builder
	b.Grow(len(s))
	start := 0
	for i := skipTo(s, 0, ref r.firsts, ref r.starts); i < len(s); i = skipTo(s, i, ref r.firsts, ref r.starts) {
		b.WriteString(s[start:i])
		b.WriteString(ref r.pairs[r.table[int(s[i])]].new)
		i++
		start = i
	}

	b.WriteString(s[start:])
	return b.String()
}

// replaceText walks s, entering the trie only at a byte some old
// string starts with, skipped to a word at a time, and writes the runs
// between matches whole. With an empty old string among the pairs the
// walk is replaceEvery's.
func (r ref Replacer) replaceText(s ref string) string {
	if r.empty != none {
		return r.replaceEvery(s)
	}

	var b Builder
	b.Grow(len(s))
	start := 0
	for i := skipTo(s, 0, ref r.firsts, ref r.starts); i < len(s); i = skipTo(s, i, ref r.firsts, ref r.starts) {
		p, length := r.lookup(s, i)
		if p == none {
			i++
			continue
		}

		b.WriteString(s[start:i])
		b.WriteString(ref r.pairs[p].new)
		i += length
		start = i
	}

	b.WriteString(s[start:])
	return b.String()
}

// replaceEvery is the walk with an empty old string among the pairs: it
// matches at every position, its new string written before the rune
// there and once more at the end, as the string's ReplaceAll places
// it. A pair given before the empty string takes a position alone; one
// given after it still matches there, after the empty string's new
// text.
func (r ref Replacer) replaceEvery(s ref string) string {
	var b Builder
	b.Grow(len(s))
	start := 0
	i := 0
	for i < len(s) {
		p, length := r.lookup(s, i)
		b.WriteString(s[start:i])
		if p == none || p > r.empty {
			b.WriteString(ref r.pairs[r.empty].new)
			if p == none {
				_, length = utf8.DecodeRuneInString(s[i:])
				b.WriteString(s[i : i+length])
				i += length
				start = i
				continue
			}
		}

		b.WriteString(ref r.pairs[p].new)
		i += length
		start = i
	}

	b.WriteString(s[start:])
	b.WriteString(ref r.pairs[r.empty].new)
	return b.String()
}

// appendString appends the bytes of s to b in one copy, growing b
// once. The runtime provides it.
func appendString(b mut []byte, s ref string)

// repeat writes s n times into one allocation, by doubling: s once,
// then what is written so far again, until the length is reached. The
// runtime provides it.
func repeat(s ref string, n int) string

// toTitle returns s in title case, by word boundaries and the full case
// mappings. The runtime provides it.
func toTitle(s ref string) string

// equalIgnoreCase compares s and t by their full case folding. The
// runtime provides it.
func equalIgnoreCase(s ref string, t ref string) bool

// toValidUTF8 returns s with each run of bytes that are not UTF-8
// replaced by rep. The runtime provides it.
func toValidUTF8(s ref string, rep ref string) string

// reserve makes room in b for n more bytes, growing it once as a Push
// grows. The runtime provides it.
func reserve(b mut []byte, n int)

// copyString copies the bytes of src that fit to the start of dst and
// returns how many. The runtime provides it, by memcpy.
func copyString(dst mut []byte, src ref string) int

// ownString makes b, which it takes, the string's bytes, with no copy.
// The runtime provides it.
func ownString(b []byte) string

// mapBytes replaces each byte of b by the byte of table, of 256, at its
// value. The runtime provides it.
func mapBytes(b mut []byte, table ref []byte)

// skipTo returns the offset of the first byte of s at or after from
// that is one of firsts, or len(s); starts is the table of 256 with a
// value other than zero at each of them. The runtime provides it, a
// word at a time for up to four bytes.
func skipTo(s ref string, from int, firsts ref []byte, starts ref []byte) int
