// Package strings builds and transforms text.
//
// What a string can do on its own is a method of the string: Len,
// Fields, Lines, Split, SplitN, SplitOnce, Trim, TrimSpace, TrimPrefix,
// TrimSuffix, HasPrefix, HasSuffix, Contains, Index, LastIndex, Count,
// Replace, ReplaceAll, ToUpper, ToLower and Clone. This package has
// what works on more than one string, Join, what builds a new one piece
// by piece, Builder and Repeat, a Reader that hands a string to what
// reads bytes, and the transformations as functions, for a call that
// reads better that way or a function value to pass along.
//
// Every parameter here is a borrow, ref string, but NewReader's: a call
// lends its argument and gets a new string back, and the argument stays
// with its owner. NewReader takes the string, so that the Reader can be
// held by what reads it.
package strings

import (
	"io"
	"unicode/utf8"
)

// maxInt is the largest int, the longest a string can be.
const maxInt int = 9223372036854775807

// A Builder accumulates text piece by piece and gives it back as one
// string, cheaper than joining with + at every step. Its zero value is
// ready to use: var b strings.Builder. A Builder owns the bytes it
// holds and is passed mut to be written to.
struct Builder {
	buf []byte
}

// WriteString appends the bytes of s, in one copy.
func (b mut Builder) WriteString(s ref string) {
	appendString(mut b.buf, s)
}

// WriteByte appends one byte.
func (b mut Builder) WriteByte(c byte) {
	b.buf.Push(c)
}

// WriteRune appends the UTF-8 bytes of r, and those of U+FFFD for a
// value that is not a code point.
func (b mut Builder) WriteRune(r rune) {
	utf8.AppendRune(mut b.buf, r)
}

// Len returns the number of bytes written so far.
func (b ref Builder) Len() int {
	return len(b.buf)
}

// String returns what was written so far, as a new string. The builder
// keeps its text and may go on; call it again after more writes for
// the longer text.
func (b ref Builder) String() string {
	return string(b.buf)
}

// Reset empties the builder, ready for new text.
func (b mut Builder) Reset() {
	b.buf.Clear()
}

// Grow makes room for n more bytes, so that writing them does not
// allocate again: at most one allocation, to twice the room or the
// length and n, whichever is more, as a Push grows. An n of zero or
// less, or one no int can add to the length, does nothing.
func (b mut Builder) Grow(n int) {
	if n > 0 {
		reserve(mut b.buf, n)
	}
}

// A Reader reads the bytes of a string it owns, as an io.Reader: what
// reads bytes, bufio or io.Copy, reads a string through it. It owns the
// string, so that bufio can hold it, as a type argument cannot hold a
// borrow; a literal is moved in with nothing copied, and a string the
// caller keeps is cloned into it.
struct Reader impl io.Reader {
	s  string
	at int // the bytes before at have been read
}

// NewReader returns a Reader over s, which it takes, from its first
// byte.
func NewReader(s string) Reader {
	return Reader{s: s, at: 0}
}

// Read copies the bytes not read yet that fit into buf, by memcpy, and
// returns how many: zero at the end of the string, and for an empty
// buf, as io.Reader says. Reading a string never fails.
func (r mut Reader) Read(buf mut []byte) Result<int, io.Error> {
	n := copyString(mut buf, r.s[r.at:])
	r.at += n
	return Ok(n)
}

// Len returns the number of bytes not read yet.
func (r ref Reader) Len() int {
	return r.s.Len() - r.at
}

// Repeat returns s written n times in a row, and the empty string for
// an n of zero; None for a negative n, or one that would make a string
// longer than an int can count.
func Repeat(s ref string, n int) string? {
	if n < 0 || s.Len() > 0 && n > maxInt / s.Len() {
		return None
	}

	return Some(repeat(s, n))
}

// Join writes the parts one after another with sep between every two,
// and none before the first or after the last: Join(ref parts, ", ").
// An empty slice gives the empty string.
func Join(parts ref []string, sep ref string) string {
	size := 0
	for i, p := range parts {
		if i > 0 {
			size += sep.Len()
		}

		size += p.Len()
	}

	buf := make([]byte, 0, size) // the whole result, allocated once and given to the string
	for i, p := range parts {
		if i > 0 {
			appendString(mut buf, sep)
		}

		appendString(mut buf, p)
	}

	return ownString(buf)
}

// Fields splits s around runs of white space, as Go's unicode.IsSpace
// knows it, and yields
// each word as a borrow into s, so no word is copied; a loop over them
// lends s for its duration, for w := range strings.Fields(ref text).
// It is the string's Fields method as a function.
func Fields(s ref string) []ref string {
	return s.Fields()
}

// ToLower returns a new string with every letter of s in lower case,
// by Unicode's full case mapping: the mappings that hold in every
// language, and a capital sigma at the end of a word lowered to the
// final form ς.
func ToLower(s ref string) string {
	return s.ToLower()
}

// ToUpper returns a new string with every letter of s in upper case,
// by Unicode's full case mapping, so a rune may become several and the
// string grow: ß upper-cases to SS, ﬁ to FI.
func ToUpper(s ref string) string {
	return s.ToUpper()
}

// ToTitle returns s in title case as Unicode defines it: in each word,
// by the word boundaries of annex 29, the rune that starts it in title
// case and the rest in lower case, by the full case mappings, so
// "straße ﬁx" is "Straße Fix" and "ǆungla" is "ǅungla". A word starts
// at its first letter, number or symbol, as ICU starts it by default:
// a quote before it is passed over, "'tis" is "'Tis", and a digit that
// starts it stays, "3RD" is "3rd".
func ToTitle(s ref string) string {
	return toTitle(s)
}

// ToValidUTF8 returns a copy of s with each run of bytes that are not
// UTF-8 replaced by rep, once a run, so the result is valid UTF-8.
func ToValidUTF8(s ref string, rep ref string) string {
	return toValidUTF8(s, rep)
}

// IndexFunc returns the byte offset of the first rune of s for which f
// is true, or -1.
func IndexFunc(s ref string, f func(rune) bool) int {
	for i, r := range s {
		if f(r) {
			return i
		}
	}

	return -1
}

// LastIndexFunc returns the byte offset of the last rune of s for which
// f is true, or -1.
func LastIndexFunc(s ref string, f func(rune) bool) int {
	end := len(s)
	for end > 0 {
		r, n := utf8.DecodeLastRuneInString(s[:end])
		end -= n
		if f(r) {
			return end
		}
	}

	return -1
}

// TrimFunc returns s without the runes at either end for which f is
// true, as a borrow of s.
func TrimFunc(s ref string, f func(rune) bool) ref string {
	return TrimRightFunc(TrimLeftFunc(s, f), f)
}

// TrimLeftFunc returns s without the runes at its start for which f is
// true, as a borrow of s.
func TrimLeftFunc(s ref string, f func(rune) bool) ref string {
	for i, r := range s {
		if !f(r) {
			return s[i:]
		}
	}

	return s[len(s):]
}

// TrimRightFunc returns s without the runes at its end for which f is
// true, as a borrow of s.
func TrimRightFunc(s ref string, f func(rune) bool) ref string {
	end := len(s)
	for end > 0 {
		r, n := utf8.DecodeLastRuneInString(s[:end])
		if !f(r) {
			break
		}

		end -= n
	}

	return s[:end]
}

// FieldsFunc splits s around each run of runes for which f is true and
// yields the pieces between, each a borrow into s, none of them empty.
func FieldsFunc(s ref string, f func(rune) bool) []ref string {
	out := []ref string{}
	start := -1
	for i, r := range s {
		if f(r) {
			if start >= 0 {
				out.Push(s[start:i])
				start = -1
			}
		} else if start < 0 {
			start = i
		}
	}

	if start >= 0 {
		out.Push(s[start:])
	}

	return out
}

// EqualIgnoreCase reports whether s and t are equal ignoring case, by
// Unicode's full case folding, its default caseless match: Straße and
// STRASSE are equal, as are Σ, σ and ς. A byte that is not UTF-8 reads
// as U+FFFD, so two strings that differ only in such bytes are equal.
func EqualIgnoreCase(s ref string, t ref string) bool {
	return equalIgnoreCase(s, t)
}

// IndexRune returns the byte offset of the first r in s, or -1. A
// RuneError matches a byte that starts no valid UTF-8 sequence too, as
// a range over s reads one.
func IndexRune(s ref string, r rune) int {
	for i, c := range s {
		if c == r {
			return i
		}
	}

	return -1
}

// ContainsRune reports whether r is in s.
func ContainsRune(s ref string, r rune) bool {
	return IndexRune(s, r) >= 0
}

// Map returns a new string of the runes of s each passed through f; a
// rune for which f returns a negative value is dropped.
func Map(f func(rune) rune, s ref string) string {
	var b Builder
	for _, r := range s {
		if m := f(r); m >= 0 {
			b.WriteRune(m)
		}
	}

	return b.String()
}

// appendString appends the bytes of s to b in one copy, growing b
// once. The runtime provides it.
func appendString(b mut []byte, s ref string)

// repeat writes s n times into one allocation, by doubling: s once,
// then what is written so far again, until the length is reached, as
// Go's Repeat does. The runtime provides it.
func repeat(s ref string, n int) string

// toTitle, equalIgnoreCase and toValidUTF8 are the runtime's title
// casing by words, its full case folding, and its repair of bytes that
// are not UTF-8.
func toTitle(s ref string) string
func equalIgnoreCase(s ref string, t ref string) bool
func toValidUTF8(s ref string, rep ref string) string

// reserve makes room in b for n more bytes, growing it once as a Push
// grows. The runtime provides it.
func reserve(b mut []byte, n int)

// copyString copies the bytes of src that fit to the start of dst and
// returns how many. The runtime provides it, by memcpy.
func copyString(dst mut []byte, src ref string) int

// ownString makes b, which it takes, the string's bytes, with no copy.
func ownString(b []byte) string
