// Package strings builds and transforms text.
//
// What a string can do on its own is a method of the string: Len,
// Fields, Split, SplitOnce, Trim, HasPrefix, HasSuffix, Contains,
// ToUpper, ToLower and Clone. This package has what works on more than
// one string, Join, what builds a new one piece by piece, Builder and
// Repeat, and the transformations as functions, for a call that reads
// better that way or a function value to pass along.
//
// Every parameter here is a borrow, ref string: a call lends its
// argument and gets a new string back, and the argument stays with its
// owner.
package strings

// A Builder accumulates text piece by piece and gives it back as one
// string, cheaper than joining with + at every step. Its zero value is
// ready to use: var b strings.Builder. A Builder owns the bytes it
// holds and is passed mut to be written to.
struct Builder {
	buf []byte
}

// WriteString appends the bytes of s, in one copy.
func (b mut Builder) WriteString(s ref string) {
	appendString(mut b.buf, s)
}

// WriteByte appends one byte.
func (b mut Builder) WriteByte(c byte) {
	b.buf.Push(c)
}

// Len returns the number of bytes written so far.
func (b ref Builder) Len() int {
	return len(b.buf)
}

// String returns what was written so far, as a new string. The builder
// keeps its text and may go on; call it again after more writes for
// the longer text.
func (b ref Builder) String() string {
	return string(b.buf)
}

// Reset empties the builder, ready for new text.
func (b mut Builder) Reset() {
	b.buf.Clear()
}

// Repeat returns s written n times in a row, and the empty string for
// an n of zero. A negative n, or one that would make a string longer
// than an int can count, stops the program, as Go's Repeat does.
func Repeat(s ref string, n int) string {
	if n < 0 {
		panic("strings: negative Repeat count")
	}

	if s.Len() > 0 && n > maxInt / s.Len() {
		panic("strings: Repeat output length overflow")
	}

	return repeat(s, n)
}

// Join writes the parts one after another with sep between every two,
// and none before the first or after the last: Join(ref parts, ", ").
// An empty slice gives the empty string.
func Join(parts ref []string, sep ref string) string {
	size := 0
	for i, p := range parts {
		if i > 0 {
			size += sep.Len()
		}

		size += p.Len()
	}

	buf := make([]byte, 0, size) // the whole result, allocated once and given to the string
	for i, p := range parts {
		if i > 0 {
			appendString(mut buf, sep)
		}

		appendString(mut buf, p)
	}

	return ownString(buf)
}

// Fields splits s around runs of white space, as Go's unicode.IsSpace
// knows it, and yields
// each word as a borrow into s, so no word is copied; a loop over them
// lends s for its duration, for w := range strings.Fields(ref text).
// It is the string's Fields method as a function.
func Fields(s ref string) []ref string {
	return s.Fields()
}

// ToLower returns a new string with every letter of s in lower case,
// by Unicode's simple case mapping, as Go's strings.ToLower gives it.
func ToLower(s ref string) string {
	return s.ToLower()
}

// ToUpper returns a new string with every letter of s in upper case,
// by Unicode's simple case mapping, as Go's strings.ToUpper gives it.
func ToUpper(s ref string) string {
	return s.ToUpper()
}

// maxInt is the largest int, the longest a string can be.
const maxInt int = 9223372036854775807

// appendString appends the bytes of s to b in one copy, growing b
// once. The runtime provides it.
func appendString(b mut []byte, s ref string)

// repeat writes s n times into one allocation, by doubling: s once,
// then what is written so far again, until the length is reached, as
// Go's Repeat does. The runtime provides it.
func repeat(s ref string, n int) string

// ownString makes b, which it takes, the string's bytes, with no copy.
func ownString(b []byte) string
