package strings_test

import ("bufio"; "expect"; "io"; "strings"; "testing"; "unicode/utf8")

// Repeat writes a string n times, and refuses a negative count and one
// whose result no int can measure.
func TestRepeat() {
	expect.Equal(ref expect.IsSome(strings.Repeat("ab", 3)), "ababab")
	expect.Equal(ref expect.IsSome(strings.Repeat("x", 0)), "")
	expect.Equal(ref expect.IsSome(strings.Repeat("", 1000)), "")
	expect.IsNone(strings.Repeat("x", -1))                   // a negative count
	expect.IsNone(strings.Repeat("ab", 9223372036854775807)) // longer than an int can count
}

// Join puts the separator between every two parts and nowhere else; no
// part gives the empty string.
func TestJoin() {
	expect.Equal(ref strings.Join(ref []string{"a", "b", "c"}, "-"), "a-b-c")
	expect.Equal(ref strings.Join(ref []string{}, "-"), "")
	expect.Equal(ref strings.Join(ref []string{"one"}, ", "), "one")
}

// ToUpper and ToLower map ASCII and the letters past it.
func TestCase() {
	testing.Run("upper", func() { expect.Equal(ref strings.ToUpper("snello"), "SNELLO") })
	testing.Run("lower", func() { expect.Equal(ref strings.ToLower("SNELLO"), "snello") })
	testing.Run("mixed", func() { expect.Equal(ref strings.ToUpper("Café 1"), "CAFÉ 1") })
}

// Fields splits at runs of white space and gives no empty word.
func TestFields() {
	fields := strings.Fields("  two   words ")
	expect.Equal(ref len(fields), ref 2)
	expect.Equal(fields[0], "two")
	expect.Equal(fields[1], "words")
	expect.Equal(ref len(strings.Fields("   ")), ref 0)
}

// The full case mappings: a rune that grows to several, the final
// sigma, and title case by words.
func TestFullCase() {
	expect.Equal(ref strings.ToUpper("straße"), "STRASSE") // a rune grows to two
	expect.Equal(ref strings.ToUpper("ﬁ"), "FI")
	expect.Equal(ref strings.ToLower("ΟΔΥΣΣΕΥΣ"), "οδυσσευς") // the last sigma is final, the one inside a word is not
	expect.Equal(ref strings.ToLower("Σ"), "σ") // alone, no cased letter before it
	expect.Equal(ref strings.ToLower("ΑΣ'"), "ας'") // a case-ignorable apostrophe after it
	expect.Equal(ref "ß".ToUpper(), "SS") // the string method maps the same
	expect.Equal(ref strings.ToTitle("ǆ ß a"), "ǅ Ss A")
	expect.Equal(ref strings.ToTitle("straße ﬁx ǆungla"), "Straße Fix ǅungla") // the first cased letter of each word, the rest lowered
	expect.Equal(ref strings.ToTitle("HELLO wORLD, it's 2026"), "Hello World, It's 2026")
	expect.Equal(ref strings.ToTitle("ΟΔΥΣΣΕΥΣ"), "Οδυσσευς") // lowered with the final sigma
	expect.Equal(ref strings.ToTitle(""), "")
	expect.Equal(ref strings.ToTitle("3rd o'neil 'tis"), "3rd O'neil 'Tis") // a word starts at its first letter, number or symbol
	expect.Equal(ref strings.ToTitle("3RD (hello)"), "3rd (Hello)")
	expect.Equal(ref strings.ToUpper("snello"), "SNELLO") // ASCII stays byte for byte
}

// EqualIgnoreCase compares by the full case folding, where ß is ss and
// the sigmas are one.
func TestEqualIgnoreCase() {
	expect.True(strings.EqualIgnoreCase("Straße", "STRASSE"))
	expect.True(strings.EqualIgnoreCase("Snello", "sNELLO"))
	expect.True(strings.EqualIgnoreCase("ΣΑΣ", "σας")) // σ and ς fold alike
	expect.True(strings.EqualIgnoreCase("K", "\u212A")) // the Kelvin sign
	expect.True(strings.EqualIgnoreCase("", ""))
	expect.False(strings.EqualIgnoreCase("a", "b"))
	expect.False(strings.EqualIgnoreCase("ß", "s")) // a prefix of the folding is not equal
	expect.False(strings.EqualIgnoreCase("ı", "I")) // dotless i folds to itself outside Turkish
}

// ToValidUTF8 replaces each run of bytes that are not UTF-8 once.
func TestValidUTF8() {
	expect.Equal(ref strings.ToValidUTF8("a\xffb\xfe\xfdc", "?"), "a?b?c") // one replacement a run
	expect.Equal(ref strings.ToValidUTF8("añ", "?"), "añ")
	expect.Equal(ref strings.ToValidUTF8("\xff", ""), "")
	expect.Equal(ref strings.ToValidUTF8("", "?"), "")
}

// The functions that take a predicate find, trim and split by it.
func TestFuncs() {
	space := func(r rune) bool { return r == ' ' || r == ',' }
	expect.Equal(ref strings.IndexFunc("ab, c", space), ref 2)
	expect.Equal(ref strings.LastIndexFunc("ab, c", space), ref 3)
	expect.Equal(ref strings.IndexFunc("abc", space), ref -1)
	expect.Equal(ref strings.LastIndexFunc("", space), ref -1)
	expect.Equal(strings.TrimFunc(" ,añ, ", space), "añ")
	expect.Equal(strings.TrimLeftFunc(" ,añ, ", space), "añ, ")
	expect.Equal(strings.TrimRightFunc(" ,añ, ", space), " ,añ")
	expect.Equal(strings.TrimFunc(" , ", space), "")
	fields := strings.FieldsFunc(", a,b ,, c ", space)
	expect.Equal(ref len(fields), ref 3)
	expect.Equal(fields[0], "a")
	expect.Equal(fields[2], "c")
	expect.Equal(ref len(strings.FieldsFunc("", space)), ref 0)
}

// IndexRune finds a rune, a stray byte as RuneError, and Map maps each
// rune or drops it.
func TestRunes() {
	expect.Equal(ref strings.IndexRune("añb", 'b'), ref 3)
	expect.Equal(ref strings.IndexRune("añb", 'z'), ref -1)
	expect.Equal(ref strings.IndexRune("a\xffb", '\uFFFD'), ref 1) // a stray byte reads as RuneError
	expect.True(strings.ContainsRune("añb", 'ñ'))
	expect.False(strings.ContainsRune("", 'a'))
	upper := func(r rune) rune { return r - 32 }
	expect.Equal(ref strings.Map(upper, "abc"), "ABC")
	drop := func(r rune) rune {
		if r == 'a' {
			return -1
		}

		return r
	}

	expect.Equal(ref strings.Map(drop, "banana"), "bnn")
}

// WriteRune writes one to four bytes, and U+FFFD for a value that is
// not a code point.
func TestWriteRune() {
	var b strings.Builder
	b.WriteRune('h')
	b.WriteRune('é')
	b.WriteRune('世')
	b.WriteRune(-1) // not a code point: U+FFFD
	expect.Equal(ref b.String(), "hé世\uFFFD")
	expect.Equal(ref b.Len(), ref 9)
}

// A Builder joins what is written to it, lends it with Bytes, and Reset
// empties it.
func TestBuilder() {
	var b strings.Builder
	b.WriteString("one")
	b.WriteByte(' ')
	b.WriteString("two")
	expect.Equal(ref b.Len(), ref 7)
	expect.Equal(ref b.String(), "one two")
	expect.EqualSlice(b.Bytes(), ref []byte("one two")) // lent, not copied
	b.Reset()
	expect.Equal(ref b.Len(), ref 0)
	expect.Equal(ref b.String(), "")
	expect.Empty(b.Bytes())
}

// How long Repeat takes for a short string, and what it allocates.
func BenchmarkRepeat() {
	testing.ReportAllocs()
	for testing.Loop() {
		_ = strings.Repeat("ab", 16)
	}
}

// How long a Builder takes to make a short string from three writes.
func BenchmarkBuilder() {
	for testing.Loop() {
		var b strings.Builder
		b.WriteString("one")
		b.WriteByte(' ')
		b.WriteString("two")
		_ = b.String()
	}
}

// A Reader hands out its string in pieces of any size, and bufio reads
// lines through it.
func TestReader() {
	r := strings.NewReader("hello, world")
	buf := make([]byte, 5)
	var got strings.Builder
	for {
		n := r.Read(mut buf).Unwrap()
		if n == 0 {
			break
		}

		got.WriteString(ref string(buf[:n]))
	}

	expect.Equal(ref got.String(), "hello, world")
	expect.Equal(ref r.Len(), ref 0)
	empty := make([]byte, 0)
	expect.Equal(ref r.Read(mut empty).Unwrap(), ref 0) // nowhere to put a byte

	lines := strings.NewReader("one\ntwo\nthree")
	sc := bufio.NewScanner(mut lines) // the Reader owns its text, so bufio can hold it
	var seen strings.Builder
	for sc.Scan() {
		seen.WriteString(sc.Text())
		seen.WriteByte('|')
	}

	expect.Equal(ref seen.String(), "one|two|three|")
}

// Grow makes room that the writes after it use, and does nothing for a
// count of zero or less.
func TestGrow() {
	var b strings.Builder
	b.Grow(64)
	b.Grow(-1) // nothing
	b.WriteString("grown")
	expect.Equal(ref b.String(), "grown")
	expect.Equal(ref b.Len(), ref 5)
}

// ContainsFunc says whether any rune satisfies the predicate.
func TestContainsFunc() {
	digit := func(r rune) bool { return r >= '0' && r <= '9' }
	expect.True(strings.ContainsFunc("room 101", digit))
	expect.False(strings.ContainsFunc("room", digit))
	expect.False(strings.ContainsFunc("", digit))
}

// The Reader reads bytes and runes one at a time, steps back over the
// last one, and seeks from the start, the current position and the end.
func TestReaderBytesAndRunes() {
	r := strings.NewReader("aé")
	expect.Equal(ref expect.IsSome(r.ReadByte()), ref byte('a'))
	expect.True(r.UnreadByte())
	expect.Equal(ref expect.IsSome(r.ReadByte()), ref byte('a'))
	c, width := expect.IsSome(r.ReadRune())
	expect.Equal(ref c, ref 'é')
	expect.Equal(ref width, ref 2)
	expect.True(r.UnreadRune())
	expect.False(r.UnreadRune()) // only the rune the last ReadRune returned
	c, width = expect.IsSome(r.ReadRune())
	expect.Equal(ref c, ref 'é')
	expect.IsNone(r.ReadRune())
	expect.IsNone(r.ReadByte())
	expect.False(r.UnreadRune()) // after a read that returned nothing
	expect.Equal(ref r.Len(), ref 0)
	expect.True(r.UnreadByte()) // back over the last byte of é
	expect.Equal(ref r.Len(), ref 1)
	fresh := strings.NewReader("x")
	expect.False(fresh.UnreadByte()) // nothing read yet
	expect.False(fresh.UnreadRune())
	bad := strings.NewReader("\xff")
	c, width = expect.IsSome(bad.ReadRune()) // a byte that is not UTF-8: U+FFFD of width one
	expect.Equal(ref c, ref utf8.RuneError)
	expect.Equal(ref width, ref 1)
}

// Seek moves from the start, the current position and the end, fails
// before the start and past what an int counts, and allows a position
// past the end, where nothing is read and nothing can be unread.
func TestReaderSeek() {
	r := strings.NewReader("hello, world")
	expect.Equal(ref expect.IsOk(r.Seek(io.Start(7))), ref u64(7))
	expect.Equal(ref expect.IsSome(r.ReadByte()), ref byte('w'))
	expect.Equal(ref expect.IsOk(r.Seek(io.Current(-1))), ref u64(7))
	expect.Equal(ref expect.IsSome(r.ReadByte()), ref byte('w'))
	expect.Equal(ref expect.IsOk(r.Seek(io.End(-5))), ref u64(7))
	expect.Equal(ref r.Len(), ref 5)
	expect.Equal(ref expect.IsOk(r.Seek(io.End(10))), ref u64(22)) // past the end: allowed, nothing to read
	expect.Equal(ref r.Len(), ref 0)
	expect.IsNone(r.ReadByte())
	buf := make([]byte, 4)
	expect.Equal(ref expect.IsOk(r.Read(mut buf)), ref 0)
	expect.False(r.UnreadByte()) // past the end, nothing was read
	expect.Equal(ref expect.IsErr(r.Seek(io.Current(-100))).Error(), "seek: negative position")
	expect.Equal(ref expect.IsErr(r.Seek(io.Start(18446744073709551615))).Error(), "seek: position beyond what an int counts")
	expect.Equal(ref expect.IsOk(r.Seek(io.Start(0))), ref u64(0))
	expect.Equal(ref expect.IsSome(r.ReadByte()), ref byte('h'))
	expect.True(r.UnreadByte())
	expect.Equal(ref expect.IsOk(r.Seek(io.Start(0))), ref u64(0))
	expect.False(r.UnreadByte()) // a seek forgets what was read
}

// The Replacer's three shapes: bytes to bytes, bytes to text, and text,
// with the first pair winning a position, no overlapping matches, and
// an empty old string placed before every rune and at the end, a pair
// given after it matching at the same position too.
func TestReplacer() {
	swap := expect.IsSome(strings.NewReplacer("a", "b", "b", "a"))
	expect.Equal(ref swap.Replace("abracadabra"), "barbcbdbarb")
	expect.Equal(ref swap.Replace(""), "")
	spread := expect.IsSome(strings.NewReplacer("a", "xx", "b", "", "é", "e"))
	expect.Equal(ref spread.Replace("abcé"), "xxce") // é is two bytes, so this is the text kind too
	drop := expect.IsSome(strings.NewReplacer("a", "xx", "b", ""))
	expect.Equal(ref drop.Replace("abcab"), "xxcxx")
	esc := expect.IsSome(strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;"))
	expect.Equal(ref esc.Replace("a < b & c > d"), "a &lt; b &amp; c &gt; d")
	expect.Equal(ref esc.Replace("plain"), "plain")
	first := expect.IsSome(strings.NewReplacer("ab", "1", "a", "2"))
	expect.Equal(ref first.Replace("abc abd"), "1c 1d") // the longer pair, given first, wins
	shorter := expect.IsSome(strings.NewReplacer("a", "2", "ab", "1"))
	expect.Equal(ref shorter.Replace("abc"), "2bc") // the pair given first wins, though shorter
	chain := expect.IsSome(strings.NewReplacer("aaa", "x", "aa", "y"))
	expect.Equal(ref chain.Replace("aaaaa"), "xy") // no overlap: the pass moves past a match
	empty := expect.IsSome(strings.NewReplacer("", "-"))
	expect.Equal(ref empty.Replace("abc"), "-a-b-c-")
	expect.Equal(ref empty.Replace(""), "-")
	emptyLast := expect.IsSome(strings.NewReplacer("b", "B", "", "-"))
	expect.Equal(ref emptyLast.Replace("abc"), "-aB-c-") // b, given before the empty string, takes its position
	emptyFirst := expect.IsSome(strings.NewReplacer("", "-", "b", "B"))
	expect.Equal(ref emptyFirst.Replace("abc"), "-a-B-c-") // the empty string, given first, matches everywhere, and the later pair still matches after it
	accent := expect.IsSome(strings.NewReplacer("", "-", "é", "e"))
	expect.Equal(ref accent.Replace("é"), "-e-")
	none := expect.IsSome(strings.NewReplacer())
	expect.Equal(ref none.Replace("as is"), "as is")
	expect.IsNone(strings.NewReplacer("odd"))
	word := expect.IsSome(strings.NewReplacer("naïve", "naive", "ï", "i"))
	expect.Equal(ref word.Replace("naïve ï"), "naive i")
	five := expect.IsSome(strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;", `"`, "&#34;", "'", "&#39;")) // five start bytes: past the four found a word at a time
	expect.Equal(ref five.Replace(`<a href="x">it's & more</a>`), "&lt;a href=&#34;x&#34;&gt;it&#39;s &amp; more&lt;/a&gt;")
	twice := expect.IsSome(strings.NewReplacer("a", "x", "a", "y")) // the first pair of a byte wins, in the table kind
	expect.Equal(ref twice.Replace("aaa"), "xxx")
	twiceText := expect.IsSome(strings.NewReplacer("ab", "x", "ab", "yy")) // and in the trie kind
	expect.Equal(ref twiceText.Replace("abab"), "xx")
	mixed := expect.IsSome(strings.NewReplacer("a", "xx", "a", "y", "b", "z")) // a losing pair of one byte for one does not change the kind
	expect.Equal(ref mixed.Replace("abba"), "xxzzxx")
}
