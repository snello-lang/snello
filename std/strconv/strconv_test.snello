package strconv_test

import ("expect"; "strconv"; "testing")

func TestAtoi() {
	expect.Equal(ref expect.IsOk(strconv.Atoi("42")), ref 42)
	expect.Equal(ref expect.IsOk(strconv.Atoi("-7")), ref -7)
	e := expect.IsErr(strconv.Atoi("x"))
	expect.Contains(ref e.Error(), "parsing \"x\"")
	expect.True(e.Kind() == e.Kind())
}

func TestItoa() {
	expect.Equal(ref strconv.Itoa(0), "0")
	expect.Equal(ref strconv.Itoa(-120), "-120")
	expect.Equal(ref strconv.Itoa(9007199254740993), "9007199254740993")
}

func TestFloat() {
	expect.Equal(ref expect.IsOk(strconv.ParseFloat("1.5")), ref 1.5)
	expect.Equal(ref expect.IsOk(strconv.ParseFloat("-2e3")), ref -2000.0)
	expect.IsErr(strconv.ParseFloat("abc"))
	expect.Equal(ref strconv.FormatFloat(1.5), "1.5")
	expect.Equal(ref strconv.FormatFloat(0.1), "0.1")
}

func BenchmarkAtoi() {
	for testing.Loop() { _ = strconv.Atoi("123456") }
}
