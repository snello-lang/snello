// Package strconv reads numbers from text and writes them back.
//
// Reading can fail, so Atoi and ParseFloat return a Result whose error
// is an Error saying what was tried on which text and why it failed;
// a program passes it up with ? or handles it with a match. Writing
// cannot fail: Itoa and FormatFloat return the text.
package strconv

import "fmt"

// An Error says which function could not read which text, and why: the
// text was not a number of that kind, or the number does not fit the
// type. It prints as "strconv.Atoi: parsing "4x": invalid syntax".
struct Error impl Error, Clone {
	// Func names the function that failed: Atoi or ParseFloat.
	Func string

	// Text is the text the function was given, copied, so the Error
	// may outlive it.
	Text string

	// Msg says why: "invalid syntax" for text that is not a number,
	// "value out of range" for a number the type does not hold.
	Msg string
}

// A Kind says why a text did not read, as Go's strconv.ErrSyntax and
// ErrRange do: a program that must tell the two apart asks Kind rather
// than reading the message.
enum Kind impl Copy, Clone, Eq {
	// Syntax: the text is not a number of the kind asked for.
	Syntax

	// Range: the number does not fit the type.
	Range
}

const minInt int = -9223372036854775808

// Error returns the message, worded as Go's strconv words it: the
// function, the text in quotes, and the reason.
func (e ref Error) Error() string {
	return fmt.Sprintf("strconv.%s: parsing %q: %s", e.Func, e.Text, e.Msg)
}

// Kind returns why the text did not read: Range for a number that does
// not fit, Syntax for anything else.
func (e ref Error) Kind() Kind {
	if e.Msg == "value out of range" {
		return Range
	}

	return Syntax
}

// Atoi reads a decimal integer: an optional sign and then digits, with
// nothing before or after, from -9223372036854775808 to
// 9223372036854775807. Text that is not that is an Error saying
// invalid syntax; a number that does not fit an int, value out of
// range.
func Atoi(s ref string) Result<int, Error> {
	i := 0
	neg := false
	if s.Len() > 0 && (s[0] == '+' || s[0] == '-') {
		neg = s[0] == '-'
		i = 1
	}

	if i == s.Len() {
		return Err(Error{Func: "Atoi", Text: s.Clone(), Msg: "invalid syntax"})
	}

	// The number is accumulated below zero, so that the most negative
	// int, whose magnitude no int holds, is reached without wrapping.
	n := 0
	for i < s.Len() {
		c := s[i]
		if c < '0' || c > '9' {
			return Err(Error{Func: "Atoi", Text: s.Clone(), Msg: "invalid syntax"})
		}

		d := int(c - '0')
		if n < (minInt+d)/10 || (!neg && n*10-d == minInt) {
			return Err(Error{Func: "Atoi", Text: s.Clone(), Msg: "value out of range"})
		}

		n = n*10 - d
		i++
	}

	if neg {
		return Ok(n)
	}

	return Ok(-n)
}

// Itoa writes n in decimal, with a minus sign when it is negative.
func Itoa(n int) string {
	return fmt.Sprint(n)
}

// ParseFloat reads a floating-point number as Go's strconv.ParseFloat
// reads one: an optional sign, digits with an optional point and an
// optional exponent, 1.5e3, or a hexadecimal mantissa with the p
// exponent Go asks of it, 0x1p-2; also inf and infinity in any case,
// with a sign or not, and nan in any case without one. An underscore
// may stand between two digits, 1_000.5. Nothing may come before or
// after the number, not even a space. Text that is not that is an Error
// saying invalid syntax; a number too large for an f64, value out of
// range, while one too small rounds to zero, as a literal does.
func ParseFloat(s ref string) Result<f64, Error> {
	v := 0.0
	code := parseFloat(s, mut v)
	if code == 0 {
		return Ok(v)
	}

	msg := if code == 1 { "invalid syntax" } else { "value out of range" }
	return Err(Error{Func: "ParseFloat", Text: s.Clone(), Msg: msg})
}

// FormatFloat writes f as the shortest text that reads back as the
// same number, as fmt prints a float and as Go's FormatFloat(f, 'g',
// -1, 64) writes it: 15 for 15.0, 2.5, 0.1, an exponent from a million
// up and below 0.0001, 1e+06 and 1e-05, and +Inf, -Inf and NaN.
func FormatFloat(f f64) string {
	return fmt.Sprint(f)
}

// parseFloat reads s into out and returns 0, or 1 when s is not a
// number and 2 when it does not fit. The runtime provides it.
func parseFloat(s ref string, out mut f64) int
