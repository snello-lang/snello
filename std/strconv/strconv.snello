// Package strconv reads numbers, bools and quoted strings from text and
// writes them back.
//
// Reading can fail, so Atoi, ParseInt, ParseUint, ParseFloat,
// ParseFloat32, ParseBool and Unquote return a Result whose error is an
// Error saying what was tried on which text and why it failed; a
// program passes it up with ? or handles it with a match. Writing
// cannot fail: Itoa, FormatFloat, FormatFloat32, FormatBool and Quote
// return the text. FormatInt and FormatUint write in a base the caller
// names, and return None for a base that is none, below 2 or above 36.
// No function of the package panics on a text or a base it is given.
package strconv

import ("fmt"; "math")

// The reasons an Error gives in its Msg: a text that is not of the
// kind asked for, a number its type does not hold, and a base that is
// none, which the base itself follows, invalid base 37.
const invalidSyntax string = "invalid syntax"
const outOfRange string = "value out of range"
const invalidBase string = "invalid base "

// What readUnsigned, parseFloat and parseFloat32 return: parsed when
// they read a number, and otherwise why they did not.
const parsed int = 0
const badSyntax int = 1
const badRange int = 2
const badBase int = 3

// The bases a number is read and written in: from two, its digits 0
// and 1, to thirty-six, the ten digits and the twenty-six letters.
const minBase int = 2
const maxBase int = 36

// The characters of a number's text besides its digits: the signs, the
// underscore that may stand between digits when the base is read from
// the text, and the letters, in lower case, of the base prefixes after
// a 0: 0b for two, 0o for eight and 0x for sixteen.
const minusSign byte = '-'
const plusSign byte = '+'
const digitSeparator byte = '_'
const binaryPrefix byte = 'b'
const octalPrefix byte = 'o'
const hexPrefix byte = 'x'

// lowerCaseBit is the bit that makes an ASCII letter lower case: c |
// lowerCaseBit is the letter c in lower case.
const lowerCaseBit byte = 0x20

// quickAtoiLen is the longest text Atoi reads without checking for
// overflow: eighteen digits are below the largest int whatever they
// are, so a text no longer is only checked for being digits.
const quickAtoiLen int = 18

// An Error says which function could not read which text, and why: the
// text was not of the kind asked for, the number does not fit the
// type, or the base is none. It prints as
// "strconv.Atoi: parsing "4x": invalid syntax".
struct Error impl Error, Clone {
	// Func names the function that failed: Atoi, ParseInt, ParseUint,
	// ParseFloat, ParseFloat32, ParseBool or Unquote.
	Func string

	// Text is the text the function was given, copied, so the Error
	// may outlive it.
	Text string

	// Msg says why: "invalid syntax" for text that is not of the kind,
	// "value out of range" for a number the type does not hold, and
	// "invalid base 37" for a base below 2 or above 36.
	Msg string
}

// A Kind says why a text did not read: a program that must tell the
// reasons apart asks Error.Kind rather than reading the message.
enum Kind impl Copy, Clone, Eq {
	// Syntax: the text is not of the kind asked for.
	Syntax

	// Range: the number does not fit the type.
	Range

	// Base: the base is none, below 2 or above 36 and not 0.
	Base
}

// Error returns the message: the function, the text in quotes, and the
// reason, strconv.Atoi: parsing "4x": invalid syntax. It allocates the
// string it returns.
func (e ref Error) Error() string {
	return fmt.Sprintf("strconv.%s: parsing %q: %s", e.Func, e.Text, e.Msg)
}

// Kind returns why the text did not read: Range for a number that does
// not fit, Base for a base that is none, Syntax for anything else.
//
//	match strconv.Atoi(text) {
//		Ok(n) => use(n),
//		Err(e) if e.Kind() == strconv.Range => tooLarge(),
//		Err(e) => fail(e),
//	}
func (e ref Error) Kind() Kind {
	if e.Msg == outOfRange {
		return Range
	}

	if e.Msg.HasPrefix(invalidBase) {
		return Base
	}

	return Syntax
}

// Atoi reads a decimal integer from s, which it only borrows: an
// optional sign and then digits, with nothing before or after, from
// -9223372036854775808 to 9223372036854775807. It returns an Error
// saying invalid syntax for text that is not that, however large the
// digits it starts with, and value out of range for a number that does
// not fit an int. A text of eighteen bytes or fewer is read in one
// pass with no check for overflow, which none of them can reach; it
// allocates only an Error.
//
//	n := strconv.Atoi("-42")?   // -42
func Atoi(s ref string) Result<int, Error> {
	if s.Len() > 0 && s.Len() <= quickAtoiLen {
		i := 0
		neg := s[0] == minusSign
		if neg || s[0] == plusSign {
			i = 1
		}

		if i == s.Len() {
			return Err(parseError("Atoi", s, invalidSyntax))
		}

		n := 0
		for i < s.Len() {
			d := s[i] - '0' // a byte below '0' wraps to one above 9
			if d > 9 {
				return Err(parseError("Atoi", s, invalidSyntax))
			}

			n = n*10 + int(d)
			i++
		}

		if neg {
			n = -n
		}

		return Ok(n)
	}

	return parseInt("Atoi", s, 10)
}

// Itoa returns n in decimal, with a minus sign when it is negative:
// Itoa(-120) is "-120". It allocates the string it returns.
func Itoa(n int) string {
	return fmt.Sprint(n)
}

// ParseInt reads an integer from s, which it only borrows, written in
// the base given, from 2 to 36: an optional sign and then digits, the
// letters a to z in either case standing for ten to thirty-five, with
// nothing before or after. A base of 0 reads the base from the text:
// 0x for sixteen, 0o or a leading 0 for eight, 0b for two, and ten
// without one; and only then may an underscore stand between two
// digits or after the prefix, 1_000 and 0x_ff. It returns an Error
// saying invalid syntax for text that is not that, however large the
// digits it starts with; value out of range for a number that does not
// fit an int; and invalid base for a base that is none. It reads s
// once, and allocates only an Error.
//
//	n := strconv.ParseInt("ff", 16)?    // 255
//	m := strconv.ParseInt("0b101", 0)?  // 5
func ParseInt(s ref string, base int) Result<int, Error> {
	return parseInt("ParseInt", s, base)
}

// ParseUint reads an unsigned integer from s as ParseInt reads an
// integer, but without a sign, from 0 to 18446744073709551615. It
// returns an Error saying invalid syntax for text that is not that, a
// sign included; value out of range for a number that does not fit a
// uint; and invalid base for a base that is none.
//
//	n := strconv.ParseUint("0xFFFF_FFFF", 0)?   // 4294967295
func ParseUint(s ref string, base int) Result<uint, Error> {
	un := u64(0)
	code := readUnsigned(s, 0, base, mut un)
	if code != parsed {
		return Err(parseError("ParseUint", s, failureReason(code, base)))
	}

	return Ok(uint(un))
}

// FormatInt returns n written in the base given, from 2 to 36, with a
// minus sign when it is negative and the letters a to z for the digits
// from ten up: FormatInt(-255, 16) is "-ff". It returns None for a
// base that is none, 0 included, since reading the base from the text
// is for reading only. It allocates the string it returns.
//
//	hex := strconv.FormatInt(255, 16) ?? ""   // "ff"
func FormatInt(n int, base int) string? {
	if base < minBase || base > maxBase {
		return None
	}

	if n < 0 {
		return Some(formatBits(0-u64(n), base, true))
	}

	return Some(formatBits(u64(n), base, false))
}

// FormatUint returns n written in the base given, from 2 to 36, as
// FormatInt writes it, or None for a base that is none.
func FormatUint(n uint, base int) string? {
	if base < minBase || base > maxBase {
		return None
	}

	return Some(formatBits(u64(n), base, false))
}

// AppendInt writes n after the bytes of b, in the base given, from 2 to
// 36, as FormatInt writes it, and reports whether it did: for a base
// outside that range it writes nothing and returns false. The digits
// are made on the stack and copied once, so a line of numbers is built
// with no string between.
//
//	strconv.AppendInt(mut line, n, 10)
func AppendInt(b mut []byte, n int, base int) bool {
	if base < minBase || base > maxBase {
		return false
	}

	if n < 0 {
		appendBits(mut b, 0-u64(n), base, true)
	} else {
		appendBits(mut b, u64(n), base, false)
	}

	return true
}

// AppendUint writes n after the bytes of b, in the base given, from 2
// to 36, as FormatUint writes it, and reports whether it did: for a
// base outside that range it writes nothing and returns false.
func AppendUint(b mut []byte, n uint, base int) bool {
	if base < minBase || base > maxBase {
		return false
	}

	appendBits(mut b, u64(n), base, false)
	return true
}

// ParseBool reads a bool from s, which it only borrows: 1, t, T, true,
// TRUE and True are true; 0, f, F, false, FALSE and False are false.
// It returns an Error saying invalid syntax for any other text.
//
//	verbose := strconv.ParseBool("true")?   // true
func ParseBool(s ref string) Result<bool, Error> {
	if s == "1" || s == "t" || s == "T" || s == "true" || s == "TRUE" || s == "True" {
		return Ok(true)
	}

	if s == "0" || s == "f" || s == "F" || s == "false" || s == "FALSE" || s == "False" {
		return Ok(false)
	}

	return Err(parseError("ParseBool", s, invalidSyntax))
}

// FormatBool returns b as text, "true" or "false".
func FormatBool(b bool) string {
	if b {
		return "true"
	}

	return "false"
}

// AppendBool writes true or false after the bytes of b.
func AppendBool(b mut []byte, v bool) {
	appendString(mut b, ref FormatBool(v))
}

// Quote returns s, which it only borrows, as a string literal in
// double quotes, as fmt's %q writes one: a quote and a backslash
// escaped, a character that does not print as its escape, \n, \x00 or
// \u00a0, and a byte that starts no character as \xNN. Unquote reads
// it back. It allocates the string it returns.
//
//	strconv.Quote("tab\there")   // "tab\there", its quotes included
func Quote(s ref string) string {
	return fmt.Sprintf("%q", s)
}

// AppendQuote writes s as a literal in double quotes, as Quote writes
// it, after the bytes of b.
func AppendQuote(b mut []byte, s ref string) {
	appendString(mut b, ref Quote(s))
}

// Unquote reads the literal s, which it only borrows, and returns the
// text it stands for, as a new string: a string in double quotes with
// a string literal's escapes, "a\tb"; a string in back quotes, taken
// as it is but for its carriage returns; or one character in single
// quotes, 'x', returned as a string. The whole of s is the literal,
// its quotes included. It returns an Error saying invalid syntax for
// text that is not one, an escape that is none or a character that
// does not fit its quotes.
//
//	text := strconv.Unquote("\"a\\tb\"")?   // a, a tab, b
func Unquote(s ref string) Result<string, Error> {
	ok := false
	text := unquote(s, mut ok)
	if ok {
		return Ok(text)
	}

	return Err(parseError("Unquote", s, invalidSyntax))
}

// ParseFloat reads a floating-point number from s, which it only
// borrows: an optional sign, digits with an optional point and an
// optional exponent, 1.5e3, or a hexadecimal mantissa with the p
// exponent a literal asks of it, 0x1p-2; also inf and infinity in any
// case, with a sign or not, and nan in any case without one. An
// underscore may stand between two digits, 1_000.5. Nothing may come
// before or after the number, not even a space. The result is the f64
// nearest the number written, however many digits it has, a tie going
// to the even one. It returns an Error saying invalid syntax for text
// that is not a number, and value out of range for a number too large
// for an f64, while one too small rounds to zero, as a literal does.
//
//	f := strconv.ParseFloat("1.5e3")?   // 1500.0
func ParseFloat(s ref string) Result<f64, Error> {
	v := 0.0
	code := parseFloat(s, mut v)
	if code == parsed {
		return Ok(v)
	}

	return Err(parseError("ParseFloat", s, failureReason(code, 0)))
}

// ParseFloat32 reads a floating-point number from s as ParseFloat
// reads one, and returns the f32 nearest it, which converting
// ParseFloat's f64 does not always give, since that rounds twice. It
// returns an Error saying invalid syntax for text that is not a
// number, and value out of range for a number too large for an f32.
func ParseFloat32(s ref string) Result<f32, Error> {
	v := f32(0.0)
	code := parseFloat32(s, mut v)
	if code == parsed {
		return Ok(v)
	}

	return Err(parseError("ParseFloat32", s, failureReason(code, 0)))
}

// FormatFloat returns f written with prec digits after the point,
// rounded to them, a tie to the even digit, as fmt's %.2f writes it:
// FormatFloat(2.5, 2) is "2.50" and FormatFloat(1e21, 0) is
// "1000000000000000000000". A negative prec asks for the shortest text
// that reads back as the same number, as fmt prints a float: 15 for
// 15.0, 2.5, 0.1, an exponent from a million up, 1e+06, and below
// 0.0001, 1e-05. An infinity is +Inf or -Inf and a NaN is NaN,
// whatever prec is. Every digit written is exact, however many are
// asked for: an f64 is a whole number times a power of two no smaller
// than 2^-1074, so it has no digit that is not zero past the 1074th
// after its point, and FormatFloat(5e-324, 1074) is the smallest f64
// written out in full. The text is as long as prec asks, and allocated
// once.
//
//	strconv.FormatFloat(3.14159, 2)   // "3.14"
//	strconv.FormatFloat(0.1, -1)      // "0.1"
func FormatFloat(f f64, prec int) string {
	if prec < 0 {
		return fmt.Sprint(f)
	}

	return formatFixed(f, prec)
}

// FormatFloat32 returns f written as FormatFloat writes an f64, but
// with a negative prec the shortest text that reads back as the same
// f32, so that f32(0.1) is "0.1" rather than the f64's
// 0.10000000149011612.
func FormatFloat32(f f32, prec int) string {
	if prec < 0 {
		return fmt.Sprint(f)
	}

	return formatFixed(f64(f), prec)
}

// AppendFloat writes f after the bytes of b, as FormatFloat writes it:
// prec digits after the point, or the shortest text that reads back
// as f for a negative prec.
func AppendFloat(b mut []byte, f f64, prec int) {
	if prec < 0 {
		appendFloat(mut b, f, false)
	} else {
		appendFixed(mut b, f, prec)
	}
}

// AppendFloat32 writes f after the bytes of b, as FormatFloat32 writes
// it.
func AppendFloat32(b mut []byte, f f32, prec int) {
	if prec < 0 {
		appendFloat(mut b, f64(f), true)
	} else {
		appendFixed(mut b, f64(f), prec)
	}
}

// parseError returns the Error of the function named fn on the text
// s, which it copies, for the reason msg.
func parseError(fn string, s ref string, msg string) Error {
	return Error{Func: fn, Text: s.Clone(), Msg: msg}
}

// parseInt is ParseInt for the function named fn, which its Error
// names.
func parseInt(fn string, s ref string, base int) Result<int, Error> {
	if s.Len() == 0 {
		return Err(parseError(fn, s, invalidSyntax))
	}

	neg := s[0] == minusSign
	from := 0
	if neg || s[0] == plusSign {
		from = 1
	}

	un := u64(0)
	code := readUnsigned(s, from, base, mut un)
	if code == badSyntax || code == badBase {
		return Err(parseError(fn, s, failureReason(code, base)))
	}

	// The most negative int is one further from zero than the largest.
	limit := u64(1) << 63
	if code == badRange || (!neg && un >= limit) || (neg && un > limit) {
		return Err(parseError(fn, s, outOfRange))
	}

	n := int(un)
	if neg {
		n = -n
	}

	return Ok(n)
}

// failureReason returns the message of a code readUnsigned or
// parseFloat returned, for a number read in base.
func failureReason(code int, base int) string {
	if code == badRange {
		return outOfRange
	}

	if code == badBase {
		return invalidBase + Itoa(base)
	}

	return invalidSyntax
}

// readUnsigned reads the digits of s from the index from into out, in
// base, or in the base its prefix names when base is 0, and returns
// parsed, or why it could not. A number past the largest u64 is read
// to its end all the same, so that text which is no number is
// badSyntax however large its first digits are, and badRange only
// when every byte is a digit.
func readUnsigned(s ref string, from int, base int, out mut u64) int {
	if from >= s.Len() {
		return badSyntax
	}

	i := from
	b := u64(base)
	if base == 0 {
		b = 10
		if s[i] == '0' {
			b = 8
			i++
			if s.Len()-from >= 3 { // a 0, a prefix and a digit
				c := s[i] | lowerCaseBit
				if c == binaryPrefix {
					b = 2
					i++
				} else if c == octalPrefix {
					i++
				} else if c == hexPrefix {
					b = 16
					i++
				}
			}
		}
	} else if base < minBase || base > maxBase {
		return badBase
	}

	// At cutoff and above, one more digit does not fit.
	cutoff := math.MaxUint64/b + 1
	underscores := false
	over := false
	n := u64(0)
	for i < s.Len() {
		c := s[i]
		i++
		d := u64(0)
		if c == digitSeparator && base == 0 {
			underscores = true
			continue
		} else if c >= '0' && c <= '9' {
			d = u64(c - '0')
		} else if (c|lowerCaseBit) >= 'a' && (c|lowerCaseBit) <= 'z' {
			d = u64((c|lowerCaseBit)-'a') + 10
		} else {
			return badSyntax
		}

		if d >= b {
			return badSyntax
		}

		if over || n >= cutoff {
			over = true
			continue
		}

		n *= b
		over = n+d < n
		n += d
	}

	if underscores && !hasWellPlacedUnderscores(s) {
		return badSyntax
	}

	if over {
		return badRange
	}

	*out = n
	return parsed
}

// hasWellPlacedUnderscores reports whether the underscores of s stand
// where a number literal lets them: each between two digits, a base
// prefix counting as a digit.
func hasWellPlacedUnderscores(s ref string) bool {
	i := 0
	if s.Len() >= 1 && (s[0] == minusSign || s[0] == plusSign) {
		i = 1
	}

	// What came last: a digit, an underscore, or anything else, the
	// start included.
	digit := false
	underscore := false
	hex := false
	if s.Len()-i >= 2 && s[i] == '0' {
		c := s[i+1] | lowerCaseBit
		if c == binaryPrefix || c == octalPrefix || c == hexPrefix {
			i += 2
			digit = true
			hex = c == hexPrefix
		}
	}

	for i < s.Len() {
		c := s[i]
		i++
		if (c >= '0' && c <= '9') || (hex && (c|lowerCaseBit) >= 'a' && (c|lowerCaseBit) <= 'f') {
			digit = true
			underscore = false
		} else if c == digitSeparator {
			if !digit {
				return false
			}

			digit = false
			underscore = true
		} else {
			if underscore {
				return false
			}

			digit = false
		}
	}

	return !underscore
}

// parseFloat reads s into out and returns parsed, or badSyntax when s
// is not a number and badRange when it does not fit an f64. The
// runtime provides it.
func parseFloat(s ref string, out mut f64) int

// parseFloat32 reads s into out as parseFloat does, the f32 nearest
// the number. The runtime provides it.
func parseFloat32(s ref string, out mut f32) int

// unquote returns the text the literal s stands for and sets ok, or
// clears it when s is no literal. The runtime provides it.
func unquote(s ref string, ok mut bool) string

// formatBits writes u in a base from 2 to 36, after a minus sign when
// neg says so. The runtime provides it.
func formatBits(u u64, base int, neg bool) string

// formatFixed writes f with prec digits after the point, prec not
// negative. The runtime provides it.
func formatFixed(f f64, prec int) string

// appendBits writes u in the base given after a minus sign when neg
// says so, after the bytes of b. The runtime provides it.
func appendBits(b mut []byte, u u64, base int, neg bool)

// appendString appends the bytes of s to b in one copy, growing b once.
// The runtime provides it.
func appendString(b mut []byte, s ref string)

// appendFloat writes f in its shortest form, as an f32 when single says
// so, after the bytes of b. The runtime provides it.
func appendFloat(b mut []byte, f f64, single bool)

// appendFixed writes f with prec digits after the point, prec not
// negative, after the bytes of b. The runtime provides it.
func appendFixed(b mut []byte, f f64, prec int)
