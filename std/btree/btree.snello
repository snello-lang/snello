// Package btree is an ordered map and an ordered set: a Map keeps its
// keys in the order of their Cmp, and a Set its values, so a range over
// either walks them least first, First and Last read the ends, PopFirst
// and PopLast take them, and Range and From walk from a given key. A
// hash map finds a key in constant time but holds its keys in the
// order they were inserted; this one finds a key in O(log n)
// comparisons and keeps them sorted.
//
// Both are B-trees: the keys lie in nodes of up to maxKeys each, sorted,
// an inner node holding one child between each two keys and at each
// end, every leaf at the same depth, and every node but the root at
// least half full. A key is found by a scan of each node's keys from
// the root down, the last key first, so a key greater than a node's
// keys passes it in one comparison and a tree of a million keys is six
// nodes deep. An insertion splits a full node on the way down, moving
// its middle key into the parent, and a removal gives a node too empty
// a key from a sibling or merges it with one on the way down, so
// neither walks back up and neither recurses.
//
// A node's keys lie in one block of slots and its values in another,
// which hold an element or nothing, which no value of the language can
// say without a tag beside each element, so the blocks are the
// compiler's to read and write for this package alone, as a deque's
// buffer is: the node's count says which slots hold an element, every
// slot is written only when it holds nothing and read only when it
// holds one, and a slot costs the element alone. The nodes are owned by
// the tree in numbered slots, a node naming its children by their
// numbers, so no pointer is needed and a slot emptied is used again.
package btree

import ("fmt"; "iter")

// The keys a node holds: at most maxKeys, and at least minKeys unless it
// is the root; maxKeys is odd so that a full node splits into two of
// minKeys with the middle key moving up. Fifteen measured fastest on a
// million ints, against eleven, nineteen, twenty-three and thirty-one:
// a node's keys fill two cache lines, the scan over them is short, and
// the tree is six nodes deep.
const maxKeys = 15
const minKeys = maxKeys / 2

// noNode is the number of no node: an empty walk's end, and a search
// that found nothing.
const noNode = -1

// A Map holds one value per key, the keys in the order of their Cmp,
// for a K that is Ord. It owns its keys and values and lends them for
// reading or changing. It is moved, or lent with ref and mut; when it
// goes out of scope, the keys and values are dropped with it. It has
// no zero value, as no type that frees what it holds has: one comes
// from New.
//
//	m := btree.New<string, int>()
//	m.Insert("b".Clone(), 2)
//	m.Insert("a".Clone(), 1)
//	for k, v := range ref m { ... } // a 1, then b 2
//
// A Map prints as map[a:1 b:2], its entries in key order. It is Send
// when K and V are, so it may be sent to another task whole.
struct Map<K: Ord, V> impl Drop, fmt.Stringer {
	keyType [0]*K  // holds nothing: it gives the map its keys' type, so that it is Send as they are, and a pointer, so that a type may hold a Map of itself
	valType [0]*V  // the same for the values
	nodes   []node // the tree's nodes, by number; a released one holds no blocks
	free    []int  // the numbers of the nodes released, to use again
	root    int    // the number of the root, when nodes is not empty
	len     int    // the entries
}

// A Set holds each value once, the values in the order of their Cmp, for
// a T that is Ord. It owns its values and lends them for reading. It is
// moved, or lent with ref and mut; when it goes out of scope, the
// values are dropped with it. It has no zero value: one comes from
// NewSet.
//
//	s := btree.NewSet<int>()
//	s.Insert(3)
//	s.Insert(1)
//	for v := range ref s { ... } // 1, then 3
//
// A Set is a Map of its values to nothing, and prints as set[1 3].
struct Set<T: Ord> impl fmt.Stringer {
	m Map<T, ()>
}

// An Iter walks a map's entries in key order, lending each key and
// value as a pair; it lends the map for as long as it lives, so the map
// cannot change during the walk. Map.Iter, Map.Range and Map.From make
// one, and the adapters of iter.Iterator wrap it.
struct Iter<K: Ord, V> impl iter.Iterator<(ref K, ref V)> {
	m   ref Map<K, V>
	cur cursor
}

// A SetIter walks a set's values in order, lending each; it lends the
// set for as long as it lives. Set.Iter, Set.Range and Set.From make
// one, and the adapters of iter.Iterator wrap it.
struct SetIter<T: Ord> impl iter.Iterator<ref T> {
	m   ref Map<T, ()>
	cur cursor
}

// A node holds up to maxKeys keys, sorted, in the slots 0 to n-1 of its
// keys block, a value for each in its vals block, and, when it is not a
// leaf, one child for each key and one more: the keys of children[i]
// are less than key i, and those of children[i+1] greater. A leaf holds
// no children. A released node holds no blocks: keys is 0.
struct node {
	keys     int
	vals     int
	n        int
	children []int
}

// A cursor is where a walk over a map stands: the leaf whose entries
// are being given and the next of them, the path of inner nodes above
// it, each at the key to give once the child below it is done, and the
// entry the walk stops at, or none for the end of the map. It holds no
// borrow, so the Iter and SetIter that hold one call it on a map they
// lend; the common step, the next entry of the same leaf, reads the
// cursor alone.
struct cursor {
	leaf    int // the leaf being given, or noNode once it is done
	keys    int // the leaf's blocks, read once for all its entries
	vals    int
	at      int // the next entry of the leaf
	count   int // the leaf's entries
	path    []step
	endNode int // the node of the entry the walk stops at, or noNode
	endAt   int
}

// A step of a cursor's path: an inner node, and the key in it to give
// once the child before that key is done, n once its keys are given.
struct step impl Copy {
	node int
	at   int
}

// A place is an entry a walk gives: the blocks of the node holding it
// and its slot in them.
struct place impl Copy {
	keys int
	vals int
	at   int
}

// New returns an empty map of K to V, which allocates nothing until the
// first Insert.
func New<K: Ord, V>() Map<K, V> {
	return Map<K, V>{keyType: [0]*K{}, valType: [0]*V{}, nodes: []node{}, free: []int{}, root: 0, len: 0}
}

// NewSet returns an empty set of T, which allocates nothing until the
// first Insert.
func NewSet<T: Ord>() Set<T> {
	return Set<T>{m: New<T, ()>()}
}

// Len returns how many entries the map holds.
func (m ref Map<K, V>) Len() int {
	return m.len
}

// IsEmpty reports whether the map holds no entry.
func (m ref Map<K, V>) IsEmpty() bool {
	return m.len == 0
}

// Insert puts v under k, which the map takes and owns from then on, and
// returns the value that was under k, or None when k is new. A key
// already present keeps its place and its own key; the k given is
// dropped. It costs O(log n) comparisons, one a node when k is greater
// than every key so far, and the split of a full node on the way down,
// which allocates a node; a full root splits into three.
//
//	if old := m.Insert(k, v) { ... } // k was there, with old
func (m mut Map<K, V>) Insert(k K, v V) V? {
	if len(m.nodes) == 0 {
		m.root = m.newNode(true)
	}

	if m.nodes[m.root].n == maxKeys {
		top := m.newNode(false)
		m.nodes[top].children.Push(m.root)
		m.root = top
		m.split(top, 0)
	}

	n := m.root
	for {
		i, found := m.search(n, ref k)
		if found {
			return Some(m.exchange(n, i, v))
		}

		if len(m.nodes[n].children) == 0 {
			m.insertAt(n, i, k, v)
			m.len++
			return None
		}

		child := m.nodes[n].children[i]
		if m.nodes[child].n == maxKeys {
			m.split(n, i)
			match k.Cmp(m.key(n, i)) {
				Equal => { return Some(m.exchange(n, i, v)) },
				Greater => { i++ },
				Less => {},
			}

			child = m.nodes[n].children[i]
		}

		n = child
	}
}

// Get lends the value under k, or returns None when k is absent. The
// borrow lasts as long as the map's. It costs O(log n) comparisons.
//
//	if v := m.Get("port") { ... }
func (m ref Map<K, V>) Get(k ref K) ref V? {
	n, i := m.find(k) ?? return None
	return Some(m.val(n, i))
}

// GetMut lends the value under k for changing, or returns None when k
// is absent. The borrow keeps the map lent mut for as long as it lives.
//
//	if n := counts.GetMut(ref word) { *n += 1 }
func (m mut Map<K, V>) GetMut(k ref K) mut V? {
	n, i := m.find(k) ?? return None
	return Some(rawMut<V, Map<K, V>>(m.nodes[n].vals, i, m))
}

// Contains reports whether k has an entry, in O(log n) comparisons.
func (m ref Map<K, V>) Contains(k ref K) bool {
	return m.find(k).IsSome()
}

// Remove takes the entry under k out and returns its value, owned, or
// None when k is absent; the key is dropped. It costs O(log n)
// comparisons and, on the way down, a key moved from a sibling or two
// nodes merged where a node would fall below half full.
func (m mut Map<K, V>) Remove(k ref K) V? {
	if m.len == 0 {
		return None
	}

	n := m.root
	for {
		i, found := m.search(n, k)
		if len(m.nodes[n].children) == 0 {
			if !found {
				return None
			}

			_, v := m.removeAt(n, i)
			m.shrink()
			return Some(v)
		}

		if found {
			return Some(m.removeInner(n, i))
		}

		n = m.descend(n, i)
	}
}

// First lends the least entry, its key and its value, or returns None
// when the map is empty. The borrows last as long as the map's. It
// costs O(log n) steps and no comparison.
func (m ref Map<K, V>) First() (ref K, ref V)? {
	if m.len == 0 {
		return None
	}

	n := m.leftmost(m.root)
	return Some((m.key(n, 0), m.val(n, 0)))
}

// Last lends the greatest entry, its key and its value, or returns None
// when the map is empty. The borrows last as long as the map's.
func (m ref Map<K, V>) Last() (ref K, ref V)? {
	if m.len == 0 {
		return None
	}

	n := m.rightmost(m.root)
	last := m.nodes[n].n - 1
	return Some((m.key(n, last), m.val(n, last)))
}

// PopFirst takes the least entry out and returns its key and value,
// owned, or None when the map is empty. It costs O(log n) steps, with a
// node refilled from a sibling or merged where one would fall below
// half full.
//
//	k, v := m.PopFirst() ?? return
func (m mut Map<K, V>) PopFirst() (K, V)? {
	if m.len == 0 {
		return None
	}

	k, v := m.popEnd(m.root, true)
	m.shrink()
	return Some((k, v))
}

// PopLast takes the greatest entry out and returns its key and value,
// owned, or None when the map is empty. It costs what PopFirst costs.
func (m mut Map<K, V>) PopLast() (K, V)? {
	if m.len == 0 {
		return None
	}

	k, v := m.popEnd(m.root, false)
	m.shrink()
	return Some((k, v))
}

// Clear drops every entry and frees the nodes they were held in.
func (m mut Map<K, V>) Clear() {
	m.dropAll()
	m.nodes = []node{}
	m.free = []int{}
	m.root = 0
	m.len = 0
}

// Drop drops the entries still in the map and frees its nodes' blocks.
// The compiler calls it when the map goes out of scope; a program does
// not call it.
func (m mut Map<K, V>) Drop() {
	m.dropAll()
}

// dropAll drops the entries of every node still placed and frees the
// nodes' blocks.
func (m mut Map<K, V>) dropAll() {
	for n := 0; n < len(m.nodes); n++ {
		if m.nodes[n].keys == 0 {
			continue // released already
		}

		for i := 0; i < m.nodes[n].n; i++ {
			_ = rawTake<K>(m.nodes[n].keys, i)
			_ = rawTake<V>(m.nodes[n].vals, i)
		}

		m.nodes[n].n = 0
		m.release(n)
	}
}

// Iter returns a walk over every entry in key order, lending each key
// and value for as long as the map is lent; nothing is copied. A range
// over the map lent walks through it: for k, v := range ref m.
//
//	for k, v := range ref m { ... }
//	n := m.Iter().Count()
func (m ref Map<K, V>) Iter() Iter<K, V> {
	c := newCursor()
	c.start(m)
	return Iter<K, V>{m: m, cur: c}
}

// Range returns a walk over the entries whose keys are at least from
// and less than to, in key order, lending each for as long as the map
// is lent; it is empty when from is not less than to. Finding the two
// ends costs O(log n) comparisons each, and the walk then costs what
// Iter costs over the entries between.
//
//	for k, v := range m.Range("b", "f") { ... } // b up to but not f
func (m ref Map<K, V>) Range(from ref K, to ref K) Iter<K, V> {
	c := newCursor()
	if from.Cmp(to) == Less {
		c.seek(m, from)
		endNode, endAt := m.position(to)
		c.endNode = endNode
		c.endAt = endAt
	}

	return Iter<K, V>{m: m, cur: c}
}

// From returns a walk over the entries whose keys are at least from, in
// key order, to the end of the map, lending each for as long as the map
// is lent. Finding the start costs O(log n) comparisons.
//
//	for k, v := range m.From("m") { ... } // from m on
func (m ref Map<K, V>) From(from ref K) Iter<K, V> {
	c := newCursor()
	c.seek(m, from)
	return Iter<K, V>{m: m, cur: c}
}

// String returns the entries in key order as a new string, written as a
// map is printed, each key and value by fmt.Sprint: map[a:1 b:2]. It is
// how fmt prints a Map.
func (m ref Map<K, V>) String() string {
	out := "map["
	sep := ""
	for k, v := range m {
		out = out + sep + fmt.Sprint(k) + ":" + fmt.Sprint(v)
		sep = " "
	}

	return out + "]"
}

// Len returns how many values the set holds.
func (s ref Set<T>) Len() int {
	return s.m.len
}

// IsEmpty reports whether the set holds no value.
func (s ref Set<T>) IsEmpty() bool {
	return s.m.len == 0
}

// Insert adds v, which the set takes and owns from then on, and reports
// whether it was new; a value already in the set is left as it was, and
// v is dropped. It costs O(log n) comparisons.
//
//	if !s.Insert(name) { ... } // name was there already
func (s mut Set<T>) Insert(v T) bool {
	return s.m.Insert(v, ()).IsNone()
}

// Contains reports whether v is in the set, in O(log n) comparisons.
func (s ref Set<T>) Contains(v ref T) bool {
	return s.m.Contains(v)
}

// Remove takes v out of the set, dropping the set's value, and reports
// whether it was there. It costs what Map.Remove costs.
func (s mut Set<T>) Remove(v ref T) bool {
	return s.m.Remove(v).IsSome()
}

// First lends the least value, or returns None when the set is empty.
func (s ref Set<T>) First() ref T? {
	k, _ := s.m.First() ?? return None
	return Some(k)
}

// Last lends the greatest value, or returns None when the set is empty.
func (s ref Set<T>) Last() ref T? {
	k, _ := s.m.Last() ?? return None
	return Some(k)
}

// PopFirst takes the least value out and returns it, owned, or None
// when the set is empty.
func (s mut Set<T>) PopFirst() T? {
	k, _ := s.m.PopFirst() ?? return None
	return Some(k)
}

// PopLast takes the greatest value out and returns it, owned, or None
// when the set is empty.
func (s mut Set<T>) PopLast() T? {
	k, _ := s.m.PopLast() ?? return None
	return Some(k)
}

// Clear drops every value and frees the nodes they were held in.
func (s mut Set<T>) Clear() {
	s.m.Clear()
}

// Iter returns a walk over every value in order, lending each for as
// long as the set is lent. A range over the set lent walks through it:
// for v := range ref s.
func (s ref Set<T>) Iter() SetIter<T> {
	c := newCursor()
	c.start(ref s.m)
	return SetIter<T>{m: ref s.m, cur: c}
}

// Range returns a walk over the values at least from and less than to,
// in order; it is empty when from is not less than to.
func (s ref Set<T>) Range(from ref T, to ref T) SetIter<T> {
	c := newCursor()
	if from.Cmp(to) == Less {
		c.seek(ref s.m, from)
		endNode, endAt := s.m.position(to)
		c.endNode = endNode
		c.endAt = endAt
	}

	return SetIter<T>{m: ref s.m, cur: c}
}

// From returns a walk over the values at least from, in order, to the
// end of the set.
func (s ref Set<T>) From(from ref T) SetIter<T> {
	c := newCursor()
	c.seek(ref s.m, from)
	return SetIter<T>{m: ref s.m, cur: c}
}

// String returns the values in order as a new string, written as a
// slice of them is printed, each by fmt.Sprint: set[1 2 3]. It is how
// fmt prints a Set.
func (s ref Set<T>) String() string {
	out := "set["
	sep := ""
	for v := range s {
		out = out + sep + fmt.Sprint(v)
		sep = " "
	}

	return out + "]"
}

// Next lends the next entry of the walk, its key and its value, or None
// once every entry up to the walk's end has been given. The borrows are
// of the map, not of the Iter, so they stay good while the walk goes
// on and for as long as the map is lent.
func (it mut Iter<K, V>) Next() (ref K, ref V)? {
	e := it.cur.next(it.m) ?? return None
	return Some((rawRef<K, Map<K, V>>(e.keys, e.at, it.m), rawRef<V, Map<K, V>>(e.vals, e.at, it.m)))
}

// Next lends the next value of the walk, or None once every value up to
// the walk's end has been given. The borrow is of the set, not of the
// SetIter.
func (it mut SetIter<T>) Next() ref T? {
	e := it.cur.next(it.m) ?? return None
	return Some(rawRef<T, Map<T, ()>>(e.keys, e.at, it.m))
}

// key lends the key i of the node n. The borrow is the map's.
func (m ref Map<K, V>) key(n int, i int) ref K {
	return rawRef<K, Map<K, V>>(m.nodes[n].keys, i, m)
}

// val lends the value i of the node n. The borrow is the map's.
func (m ref Map<K, V>) val(n int, i int) ref V {
	return rawRef<V, Map<K, V>>(m.nodes[n].vals, i, m)
}

// search returns the place in node n of the first key not less than k,
// n's count when every key is less, and whether the key there is k. The
// last key is read first, so a key greater than the node's keys, which
// every key is when they come in order, passes the node in one
// comparison; else the keys are read in order up to the first not less
// than k. Over a node's few keys the scan is faster than a binary
// search, whose branches go either way and cannot be predicted, where
// the scan's go one way until the end; a binary search written without
// a branch on the outcome measured slower still.
func (m ref Map<K, V>) search(n int, k ref K) (int, bool) {
	count := m.nodes[n].n
	if count == 0 {
		return (0, false)
	}

	keys := m.nodes[n].keys
	match rawRef<K, Map<K, V>>(keys, count-1, m).Cmp(k) {
		Less => { return (count, false) },
		Equal => { return (count - 1, true) },
		Greater => {},
	}

	for i := 0; i < count-1; i++ {
		match rawRef<K, Map<K, V>>(keys, i, m).Cmp(k) {
			Less => {},
			Equal => { return (i, true) },
			Greater => { return (i, false) },
		}
	}

	return (count - 1, false)
}

// find returns the node and the place of the entry under k, or None
// when k is absent: the search from the root down.
func (m ref Map<K, V>) find(k ref K) (int, int)? {
	if m.len == 0 {
		return None
	}

	n := m.root
	for {
		i, found := m.search(n, k)
		if found {
			return Some((n, i))
		}

		if len(m.nodes[n].children) == 0 {
			return None
		}

		n = m.nodes[n].children[i]
	}
}

// position returns the node and the place of the first entry whose key
// is not less than k, or noNode when every key is less: where a walk
// from k starts, and where one up to k stops.
func (m ref Map<K, V>) position(k ref K) (int, int) {
	c := newCursor()
	c.seek(m, k)
	return c.peek(m) ?? return (noNode, 0)
}

// leftmost returns the leaf holding the least key under n: the first
// child, down to a leaf.
func (m ref Map<K, V>) leftmost(n int) int {
	for len(m.nodes[n].children) > 0 {
		n = m.nodes[n].children[0]
	}

	return n
}

// rightmost returns the leaf holding the greatest key under n: the last
// child, down to a leaf.
func (m ref Map<K, V>) rightmost(n int) int {
	for len(m.nodes[n].children) > 0 {
		n = m.nodes[n].children[len(m.nodes[n].children)-1]
	}

	return n
}

// newNode places a new leaf, or inner node, its blocks holding nothing
// and, when it is not a leaf, room for its children, and returns its
// number.
func (m mut Map<K, V>) newNode(leaf bool) int {
	children := []int{}
	if !leaf {
		children = make([]int, 0, maxKeys+1)
	}

	fresh := node{keys: rawAlloc<K>(maxKeys), vals: rawAlloc<V>(maxKeys), n: 0, children: children}
	if n := m.free.Pop() {
		m.nodes[n] = fresh
		return n
	}

	m.nodes.Push(fresh)
	return len(m.nodes) - 1
}

// release frees the blocks of the node n, whose slots hold nothing, and
// gives its number back to free.
func (m mut Map<K, V>) release(n int) {
	rawFree(m.nodes[n].keys)
	rawFree(m.nodes[n].vals)
	m.nodes[n].keys = 0
	m.nodes[n].vals = 0
	m.free.Push(n)
}

// insertAt puts the entry k, v in the node n at i, moving the entries
// from i on up by one; n has room.
func (m mut Map<K, V>) insertAt(n int, i int, k K, v V) {
	count := m.nodes[n].n
	keys, vals := m.nodes[n].keys, m.nodes[n].vals
	if i < count { // the entries from i on one slot up, as one block each
		rawMove<K>(keys, i+1, keys, i, count-i)
		rawMove<V>(vals, i+1, vals, i, count-i)
	}

	rawPut<K>(keys, i, k)
	rawPut<V>(vals, i, v)
	m.nodes[n].n = count + 1
}

// removeAt takes the entry i out of the node n and returns it, moving
// the entries after it down by one.
func (m mut Map<K, V>) removeAt(n int, i int) (K, V) {
	count := m.nodes[n].n
	keys, vals := m.nodes[n].keys, m.nodes[n].vals
	k := rawTake<K>(keys, i)
	v := rawTake<V>(vals, i)
	if i < count-1 { // the entries after i one slot down, as one block each
		rawMove<K>(keys, i, keys, i+1, count-i-1)
		rawMove<V>(vals, i, vals, i+1, count-i-1)
	}

	m.nodes[n].n = count - 1
	return (k, v)
}

// exchange puts v in place of the value i of the node n and returns the
// value that was there, owned.
func (m mut Map<K, V>) exchange(n int, i int, v V) V {
	old := rawTake<V>(m.nodes[n].vals, i)
	rawPut<V>(m.nodes[n].vals, i, v)
	return old
}

// replaceKey puts k in place of the key i of the node n, dropping the
// key that was there: the keys compare Equal, or the entry is replaced
// whole with its value.
func (m mut Map<K, V>) replaceKey(n int, i int, k K) {
	_ = rawTake<K>(m.nodes[n].keys, i)
	rawPut<K>(m.nodes[n].keys, i, k)
}

// split splits the full child i of the node n into two of minKeys keys,
// moving the middle key and its value up into n at i and the new right
// half in as child i+1.
func (m mut Map<K, V>) split(n int, i int) {
	left := m.nodes[n].children[i]
	right := m.newNode(len(m.nodes[left].children) == 0)

	// The upper half of the entries, and of the children, go to the new node.
	rawMove<K>(m.nodes[right].keys, 0, m.nodes[left].keys, minKeys+1, minKeys)
	rawMove<V>(m.nodes[right].vals, 0, m.nodes[left].vals, minKeys+1, minKeys)
	m.nodes[right].n = minKeys
	if len(m.nodes[left].children) > 0 {
		m.nodes[right].children = splitOff(mut m.nodes[left].children, minKeys+1)
	}

	// The middle entry goes up into the parent, the new node beside it.
	k := rawTake<K>(m.nodes[left].keys, minKeys)
	v := rawTake<V>(m.nodes[left].vals, minKeys)
	m.nodes[left].n = minKeys
	m.insertAt(n, i, k, v)
	m.nodes[n].children.Insert(i+1, right)
}

// descend returns the child i of the node n to go on down into for a
// removal, refilled first when it holds only minKeys keys, so that a
// key can leave it: a key comes down from n and one up from a sibling
// that can spare one, else the child is merged with a sibling, and the
// merged node is returned.
func (m mut Map<K, V>) descend(n int, i int) int {
	child := m.nodes[n].children[i]
	if m.nodes[child].n > minKeys {
		return child
	}

	siblings := len(m.nodes[n].children)
	if i > 0 && m.nodes[m.nodes[n].children[i-1]].n > minKeys {
		m.rotateRight(n, i-1)
		return child
	}

	if i+1 < siblings && m.nodes[m.nodes[n].children[i+1]].n > minKeys {
		m.rotateLeft(n, i)
		return child
	}

	if i+1 < siblings {
		return m.merge(n, i)
	}

	return m.merge(n, i-1)
}

// removeInner takes out the entry at i of the inner node n and returns
// its value: the entry is replaced by the greatest of its left subtree
// or the least of its right, whichever child can spare one; when
// neither can, the two children are merged with the entry between them
// and the removal goes on in the merged node, where the entry now sits
// in the middle.
func (m mut Map<K, V>) removeInner(n int, i int) V {
	for len(m.nodes[n].children) > 0 {
		left := m.nodes[n].children[i]
		right := m.nodes[n].children[i+1]
		if m.nodes[left].n > minKeys {
			k, v := m.popEnd(left, false)
			m.replaceKey(n, i, k)
			old := m.exchange(n, i, v)
			m.shrink()
			return old
		}

		if m.nodes[right].n > minKeys {
			k, v := m.popEnd(right, true)
			m.replaceKey(n, i, k)
			old := m.exchange(n, i, v)
			m.shrink()
			return old
		}

		n = m.merge(n, i)
		i = minKeys
	}

	_, old := m.removeAt(n, i)
	m.shrink()
	return old
}

// popEnd takes the least entry under the node n out, or the greatest
// when first is false, refilling nodes on the way down as a removal
// does, and returns it; the map's count is the caller's to settle.
func (m mut Map<K, V>) popEnd(n int, first bool) (K, V) {
	for len(m.nodes[n].children) > 0 {
		i := 0
		if !first {
			i = len(m.nodes[n].children) - 1
		}

		n = m.descend(n, i)
	}

	if first {
		return m.removeAt(n, 0)
	}

	return m.removeAt(n, m.nodes[n].n-1)
}

// rotateRight moves one entry from the child i of n to its right
// neighbour, child i+1: the entry at i of n goes down to the front of
// the right child, the last entry of the left child comes up to i, and
// the left child's last child goes with it.
func (m mut Map<K, V>) rotateRight(n int, i int) {
	left := m.nodes[n].children[i]
	right := m.nodes[n].children[i+1]

	k, v := m.removeAt(left, m.nodes[left].n-1)
	downK := rawTake<K>(m.nodes[n].keys, i)
	rawPut<K>(m.nodes[n].keys, i, k)
	downV := m.exchange(n, i, v)

	m.insertAt(right, 0, downK, downV)
	if c := m.nodes[left].children.Pop() {
		m.nodes[right].children.Insert(0, c)
	}
}

// rotateLeft moves one entry from the child i+1 of n to its left
// neighbour, child i: the entry at i of n goes down to the back of the
// left child, the first entry of the right child comes up to i, and
// the right child's first child goes with it.
func (m mut Map<K, V>) rotateLeft(n int, i int) {
	left := m.nodes[n].children[i]
	right := m.nodes[n].children[i+1]

	k, v := m.removeAt(right, 0)
	downK := rawTake<K>(m.nodes[n].keys, i)
	rawPut<K>(m.nodes[n].keys, i, k)
	downV := m.exchange(n, i, v)

	m.insertAt(left, m.nodes[left].n, downK, downV)
	if len(m.nodes[right].children) > 0 {
		c := m.nodes[right].children.Remove(0)
		m.nodes[left].children.Push(c)
	}
}

// merge joins the children i and i+1 of n into child i, with the entry
// at i of n between them, releases the right node, and returns the
// merged node. A root left with no key is replaced by the merged node.
func (m mut Map<K, V>) merge(n int, i int) int {
	left := m.nodes[n].children[i]
	right := m.nodes[n].children.Remove(i + 1)

	// The entry between the two children comes down to the end of the left one.
	k, v := m.removeAt(n, i)
	m.insertAt(left, m.nodes[left].n, k, v)

	// The right child's entries and children follow it, and the right child is let go.
	count := m.nodes[left].n
	moved := m.nodes[right].n
	rawMove<K>(m.nodes[left].keys, count, m.nodes[right].keys, 0, moved)
	rawMove<V>(m.nodes[left].vals, count, m.nodes[right].vals, 0, moved)
	m.nodes[left].n = count + moved
	m.nodes[right].n = 0
	children := take(mut m.nodes[right].children)
	moveAll(mut m.nodes[left].children, children)
	m.release(right)

	if n == m.root && m.nodes[n].n == 0 {
		m.release(n)
		m.root = left
	}

	return left
}

// shrink settles the map after an entry left it: the count goes down,
// and a map left empty lets its nodes go.
func (m mut Map<K, V>) shrink() {
	m.len--
	if m.len == 0 {
		m.Clear()
	}
}

// newCursor returns a cursor at the end of any map, with no stop.
func newCursor() cursor {
	return cursor{leaf: noNode, keys: 0, vals: 0, at: 0, count: 0, path: []step{}, endNode: noNode, endAt: 0}
}

// start sets the cursor at the least entry of m, the path from the root
// down its first children.
func (c mut cursor) start<K: Ord, V>(m ref Map<K, V>) {
	if m.len == 0 {
		return
	}

	c.descend(m, m.root)
}

// seek sets the cursor at the first entry of m whose key is not less
// than k: the search from the root down, each inner node's place kept
// as a step of the path, which ends at the end of the map when every
// key is less.
func (c mut cursor) seek<K: Ord, V>(m ref Map<K, V>, k ref K) {
	if m.len == 0 {
		return
	}

	n := m.root
	for {
		i, found := m.search(n, k)
		if len(m.nodes[n].children) == 0 {
			c.setLeaf(m, n, i)
			return
		}

		c.path.Push(step{node: n, at: i})
		if found {
			return // the inner entry at i is next; the leaf is done
		}

		n = m.nodes[n].children[i]
	}
}

// next returns the place of the entry the walk gives next, and moves
// the cursor past it, or returns None at the walk's end. The next entry
// of the same leaf costs three comparisons and no read of the map.
func (c mut cursor) next<K: Ord, V>(m ref Map<K, V>) place? {
	if c.at < c.count {
		if c.leaf == c.endNode && c.at == c.endAt {
			c.stop()
			return None
		}

		c.at++
		return Some(place{keys: c.keys, vals: c.vals, at: c.at - 1})
	}

	n, i := c.peek(m) ?? return None
	if n == c.endNode && i == c.endAt {
		c.stop()
		return None
	}

	// An inner entry, at the top of the path: the walk goes on in the
	// child after it.
	c.path[len(c.path)-1].at++
	given := place{keys: m.nodes[n].keys, vals: m.nodes[n].vals, at: i}
	c.descend(m, m.nodes[n].children[i+1])
	return Some(given)
}

// peek returns the node and the place of the entry the walk gives
// next, or None at the end of the map, climbing past the inner nodes
// whose keys are all given once the leaf is done.
func (c mut cursor) peek<K: Ord, V>(m ref Map<K, V>) (int, int)? {
	if c.at < c.count {
		return Some((c.leaf, c.at))
	}

	c.leaf = noNode
	c.count = 0
	for len(c.path) > 0 {
		top := c.path[len(c.path)-1]
		if top.at < m.nodes[top.node].n {
			return Some((top.node, top.at))
		}

		_ = c.path.Pop()
	}

	return None
}

// descend sets the cursor at the least entry under the node n: the
// inner nodes down the first children join the path, each at its first
// key, and the leaf at the bottom is the one being given.
func (c mut cursor) descend<K: Ord, V>(m ref Map<K, V>, n int) {
	for len(m.nodes[n].children) > 0 {
		c.path.Push(step{node: n, at: 0})
		n = m.nodes[n].children[0]
	}

	c.setLeaf(m, n, 0)
}

// setLeaf makes the leaf n the one being given, from its entry at.
func (c mut cursor) setLeaf<K: Ord, V>(m ref Map<K, V>, n int, at int) {
	c.leaf = n
	c.keys = m.nodes[n].keys
	c.vals = m.nodes[n].vals
	c.at = at
	c.count = m.nodes[n].n
}

// stop ends the walk: the leaf is done and the path is empty.
func (c mut cursor) stop() {
	c.leaf = noNode
	c.at = 0
	c.count = 0
	c.path.Clear()
}

// splitOff takes the elements of xs from at on out of it, in order,
// into a new slice with room for maxKeys+1, which it returns.
func splitOff<T>(xs mut []T, at int) []T {
	out := make([]T, 0, maxKeys+1)
	for len(xs) > at {
		out.Push(xs.Pop() ?? break)
	}

	out.Reverse()
	return out
}

// moveAll moves every element of ys onto the end of xs, in order, and
// uses ys up.
func moveAll<T>(xs mut []T, ys []T) {
	ys.Reverse()
	for {
		xs.Push(ys.Pop() ?? break)
	}
}

// rawAlloc makes a block of n slots of T, n above zero, and returns its
// address. The compiler writes it for this package alone, as it writes
// the deque's.
func rawAlloc<T>(n int) int

// rawFree frees the block of slots at p. The compiler writes it.
func rawFree(p int)

// rawPut moves v into the slot i of the block p, which holds nothing.
// The compiler writes it.
func rawPut<T>(p int, i int, v T)

// rawTake moves the element out of the slot i of the block p, which
// holds one. The compiler writes it.
func rawTake<T>(p int, i int) T

// rawRef lends the element in the slot i of the block p, the borrow the
// owner's. The compiler writes it.
func rawRef<T, O>(p int, i int, o ref O) ref T

// rawMut lends the element in the slot i of the block p for changing,
// the borrow the owner's. The compiler writes it.
func rawMut<T, O>(p int, i int, o mut O) mut T

// rawMove moves n elements from the run of slots at si of the block
// src to the run at di of the block dst, which holds nothing, or holds
// elements of the run itself. The compiler writes it.
func rawMove<T>(dst int, di int, src int, si int, n int)
