// Package json writes a value of any type as JSON text and reads JSON
// text into a value, with no code written for the type: Marshal and
// Unmarshal ask which type they were given, with a match on it, and go
// through a struct's fields and an enum's variants, which the compiler
// writes out for each type a program uses them with. Nothing about a
// type is read when the program runs.
//
// A bool, a number and a string are themselves; an option is null or
// its value; an owned pointer the value it points at; a slice is an
// array; a map with string keys is an object, its keys sorted; a struct
// is an object of its fields, under the names they are declared with;
// an enum's variant without fields is its name, "Dot", and one with
// fields an object of one key, {"Rect":{"w":1,"h":2}}.
// A struct of another package is reached through the fields it exports,
// or through all of them when it lists Reflect. Attributes change the
// keys and leave fields out: Name, OmitEmpty and Skip, below.
//
// Reading finds each field of a struct by its key, wherever the text
// puts it, and passes over a key the struct has no field for. A field
// the text leaves out is an error, unless its type is an option, which
// is None, or it declares a default, which it takes. A number its field
// cannot hold is an error, and so is a key given twice, text that is
// not JSON, and arrays and objects nested more than 128 deep.
package json

import ("strconv"; "strings"; "unicode/utf8")

// hex are the digits of a \u escape, by their value.
const hex = "0123456789abcdef"

// The structural characters of JSON text, named as RFC 8259 names them,
// and the quotation mark and escape a string is written with. A match
// arm writes its character itself, since a name there binds.
const beginArray byte = '['
const endArray byte = ']'
const beginObject byte = '{'
const endObject byte = '}'
const nameSeparator byte = ':'
const valueSeparator byte = ','
const quotationMark byte = '"'
const escape byte = '\\'

// Name is the key a field or a variant is written and read under, in
// place of the name it is declared with: Host string @json.Name("host").
type Name string impl FieldAttribute, VariantAttribute

// OmitEmpty leaves a field out of the object it is written in when its
// value is empty, as JSON writes it: None, or an empty string, slice or
// map. A number, a bool and a struct are never empty. Read, a field
// whose key is missing takes its default, or the empty value it was
// left out for, so what is written reads back.
struct OmitEmpty impl FieldAttribute {}

// Skip leaves a field out of JSON: it is never written, and read, it
// takes its default, or the empty value of its type, None, "", [] or {},
// whatever the text holds. A skipped field of another type declares a
// default, or reading it is an error. On a variant, Skip and OmitEmpty
// apply to its named fields; an unnamed field keeps its place.
struct Skip impl FieldAttribute {}

// maxDepth is how deep arrays and objects may nest in the text read, so
// that a text cannot run the stack out: a task's stack does not grow,
// and each level of nesting the reader goes into takes a frame of it.
const maxDepth = 128

// An Error says what in the text could not be read, and where: the
// offset in bytes it was met at. Marshal reports a float that is not a
// number, which JSON cannot write, with an offset of -1.
struct Error impl Error {
	at  int
	msg string
}

// Error returns the message, with the offset when it has one:
// json: expected a value at offset 12.
func (e ref Error) Error() string {
	if e.at < 0 {
		return "json: " + e.msg
	}

	return "json: " + e.msg + " at offset " + strconv.Itoa(e.at)
}

// Offset returns where in the text the error was met, or -1.
func (e ref Error) Offset() int {
	return e.at
}

// Marshal returns v as JSON text: one line, no space between its parts.
func Marshal<T>(v ref T) Result<string, Error> {
	w := writer{out: strings.Builder{}, bad: None}
	write(v, mut w)
	if msg := take(mut w.bad) {
		return Err(Error{at: -1, msg: msg})
	}

	return Ok(w.out.String())
}

// Unmarshal reads a value of T from JSON text, which holds that value
// alone, with space around it.
func Unmarshal<T>(text ref string) Result<T, Error> {
	r := reader{text: text, at: 0, first: false, depth: 0, ends: map[int]int{}}
	v := read<T>(mut r)?
	r.space()
	if r.at < len(r.text) {
		return Err(r.fail("text after the value"))
	}

	return Ok(v)
}

// A writer is the text written so far, and the first thing it could not
// write, which ends the writing.
struct writer {
	out strings.Builder
	bad string?
}

func write<T>(v ref T, w mut writer) {
	match T {
		bool => w.out.WriteString(if v { "true" } else { "false" }),
		i8 | i16 | i32 | i64 | int => w.out.WriteString(strconv.Itoa(int(v))),
		u8 | u16 | u32 | u64 | uint => w.out.WriteString(strconv.FormatUint(uint(v), 10) ?? ""),
		f32 => writeFloat(f64(v), strconv.FormatFloat32(v, -1), mut w),
		f64 => writeFloat(v, strconv.FormatFloat(v, -1), mut w),
		*E => write(ref **v, mut w),
		string => quote(v, mut w.out),
		E? => match v {
			Some(x) => write(x, mut w),
			None => w.out.WriteString("null"),
		},
		[]E => {
			w.out.WriteByte(beginArray)
			for i, e := range v {
				if i > 0 {
					w.out.WriteByte(valueSeparator)
				}

				write(e, mut w)
			}

			w.out.WriteByte(endArray)
		}
		map[K]V => match K {
			string => {
				keys := make([]string, 0, len(v))
				for k, _ := range v {
					keys.Push(k.Clone())
				}

				keys.Sort()
				w.out.WriteByte(beginObject)
				for i, k := range ref keys {
					if i > 0 {
						w.out.WriteByte(valueSeparator)
					}

					quote(k, mut w.out)
					w.out.WriteByte(nameSeparator)
					if x := v.Get(k) {
						write(x, mut w)
					}
				}

				w.out.WriteByte(endObject)
			}
		},
		struct => {
			w.out.WriteByte(beginObject)
			first := true
			for f := range fields(T) {
				if attr(f, Skip).IsNone() && !(attr(f, OmitEmpty).IsSome() && empty(ref v.[f])) {
					if !first {
						w.out.WriteByte(valueSeparator)
					}

					first = false
					quote(ref keyOf(attr(f, Name), f.name), mut w.out)

					w.out.WriteByte(nameSeparator)
					write(ref v.[f], mut w)
				}
			}

			w.out.WriteByte(endObject)
		}
		enum => match v {
			for c := range variants(T) => {
				n, named := 0, false
				for f := range fields(c) {
					n += 1
					named = f.name != ""
				}

				if n == 0 {
					quote(ref keyOf(attr(c, Name), c.name), mut w.out)

					return
				}

				w.out.WriteByte(beginObject)
				quote(ref keyOf(attr(c, Name), c.name), mut w.out)

				w.out.WriteByte(nameSeparator)
				if named {
					w.out.WriteByte(beginObject)
				} else if n > 1 {
					w.out.WriteByte(beginArray)
				}

				first := true
				for f := range fields(c) {
					if !named || attr(f, Skip).IsNone() && !(attr(f, OmitEmpty).IsSome() && empty(ref v.[f])) { // a named field is left out as a struct's is; an unnamed one keeps its place
						if !first {
							w.out.WriteByte(valueSeparator)
						}

						first = false
						if named {
							quote(ref keyOf(attr(f, Name), f.name), mut w.out)

							w.out.WriteByte(nameSeparator)
						}

						write(ref v.[f], mut w)
					}
				}

				if named {
					w.out.WriteByte(endObject)
				} else if n > 1 {
					w.out.WriteByte(endArray)
				}

				w.out.WriteByte(endObject)
			}
		},
	}
}

// keyOf is the key a field or a variant is written and read under: its
// Name attribute, or the name it is declared with.
func keyOf(name Name?, declared string) string {
	return match name {
		Some(k) => string(k),
		None => declared,
	}
}

// empty reports whether v is a value OmitEmpty leaves out: None, or an
// empty string, slice or map, which JSON writes as null, "", [] or {}.
func empty<T>(v ref T) bool {
	return match T {
		E? => v.IsNone(),
		string => len(v) == 0,
		[]E => len(v) == 0,
		map[K]V => len(v) == 0,
		_ => false,
	}
}

// omitted returns the empty value of T that OmitEmpty leaves out, when
// omit says the field has it, read for a key that is missing; None for
// a type with no empty value, or a field without OmitEmpty.
func omitted<T>(omit bool) T? {
	if !omit {
		return None
	}

	return match T {
		string => Some(""),
		[]E => Some([]E{}),
		map[K]V => Some(map[K]V{}),
		_ => None,
	}
}

// writeFloat writes f, whose shortest text is short: in plain decimals
// from 1e-6 up to 1e21, and with an exponent outside, its leading zero
// dropped, 1e-7; or notes that JSON has no text for it, a NaN or an
// infinity.
func writeFloat(f f64, short ref string, w mut writer) {
	if f != f || f > 1.7976931348623157e308 || f < -1.7976931348623157e308 {
		if w.bad == None {
			w.bad = Some("unsupported value: " + short)
		}

		w.out.WriteString("null")
		return
	}

	abs := if f < 0.0 { -f } else { f }
	e := short.Index("e") ?? -1
	if e < 0 {
		w.out.WriteString(short)
		return
	}

	if abs < 1e-6 || abs >= 1e21 {
		w.out.WriteString(short[0:e + 1])
		rest := short[e + 1:len(short)]
		if rest[0] == '-' && len(rest) > 2 && rest[1] == '0' {
			w.out.WriteByte('-')
			w.out.WriteString(rest[2:len(rest)])
		} else {
			w.out.WriteString(rest)
		}

		return
	}

	plain(short, e, mut w.out)
}

// plain writes the shortest text short of a float in plain decimals: its
// digits, before e, moved by the exponent after it.
func plain(short ref string, e int, out mut strings.Builder) {
	exp := strconv.Atoi(short[e + 1:len(short)]) ?? 0
	start := 0
	if short[0] == '-' {
		out.WriteByte('-')
		start = 1
	}

	digits := strings.Builder{}
	point := -1
	for i := start; i < e; i++ {
		if short[i] == '.' {
			point = digits.Len()
		} else {
			digits.WriteByte(short[i])
		}
	}

	d := digits.String()
	if point < 0 {
		point = len(d)
	}

	point += exp
	if point <= 0 {
		out.WriteString("0.")
		for i := 0; i < -point; i++ {
			out.WriteByte('0')
		}

		out.WriteString(d)
		return
	}

	if point >= len(d) {
		out.WriteString(d)
		for i := len(d); i < point; i++ {
			out.WriteByte('0')
		}

		return
	}

	out.WriteString(d[0:point])
	out.WriteByte('.')
	out.WriteString(d[point:len(d)])
}

// quote writes s as a JSON string: the quote, the backslash and every
// control character escaped, the runs of other bytes between them as
// they are, each run in one write.
func quote(s ref string, out mut strings.Builder) {
	out.WriteByte(quotationMark)
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c >= 0x80 { // a rune of several bytes, written as it is; a byte that starts none is U+FFFD
			r, size := utf8.DecodeRuneInString(s[i:len(s)])
			if r != utf8.RuneError || size > 1 {
				i += size - 1
				continue
			}

			if start < i {
				out.WriteString(s[start:i])
			}

			out.WriteString("\\ufffd")
			start = i + 1
			continue
		}

		if c >= 0x20 && c != quotationMark && c != escape {
			continue
		}

		if start < i {
			out.WriteString(s[start:i])
		}

		match c {
			'"' => out.WriteString("\\\""),
			'\\' => out.WriteString("\\\\"),
			'\n' => out.WriteString("\\n"),
			'\r' => out.WriteString("\\r"),
			'\t' => out.WriteString("\\t"),
			_ => {
				out.WriteString("\\u00")
				out.WriteByte(hex[c >> 4])
				out.WriteByte(hex[c & 0xf])
			}
		}

		start = i + 1
	}

	if start < len(s) {
		out.WriteString(s[start:len(s)])
	}

	out.WriteByte(quotationMark)
}

// A reader is the text being read, lent, the offset it has reached,
// and whether the element of an array of a variant's fields it reads
// next is the first, which no comma comes before.
struct reader {
	text  ref string
	at    int
	first bool
	depth int
	ends  map[int]int // where each array or object skipped ends, by where it begins, so that one is skipped once however deep the scans that skip it
}

// A key is one key of an object being read: the bytes of its name in
// the text, from and to, whether they hold an escape, and the offset of
// its value.
struct key {
	from    int
	to      int
	escaped bool
	at      int
}

// An object is the state of reading an object's members into a struct's
// fields. While the members come in the order of the fields, each is read
// where it stands, in one pass; once one does not, the object is scanned
// whole, where each key's value lies noted, and the fields are found by
// key. read counts the members read in order.
struct object {
	start   int
	keys    []key
	scanned bool
	read    int
	end     int
}

func read<T>(r mut reader) Result<T, Error> {
	r.space()
	return match T {
		bool => r.boolean(),
		i8 => Ok(i8(r.integer(-128, 127)?)),
		i16 => Ok(i16(r.integer(-32768, 32767)?)),
		i32 => Ok(i32(r.integer(-2147483648, 2147483647)?)),
		i64 | int => Ok(T(r.integer(-9223372036854775807 - 1, 9223372036854775807)?)),
		u8 => Ok(u8(r.unsigned(255)?)),
		u16 => Ok(u16(r.unsigned(65535)?)),
		u32 => Ok(u32(r.unsigned(4294967295)?)),
		u64 | uint => Ok(T(r.unsigned(18446744073709551615)?)),
		f32 => {
			start := r.at
			f := r.float()?
			if f > 3.4028234663852886e38 || f < -3.4028234663852886e38 {
				return Err(Error{at: start, msg: strconv.FormatFloat(f, -1) + " overflows its field"})
			}

			Ok(f32(f))
		}
		*E => Ok(&read<E>(mut r)?),
		f64 => r.float(),
		string => r.str(),
		E? => {
			if r.literal("null") {
				return Ok(None)
			}

			Ok(Some(read<E>(mut r)?))
		}
		[]E => {
			r.expect(beginArray)?
			r.enter()?
			xs := []E{}
			if !r.next(endArray)? {
				xs.Push(read<E>(mut r)?)
				for r.more(endArray)? {
					xs.Push(read<E>(mut r)?)
				}
			}

			r.depth -= 1
			Ok(xs)
		}
		map[K]V => match K {
			string => {
				r.expect(beginObject)?
				r.enter()?
				m := map[string]V{}
				if !r.next(endObject)? {
					for {
						r.space()
						at := r.at
						k := r.str()?
						if m.Contains(ref k) {
							return Err(Error{at: at, msg: "key " + k + " given twice"})
						}

						r.space()
						r.expect(nameSeparator)?
						m[k] = read<V>(mut r)?
						if !r.more(endObject)? {
							break
						}
					}
				}

				r.depth -= 1
				Ok(m)
			}
		},
		struct => {
			start := r.at
			r.expect(beginObject)?
			r.enter()?
			o := object{start: start, keys: []key{}, scanned: false, read: 0, end: 0}
			v := T{ for f := range fields(T) {
				[f]: if attr(f, Skip).IsNone() && r.member(mut o, ref keyOf(attr(f, Name), f.name))? {
					read<f.type>(mut r)?
				} else {
					match f.type {
						E? => None,
						_ => f.default ?? omitted<f.type>(attr(f, OmitEmpty).IsSome() || attr(f, Skip).IsSome()) ?? return Err(absent(start, ref keyOf(attr(f, Name), f.name), attr(f, Skip).IsSome())),
					}
				}
			} }

			r.close(mut o)?
			r.depth -= 1
			Ok(v)
		}
		enum => {
			start := r.at
			if r.peek() == quotationMark {
				name := r.str()?
				for c := range variants(T) {
					n := 0
					for f := range fields(c) {
						n += 1
					}

					if n == 0 && name == keyOf(attr(c, Name), c.name) {
						return Ok(c(for f := range fields(c) { read<f.type>(mut r)? }))
					}
				}

				return Err(Error{at: start, msg: "no variant " + name + " without fields"})
			}

			r.expect(beginObject)?
			r.enter()?
			r.space()
			name := r.str()?
			r.space()
			r.expect(nameSeparator)?
			r.space()
			for c := range variants(T) {
				if name == keyOf(attr(c, Name), c.name) {
					n, named := 0, false
					for f := range fields(c) {
						n += 1
						named = f.name != ""
					}

					v := if named {
						start := r.at
						r.expect(beginObject)?
						o := object{start: start, keys: []key{}, scanned: false, read: 0, end: 0}
						v := c(for f := range fields(c) {
							if attr(f, Skip).IsNone() && r.member(mut o, ref keyOf(attr(f, Name), f.name))? {
								read<f.type>(mut r)?
							} else {
								match f.type {
									E? => None,
									_ => omitted<f.type>(attr(f, OmitEmpty).IsSome() || attr(f, Skip).IsSome()) ?? return Err(absent(start, ref keyOf(attr(f, Name), f.name), attr(f, Skip).IsSome())),
								}
							}
						})

						r.close(mut o)?
						v
					} else if n == 1 {
						c(for f := range fields(c) { read<f.type>(mut r)? })
					} else {
						r.expect(beginArray)?
						r.first = true
						v := c(for f := range fields(c) { element<f.type>(mut r)? })
						r.space()
						r.expect(endArray)?
						v
					}

					r.space()
					r.expect(endObject)?
					r.depth -= 1
					return Ok(v)
				}
			}

			Err(Error{at: start, msg: "no variant " + name})
		}
	}
}

// element reads the next element of an array of a variant's unnamed
// fields: a comma before it but for the first.
func element<T>(r mut reader) Result<T, Error> {
	r.space()
	if !r.first {
		r.expect(valueSeparator)?
	}

	r.first = false
	return read<T>(mut r)
}

// space moves past spaces, tabs and line ends.
func (r mut reader) space() {
	for r.at < len(r.text) && (r.text[r.at] == ' ' || r.text[r.at] == '\t' || r.text[r.at] == '\n' || r.text[r.at] == '\r') {
		r.at += 1
	}
}

// peek returns the byte at the offset, or 0 at the end.
func (r ref reader) peek() byte {
	if r.at < len(r.text) {
		return r.text[r.at]
	}

	return 0
}

// fail returns the error for what is at the offset.
func (r ref reader) fail(msg string) Error {
	return Error{at: r.at, msg: msg}
}

// missing returns the error for a field the object at the offset at
// leaves out.
func missing(at int, name ref string) Error {
	return Error{at: at, msg: "missing field " + name}
}

// absent is the error for a field read with no value to take, at the
// object at: missing from the text, or skipped, when its type has no
// empty value and it declares no default.
func absent(at int, name ref string, skipped bool) Error {
	if skipped {
		return Error{at: at, msg: "field " + name + " is skipped and has no default"}
	}

	return missing(at, name)
}

// expect moves past the byte c, or fails.
func (r mut reader) expect(c byte) Result<(), Error> {
	if r.peek() != c {
		return Err(r.fail("expected " + string(rune(c))))
	}

	r.at += 1
	return Ok(())
}

// next moves past the closing byte close when it comes next, after
// space, and reports whether it did.
func (r mut reader) next(close byte) Result<bool, Error> {
	r.space()
	if r.peek() == close {
		r.at += 1
		return Ok(true)
	}

	return Ok(false)
}

// more reads what comes after an element: a comma, and there is
// another, or the closing byte, and there is none.
func (r mut reader) more(close byte) Result<bool, Error> {
	r.space()
	match r.peek() {
		',' => {
			r.at += 1
			return Ok(true)
		}
		_ => {
			r.expect(close)?
			return Ok(false)
		}
	}
}

// literal moves past lit when it comes next, and reports whether it did.
func (r mut reader) literal(lit ref string) bool {
	end := r.at + len(lit)
	if end <= len(r.text) && r.text[r.at:end] == lit {
		r.at = end
		return true
	}

	return false
}

// boolean reads true or false.
func (r mut reader) boolean() Result<bool, Error> {
	if r.literal("true") {
		return Ok(true)
	}

	if r.literal("false") {
		return Ok(false)
	}

	return Err(r.fail("expected true or false"))
}

// enter goes one level deeper into the arrays and objects of the text,
// and refuses a text nested deeper than maxDepth.
func (r mut reader) enter() Result<(), Error> {
	r.depth += 1
	if r.depth > maxDepth {
		return Err(r.fail("exceeded max depth"))
	}

	return Ok(())
}

// token returns the bytes of a number at the offset, as JSON writes one,
// and moves past them: a minus, digits with no leading zero, a fraction
// and an exponent, each with a digit; nothing when no number begins
// there.
func (r mut reader) token() Result<ref string, Error> {
	start := r.at
	if r.peek() == '-' {
		r.at += 1
	}

	if r.peek() == '0' {
		r.at += 1
	} else if !r.digits() {
		r.at = start
		return Ok(r.text[start:start])
	}

	if r.peek() == '.' {
		r.at += 1
		if !r.digits() {
			return Err(Error{at: start, msg: "invalid number " + r.text[start:r.at]})
		}
	}

	if r.peek() == 'e' || r.peek() == 'E' {
		r.at += 1
		if r.peek() == '+' || r.peek() == '-' {
			r.at += 1
		}

		if !r.digits() {
			return Err(Error{at: start, msg: "invalid number " + r.text[start:r.at]})
		}
	}

	if c := r.peek(); c >= '0' && c <= '9' || c == '.' || c == '+' || c == '-' {
		return Err(Error{at: start, msg: "invalid number " + r.text[start:r.at + 1]})
	}

	return Ok(r.text[start:r.at])
}

// digits moves past the digits at the offset, and reports whether there
// was one.
func (r mut reader) digits() bool {
	start := r.at
	for r.at < len(r.text) && r.text[r.at] >= '0' && r.text[r.at] <= '9' {
		r.at += 1
	}

	return r.at > start
}

// integer reads a whole number from lo to hi.
func (r mut reader) integer(lo int, hi int) Result<int, Error> {
	start := r.at
	text := r.token()?
	n := strconv.ParseInt(text, 10) ?? return Err(Error{at: start, msg: "expected an integer, found " + quoted(text)})
	if n < lo || n > hi {
		return Err(Error{at: start, msg: text + " overflows its field"})
	}

	return Ok(n)
}

// unsigned reads a whole number from 0 to hi.
func (r mut reader) unsigned(hi uint) Result<uint, Error> {
	start := r.at
	text := r.token()?
	n := strconv.ParseUint(text, 10) ?? return Err(Error{at: start, msg: "expected an unsigned integer, found " + quoted(text)})
	if n > hi {
		return Err(Error{at: start, msg: text + " overflows its field"})
	}

	return Ok(n)
}

// float reads a number.
func (r mut reader) float() Result<f64, Error> {
	start := r.at
	text := r.token()?
	return Ok(strconv.ParseFloat(text) ?? return Err(Error{at: start, msg: "expected a number, found " + quoted(text)}))
}

// quoted returns text for a message, or "nothing".
func quoted(text ref string) string {
	if len(text) == 0 {
		return "nothing"
	}

	return text.Clone()
}

// str reads a JSON string, its escapes decoded, a \u escape with the
// low half of a pair after a high one read as the one rune they encode.
func (r mut reader) str() Result<string, Error> {
	r.expect(quotationMark)?
	start := r.at
	for r.at < len(r.text) && r.text[r.at] != quotationMark && r.text[r.at] != escape && r.text[r.at] >= 0x20 {
		r.at += 1
	}

	if r.at < len(r.text) && r.text[r.at] == quotationMark { // no escape: the bytes as they are, in one copy
		r.at += 1
		return Ok(r.text[start:r.at - 1].Clone())
	}

	b := strings.Builder{}
	b.WriteString(r.text[start:r.at])
	for {
		if r.at >= len(r.text) {
			return Err(r.fail("unterminated string"))
		}

		c := r.text[r.at]
		r.at += 1
		match c {
			'"' => return Ok(b.String()),
			'\\' => {
				if r.at >= len(r.text) {
					return Err(r.fail("unterminated escape"))
				}

				e := r.text[r.at]
				r.at += 1
				match e {
					'"' => b.WriteByte(quotationMark),
					'\\' => b.WriteByte(escape),
					'/' => b.WriteByte('/'),
					'b' => b.WriteByte(0x08),
					'f' => b.WriteByte(0x0c),
					'n' => b.WriteByte('\n'),
					'r' => b.WriteByte('\r'),
					't' => b.WriteByte('\t'),
					'u' => b.WriteRune(r.escaped()?),
					_ => return Err(r.fail("invalid escape")),
				}
			}
			_ => {
				if c < 0x20 {
					r.at -= 1
					return Err(r.fail("invalid character in string"))
				}

				b.WriteByte(c)
			}
		}
	}
}

// escaped reads what follows \u: a rune, the two halves of a pair read
// as the one rune they encode; a half without its other is U+FFFD.
func (r mut reader) escaped() Result<rune, Error> {
	u := r.hex4()?
	if u >= 0xdc00 && u < 0xe000 { // a low half alone
		return Ok(utf8.RuneError)
	}

	if u < 0xd800 || u >= 0xdc00 {
		return Ok(rune(u))
	}

	if r.at + 6 <= len(r.text) && r.text[r.at] == escape && r.text[r.at + 1] == 'u' {
		at := r.at
		r.at += 2
		low := r.hex4()?
		if low >= 0xdc00 && low < 0xe000 {
			return Ok(rune(((u - 0xd800) << 10 | (low - 0xdc00)) + 0x10000))
		}

		r.at = at // not a low half: read as an escape of its own
	}

	return Ok(utf8.RuneError)
}

// hex4 reads the four hex digits of a \u escape, and nothing else.
func (r mut reader) hex4() Result<int, Error> {
	if r.at + 4 > len(r.text) {
		return Err(r.fail("short \\u escape"))
	}

	n := 0
	for i := 0; i < 4; i++ {
		c := r.text[r.at + i]
		d := match {
			c >= '0' && c <= '9' => int(c - '0'),
			c >= 'a' && c <= 'f' => int(c - 'a') + 10,
			c >= 'A' && c <= 'F' => int(c - 'A') + 10,
			_ => return Err(r.fail("invalid \\u escape")),
		}
		n = n * 16 + d
	}

	r.at += 4
	return Ok(n)
}

// skip moves past one JSON value of any kind. An array or object it
// has skipped before, in an earlier scan of an object around it, is
// passed over at once, from where it was found to end.
func (r mut reader) skip() Result<(), Error> {
	r.space()
	start := r.at
	match r.ends.Get(start) {
		Some(end) => {
			r.at = end
			return Ok(())
		}
		None => {},
	}

	match r.peek() {
		'"' => {
			_ = r.str()?
		}
		'[' => {
			r.at += 1
			r.enter()?
			if !r.next(endArray)? {
				r.skip()?
				for r.more(endArray)? {
					r.skip()?
				}
			}

			r.depth -= 1
			r.ends[start] = r.at
		}
		'{' => {
			r.enter()?
			_ = r.keys(false)?
			r.depth -= 1
			r.ends[start] = r.at
		}
		't' | 'f' => {
			_ = r.boolean()?
		}
		'n' => {
			if !r.literal("null") {
				return Err(r.fail("expected a value"))
			}
		}
		_ => {
			if len(r.token()?) == 0 {
				return Err(r.fail("expected a value"))
			}
		}
	}

	return Ok(())
}

// keys reads an object's members from its {, noting each key and the
// offset of its value when note says so, passing over the values, and
// leaves the offset after its }. A key given twice is an error.
func (r mut reader) keys(note bool) Result<[]key, Error> {
	r.space()
	r.expect(beginObject)?
	keys := []key{}
	if r.next(endObject)? {
		return Ok(keys)
	}

	for {
		r.space()
		k := r.keySpan()?
		if note {
			if r.find(ref keys, ref k) != None {
				return Err(Error{at: k.from - 1, msg: "key " + r.keyName(ref k) + " given twice"})
			}
		}

		r.space()
		r.expect(nameSeparator)?
		r.space()
		if note {
			keys.Push(key{from: k.from, to: k.to, escaped: k.escaped, at: r.at})
		}

		r.skip()?
		if !r.more(endObject)? {
			return Ok(keys)
		}
	}
}

// keySpan reads a key as the bytes between its quotes, and whether they
// hold an escape, without making a string of it.
func (r mut reader) keySpan() Result<key, Error> {
	r.expect(quotationMark)?
	from := r.at
	escaped := false
	for r.at < len(r.text) && r.text[r.at] != quotationMark {
		if r.text[r.at] == escape {
			escaped = true
			r.at += 1
		}

		r.at += 1
	}

	if r.at >= len(r.text) {
		return Err(r.fail("unterminated string"))
	}

	r.at += 1
	return Ok(key{from: from, to: r.at - 1, escaped: escaped, at: 0})
}

// keyName returns the key k as a string, its escapes decoded.
func (r ref reader) keyName(k ref key) string {
	if !k.escaped {
		return r.text[k.from:k.to].Clone()
	}

	sub := reader{text: r.text, at: k.from - 1, first: false}
	return sub.str() ?? r.text[k.from:k.to].Clone()
}

// keyIs reports whether the key k is name.
func (r ref reader) keyIs(k ref key, name ref string) bool {
	if !k.escaped {
		return r.text[k.from:k.to] == name
	}

	return r.keyName(k) == name
}

// find returns the offset of the value of the key that is the key k, or
// None.
func (r ref reader) find(keys ref []key, k ref key) int? {
	name := r.keyName(k)
	return r.findName(keys, ref name)
}

// findName returns the offset of the value of the key name, or None.
func (r ref reader) findName(keys ref []key, name ref string) int? {
	for _, k := range keys {
		if r.keyIs(k, name) {
			return Some(k.at)
		}
	}

	return None
}

// member moves to the value of the member name of the object o, and
// reports whether the object has one. While the members come in the
// order of the fields, the next one is read where it stands; the first
// that does not makes the object scanned whole from its {, and every
// field after is found by its key.
func (r mut reader) member(o mut object, name ref string) Result<bool, Error> {
	if !o.scanned {
		at := r.at
		r.space()
		comma := o.read == 0
		if o.read > 0 && r.peek() == valueSeparator {
			r.at += 1
			r.space()
			comma = true
		}

		if comma && r.peek() == quotationMark { // a member in order, after the comma that must come before it
			k := r.keySpan()?
			if !k.escaped && r.text[k.from:k.to] == name {
				r.space()
				r.expect(nameSeparator)?
				r.space()
				o.read += 1
				return Ok(true)
			}
		}

		r.at = o.start // out of order, or no member here: the object whole
		o.keys = r.keys(true)?
		o.end, o.scanned = r.at, true
		r.at = at
	}

	match r.findName(ref o.keys, name) {
		Some(at) => {
			r.at = at
			return Ok(true)
		}
		None => return Ok(false),
	}
}

// close leaves the offset after the object o: at its end, when it was
// scanned whole; past its }, when every member was read in order; and
// otherwise, members left after the fields, scanned whole, which passes
// over keys the struct has no field for and finds a key given twice.
func (r mut reader) close(o mut object) Result<(), Error> {
	if !o.scanned {
		r.space()
		if r.peek() == endObject {
			r.at += 1
			return Ok(())
		}

		r.at = o.start
		_ = r.keys(true)?
		return Ok(())
	}

	r.at = o.end
	return Ok(())
}
