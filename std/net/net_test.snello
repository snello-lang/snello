package net_test

import ("bufio"; "expect"; "io"; "net"; "strconv"; "testing"; "time")

// serve answers one connection line by line, in upper case, until the
// client closes its side, and reports how many lines it saw.
func serve(l net.Listener, done chan<- int) {
	conn := l.Accept().Expect("accept")
	lines := 0
	r := bufio.NewReader(mut conn)
	for {
		line := r.ReadString('\n').Expect("read") ?? break
		r.Get().WriteString(ref line.ToUpper()).Expect("write")
		lines += 1
	}

	done <- lines
}

func TestEcho() {
	l := expect.IsOk(net.Listen("127.0.0.1", 0))
	port := l.Port()
	expect.True(port > 0)
	done := make(chan int)
	spawn serve(l, done.Clone())
	c := expect.IsOk(net.Dial("127.0.0.1", port))
	expect.IsOk(c.SetDeadline(time.Now().Add(time.Duration(5) * time.Second)))
	expect.IsOk(c.SetReadDeadline(time.Now().Add(time.Duration(5) * time.Second)))
	expect.IsOk(c.SetWriteDeadline(time.Now().Add(time.Duration(5) * time.Second)))
	r := bufio.NewReader(mut c)
	expect.Equal(ref expect.IsOk(r.Get().WriteString("snello\n")), ref 7)
	expect.Equal(ref expect.IsSome(expect.IsOk(r.ReadString('\n'))), "SNELLO\n")
	expect.Equal(ref expect.IsOk(r.Get().Write(ref []byte{111, 107, 10})), ref 3)
	buf := make([]byte, 3)
	expect.Equal(ref expect.IsOk(r.Read(mut buf)), ref 3)
	expect.Equal(ref buf[0], ref byte(79))
	expect.IsOk(c.Close())
	expect.Equal(ref (<-done ?? 0), ref 2)
}

func TestDialErrors() {
	e := expect.IsErr(net.Dial("127.0.0.1", 1))
	expect.True(e.Kind() == io.Refused)
	expect.IsErr(net.Listen("127.0.0.1", 70000))
	expect.IsErr(net.DialTimeout("127.0.0.1", 1, time.Duration(100)*time.Millisecond))
}

func TestListenerDeadline() {
	l := expect.IsOk(net.Listen("127.0.0.1", 0))
	expect.IsOk(l.SetDeadline(time.Now().Add(time.Duration(20) * time.Millisecond)))
	expect.IsErr(l.Accept())
}

// needIPv6 skips a test on a system with no IPv6 loopback, as Go's
// tests skip one.
func needIPv6() {
	if net.Listen("::1", 0).IsErr() {
		testing.Skip("no IPv6 loopback")
	}
}

// needNameServer skips a test when the system's resolver reaches no
// name server: a name under .invalid then fails for that, "Temporary
// failure in name resolution", and not for having no address.
func needNameServer() {
	match net.LookupHost("nosuch.invalid") {
		Ok(_) => {},
		Err(e) => {
			if e.Kind() != io.NotExist {
				testing.Skip("no name server: " + e.Error())
			}
		},
	}
}

func TestIPv6() {
	needIPv6()
	l := expect.IsOk(net.Listen("::1", 0))
	expect.Equal(l.Addr(), ref ("[::1]:" + strconv.Itoa(l.Port())))
	c := expect.IsOk(net.Dial("::1", l.Port()))
	a := expect.IsOk(l.Accept())
	expect.Equal(c.RemoteAddr(), l.Addr())
	expect.Equal(c.LocalAddr(), a.RemoteAddr())
	expect.Equal(a.LocalAddr(), l.Addr())
	e := expect.IsErr(net.Dial("::1", 1))
	expect.True(e.Kind() == io.Refused)
	expect.Equal(ref e.Error(), "dial tcp [::1]:1: connect: connection refused")
}

func TestEveryIPv4Address() {
	l := expect.IsOk(net.Listen("0.0.0.0", 0))
	expect.Equal(l.Addr(), ref ("0.0.0.0:" + strconv.Itoa(l.Port())))
}

func TestEveryAddress() {
	needIPv6()
	l := expect.IsOk(net.Listen("", 0))
	at := strconv.Itoa(l.Port())
	expect.Equal(l.Addr(), ref ("[::]:" + at))
	c := expect.IsOk(net.Dial("127.0.0.1", l.Port()))
	a := expect.IsOk(l.Accept())
	expect.Equal(a.LocalAddr(), ref ("127.0.0.1:" + at)) // an IPv4 peer prints as IPv4, not mapped into IPv6
	expect.Equal(a.RemoteAddr(), c.LocalAddr())
}

func TestLookup() {
	found := expect.IsOk(net.LookupHost("localhost"))
	expect.True(found.Contains("127.0.0.1") || found.Contains("::1"))
	expect.Equal(ref len(expect.IsOk(net.LookupHost("::1"))), ref 1)
	expect.Equal(ref expect.IsOk(net.LookupHost("fe80::1%1"))[0], "fe80::1%1") // an IP address is its own, as given
	empty := expect.IsErr(net.LookupHost(""))
	expect.True(empty.Kind() == io.NotExist)
	expect.Equal(ref empty.Error(), "lookup : no such host")
	expect.Equal(ref expect.IsErr(net.LookupHost("a\x00b")).Error(), "lookup a\x00b: invalid argument")
}

func TestNoSuchHost() {
	needNameServer()
	e := expect.IsErr(net.LookupHost("nosuch.invalid"))
	expect.True(e.Kind() == io.NotExist)
	expect.Equal(ref e.Error(), "lookup nosuch.invalid: no such host")
	d := expect.IsErr(net.Dial("nosuch.invalid", 80))
	expect.True(d.Kind() == io.NotExist)
	expect.Equal(ref d.Error(), "dial tcp: lookup nosuch.invalid: no such host")
	expect.Equal(ref expect.IsErr(net.Listen("nosuch.invalid", 0)).Error(), "listen tcp: lookup nosuch.invalid: no such host")
}

func TestDialName() {
	l := expect.IsOk(net.Listen("localhost", 0))
	expect.Equal(l.Addr(), ref ("127.0.0.1:" + strconv.Itoa(l.Port())))
	c := expect.IsOk(net.DialTimeout("localhost", l.Port(), time.Duration(5) * time.Second)) // ::1 first where localhost has it, refused, then 127.0.0.1
	expect.Equal(c.RemoteAddr(), l.Addr())
	first := expect.IsOk(net.LookupHost("localhost"))[0].Clone()
	at := if first.Contains(":") { "[" + first + "]:1" } else { first + ":1" }
	expect.Equal(ref expect.IsErr(net.Dial("localhost", 1)).Error(), ref ("dial tcp " + at + ": connect: connection refused")) // the first address's failure, of all it tried
}

// accepting takes every connection l is dialed with and drops it.
func accepting(l net.Listener) {
	for {
		_ = l.Accept()
	}
}

// race dials a name n times with timeouts from a nanosecond to a
// millisecond, about as long as a lookup of localhost takes, so that
// the lookup and its timer finish in either order, and the dial after
// the lookup is cut short too, which must neither crash, leak nor hang;
// it reports when it is done.
func race(port int, n int, done chan<- bool) {
	ok := true
	for i := 0; i < n; i++ {
		match net.DialTimeout("localhost", port, time.Duration(i % 40) * time.Duration(25) * time.Microsecond + time.Nanosecond) {
			Ok(_) => {},
			Err(e) => ok = ok && (e.Kind() == io.TimedOut || e.Kind() == io.Refused),
		}
	}

	done <- ok
}

func TestLookupTimeouts() {
	l := expect.IsOk(net.Listen("localhost", 0))
	port := l.Port()
	spawn accepting(l)
	done := make(chan bool)
	for i := 0; i < 8; i++ {
		spawn race(port, 100, done.Clone())
	}

	for i := 0; i < 8; i++ {
		expect.True(<-done ?? false)
	}
}

func BenchmarkDial() {
	l := expect.IsOk(net.Listen("127.0.0.1", 0))
	port := l.Port()
	spawn func(l net.Listener) { for { _ = l.Accept() } }(l)
	testing.ResetTimer()
	for testing.Loop() { _ = net.Dial("127.0.0.1", port) }
}
