// Package io has what reading and writing share: the Reader, Writer
// and Seeker traits, which files implement and other sources and sinks
// of bytes will, the Error a failed operation reports, Copy, which
// moves everything a Reader has into a Writer, ReadAll and ReadFull,
// which read a whole input and an exact count of bytes, and Discard, a
// Writer that keeps nothing.
//
// A function of this package or of os that can fail returns a
// Result<T, Error>, never a value and an error side by side, so a
// failure is passed up with ? or handled with a match. An Error prints
// as its message, "open /x: no such file or directory", wherever a
// value is printed.
package io

// An Error is what a file operation reports when it fails: the
// operation, the path or stream it was on, and the system's reason.
// A program that must tell one failure from another asks Kind; one
// that only reports it prints the Error, or calls Error for the text.
struct Error impl Error, Clone {
	// Op names the operation that failed, as the system call is
	// named: open, read, write, close, sync, remove, mkdirtemp.
	Op string

	// Path is the path the operation was given, or the name of the
	// stream it was on, /dev/stdout for the standard output.
	Path string

	// Msg is the system's reason, in lower case: "no such file or
	// directory", "permission denied".
	Msg string

	kind    Kind
	hasPath bool // the operation was on a path, empty or not, which the message shows
	written int  // the bytes a write took before it failed
}

// A Kind sorts the failures a program may want to tell apart from the
// rest, since the reasons the system gives are many. A failure the
// Kind does not name is Other.
enum Kind impl Copy, Clone, Eq {
	// Other is any failure the other kinds do not name.
	Other

	// NotExist: the path named nothing.
	NotExist

	// Permission: the system refused the operation.
	Permission

	// Exists: the path named something already.
	Exists

	// Refused: nothing listens at the address dialed.
	Refused

	// Reset: the other side ended the connection abruptly, or had
	// closed it before a write.
	Reset

	// TimedOut: the other side did not answer in the time the system
	// waits.
	TimedOut

	// UnexpectedEOF: the input ended partway through what had to be
	// read whole, as ReadFull reports it.
	UnexpectedEOF
}

// A Reader is a source of bytes. Read fills the buffer it is given
// from the front, with as many bytes as it has at hand, and returns
// how many it wrote; zero means the end of the data. A Read into an
// empty buffer returns zero too, having nowhere to put a byte, so a
// caller reads into a buffer of at least one. A failure is an Error.
trait Reader {
	func (r mut Self) Read(buf mut []byte) Result<int, Error>
}

// A Writer is a sink of bytes. Write takes every byte of the buffer it
// is given and returns how many it wrote, which is the buffer's
// length; a Writer that cannot take them all fails instead.
trait Writer {
	func (w mut Self) Write(buf ref []byte) Result<int, Error>
}

// A Seeker is a source or sink of bytes with a position in it, which
// Seek moves: a file is one. Seek returns the new position, counted in
// bytes from the start. Moving before the start fails, and moving past
// the end is allowed, as the system allows it of a file.
trait Seeker {
	func (s mut Self) Seek(pos SeekFrom) Result<u64, Error>
}

// A SeekFrom says where Seek moves to: a position from the start, or an
// offset from the current position or from the end, which may be
// negative. A position from the start cannot be negative, so it is a
// u64, and no other way to count holds.
enum SeekFrom impl Copy, Clone, Eq {
	// Start is the position counted from the first byte.
	Start(u64)

	// Current is an offset from the current position.
	Current(i64)

	// End is an offset from the end: End(0) is just past the last byte,
	// and End(-2) the last byte but one.
	End(i64)
}

// Error returns the message, Op, Path and Msg in one line, as Go words
// it: "open /nonexistent: no such file or directory", with the space
// before the colon even for an empty path, "open : no such file or
// directory". An Error that was on no path, as a short write is not,
// leaves the path out, "write: short write", and one with no Op is its
// Msg alone.
func (e ref Error) Error() string {
	if e.Op.Len() == 0 {
		return e.Msg.Clone()
	}

	if !e.hasPath {
		return e.Op + ": " + e.Msg
	}

	return e.Op + " " + e.Path + ": " + e.Msg
}

// Kind returns which kind of failure this is.
func (e ref Error) Kind() Kind {
	return e.kind
}

// Written returns how many bytes a write had taken before it failed,
// which Go's Write returns beside its error: a connection whose
// deadline passed partway through a large write, or a disk that filled,
// took the first Written bytes and not the rest. It is 0 for every
// other failure. A Result holds a count or an Error and not both, so
// the Error holds the count, as Java's InterruptedIOException holds
// bytesTransferred.
func (e ref Error) Written() int {
	return e.written
}

// WithWritten returns e saying that n bytes were written before it: for
// a Writer of a program's own that fails partway, as a connection's
// Write does.
func (e Error) WithWritten(n int) Error {
	e.written = n
	return e
}

// NewError builds an Error a program reports: a Reader or a Writer of
// its own, a parser of a file format. Op is what was tried, Path what
// it was on, empty for none, Msg why it failed, and kind which Kind of
// failure it is, Other when none fits.
func NewError(op string, path string, msg string, kind Kind) Error {
	has := path.Len() > 0
	return Error{Op: op, Path: path, Msg: msg, kind: kind, hasPath: has}
}

// ShortWrite is the Error for a writer that took none of the bytes it
// was given and reported no failure: Op "write", Kind Other, message
// "short write". Copy and bufio's Flush report it rather than ask
// forever.
func ShortWrite() Error {
	return NewError("write", "", "short write", Other)
}

// Errno builds the Error for a system call that failed with the given
// error number: op and path say what was tried, and the runtime turns
// the number into its reason and its Kind. It is for a package that
// calls the system, as os does; a program meets the Errors it makes.
func Errno(op string, path ref string, code int) Error {
	kind := match kindOf(code) {
		1 => NotExist,
		2 => Permission,
		3 => Exists,
		4 => Refused,
		5 => Reset,
		6 => TimedOut,
		_ => Other,
	}
	return Error{Op: op, Path: path.Clone(), Msg: reason(code), kind: kind, hasPath: true}
}

// Copy reads src until its end and writes everything to dst, through a
// buffer of 32 KiB, and returns the number of bytes copied. The first
// failure of either side ends the copy with its Error; a Writer that
// takes fewer bytes than it was given is asked again for the rest, one
// that takes none fails the copy with a short write, and one that
// claims more than it was given fails it with "invalid write result",
// as Go's Copy does. Both are lent mut for the duration: io.Copy(mut
// out, mut in).
func Copy<W: Writer, R: Reader>(dst mut W, src mut R) Result<i64, Error> {
	buf := make([]byte, 32768)
	var total i64 = 0
	for {
		n := src.Read(mut buf)?
		if n == 0 {
			return Ok(total)
		}

		written := 0
		for written < n {
			m := dst.Write(buf[written:n])?
			if m <= 0 {
				return Err(ShortWrite())
			}

			if m > n-written {
				return Err(NewError("", "", "invalid write result", Other))
			}

			written += m
		}

		total += i64(n)
	}
}

// ReadAll reads r until its end and returns everything it read, as
// Go's ReadAll does: into blocks that grow by half each time, starting
// from 512 bytes, then copied once into a slice of the exact length, so
// that no block is copied as it grows. The first failure of r ends the
// read with its Error, and what was read before it is not returned. r
// is lent mut for the duration: io.ReadAll(mut f).
func ReadAll<R: Reader>(r mut R) Result<[]byte, Error> {
	b := make([]byte, 512)
	filled := 0
	next := 256
	blocks := [][]byte{}
	total := 0
	for {
		n := r.Read(mut b[filled:])?
		if n == 0 {
			break
		}

		filled += n
		if len(b)-filled < len(b)/16 { // nearly full: a larger block takes the rest
			b.Truncate(filled)
			total += filled
			blocks.Push(b)
			b = make([]byte, next)
			filled = 0
			next += next / 2
		}
	}

	b.Truncate(filled)
	if len(blocks) == 0 {
		return Ok(b)
	}

	all := []byte{}
	reserve(mut all, total+filled)
	for _, block := range ref blocks {
		all.Extend(block)
	}

	all.Extend(ref b)
	return Ok(all)
}

// ReadFull reads exactly len(buf) bytes from r into buf and returns
// that count, as Go's ReadFull does: Read is asked as often as it takes.
// It returns 0 when r ends before any byte, as Read does at the end; an
// end partway through is an Error of Kind UnexpectedEOF, "unexpected
// EOF", since the bytes it had to read whole are not all there. A
// failure of r ends the read with its Error.
func ReadFull<R: Reader>(r mut R, buf mut []byte) Result<int, Error> {
	n := 0
	for n < len(buf) {
		m := r.Read(mut buf[n:])?
		if m == 0 {
			if n == 0 {
				return Ok(0)
			}

			return Err(NewError("", "", "unexpected EOF", UnexpectedEOF))
		}

		n += m
	}

	return Ok(n)
}

// A Discard is a Writer that takes every byte it is given and keeps
// none, as Go's io.Discard: for output a program must write and does
// not want. It holds nothing, so its zero value is ready: var sink
// io.Discard, then fmt.Fprintln(mut sink, ...). It is a type and not a
// package variable, since a package variable is never lent mut.
struct Discard impl Writer {}

// Write takes all of buf and keeps none of it.
func (d mut Discard) Write(buf ref []byte) Result<int, Error> {
	return Ok(len(buf))
}

// reserve makes room in b for n more bytes, in at most one allocation.
// The runtime provides it.
func reserve(b mut []byte, n int)

// reason returns the system's text for an error number, with its first
// letter in lower case. The runtime provides it.
func reason(code int) string

// kindOf sorts an error number into a Kind: 1 for a missing file, 2
// for a permission refused, 3 for a file that exists, 4 for a
// connection refused, 5 for one reset or broken, 6 for one timed out,
// 0 otherwise. The runtime provides it.
func kindOf(code int) int
