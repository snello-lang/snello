// Package io has what reading and writing share: the Reader, Writer
// and Seeker traits, which files implement and other sources and sinks
// of bytes will, the Error a failed operation reports, Copy, which
// moves everything a Reader has into a Writer, ReadAll and ReadFull,
// which read a whole input and an exact count of bytes, and Discard, a
// Writer that keeps nothing.
//
// A function of this package or of os that can fail returns a
// Result<T, Error>, never a value and an error side by side, so a
// failure is passed up with ? or handled with a match. An Error prints
// as its message, "open /x: no such file or directory", wherever a
// value is printed.
package io

// copyBufferSize is the size of the buffer Copy moves bytes through,
// 32 KiB: large enough that a copy of a file takes few system calls,
// small enough that a copy per task costs little memory.
const copyBufferSize = 32768

// The blocks ReadAll reads into: the first is firstBlockSize bytes,
// and each one after it is half the size of all the blocks before it
// together, so that the room grows by half each time. A block is
// taken as full once less than one part in nearlyFullFraction of it is
// left, so that a reader that hands out a few bytes a call does not
// end a block on a sliver.
const firstBlockSize = 512
const nearlyFullFraction = 16

// The numbers the runtime's kindOf sorts an error number into, one for
// each Kind it names; any other number is Other.
const kindCodeNotExist = 1
const kindCodePermission = 2
const kindCodeExists = 3
const kindCodeRefused = 4
const kindCodeReset = 5
const kindCodeTimedOut = 6

// An Error is what an operation on a file, a connection or another
// source or sink of bytes reports when it fails: the operation, the
// path or stream it was on, and the reason. A program that must tell
// one failure from another asks Kind; one that only reports it prints
// the Error, or calls Error for the text:
//
//	f := match os.Open(path) {
//		Ok(f) => f,
//		Err(e) if e.Kind() == io.NotExist => return Ok(()),
//		Err(e) => return Err(e),
//	}
//
// An Error is a value of its own, owning its strings: it outlives the
// operation and the path it was made from, and Clone copies it.
struct Error impl Error, Clone {
	// Op names the operation that failed, as the system call is
	// named: open, read, write, close, sync, remove, mkdirtemp.
	Op      string

	// Path is the path the operation was given, or the name of the
	// stream it was on, /dev/stdout for the standard output.
	Path    string

	// Msg is the reason, in lower case: "no such file or directory",
	// "permission denied".
	Msg     string

	kind    Kind
	hasPath bool // the operation was on a path, empty or not, which the message shows
	written int  // the bytes a write took before it failed
}

// A Kind sorts the failures a program may want to tell apart from the
// rest, since the reasons the system gives are many: a missing file, a
// refused permission, a dial nobody answers. A failure the Kind does
// not name is Other. A Kind is copied as a number is, and compared
// with ==:
//
//	if e.Kind() == io.TimedOut { retry() }
enum Kind impl Copy, Clone, Eq {
	// Other is any failure the other kinds do not name.
	Other

	// NotExist: the path named nothing, or the host name no address.
	NotExist

	// Permission: the system refused the operation.
	Permission

	// Exists: the path named something already.
	Exists

	// Refused: nothing listens at the address dialed.
	Refused

	// Reset: the other side ended the connection abruptly, or had
	// closed it before a write.
	Reset

	// TimedOut: the other side did not answer in the time the system
	// waits, or a deadline passed.
	TimedOut

	// UnexpectedEOF: the input ended partway through what had to be
	// read whole, as ReadFull reports it.
	UnexpectedEOF

	// Cancelled: the work of the task that waited was cancelled, by a
	// group's Cancel or a failure in its group, while the call waited
	// or before it began to; a deadline of the task's that passed is
	// TimedOut.
	Cancelled
}

// A Reader is a source of bytes: a file, a connection, a string read
// through strings.Reader, or a type of a program's own.
//
// Read fills the buffer it is lent from the front, with as many bytes
// as it has at hand, at most len(buf), and returns how many it wrote;
// the bytes past that count are left as they were. Zero means the end
// of the data. A Read into an empty buffer returns zero too, having
// nowhere to put a byte, so a caller reads into a buffer of at least
// one. A failure is an Error, and Read may block until a byte comes
// or the source ends:
//
//	buf := make([]byte, 4096)
//	n := f.Read(mut buf)?
trait Reader {
	func (r mut Self) Read(buf mut []byte) Result<int, Error>
}

// A Writer is a sink of bytes: a file, a connection, a bufio.Writer
// or a type of a program's own.
//
// Write takes every byte of the buffer it is lent, keeping none of the
// buffer itself, and returns how many it wrote, which is the buffer's
// length; a Writer that cannot take them all fails instead, with an
// Error whose Written says how many it took. Write may block until
// the sink has taken the bytes:
//
//	n := conn.Write(ref []byte("hello\n"))?
trait Writer {
	func (w mut Self) Write(buf ref []byte) Result<int, Error>
}

// A Seeker is a source or sink of bytes with a position in it, which
// Seek moves: a file is one, a pipe and a connection are not.
//
// Seek moves the position to where pos says and returns the new
// position, counted in bytes from the start. Moving before the start
// fails, and moving past the end is allowed, as the system allows it
// of a file; a write there leaves a gap of zero bytes:
//
//	size := f.Seek(io.End(0))?
//	f.Seek(io.Start(0))?
trait Seeker {
	func (s mut Self) Seek(pos SeekFrom) Result<u64, Error>
}

// A SeekFrom says where Seek moves to: a position from the start, or an
// offset from the current position or from the end, which may be
// negative. A position from the start cannot be negative, so it is a
// u64, and no other way to count holds. It is copied as a number is,
// and compared with ==.
enum SeekFrom impl Copy, Clone, Eq {
	// Start is the position counted from the first byte.
	Start(u64)

	// Current is an offset from the current position.
	Current(i64)

	// End is an offset from the end: End(0) is just past the last byte,
	// and End(-2) the last byte but one.
	End(i64)
}

// A Discard is a Writer that takes every byte it is given and keeps
// none: for output a program must write and does not want. It holds
// nothing, so its zero value is ready, and writing to it costs no
// allocation and no system call:
//
//	var sink io.Discard
//	fmt.Fprintln(mut sink, "dropped")
//
// It is a type and not a package variable, since a package variable is
// never lent mut, and a Write needs a mut.
struct Discard impl Writer {}

// Error returns the Error's message, Op, Path and Msg in one line:
// "open /nonexistent: no such file or directory". The space before the
// colon stays even for an empty path, "open : no such file or
// directory", since the operation was on a path; an Error that was on
// no path, as a short write is not, leaves the path out, "write: short
// write", and one with no Op is its Msg alone. It allocates the line
// it returns.
func (e ref Error) Error() string {
	if e.Op.Len() == 0 {
		return e.Msg.Clone()
	}

	if !e.hasPath {
		return e.Op + ": " + e.Msg
	}

	return e.Op + " " + e.Path + ": " + e.Msg
}

// Kind returns which kind of failure e is, so that a program can tell
// a missing file or a refused dial from the rest without reading the
// message: e.Kind() == io.NotExist.
func (e ref Error) Kind() Kind {
	return e.kind
}

// Written returns how many bytes a write had taken before it failed: a
// connection whose deadline passed partway through a large write, or a
// disk that filled, took the first Written bytes and not the rest, so
// a program that retries writes from buf[e.Written():]. It is 0 for
// every other failure. A Result holds a count or an Error and not
// both, so the Error holds the count.
func (e ref Error) Written() int {
	return e.written
}

// WithWritten takes e and returns it saying that n bytes were written
// before it failed, which Written then reports: for a Writer of a
// program's own that fails partway, as a connection's Write does.
//
//	e := io.NewError("write", "", "disk full", io.Other)
//	return Err(e.WithWritten(n))
func (e Error) WithWritten(n int) Error {
	e.written = n
	return e
}

// NewError returns an Error a program reports itself: from a Reader or
// a Writer of its own, or a parser of a file format. op is what was
// tried, path what it was on, empty for none, msg why it failed, and
// kind which Kind of failure it is, Other when none fits. It takes the
// three strings and keeps them, with no copy:
//
//	io.NewError("parse", path.Clone(), "bad header", io.Other)
func NewError(op string, path string, msg string, kind Kind) Error {
	has := path.Len() > 0
	return Error{Op: op, Path: path, Msg: msg, kind: kind, hasPath: has}
}

// ShortWrite returns the Error of a Writer that took none of the bytes
// it was given and reported no failure: Op "write", no path, Kind
// Other, and the message "write: short write". Copy and bufio's Flush
// report it rather than ask such a Writer again for ever.
func ShortWrite() Error {
	return NewError("write", "", "short write", Other)
}

// Errno returns the Error of a system call that failed with the error
// number code: op and path say what was tried and on what, and the
// runtime turns the number into its reason, "no such file or
// directory", and its Kind, NotExist. It takes op, and copies path,
// which it only borrows. It is for a package that calls the system, as
// os and net do; a program meets the Errors they make.
//
//	return Err(io.Errno("open", path, code))
func Errno(op string, path ref string, code int) Error {
	k := kindOf(code)
	kind := match {
		k == kindCodeNotExist => NotExist,
		k == kindCodePermission => Permission,
		k == kindCodeExists => Exists,
		k == kindCodeRefused => Refused,
		k == kindCodeReset => Reset,
		k == kindCodeTimedOut => TimedOut,
		_ => Other,
	}

	return Error{Op: op, Path: path.Clone(), Msg: reason(code), kind: kind, hasPath: true}
}

// Copy reads src until its end and writes everything it read to dst,
// and returns the number of bytes copied. Both are lent mut for the
// call and kept by neither side:
//
//	n := io.Copy(mut out, mut in)?
//
// It moves the bytes through one buffer of 32 KiB, which it allocates
// once. The first failure of either side ends the copy with its
// Error, the bytes before it written; a Writer that takes fewer bytes
// than it was given is asked again for the rest, one that takes none
// fails the copy with ShortWrite, and one that claims more than it was
// given fails it with "invalid write result". It blocks as long as src
// and dst do.
func Copy<W: Writer, R: Reader>(dst mut W, src mut R) Result<i64, Error> {
	buf := make([]byte, copyBufferSize)
	var total i64 = 0
	for {
		n := src.Read(mut buf)?
		if n == 0 {
			return Ok(total)
		}

		written := 0
		for written < n {
			m := dst.Write(buf[written:n])?
			if m <= 0 {
				return Err(ShortWrite())
			}

			if m > n-written {
				return Err(NewError("", "", "invalid write result", Other))
			}

			written += m
		}

		total += i64(n)
	}
}

// ReadAll reads r until its end and returns everything it read, as one
// slice of the exact length. r is lent mut for the call:
//
//	data := io.ReadAll(mut f)?
//
// It reads into blocks, the first of 512 bytes and each after it half
// the size of all before it, then copies them once into the slice it
// returns, so that no byte is copied twice however long the input; an
// input that fits the first block is returned in it, with no copy. The
// first failure of r ends the read with its Error, and what was read
// before it is not returned.
func ReadAll<R: Reader>(r mut R) Result<[]byte, Error> {
	b := make([]byte, firstBlockSize)
	filled := 0
	next := firstBlockSize / 2
	blocks := [][]byte{}
	total := 0
	for {
		n := r.Read(mut b[filled:])?
		if n == 0 {
			break
		}

		filled += n
		if len(b)-filled < len(b)/nearlyFullFraction { // nearly full: a larger block takes the rest
			b.Truncate(filled)
			total += filled
			blocks.Push(b)
			b = make([]byte, next)
			filled = 0
			next += next / 2
		}
	}

	b.Truncate(filled)
	if len(blocks) == 0 {
		return Ok(b)
	}

	all := []byte{}
	reserve(mut all, total+filled)
	for _, block := range ref blocks {
		all.Extend(block)
	}

	all.Extend(ref b)
	return Ok(all)
}

// ReadFull reads exactly len(buf) bytes from r into buf and returns
// that count, asking Read as often as it takes; r and buf are lent mut
// for the call, and nothing is allocated:
//
//	header := make([]byte, 16)
//	io.ReadFull(mut f, mut header)?
//
// It returns 0 when r ends before any byte, as Read does at the end,
// so a loop over records stops cleanly. An end partway through is an
// Error of Kind UnexpectedEOF, "unexpected EOF", since the bytes it
// had to read whole are not all there; buf then holds the bytes read
// before it. A failure of r ends the read with its Error.
func ReadFull<R: Reader>(r mut R, buf mut []byte) Result<int, Error> {
	n := 0
	for n < len(buf) {
		m := r.Read(mut buf[n:])?
		if m == 0 {
			if n == 0 {
				return Ok(0)
			}

			return Err(NewError("", "", "unexpected EOF", UnexpectedEOF))
		}

		n += m
	}

	return Ok(n)
}

// Write takes all of buf, keeps none of it, and returns its length; it
// never fails and never blocks.
func (d mut Discard) Write(buf ref []byte) Result<int, Error> {
	return Ok(len(buf))
}

// reserve makes room in b for n more bytes, in at most one allocation.
// The runtime provides it.
func reserve(b mut []byte, n int)

// reason returns the system's text for an error number, with its first
// letter in lower case. The runtime provides it.
func reason(code int) string

// kindOf sorts an error number into one of the kind codes,
// kindCodeNotExist to kindCodeTimedOut, or 0 for a number no Kind
// names. The runtime provides it.
func kindOf(code int) int
