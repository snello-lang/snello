package io_test

import ("bytes"; "expect"; "fmt"; "io"; "os"; "strings"; "testing")

// enoent is the error number of a missing file, the same on every
// system Snello runs on.
const enoent = 2

// A Drip hands out at most step bytes a call, and fails with its error
// once it has handed out fail bytes, when fail is not below zero.
struct Drip impl io.Reader {
	data []byte
	at   int
	step int
	fail int
}

// Read hands out the next bytes of d, at most step of them, or fails
// once fail bytes are out.
func (d mut Drip) Read(buf mut []byte) Result<int, io.Error> {
	if d.fail >= 0 && d.at >= d.fail {
		return Err(io.NewError("read".Clone(), "drip".Clone(), "broken".Clone(), io.Other))
	}

	n := min(d.step, len(buf), len(d.data)-d.at)
	for i := 0; i < n; i++ {
		buf[i] = d.data[d.at+i]
	}

	d.at += n
	return Ok(n)
}

func TestError() {
	e := io.NewError("open".Clone(), "/x".Clone(), "boom".Clone(), io.NotExist)
	expect.Equal(ref e.Error(), "open /x: boom")
	expect.True(e.Kind() == io.NotExist)
	expect.Equal(ref e.Written(), ref 0)
	e2 := e.Clone().WithWritten(3)
	expect.Equal(ref e2.Written(), ref 3)
	expect.Equal(ref io.ShortWrite().Error(), "write: short write")
	missing := io.Errno("open".Clone(), "/nope", enoent)
	expect.True(missing.Kind() == io.NotExist)
	expect.Contains(ref missing.Error(), "/nope")
}

func TestCopy() {
	dir := testing.TempDir()
	src := expect.IsOk(os.Create(ref dir.Join("src")))
	expect.IsOk(src.WriteString("copied text"))
	expect.IsOk(src.Close())
	in := expect.IsOk(os.Open(ref dir.Join("src")))
	out := expect.IsOk(os.Create(ref dir.Join("dst")))
	expect.Equal(ref expect.IsOk(io.Copy(mut out, mut in)), ref i64(11))
	expect.IsOk(out.Close())
	expect.Equal(ref expect.IsOk(os.ReadToString(ref dir.Join("dst"))), "copied text")
}

func TestReadAll() {
	for _, n := range []int{0, 1, 511, 512, 513, 4096, 100000, 1000003} { // within the first block, at its edge, and across many
		var d = Drip{data: counting(n), at: 0, step: 4093, fail: -1}
		got := expect.IsOk(io.ReadAll(mut d))
		expect.Equal(ref len(got), ref n)
		expect.True(got.Equal(ref counting(n)))
	}

	var slow = Drip{data: counting(3000), at: 0, step: 1, fail: -1} // a byte a call
	expect.True(expect.IsOk(io.ReadAll(mut slow)).Equal(ref counting(3000)))
	var broken = Drip{data: counting(5000), at: 0, step: 100, fail: 700}
	expect.Equal(ref expect.IsErr(io.ReadAll(mut broken)).Error(), "read drip: broken")
	in := strings.NewReader("from a string".Clone())
	expect.Equal(ref string(expect.IsOk(io.ReadAll(mut in))), "from a string")
}

func TestReadFull() {
	var d = Drip{data: counting(10), at: 0, step: 3, fail: -1}
	buf := make([]byte, 4)
	expect.Equal(ref expect.IsOk(io.ReadFull(mut d, mut buf)), ref 4) // two reads make up the four
	expect.True(buf.Equal(ref []byte{0, 1, 2, 3}))
	expect.Equal(ref expect.IsOk(io.ReadFull(mut d, mut buf)), ref 4)
	e := expect.IsErr(io.ReadFull(mut d, mut buf)) // two bytes left of four
	expect.True(e.Kind() == io.UnexpectedEOF)
	expect.Equal(ref e.Error(), "unexpected EOF")
	expect.Equal(ref expect.IsOk(io.ReadFull(mut d, mut buf)), ref 0) // the end, with nothing read
	none := []byte{}
	expect.Equal(ref expect.IsOk(io.ReadFull(mut d, mut none)), ref 0)
	var broken = Drip{data: counting(10), at: 0, step: 2, fail: 2}
	expect.Equal(ref expect.IsErr(io.ReadFull(mut broken, mut buf)).Error(), "read drip: broken")
}

func TestDiscard() {
	var w io.Discard // the zero value is ready
	expect.Equal(ref expect.IsOk(w.Write(ref counting(1000))), ref 1000)
	in := strings.NewReader("copied nowhere".Clone())
	expect.Equal(ref expect.IsOk(io.Copy(mut w, mut in)), ref i64(14))
	fmt.Fprintln(mut io.Discard{}, "written nowhere") // or one made where it is used
}

func TestSeekFrom() {
	expect.True(io.Start(3) == io.Start(3))
	expect.True(io.Current(-1) != io.End(-1))
}

func BenchmarkReadAll() {
	data := counting(1 << 20)
	testing.ResetTimer()
	for testing.Loop() {
		var d = Drip{data: data.Clone(), at: 0, step: 32768, fail: -1}
		_ = io.ReadAll(mut d)
	}
}

func BenchmarkNewError() {
	for testing.Loop() { _ = io.NewError("op".Clone(), "p".Clone(), "m".Clone(), io.Other) }
}

// counting returns n bytes, each its index modulo 251, so that a byte
// out of place shows.
func counting(n int) []byte {
	b := make([]byte, n)
	for i := 0; i < n; i++ {
		b[i] = byte(i % 251)
	}

	return b
}

// A LimitedReader ends after its count, however the reader under it
// goes on, and lends the reader, which reads on from there after.
func TestLimitReader() {
	src := strings.NewReader("hello, world")
	limited := io.LimitReader(mut src, 5)
	expect.Equal(ref limited.Remaining(), ref i64(5))
	head := expect.IsOk(io.ReadAll(mut limited))
	expect.Equal(ref string(head), "hello")
	expect.Equal(ref limited.Remaining(), ref i64(0))
	buf := make([]byte, 4)
	expect.Equal(ref expect.IsOk(limited.Read(mut buf)), ref 0) // the limit holds
	rest := expect.IsOk(io.ReadAll(mut src))                  // the reader goes on from the limit
	expect.Equal(ref string(rest), ", world")
	none := strings.NewReader("x")
	empty := io.LimitReader(mut none, 0)
	expect.Equal(ref expect.IsOk(empty.Read(mut buf)), ref 0)
	negative := io.LimitReader(mut none, -3)
	expect.Equal(ref expect.IsOk(negative.Read(mut buf)), ref 0)
	short := strings.NewReader("ab")
	wide := io.LimitReader(mut short, 100) // a limit past the end: the end comes first
	expect.Equal(ref string(expect.IsOk(io.ReadAll(mut wide))), "ab")
	expect.Equal(ref wide.Remaining(), ref i64(98))
}

// A ChainReader reads its first reader to the end, then its second, a
// read never spanning the two, and an empty buffer asks it nothing; one
// of a chain reads three.
func TestChainReader() {
	both := io.ChainReader(strings.NewReader("head|"), strings.NewReader("body"))
	none := make([]byte, 0)
	expect.Equal(ref expect.IsOk(both.Read(mut none)), ref 0) // an empty buffer: nothing read, nothing lost
	expect.Equal(ref string(expect.IsOk(io.ReadAll(mut both))), "head|body")
	buf := make([]byte, 4)
	expect.Equal(ref expect.IsOk(both.Read(mut buf)), ref 0)
	cut := io.ChainReader(strings.NewReader("ab"), strings.NewReader("cd"))
	expect.Equal(ref expect.IsOk(cut.Read(mut buf)), ref 2) // not spanning the two
	expect.Equal(ref expect.IsOk(cut.Read(mut buf)), ref 2)
	expect.Equal(ref expect.IsOk(cut.Read(mut buf)), ref 0)
	three := io.ChainReader(io.ChainReader(strings.NewReader("1"), strings.NewReader("2")), strings.NewReader("3"))
	expect.Equal(ref string(expect.IsOk(io.ReadAll(mut three))), "123")
	empty := io.ChainReader(strings.NewReader(""), strings.NewReader("x"))
	expect.Equal(ref string(expect.IsOk(io.ReadAll(mut empty))), "x")
	src := strings.NewReader("abcdef")
	limited := io.ChainReader(io.LimitReader(mut src, 3), strings.NewReader("|")) // a reader holding a borrow, chained
	expect.Equal(ref string(expect.IsOk(io.ReadAll(mut limited))), "abc|")
}

// CopyN copies the count asked for and no more, and reports a source
// that ends first with the count it managed.
func TestCopyN() {
	src := strings.NewReader("hello, world")
	var dst bytes.Buffer
	expect.Equal(ref expect.IsOk(io.CopyN(mut dst, mut src, 5)), ref i64(5))
	expect.Equal(ref dst.String(), "hello")
	expect.Equal(ref string(expect.IsOk(io.ReadAll(mut src))), ", world") // the source goes on from there
	short := strings.NewReader("ab")
	var sink io.Discard
	e := expect.IsErr(io.CopyN(mut sink, mut short, 5))
	expect.True(e.Kind() == io.UnexpectedEOF)
	expect.Equal(ref e.Written(), ref 2)
	expect.Equal(ref expect.IsOk(io.CopyN(mut sink, mut short, 0)), ref i64(0))
	expect.Equal(ref expect.IsOk(io.CopyN(mut sink, mut short, -4)), ref i64(0)) // zero or less copies nothing
}

// WriteString hands a writer the string's bytes with no copy.
func TestWriteString() {
	var b bytes.Buffer
	expect.Equal(ref expect.IsOk(io.WriteString(mut b, "héllo")), ref 6)
	expect.Equal(ref expect.IsOk(io.WriteString(mut b, "")), ref 0)
	expect.Equal(ref b.String(), "héllo")
	var sink io.Discard
	expect.Equal(ref expect.IsOk(io.WriteString(mut sink, "gone")), ref 4)
	view := "bytes".Bytes()
	expect.Equal(ref len(view), ref 5)
	expect.Equal(ref view[0], ref byte('b'))
	expect.True(view.Equal(ref []byte("bytes")))
}

// BenchmarkCopyN measures a copy of 32 MB from a string into Discard,
// 32 KiB a step.
func BenchmarkCopyN() {
	var b strings.Builder
	b.Grow(32 * 1024 * 1024)
	for i := 0; i < 32*1024*1024/64; i++ {
		b.WriteString("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
	}

	text := b.String()
	var sink io.Discard
	for testing.Loop() {
		src := strings.NewReader(text.Clone())
		_ = io.CopyN(mut sink, mut src, 32*1024*1024)
	}
}

// BenchmarkWriteString measures a line written into a buffer with no
// copy of the string.
func BenchmarkWriteString() {
	var buf bytes.Buffer
	for testing.Loop() {
		if buf.Len() > 1<<20 {
			buf.Reset()
		}

		_ = io.WriteString(mut buf, "GET /index.html HTTP/1.1\r\nHost: example.com\r\n\r\n")
	}
}
