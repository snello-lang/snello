package sync_test

import ("expect"; "sync"; "testing")

// How many adds each task of a test makes to the value the tasks share,
// so that the total the test expects is the tasks times the adds.
const counterAdds = 10000
const mutexAdds = 1000

// A Point is a value of more than one word an Atomic holds.
struct Point impl Eq, Clone {
	x int
	y int
}

// TestArc shares a value between handles, one of them in another task.
func TestArc() {
	a := sync.NewArc("shared".Clone())
	expect.Equal(ref a.Count(), ref i64(1))
	b := a.Clone()
	expect.Equal(ref a.Count(), ref i64(2))
	expect.Equal(a.Get(), "shared")
	expect.Equal(b.Get(), "shared")
	done := make(chan i64, 1)
	spawn func(h sync.Arc<string>, out chan<- i64) { out <- i64(h.Get().Len()) }(b, done.Clone())
	expect.Equal(ref (<-done ?? 0), ref i64(6))
}

// TestCounter loads, adds to, stores and swaps a Counter in one task.
func TestCounter() {
	c := sync.NewCounter(5)
	expect.Equal(ref c.Load(), ref 5)
	expect.Equal(ref c.Add(2), ref 7)
	expect.Equal(ref c.Add(-7), ref 0)
	c.Store(9)
	expect.True(c.CompareAndSwap(9, 10))
	expect.False(c.CompareAndSwap(9, 11))
	expect.Equal(ref c.Load(), ref 10)
}

// TestCounterFromTasks adds to one Counter from two tasks at once and
// loses no add.
func TestCounterFromTasks() {
	hits := sync.NewArc(sync.NewCounter(0))
	done := make(chan (), 2)
	for i := 0; i < 2; i++ {
		spawn func(h sync.Arc<sync.Counter>, out chan<- ()) {
			for n := 0; n < counterAdds; n++ { h.Get().Add(1) }
			out <- ()
		}(hits.Clone(), done.Clone())
	}

	<-done
	<-done
	expect.Equal(ref hits.Get().Load(), ref (2 * counterAdds))
}

// TestAtomic loads, stores, swaps and compares-and-swaps a string, a
// struct and a bool.
func TestAtomic() {
	s := sync.NewAtomic("idle".Clone())
	expect.Equal(ref s.Load(), "idle")
	expect.True(s.CompareAndSwap("idle", "busy".Clone()))
	expect.False(s.CompareAndSwap("idle", "late".Clone()))
	expect.Equal(ref s.Swap("done".Clone()), "busy")
	s.Store("over".Clone())
	expect.Equal(ref s.Load(), "over")
	p := sync.NewAtomic(Point{x: 1, y: 2})
	expect.Equal(ref p.Swap(Point{x: 3, y: 4}), ref Point{x: 1, y: 2})
	expect.Equal(ref p.Load(), ref Point{x: 3, y: 4})
	flag := sync.NewAtomic(false)
	expect.True(flag.CompareAndSwap(ref false, true))
	expect.True(flag.Load())
}

// TestMutexFromTasks changes one value under a Mutex from four tasks a
// WaitGroup waits for, and loses no change.
func TestMutexFromTasks() {
	total := sync.NewArc(sync.NewMutex(0))
	wg := sync.NewWaitGroup()
	for i := 0; i < 4; i++ {
		t := total.Clone()
		w := wg.Clone()
		wg.Add(1)
		spawn func() {
			for n := 0; n < mutexAdds; n++ {
				g := t.Get().Lock()
				*g.Get() += 1
			}

			w.Done()
		}()
	}

	wg.Wait()
	expect.Equal(ref *total.Get().Lock().Get(), ref (4 * mutexAdds))
}

// TestRwLock holds two ReadGuards on one RwLock at once.
func TestRwLock() {
	l := sync.NewRwLock([]int{1, 2, 3})
	r := l.Read()
	expect.Equal(ref len(r.Get()), ref 3)
	r2 := l.Read()
	expect.Equal(ref r2.Get()[0], ref 1)
}

// TestRwLockWrite changes the value through the Guard Write returns.
func TestRwLockWrite() {
	l := sync.NewRwLock([]int{1, 2, 3})
	w := l.Write()
	w.Get().Push(4)
	expect.Equal(ref len(w.Get()), ref 4)
}

// TestOnce runs the first function given to Do and not the second.
func TestOnce() {
	calls := sync.NewCounter(0)
	once := sync.NewOnce()
	once.Do(func() { calls.Add(1) })
	once.Do(func() { calls.Add(1) })
	expect.Equal(ref calls.Load(), ref 1)
}

// TestWaitGroupCount refuses a count below zero and leaves the count
// as it was.
func TestWaitGroupCount() {
	wg := sync.NewWaitGroup()
	expect.False(wg.Done()) // no Add before it: the count stays at zero
	expect.True(wg.Add(2))
	expect.False(wg.Add(-3)) // below zero: refused, the count still 2
	expect.True(wg.Done())
	expect.True(wg.Done())
	expect.False(wg.Done())
	wg.Wait() // at zero, so it returns at once
}

// BenchmarkCounterAdd measures one Add on a Counter no other task
// touches.
func BenchmarkCounterAdd() {
	c := sync.NewCounter(0)
	for testing.Loop() { c.Add(1) }
}

// BenchmarkMutexLock measures a Lock, a change and the unlock of a
// Mutex no other task holds.
func BenchmarkMutexLock() {
	m := sync.NewMutex(0)
	for testing.Loop() {
		g := m.Lock()
		*g.Get() += 1
	}
}

// TestCounterSwap sets a Counter and returns the count it replaced.
func TestCounterSwap() {
	c := sync.NewCounter(3)
	expect.Equal(ref c.Swap(10), ref 3)
	expect.Equal(ref c.Load(), ref 10)
	expect.Equal(ref c.Swap(0), ref 10)
}

// TestWaitGroupGo runs tasks with Go, a handle or a tuple of handles
// moved into each, and waits for every one.
func TestWaitGroupGo() {
	hits := sync.NewArc(sync.NewCounter(0))
	wg := sync.NewWaitGroup()
	for i := 0; i < 8; i++ {
		wg.Spawn(func(h sync.Arc<sync.Counter>) { h.Get().Add(1) }, hits.Clone())
	}

	wg.Spawn(func(p (sync.Arc<sync.Counter>, int)) {
		if (h, n) := Some(p) {
			h.Get().Add(n)
		}
	}, (hits.Clone(), 2))

	wg.Wait()
	expect.Equal(ref hits.Get().Load(), ref 10)
}
