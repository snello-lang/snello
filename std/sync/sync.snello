// Package sync shares a value between tasks. An Arc<T> is a handle on
// a value that lives until the last handle to it is dropped, as an
// rc.Rc is, with a count that several tasks may change at once; it
// lends its value for reading to every handle, and never for changing,
// since a change through one handle while another task reads is the
// race the language refuses. A value that must change while shared is
// put in a Mutex<T> or an RwLock<T>, which own it and lend it only
// through a guard: Lock, Read and Write take the lock and return a
// guard holding the borrow, and the guard gives the lock back when it
// is dropped, at the end of its scope, so the lock cannot be forgotten
// and the value cannot be reached without it. A Once runs a function
// the first time it is asked and never again; a WaitGroup counts tasks
// and waits for the count to reach zero.
//
// Arc<T>, Mutex<T> and RwLock<T> are Send when T is, which is what
// lets an Arc<Mutex<T>> be cloned into every task that shares the
// value. A Mutex and an RwLock hold only a value that is Send: they are
// for sharing between tasks, and a lock around a value that must stay
// in its task, an rc.Rc, would be a way to change a value its handles
// share, and so to close a cycle of them that is never released. A
// guard holds a borrow and so stays in the task and the scope that
// took it. A WaitGroup is an owned handle, as a channel is: a task is
// given its own with Clone, and the counter is freed with the last.
//
// None of these types has a zero value: each implements Drop, or holds
// one that does, so var m Mutex<int> is refused and a handle comes only
// from its New function. A handle holds its cell by address, which no
// empty state stands in for, so no operation on one has a case for a
// handle without its value.
package sync

// An Arc is a handle on a shared value, one of its owners, that may
// be in another task than its clones. It is moved, cloned for another
// owner and lent with ref; when it goes out of scope the count goes
// down, and the value is dropped with the last handle. Its T needs no
// Send bound where a Mutex's and an RwLock's do: an Arc lends its value
// only as a ref, so no link can be set through a handle, and a cycle
// of handles that is never released cannot be built without a lock,
// whose own T is Send.
//
//	total := sync.NewArc(sync.NewMutex(0))
//	spawn work(total.Clone()) // the task holds a handle of its own
struct Arc<T> impl Clone, Drop {
	cell     int            // the address of the shared cell, which no one handle owns
	cellType [0]*arcCell<T> // holds nothing: it gives the handle the cell's type, so that an Arc is Send as its value is, and a pointer, so that a value may hold an Arc of its own type
}

// A Counter is an int that several tasks add to as one step each, a
// count of requests, a generation, a size: Add, Load, Store, Swap and
// CompareAndSwap take a ref, since the counter itself is what makes a
// change through a ref safe, as a lock is, and each is one instruction
// on a word of the runtime's that the handle names, so a Counter is
// Send and a package variable may hold one, which every task reaches
// and none can race on. It has no zero value: one comes only from
// NewCounter.
//
//	var hits = sync.NewCounter(0)
//	hits.Add(1)
struct Counter impl Drop {
	handle int
}

// An Atomic<T> holds a value of any type that several tasks read and
// replace as one step each: a flag, a name, a configuration, a
// snapshot. Load gives a copy of the value, Store and Swap replace it,
// and CompareAndSwap replaces it when it equals the value expected;
// each is one indivisible step, under a lock of the runtime's that the
// Atomic owns, which is what one word of hardware cannot give a value
// of any size. T is Send, since the value is shared between tasks,
// Clone, since Load hands out a copy, and Eq, for CompareAndSwap. The
// methods take a ref, as a lock's do, so a package variable may hold
// one, reached by every task and raced on by none; a value that is
// only a count is a Counter, which adds in one instruction.
//
//	var state = sync.NewAtomic("idle".Clone())
//	state.Store("busy".Clone())
struct Atomic<T: Send + Clone + Eq> {
	mutex Mutex<T>
}

// A Mutex owns a value and lends it for changing to one task at a
// time: Lock waits for the lock, takes it, and returns a Guard holding
// a mut borrow of the value; the lock is given back when the Guard is
// dropped. A Mutex is moved, or lent with ref, which is how an
// Arc<Mutex<T>> lends it to every task holding a handle. When it goes
// out of scope the value is dropped with it.
//
//	m := sync.NewMutex([]int{})
//	g := m.Lock()
//	g.Get().Push(1) // the lock is given back when g goes
struct Mutex<T: Send> impl Drop {
	box     int        // the address of the box, the lock and the value
	boxType [0]*box<T> // holds nothing: it gives the lock the box's type, so that it is Send as its value is
}

// A Guard holds a lock and the mut borrow of the value under it, from
// Mutex.Lock or RwLock.Write until the Guard is dropped, which gives
// the lock back. Get lends the value: *g.Get() += 1 changes a number,
// g.Get().Push(v) a slice. A Guard is tied to the lock it came from,
// as any borrow is, and cannot be stored or sent.
struct Guard<T> impl Drop {
	lock  int
	value mut T
}

// An RwLock owns a value and lends it either for reading to any number
// of tasks at once, with Read, or for changing to one task alone, with
// Write; a writer waits for the readers to finish, and readers wait
// for a writer, including one that is waiting, so that readers cannot
// keep a writer out for ever. Like a Mutex it is moved or lent with
// ref, and drops its value with itself.
//
//	l := sync.NewRwLock(config)
//	r := l.Read()
//	fmt.Println(r.Get().name)
struct RwLock<T: Send> impl Drop {
	box     int        // the address of the box, the lock and the value
	boxType [0]*box<T> // holds nothing: it gives the lock the box's type, so that it is Send as its value is
}

// A ReadGuard holds a lock for reading and the ref borrow of the value
// under it, from RwLock.Read until the ReadGuard is dropped, which
// gives the lock back. Like a Guard it cannot be stored or sent.
struct ReadGuard<T> impl Drop {
	lock  int
	value ref T
}

// A Once runs one function once: the first Do runs it, and every Do
// after, in any task, returns without running anything, after the
// first has finished. It is lent with ref, which is how an Arc shares
// it.
//
//	once := sync.NewOnce()
//	once.Do(func() { setup() })
struct Once {
	done Mutex<bool>
}

// A WaitGroup counts the tasks a program waits for: Add counts tasks
// in, Done counts one out, and Wait returns once the count is zero. It
// is a handle on a counter the runtime keeps, shared through an Arc:
// Clone gives another handle on the same count, which a task is given
// before the spawn so that it counts itself out on the one the program
// waits on, and the last handle to go frees the counter. Add, Done and
// Wait borrow the handle; Go counts a task in, spawns it and counts it
// out in one call.
//
//	wg := sync.NewWaitGroup()
//	wg.Spawn(func(h sync.Arc<sync.Counter>) { h.Get().Add(1) }, hits.Clone())
//	wg.Wait()
struct WaitGroup impl Clone {
	counter Arc<waitCounter>
}

// An arcCell is what the handles on one value share: the value, and the
// count of handles, changed atomically so that handles in different
// tasks may be cloned and dropped at the same moment.
struct arcCell<T> {
	count i64
	value T
}

// A box holds the value a lock protects, with the handle of the
// runtime's lock. It lives on the heap, behind a pointer the Mutex or
// RwLock owns, so that the one value is reached through any borrow of
// the lock.
struct box<T> {
	lock  int
	value T
}

// A waitCounter is the runtime's lock a WaitGroup counts with, freed
// when the last handle on it drops it.
struct waitCounter impl Drop {
	lock int
}

// NewArc puts v in a new shared cell and returns the first handle on
// it, with a count of one. It takes v, owned: the value lives in the
// cell until the last handle is dropped. It allocates the cell, once;
// Clone allocates nothing.
//
//	a := sync.NewArc("shared".Clone())
func NewArc<T>(v T) Arc<T> {
	return Arc<T>{cellType: [0]*arcCell<T>{}, cell: rawNew<arcCell<T>>(arcCell<T>{count: 1, value: v})}
}

// Get lends the value for reading, for as long as the Arc is lent.
// Every handle, in any task, may lend it at once; none copies it.
//
//	n := a.Get().Len()
func (a ref Arc<T>) Get() ref T {
	return ref rawMut<arcCell<T>, Arc<T>>(a.cell, a).value
}

// Clone returns another handle on the same value and counts it with one
// atomic add: the value is not copied and nothing is allocated. The
// clone may be moved into another task when T is Send.
func (a ref Arc<T>) Clone() Arc<T> {
	atomicAdd(mut rawMut<arcCell<T>, Arc<T>>(a.cell, a).count, 1)
	return Arc<T>{cellType: [0]*arcCell<T>{}, cell: a.cell}
}

// Count returns how many handles the value has, this one included.
// Another task may clone or drop a handle right after, so the count is
// a reading, not a promise.
func (a ref Arc<T>) Count() i64 {
	return atomicAdd(mut rawMut<arcCell<T>, Arc<T>>(a.cell, a).count, 0) // read as one step, as the adds that change it write
}

// Drop gives up this handle, with one atomic add: the value and its
// cell are dropped with the last one, in whichever task drops it. The
// compiler calls it when the Arc goes out of scope.
func (a mut Arc<T>) Drop() {
	if atomicAdd(mut rawMut<arcCell<T>, Arc<T>>(a.cell, a).count, -1) == 0 {
		_ = rawTake<arcCell<T>>(a.cell) // the last handle: the cell is freed and the value dropped with it
	}
}

// NewCounter returns a Counter holding v. It allocates the counter's
// word, which Drop frees.
//
//	requests := sync.NewCounter(0)
func NewCounter(v int) Counter {
	return Counter{handle: cellNew(i64(v))}
}

// Add adds d, which may be negative, to the count as one step and
// returns the count after it. It is one atomic instruction and never
// blocks.
//
//	id := next.Add(1)
func (c ref Counter) Add(d int) int {
	return int(cellAdd(c.handle, i64(d)))
}

// Load returns the count as one step, which no Add or Store tears. It
// never blocks.
func (c ref Counter) Load() int {
	return int(cellLoad(c.handle))
}

// Store sets the count to v as one step. It never blocks.
func (c ref Counter) Store(v int) {
	cellStore(c.handle, i64(v))
}

// CompareAndSwap sets the count to new when it is old, as one step,
// and reports whether it did: how one task of many takes a turn. It
// never blocks.
//
//	if turn.CompareAndSwap(0, 1) {
//		// this task won the turn
//	}
func (c ref Counter) CompareAndSwap(old int, new int) bool {
	return cellSwap(c.handle, i64(old), i64(new))
}

// Swap sets the count to v as one step and returns the count it
// replaced: how one task of many takes what was counted and leaves
// nothing. It never blocks.
//
//	pending := counted.Swap(0)
func (c ref Counter) Swap(v int) int {
	return int(cellExchange(c.handle, i64(v)))
}

// Drop frees the counter's word. The compiler calls it when the Counter
// goes out of scope.
func (c mut Counter) Drop() {
	cellFree(c.handle)
}

// NewAtomic returns an Atomic holding v, which it takes, owned. It
// allocates the lock and the box that holds v.
//
//	flag := sync.NewAtomic(false)
func NewAtomic<T: Send + Clone + Eq>(v T) Atomic<T> {
	return Atomic<T>{mutex: NewMutex(v)}
}

// Load returns a copy of the value, made by its Clone under the lock:
// the caller owns the copy, and a later Store does not change it. It
// blocks while another task holds the lock.
func (a ref Atomic<T>) Load() T {
	g := a.mutex.Lock()
	return g.Get().Clone()
}

// Store replaces the value with v, which it takes, owned, and drops the
// old one, under the lock. It blocks while another task holds the lock.
func (a ref Atomic<T>) Store(v T) {
	g := a.mutex.Lock()
	*g.Get() = v
}

// Swap replaces the value with v, which it takes, owned, and returns
// the old one, moved out from under the lock with no copy. It blocks
// while another task holds the lock.
//
//	last := state.Swap("idle".Clone())
func (a ref Atomic<T>) Swap(v T) T {
	g := a.mutex.Lock()
	return replace(mut *g.Get(), v)
}

// CompareAndSwap replaces the value with new when it equals old, by
// its Eq, as one step, and reports whether it did. It reads old, lent,
// and takes new, owned, either way, dropping it when the value was not
// old. It blocks while another task holds the lock.
//
//	if state.CompareAndSwap("idle", "busy".Clone()) {
//		// this task moved the state from idle to busy
//	}
func (a ref Atomic<T>) CompareAndSwap(old ref T, new T) bool {
	g := a.mutex.Lock()
	if !g.Get().Eq(old) {
		return false
	}

	*g.Get() = new
	return true
}

// NewMutex puts v behind a new lock. It takes v, owned: the Mutex holds
// it until it is dropped, and lends it only through Lock. It allocates
// the lock and the box that holds v, once.
//
//	m := sync.NewMutex(0)
func NewMutex<T: Send>(v T) Mutex<T> {
	return Mutex<T>{boxType: [0]*box<T>{}, box: rawNew<box<T>>(box<T>{lock: newLock(), value: v})}
}

// Lock waits until no other task holds the lock, takes it, and returns
// the Guard that holds it and lends the value for changing; the lock is
// given back when the Guard is dropped. It blocks, parking the task,
// while another task holds the lock; a task that calls Lock again while
// its own Guard lives waits for ever.
//
//	g := m.Lock()
//	*g.Get() += 1
func (m ref Mutex<T>) Lock() Guard<T> {
	return lockBox(rawMut<box<T>, Mutex<T>>(m.box, m))
}

// Drop releases the runtime's lock and drops the value with the box.
// The compiler calls it when the Mutex goes out of scope, when no Guard
// on it lives any more.
func (m mut Mutex<T>) Drop() {
	b := rawTake<box<T>>(m.box)
	freeLock(b.lock)
}

// Get lends the value under the lock for changing, for as long as the
// Guard is lent.
//
//	g.Get().Push(4)
func (g mut Guard<T>) Get() mut T {
	return mut g.value
}

// Drop gives the lock back, waking a task that waits for it. The
// compiler calls it when the Guard goes out of scope.
func (g mut Guard<T>) Drop() {
	unlock(g.lock)
}

// NewRwLock puts v behind a new lock for readers and writers. It takes
// v, owned: the RwLock holds it until it is dropped, and lends it only
// through Read and Write. It allocates the lock and the box that holds
// v, once.
//
//	l := sync.NewRwLock([]int{1, 2, 3})
func NewRwLock<T: Send>(v T) RwLock<T> {
	return RwLock<T>{boxType: [0]*box<T>{}, box: rawNew<box<T>>(box<T>{lock: newRwLock(), value: v})}
}

// Read waits until no task holds the lock for writing, or waits to,
// takes it for reading, and returns the ReadGuard that holds it and
// lends the value for reading; other readers may hold it at the same
// time. It blocks while a writer holds the lock or waits for it; a task
// that calls Read again while its own ReadGuard lives may wait for ever
// behind a writer.
//
//	r := l.Read()
//	n := len(r.Get())
func (l ref RwLock<T>) Read() ReadGuard<T> {
	h := rawMut<box<T>, RwLock<T>>(l.box, l).lock
	lockShared(h)
	return ReadGuard<T>{lock: h, value: ref rawMut<box<T>, RwLock<T>>(l.box, l).value} // lent once the lock is held, so that it is the value as the lock keeps it
}

// Write waits until no task holds the lock at all, takes it for
// writing, and returns the Guard that holds it and lends the value for
// changing. It blocks while any reader or writer holds the lock.
//
//	w := l.Write()
//	w.Get().Push(4)
func (l ref RwLock<T>) Write() Guard<T> {
	return lockBox(rawMut<box<T>, RwLock<T>>(l.box, l))
}

// Drop releases the runtime's lock and drops the value with the box.
// The compiler calls it when the RwLock goes out of scope, when no
// guard on it lives any more.
func (l mut RwLock<T>) Drop() {
	b := rawTake<box<T>>(l.box)
	freeLock(b.lock)
}

// Get lends the value under the lock for reading, for as long as the
// ReadGuard is lent.
func (g ref ReadGuard<T>) Get() ref T {
	return g.value
}

// Drop gives the lock for reading back; the last reader to go wakes a
// writer that waits. The compiler calls it when the ReadGuard goes out
// of scope.
func (g mut ReadGuard<T>) Drop() {
	unlockShared(g.lock)
}

// NewOnce returns a Once that has run nothing yet. It allocates the
// lock it runs under.
func NewOnce() Once {
	return Once{done: NewMutex(false)}
}

// Do runs f if no Do on this Once has run a function before, and waits
// for that run to finish otherwise: it blocks while another task's Do
// runs its f. f is run at most once over the life of the Once, in the
// task of the first Do. A Do called from inside f waits for ever.
//
//	once.Do(func() { fmt.Println("once") })
func (o ref Once) Do(f func()) {
	g := o.done.Lock()
	if !*g.Get() {
		f()
		*g.Get() = true
	}
}

// NewWaitGroup returns a WaitGroup counting nothing. It allocates the
// runtime's counter, which the last handle frees.
func NewWaitGroup() WaitGroup {
	return WaitGroup{counter: NewArc(waitCounter{lock: newLock()})}
}

// Add adds n, which may be negative, to the count, and reports whether
// it did: false, with the count left as it was, when the count would go
// below zero, a Done with no Add before it, or past what an int holds.
// Add is called before the task it counts is spawned, so that Wait
// cannot return between the spawn and the Add. A count that reaches
// zero wakes every task in Wait.
//
//	wg.Add(1)
//	spawn work(wg.Clone())
func (w ref WaitGroup) Add(n int) bool {
	return count(w.lockHandle(), n)
}

// Done counts one task out, Add(-1), and reports whether it did: false
// when the count is zero already.
func (w ref WaitGroup) Done() bool {
	return count(w.lockHandle(), -1)
}

// Wait returns once the count is zero, at once when it already is; it
// blocks, parking the task, until then.
func (w ref WaitGroup) Wait() {
	wait(w.lockHandle())
}

// Spawn runs f(a) in a task of its own, as spawn f(a) does, counted in
// the group: one is added before the task starts and counted out when f
// returns, so a Wait waits for it. The task's value a is moved into the
// task, as the argument of a spawned call is, so it must be Send; what
// the task needs goes there, a handle or a tuple of them, since a
// closure stored in a func value captures copies alone, and f itself
// captures nothing but copies. It returns at once, without waiting for
// the task, and allocates the task and a handle on the group for it.
//
//	wg.Spawn(func(h sync.Arc<Counter>) { h.Get().Add(1) }, hits.Clone())
//	wg.Wait()
func (w ref WaitGroup) Spawn<A: Send>(f func(A), a A) {
	w.Add(1)
	spawn runCounted(w.Clone(), f, a)
}

// Drop frees the runtime's lock, when the last WaitGroup handle drops
// the counter.
func (c mut waitCounter) Drop() {
	freeLock(c.lock)
}

// lockHandle returns the handle of the runtime's lock the group counts
// with.
func (w ref WaitGroup) lockHandle() int {
	return w.counter.Get().lock
}

// runCounted runs f on a, then counts one task out of the group done.
func runCounted<A: Send>(done WaitGroup, f func(A), a A) {
	f(a)
	done.Done()
}

// lockBox takes the lock of the box b, for writing, and returns the
// Guard holding it and the value: the one function that steps from the
// box a lock lends to the mut of its value, for Lock and Write alike.
func lockBox<T>(b mut box<T>) Guard<T> {
	lock(b.lock)
	return Guard<T>{lock: b.lock, value: mut b.value}
}

// The functions below without a body are written by the compiler, for
// this package alone: the steps of sharing the language refuses
// elsewhere, which the count and the lock make safe here.

// rawNew moves a cell or a box into a block of its own and returns its
// address.
func rawNew<C>(c C) int

// rawMut lends the block at an address, a mut through a ref, for as
// long as the handle h is lent: its fields are read in place, the value
// changed only under the lock and the count only by an atomic add.
func rawMut<C, H>(at int, h ref H) mut C

// rawTake moves the cell or box out of its block and frees the block,
// for the last handle.
func rawTake<C>(at int) C

// The functions below without a body are the runtime's. A lock is held
// as an int, as a file is, the runtime's own handle on it, never 0, and
// freed by the Mutex, RwLock or WaitGroup counter that owns it.

// newLock makes a lock held by one task at a time and returns its
// handle.
func newLock() int

// newRwLock makes a lock for readers and writers and returns its
// handle.
func newRwLock() int

// freeLock frees the lock h, which no task holds or waits on.
func freeLock(h int)

// lock waits until no other task holds the lock h, and takes it.
func lock(h int)

// unlock gives the lock h back, waking a task that waits for it.
func unlock(h int)

// lockShared waits until no writer holds the lock h or waits for it,
// and takes it for reading.
func lockShared(h int)

// unlockShared gives back the lock h held for reading.
func unlockShared(h int)

// count adds n to the count of the WaitGroup lock h, waking the tasks
// that wait when it reaches zero, and reports whether it did: a count
// that would go below zero, or past what an int holds, is left as it
// was.
func count(h int, n int) bool

// wait waits until the count of the WaitGroup lock h is zero.
func wait(h int)

// atomicAdd adds d to n as one step that no other task's add can
// interleave with, and returns the new value.
func atomicAdd(n mut i64, d i64) i64

// cellNew makes a Counter's word holding v and returns its handle.
func cellNew(v i64) int

// cellLoad reads the word h as one step.
func cellLoad(h int) i64

// cellStore writes v to the word h as one step.
func cellStore(h int, v i64)

// cellAdd adds d to the word h as one step and returns the new value.
func cellAdd(h int, d i64) i64

// cellSwap writes new to the word h when it holds old, as one step,
// and reports whether it did.
func cellSwap(h int, old i64, new i64) bool

// cellExchange writes v to the word h as one step and returns the
// value it replaced.
func cellExchange(h int, v i64) i64

// cellFree frees the word h.
func cellFree(h int)
