// Package sync shares a value between tasks. An Arc<T> is a handle on
// a value that lives until the last handle to it is dropped, as an
// rc.Rc is, with a count that several tasks may change at once; it
// lends its value for reading to every handle, and never for changing,
// since a change through one handle while another task reads is the
// race the language refuses. A value that must change while shared is
// put in a Mutex<T> or an RwLock<T>, which own it and lend it only
// through a guard: Lock, Read and Write take the lock and return a
// guard holding the borrow, and the guard gives the lock back when it
// is dropped, at the end of its scope, so the lock cannot be forgotten
// and the value cannot be reached without it. A Once runs a function
// the first time it is asked and never again; a WaitGroup counts tasks
// and waits for the count to reach zero.
//
// Arc<T>, Mutex<T> and RwLock<T> are Send when T is, which is what
// lets an Arc<Mutex<T>> be cloned into every task that shares the
// value. A Mutex and an RwLock hold only a value that is Send: they are
// for sharing between tasks, and a lock around a value that must stay
// in its task, an rc.Rc, would be a way to change a value its handles
// share, and so to close a cycle of them that is never released. A
// guard holds a borrow and so stays in the task and the scope that
// took it. A WaitGroup is an owned handle, as a channel is: a task is
// given its own with Clone, and the counter is freed with the last.
//
// None of these types has a zero value: each implements Drop, or holds
// one that does, so var m Mutex<int> is refused and a handle comes only
// from its New function. A handle holds its cell by address, which no
// empty state stands in for, so no operation on one has a case for a
// handle without its value.
package sync

// An acell is what the handles on one value share: the value, and the
// count of handles, changed atomically so that handles in different
// tasks may be cloned and dropped at the same moment.
struct acell<T> {
	count i64
	value T
}

// An Arc is a handle on a shared value, one of its owners, that may
// be in another task than its clones. It is moved, cloned for another
// owner and lent with ref; when it goes out of scope the count goes
// down, and the value is dropped with the last handle. Its T needs no
// Send bound where a Mutex's and an RwLock's do: an Arc lends its value
// only as a ref, so no link can be set through a handle, and a cycle
// of handles that is never released cannot be built without a lock,
// whose own T is Send.
struct Arc<T> impl Clone, Drop {
	cell     int          // the address of the shared cell, which no one handle owns
	cellType [0]*acell<T> // holds nothing: it gives the handle the cell's type, so that an Arc is Send as its value is, and a pointer, so that a value may hold an Arc of its own type
}

// NewArc puts v in a new shared cell and returns the first handle on
// it.
func NewArc<T>(v T) Arc<T> {
	return Arc<T>{cellType: [0]*acell<T>{}, cell: rawNew<acell<T>>(acell<T>{count: 1, value: v})}
}

// Get lends the value for reading, for as long as the Arc is lent.
func (a ref Arc<T>) Get() ref T {
	return ref rawMut<acell<T>, Arc<T>>(a.cell, a).value
}

// Clone returns another handle on the same value; the value is not
// copied.
func (a ref Arc<T>) Clone() Arc<T> {
	atomicAdd(mut rawMut<acell<T>, Arc<T>>(a.cell, a).count, 1)
	return Arc<T>{cellType: [0]*acell<T>{}, cell: a.cell}
}

// Count returns how many handles the value has, this one included.
// Another task may clone or drop a handle right after, so the count is
// a reading, not a promise.
func (a ref Arc<T>) Count() i64 {
	return atomicAdd(mut rawMut<acell<T>, Arc<T>>(a.cell, a).count, 0) // read as one step, as the adds that change it write
}

// Drop gives up this handle: the value and its cell are dropped with
// the last one.
func (a mut Arc<T>) Drop() {
	if atomicAdd(mut rawMut<acell<T>, Arc<T>>(a.cell, a).count, -1) == 0 {
		_ = rawTake<acell<T>>(a.cell) // the last handle: the cell is freed and the value dropped with it
	}
}

// A Counter is an int that several tasks add to as one step each, a
// count of requests, a generation, a size: Add, Load, Store and
// CompareAndSwap take a ref, since the counter itself is what makes a
// change through a ref safe, as a lock is, and each is one instruction
// on a word of the runtime's that the handle names, so a Counter is
// Send and a package variable may hold one, var hits = sync.NewCounter(0),
// which every task reaches and none can race on. It has no zero value:
// one comes only from NewCounter.
struct Counter impl Drop {
	h int
}

// NewCounter returns a Counter holding v.
func NewCounter(v int) Counter {
	return Counter{h: cellNew(i64(v))}
}

// Add adds d to the count as one step and returns the new count.
func (c ref Counter) Add(d int) int {
	return int(cellAdd(c.h, i64(d)))
}

// Load returns the count as one step, which no Add or Store tears.
func (c ref Counter) Load() int {
	return int(cellLoad(c.h))
}

// Store sets the count.
func (c ref Counter) Store(v int) {
	cellStore(c.h, i64(v))
}

// CompareAndSwap sets the count to new when it is old, as one step,
// and reports whether it did: how one task of many takes a turn.
func (c ref Counter) CompareAndSwap(old int, new int) bool {
	return cellSwap(c.h, i64(old), i64(new))
}

// Swap sets the count to v as one step and returns the count it
// replaced: how one task of many takes what was counted and leaves
// nothing.
func (c ref Counter) Swap(v int) int {
	return int(cellExchange(c.h, i64(v)))
}

// Drop frees the word.
func (c mut Counter) Drop() {
	cellFree(c.h)
}

// An Atomic<T> holds a value of any type that several tasks read and
// replace as one step each: a flag, a name, a configuration, a
// snapshot. Load gives a copy of the value, Store and Swap replace it,
// and CompareAndSwap replaces it when it equals the value expected;
// each is one indivisible step, under a lock of the runtime's that the
// Atomic owns, which is what one word of hardware cannot give a value
// of any size. T is Send, since the value is shared between tasks,
// Clone, since Load hands out a copy, and Eq, for CompareAndSwap. The
// methods take a ref, as a lock's do, so a package variable may hold
// one, var state = sync.NewAtomic("idle"), reached by every task and
// raced on by none; a value that is only a count is a Counter, which
// adds in one instruction.
struct Atomic<T: Send + Clone + Eq> {
	m Mutex<T>
}

// NewAtomic returns an Atomic holding v.
func NewAtomic<T: Send + Clone + Eq>(v T) Atomic<T> {
	return Atomic<T>{m: NewMutex(v)}
}

// Load returns a copy of the value.
func (a ref Atomic<T>) Load() T {
	g := a.m.Lock()
	return g.Get().Clone()
}

// Store replaces the value, dropping the old one.
func (a ref Atomic<T>) Store(v T) {
	g := a.m.Lock()
	*g.Get() = v
}

// Swap replaces the value and returns the old one, moved out from
// under the lock with v left in its place.
func (a ref Atomic<T>) Swap(v T) T {
	g := a.m.Lock()
	return replace(mut *g.Get(), v)
}

// CompareAndSwap replaces the value with new when it equals old, as
// one step, and reports whether it did; new is taken either way, and
// dropped when the value was not old.
func (a ref Atomic<T>) CompareAndSwap(old ref T, new T) bool {
	g := a.m.Lock()
	if !g.Get().Eq(old) {
		return false
	}

	*g.Get() = new
	return true
}

// A box holds the value a lock protects, with the handle of the
// runtime's lock. It lives on the heap, behind a pointer the Mutex or
// RwLock owns, so that the one value is reached through any borrow of
// the lock.
struct box<T> {
	lock  int
	value T
}

// A Mutex owns a value and lends it for changing to one task at a
// time: Lock waits for the lock, takes it, and returns a Guard holding
// a mut borrow of the value; the lock is given back when the Guard is
// dropped. A Mutex is moved, or lent with ref, which is how an
// Arc<Mutex<T>> lends it to every task holding a handle. When it goes
// out of scope the value is dropped with it.
struct Mutex<T: Send> impl Drop {
	box     int        // the address of the box, the lock and the value
	boxType [0]*box<T> // holds nothing: it gives the lock the box's type, so that it is Send as its value is
}

// NewMutex puts v behind a new lock.
func NewMutex<T: Send>(v T) Mutex<T> {
	return Mutex<T>{boxType: [0]*box<T>{}, box: rawNew<box<T>>(box<T>{lock: newLock(), value: v})}
}

// Lock waits until no other task holds the lock, takes it, and returns
// the Guard that holds it.
func (m ref Mutex<T>) Lock() Guard<T> {
	return guard(rawMut<box<T>, Mutex<T>>(m.box, m))
}

// Drop releases the runtime's lock and drops the value with the box.
func (m mut Mutex<T>) Drop() {
	b := rawTake<box<T>>(m.box)
	freeLock(b.lock)
}

// A Guard holds a lock and the mut borrow of the value under it, from
// Lock or Write until the Guard is dropped. Get lends the value: *g.Get()
// += 1 changes a number, g.Get().Push(v) a slice. A Guard is tied to
// the lock it came from, as any borrow is, and cannot be stored or
// sent.
struct Guard<T> impl Drop {
	lock int
	v    mut T
}

// Get lends the value for changing, for as long as the Guard is lent.
func (g mut Guard<T>) Get() mut T {
	return mut g.v
}

// Drop gives the lock back.
func (g mut Guard<T>) Drop() {
	unlock(g.lock)
}

// An RwLock owns a value and lends it either for reading to any number
// of tasks at once, with Read, or for changing to one task alone, with
// Write; a writer waits for the readers to finish, and readers wait
// for a writer. Like a Mutex it is moved or lent with ref, and drops
// its value with itself.
struct RwLock<T: Send> impl Drop {
	box     int        // the address of the box, the lock and the value
	boxType [0]*box<T> // holds nothing: it gives the lock the box's type, so that it is Send as its value is
}

// NewRwLock puts v behind a new lock.
func NewRwLock<T: Send>(v T) RwLock<T> {
	return RwLock<T>{boxType: [0]*box<T>{}, box: rawNew<box<T>>(box<T>{lock: newRwLock(), value: v})}
}

// Read waits until no task holds the lock for writing, takes it for
// reading, and returns the ReadGuard that holds it.
func (l ref RwLock<T>) Read() ReadGuard<T> {
	h := rawMut<box<T>, RwLock<T>>(l.box, l).lock
	lockShared(h)
	return ReadGuard<T>{lock: h, v: ref rawMut<box<T>, RwLock<T>>(l.box, l).value} // lent once the lock is held, so that it is the value as the lock keeps it
}

// Write waits until no task holds the lock at all, takes it for
// writing, and returns the Guard that holds it.
func (l ref RwLock<T>) Write() Guard<T> {
	return guard(rawMut<box<T>, RwLock<T>>(l.box, l))
}

// Drop releases the runtime's lock and drops the value with the box.
func (l mut RwLock<T>) Drop() {
	b := rawTake<box<T>>(l.box)
	freeLock(b.lock)
}

// A ReadGuard holds a lock for reading and the ref borrow of the value
// under it, from Read until the ReadGuard is dropped.
struct ReadGuard<T> impl Drop {
	lock int
	v    ref T
}

// Get lends the value for reading, for as long as the ReadGuard is
// lent.
func (g ref ReadGuard<T>) Get() ref T {
	return g.v
}

// Drop gives the lock back.
func (g mut ReadGuard<T>) Drop() {
	unlockShared(g.lock)
}

// A Once runs one function once: the first Do runs it, and every Do
// after, in any task, returns without running anything, after the
// first has finished. It is lent with ref, which is how an Arc shares
// it.
struct Once {
	done Mutex<bool>
}

// NewOnce returns a Once that has run nothing yet.
func NewOnce() Once {
	return Once{done: NewMutex(false)}
}

// Do runs f if no Do on this Once has run a function before, and waits
// for that run to finish otherwise. A Do called from inside f waits
// forever.
func (o ref Once) Do(f func()) {
	g := o.done.Lock()
	if !*g.Get() {
		f()
		*g.Get() = true
	}
}

// A WaitGroup counts the tasks a program waits for: Add counts tasks
// in, Done counts one out, and Wait returns once the count is zero. It
// is a handle on a counter the runtime keeps, shared through an Arc:
// Clone gives another handle on the same count, which a task is given
// before the spawn so that it counts itself out on the one the program
// waits on, and the last handle to go frees the counter. Add, Done and
// Wait borrow the handle.
struct WaitGroup impl Clone {
	a Arc<counter>
}

// A counter is the runtime's lock a WaitGroup counts with, freed when
// the last handle on it drops it.
struct counter impl Drop {
	h int
}

func (c mut counter) Drop() {
	freeLock(c.h)
}

// NewWaitGroup returns a WaitGroup counting nothing.
func NewWaitGroup() WaitGroup {
	return WaitGroup{a: NewArc(counter{h: newLock()})}
}

// Add adds n, which may be negative, to the count, and reports whether
// it did: false, with the count left as it was, when the count would go
// below zero, a Done with no Add before it. Add is called before the
// task it counts is spawned, so that Wait cannot return between the
// spawn and the Add.
func (w ref WaitGroup) Add(n int) bool {
	return count(w.handle(), n)
}

// Done counts one task out, Add(-1), and reports whether it did: false
// when the count is zero already.
func (w ref WaitGroup) Done() bool {
	return count(w.handle(), -1)
}

// Wait returns once the count is zero, at once when it already is.
func (w ref WaitGroup) Wait() {
	wait(w.handle())
}

// Go runs f(a) in a task of its own, counted in the group: one is
// added before the task starts and counted out when f returns, so a
// Wait waits for it. The task's value a is moved into the task, as the
// argument of a spawned call is, so it must be Send; what the task needs
// goes there, a handle or a tuple of them, since a closure stored in a
// func value captures copies alone, and f itself captures nothing but
// copies.
//
//	wg.Go(func(h sync.Arc<Counter>) { h.Get().Add(1) }, hits.Clone())
//	wg.Wait()
func (w ref WaitGroup) Go<A: Send>(f func(A), a A) {
	w.Add(1)
	spawn counted(w.Clone(), f, a)
}

// counted runs f on a and counts it out of the group.
func counted<A: Send>(done WaitGroup, f func(A), a A) {
	f(a)
	done.Done()
}

// handle returns the runtime's lock of the group.
func (w ref WaitGroup) handle() int {
	return w.a.Get().h
}

// guard takes the lock of the box b, for writing, and returns the Guard
// holding it and the value: the one function that steps from the box a
// lock lends to the mut of its value, for Lock and Write alike.
func guard<T>(b mut box<T>) Guard<T> {
	lock(b.lock)
	return Guard<T>{lock: b.lock, v: mut b.value}
}

// The compiler writes these for this package alone, the steps sharing
// the language refuses elsewhere, which the count and the lock make
// safe here: rawNew moves a cell or a box into a block of its own and
// returns its address; rawMut lends the block at an address, a mut
// through a ref, for as long as the handle is lent, its fields read in
// place, the value changed only under the lock and the count only by an
// atomic add; and rawTake moves the cell or box out and frees the
// block, for the last handle.
func rawNew<C>(c C) int
func rawMut<C, H>(at int, h ref H) mut C
func rawTake<C>(at int) C

// The runtime provides these. A lock is held as an int, as a file is,
// the runtime's own handle on it, never 0, and freed by the Mutex,
// RwLock or WaitGroup counter that owns it.
// atomicAdd adds d to n as one step that no other task's add can
// interleave with, and returns the new value.
func newLock() int
func newRwLock() int
func freeLock(h int)
func lock(h int)
func unlock(h int)
func lockShared(h int)
func unlockShared(h int)
func count(h int, n int) bool
func wait(h int)
func atomicAdd(n mut i64, d i64) i64
func cellNew(v i64) int
func cellLoad(h int) i64
func cellStore(h int, v i64)
func cellAdd(h int, d i64) i64
func cellSwap(h int, old i64, new i64) bool
func cellExchange(h int, v i64) i64
func cellFree(h int)
