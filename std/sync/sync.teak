// Package sync shares a value between tasks. An Arc<T> is a handle on
// a value that lives until the last handle to it is dropped, as an
// rc.Rc is, with a count that several tasks may change at once; it
// lends its value for reading to every handle, and never for changing,
// since a change through one handle while another task reads is the
// race the language refuses. A value that must change while shared is
// put in a Mutex<T> or an RwLock<T>, which own it and lend it only
// through a guard: Lock, Read and Write take the lock and return a
// guard holding the borrow, and the guard gives the lock back when it
// is dropped, at the end of its scope, so the lock cannot be forgotten
// and the value cannot be reached without it. A Once runs a function
// the first time it is asked and never again; a WaitGroup counts tasks
// and waits for the count to reach zero.
//
// Arc<T>, Mutex<T> and RwLock<T> are Send when T is, which is what
// lets an Arc<Mutex<T>> be cloned into every task that shares the
// value. A guard holds a borrow and so stays in the task and the scope
// that took it. A WaitGroup is a Copy handle, as a channel is: every
// copy names the same counter.
//
// The zero value of an Arc, a Mutex, an RwLock or a Once, var m
// Mutex<int>, is empty: it holds no value, and Get, Lock, Read, Write
// and Do on it panic. A zero WaitGroup counts nothing and Add on it
// panics. Each is made with its New function.
package sync

// An acell is what the handles on one value share: the value, and the
// count of handles, changed atomically so that handles in different
// tasks may be cloned and dropped at the same moment.
struct acell<T> {
	count i64
	value T
}

// An Arc is a handle on a shared value, one of its owners, that may
// be in another task than its clones. It is moved, cloned for another
// owner and lent with ref; when it goes out of scope the count goes
// down, and the value is dropped with the last handle.
struct Arc<T> impl Clone, Drop {
	p *acell<T>?
}

// NewArc puts v in a new shared cell and returns the first handle on
// it.
func NewArc<T>(v T) Arc<T> {
	return Arc<T>{p: Some(&acell<T>{count: 1, value: v})}
}

// Get lends the value for reading, for as long as the Arc is lent. An
// empty handle has no value and panics.
func (a ref Arc<T>) Get() ref T {
	if p := ref a.p {
		return ref p.value
	}

	panic("sync: Get on an empty Arc")
}

// Clone returns another handle on the same value; the value is not
// copied.
func (a ref Arc<T>) Clone() Arc<T> {
	q := retain(a.p) ?? return Arc<T>{p: None}
	atomicAdd(mut q.count, 1)
	return Arc<T>{p: Some(q)}
}

// Count returns how many handles the value has, this one included;
// zero for an empty handle. Another task may clone or drop a handle
// right after, so the count is a reading, not a promise.
func (a ref Arc<T>) Count() i64 {
	if p := ref a.p {
		return p.count
	}

	return 0
}

// Drop gives up this handle: the value and its cell are dropped with
// the last one.
func (a mut Arc<T>) Drop() {
	p := take(mut a.p) ?? return // empty, or dropped already
	if atomicAdd(mut p.count, -1) == 0 {
		return // the last handle: p goes out of scope here and frees the cell, the value with it
	}

	leak(p)
}

// A box holds the value a lock protects, with the handle of the
// runtime's lock. It lives on the heap, behind a pointer the Mutex or
// RwLock owns, so that the one value is reached through any borrow of
// the lock.
struct box<T> {
	lock  int
	value T
}

// A Mutex owns a value and lends it for changing to one task at a
// time: Lock waits for the lock, takes it, and returns a Guard holding
// a mut borrow of the value; the lock is given back when the Guard is
// dropped. A Mutex is moved, or lent with ref, which is how an
// Arc<Mutex<T>> lends it to every task holding a handle. When it goes
// out of scope the value is dropped with it.
struct Mutex<T> impl Drop {
	p *box<T>?
}

// NewMutex puts v behind a new lock.
func NewMutex<T>(v T) Mutex<T> {
	return Mutex<T>{p: Some(&box<T>{lock: newLock(), value: v})}
}

// Lock waits until no other task holds the lock, takes it, and returns
// the Guard that holds it. An empty Mutex panics.
func (m ref Mutex<T>) Lock() Guard<T> {
	if p := ref m.p {
		return guard(p)
	}

	panic("sync: Lock on an empty Mutex")
}

// Drop releases the runtime's lock; the value is dropped with the box.
func (m mut Mutex<T>) Drop() {
	if p := ref m.p {
		freeLock(p.lock)
	}
}

// A Guard holds a lock and the mut borrow of the value under it, from
// Lock or Write until the Guard is dropped. Get lends the value: *g.Get()
// += 1 changes a number, g.Get().Push(v) a slice. A Guard is tied to
// the lock it came from, as any borrow is, and cannot be stored or
// sent.
struct Guard<T> impl Drop {
	lock int
	v    mut T
}

// Get lends the value for changing, for as long as the Guard is lent.
func (g mut Guard<T>) Get() mut T {
	return mut g.v
}

// Drop gives the lock back.
func (g mut Guard<T>) Drop() {
	unlock(g.lock)
}

// An RwLock owns a value and lends it either for reading to any number
// of tasks at once, with Read, or for changing to one task alone, with
// Write; a writer waits for the readers to finish, and readers wait
// for a writer. Like a Mutex it is moved or lent with ref, and drops
// its value with itself.
struct RwLock<T> impl Drop {
	p *box<T>?
}

// NewRwLock puts v behind a new lock.
func NewRwLock<T>(v T) RwLock<T> {
	return RwLock<T>{p: Some(&box<T>{lock: newLock(), value: v})}
}

// Read waits until no task holds the lock for writing, takes it for
// reading, and returns the ReadGuard that holds it. An empty RwLock
// panics.
func (l ref RwLock<T>) Read() ReadGuard<T> {
	if p := ref l.p {
		lockShared(p.lock)
		return ReadGuard<T>{lock: p.lock, v: ref p.value}
	}

	panic("sync: Read on an empty RwLock")
}

// Write waits until no task holds the lock at all, takes it for
// writing, and returns the Guard that holds it. An empty RwLock
// panics.
func (l ref RwLock<T>) Write() Guard<T> {
	if p := ref l.p {
		return guard(p)
	}

	panic("sync: Write on an empty RwLock")
}

// Drop releases the runtime's lock; the value is dropped with the box.
func (l mut RwLock<T>) Drop() {
	if p := ref l.p {
		freeLock(p.lock)
	}
}

// A ReadGuard holds a lock for reading and the ref borrow of the value
// under it, from Read until the ReadGuard is dropped.
struct ReadGuard<T> impl Drop {
	lock int
	v    ref T
}

// Get lends the value for reading, for as long as the ReadGuard is
// lent.
func (g ref ReadGuard<T>) Get() ref T {
	return g.v
}

// Drop gives the lock back.
func (g mut ReadGuard<T>) Drop() {
	unlockShared(g.lock)
}

// A Once runs one function once: the first Do runs it, and every Do
// after, in any task, returns without running anything, after the
// first has finished. It is lent with ref, which is how an Arc shares
// it.
struct Once {
	done Mutex<bool>
}

// NewOnce returns a Once that has run nothing yet.
func NewOnce() Once {
	return Once{done: NewMutex(false)}
}

// Do runs f if no Do on this Once has run a function before, and waits
// for that run to finish otherwise. A Do called from inside f waits
// forever.
func (o ref Once) Do(f func()) {
	g := o.done.Lock()
	if !*g.Get() {
		f()
		*g.Get() = true
	}
}

// A WaitGroup counts the tasks a program waits for: Add counts tasks
// in, Done counts one out, and Wait returns once the count is zero. It
// is a Copy handle on a counter the runtime keeps, so every copy of it
// names the same count, and a task spawned with a copy counts itself
// out on the one the program waits on.
struct WaitGroup impl Copy {
	h int
}

// NewWaitGroup returns a WaitGroup counting nothing.
func NewWaitGroup() WaitGroup {
	return WaitGroup{h: newLock()}
}

// Add adds n, which may be negative, to the count; a count below zero
// panics. Add is called before the task it counts is spawned, so that
// Wait cannot return between the spawn and the Add.
func (w WaitGroup) Add(n int) {
	count(w.h, n)
}

// Done counts one task out: Add(-1).
func (w WaitGroup) Done() {
	count(w.h, -1)
}

// Wait returns once the count is zero, at once when it already is.
func (w WaitGroup) Wait() {
	wait(w.h)
}

// guard takes the lock of the box p points at, for writing, and returns
// the Guard holding it and the value: the one function that steps from
// a ref of the lock to a mut of its value, for Lock and Write alike.
func guard<T>(p ref *box<T>) Guard<T> {
	b := inside(p)
	lock(b.lock)
	return Guard<T>{lock: b.lock, v: mut b.value}
}

// retain returns an owned copy of the pointer a handle holds, for a new
// handle on the same cell, or None for an empty handle. The caller
// raises the count the new handle is counted in.
func retain<T>(p ref (*acell<T>?)) *acell<T>? {
	if q := ref p {
		return Some(alias(q))
	}

	return None
}

// The compiler provides these three. alias and leak are rc's: a second
// owned copy of the pointer a borrow lends, and a pointer that moves in
// and is not freed, which the atomic count makes safe here as the plain
// count does there. inside returns the box a borrow of its pointer
// lends, as a mut: the one place in the language a mut comes from a
// ref, and the reason a lock exists. It is only called with the lock
// taken, or about to be, so that no other task reaches the value at the
// same time; it is not reachable from a program.
func alias<T>(p ref *acell<T>) *acell<T>
func leak<T>(p *acell<T>)
func inside<T>(p ref *box<T>) mut box<T>

// The runtime provides these. A lock is numbered, as a file is, and
// freed by the Mutex or RwLock that owns it; a WaitGroup's is never
// freed, since its handle is Copy and nothing counts the copies.
// atomicAdd adds d to n as one step that no other task's add can
// interleave with, and returns the new value.
func newLock() int
func freeLock(h int)
func lock(h int)
func unlock(h int)
func lockShared(h int)
func unlockShared(h int)
func count(h int, n int)
func wait(h int)
func atomicAdd(n mut i64, d i64) i64
