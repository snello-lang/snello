package set_test

import ("expect"; "fmt"; "iter"; "set"; "testing")

// Insert, Contains and Remove keep each value once, and a value
// inserted again after its removal goes to the end of the order.
func TestInsertContainsRemove() {
	var s set.Set<string>
	expect.True(s.IsEmpty())
	expect.True(s.Insert("a".Clone()))
	expect.True(s.Insert("b".Clone()))
	expect.False(s.Insert("a".Clone())) // there already
	expect.Equal(ref s.Len(), ref 2)
	expect.True(s.Contains("a"))
	expect.False(s.Contains("z"))
	expect.True(s.Remove("a"))
	expect.False(s.Remove("a"))
	expect.Equal(ref s.Len(), ref 1)
	expect.False(s.Contains("a"))
	expect.Equal(ref fmt.Sprint(s), "set[b]")
	expect.True(s.Insert("a".Clone())) // back, and at the end of the order
	expect.Equal(ref fmt.Sprint(s), "set[b a]")
	seen := ""
	for v := range s.Iter() {
		seen = seen + v
	}

	expect.Equal(ref seen, "ba")
	words := set.From([]string{"x".Clone(), "y".Clone(), "x".Clone()})
	expect.Equal(ref words.Len(), ref 2)
	expect.Equal(ref fmt.Sprint(words), "set[x y]")
	words.Clear()
	expect.True(words.Insert("z".Clone()))
	expect.Equal(ref fmt.Sprint(words), "set[z]")
}

// A set walks and prints its values in the order they were first
// inserted, and an empty one walks none.
func TestOrderAndPrint() {
	s := set.From([]int{3, 1, 3, 2, 1})
	expect.Equal(ref s.Len(), ref 3)
	expect.Equal(ref fmt.Sprint(s), "set[3 1 2]") // insertion order, each once
	sum := 0
	for v := range s.Iter() {
		sum += *v
	}

	expect.Equal(ref sum, ref 6)
	s.Clear()
	expect.True(s.IsEmpty())
	for range s.Iter() {
		expect.Fail("an empty set yielded a value")
	}

	expect.Equal(ref fmt.Sprint(s), "set[]")
}

// A walk passes over the values removed before it.
func TestRemovedValuesAreSkipped() {
	s := set.New<int>()
	for i := 0; i < 6; i++ {
		s.Insert(i)
	}

	expect.True(s.Remove(ref 0))
	expect.True(s.Remove(ref 3))
	expect.True(s.Remove(ref 5))
	seen := []int{}
	for v := range s.Iter() {
		seen.Push(*v)
	}

	expect.Equal(ref fmt.Sprint(seen), "[1 2 4]")
}

// Union, Intersection, Difference and SymmetricDifference change a set
// by another, which they use up: the order is the first set's, with
// new values at the end.
func TestAlgebra() {
	a := set.From([]string{"a".Clone(), "b".Clone(), "c".Clone()})
	a.Union(set.From([]string{"c".Clone(), "d".Clone()}))
	expect.Equal(ref fmt.Sprint(a), "set[a b c d]")
	a.Intersection(set.From([]string{"d".Clone(), "b".Clone(), "z".Clone()}))
	expect.Equal(ref fmt.Sprint(a), "set[b d]")
	a.Difference(set.From([]string{"d".Clone(), "q".Clone()}))
	expect.Equal(ref fmt.Sprint(a), "set[b]")
	a.SymmetricDifference(set.From([]string{"b".Clone(), "e".Clone()}))
	expect.Equal(ref fmt.Sprint(a), "set[e]")
	b := set.From([]int{1, 2})
	b.Union(set.New<int>())
	expect.Equal(ref fmt.Sprint(b), "set[1 2]")
	b.Intersection(set.New<int>())
	expect.True(b.IsEmpty())
	b.Union(set.From([]int{3}))
	expect.Equal(ref fmt.Sprint(b), "set[3]")
}

// Clone gives an algebra method a copy, so the set given stays.
func TestClone() {
	a := set.From([]string{"x".Clone()})
	b := set.From([]string{"y".Clone()})
	a.Union(set.Clone(ref b))
	expect.Equal(ref fmt.Sprint(a), "set[x y]")
	expect.Equal(ref fmt.Sprint(b), "set[y]")
	expect.True(set.Clone(ref set.New<int>()).IsEmpty())
}

// IsSubset, IsSuperset and IsDisjoint compare two sets; the empty set
// is a subset of, and disjoint from, every set.
func TestComparisons() {
	a := set.From([]int{1, 2, 3})
	b := set.From([]int{2, 3})
	c := set.From([]int{4})
	expect.True(b.IsSubset(ref a))
	expect.False(a.IsSubset(ref b))
	expect.True(a.IsSuperset(ref b))
	expect.False(b.IsSuperset(ref a))
	expect.True(a.IsSubset(ref a))
	expect.False(c.IsSubset(ref a))
	empty := set.New<int>()
	expect.True(empty.IsSubset(ref c))
	expect.True(empty.IsDisjoint(ref c))
	expect.True(c.IsDisjoint(ref a))
	expect.True(a.IsDisjoint(ref c)) // the larger first: the smaller is walked
	expect.False(a.IsDisjoint(ref b))
	expect.False(b.IsDisjoint(ref a))
}

// FromIter and Extend take the items of an iterator, each once, and
// Retain keeps the values a function says yes to, in their order.
func TestFromIterExtendRetain() {
	xs := []int{5, 1, 5, 2}
	s := set.FromIter(mut iter.Over(ref xs).Map(owned))
	expect.Equal(ref fmt.Sprint(s), "set[5 1 2]")
	more := []int{2, 7}
	s.Extend(mut iter.Over(ref more).Map(owned))
	expect.Equal(ref fmt.Sprint(s), "set[5 1 2 7]")
	s.Retain(func(v ref int) bool { return *v%2 == 1 })
	expect.Equal(ref fmt.Sprint(s), "set[5 1 7]")
	s.Retain(func(v ref int) bool { return false })
	expect.True(s.IsEmpty())
	expect.True(s.Insert(9))
	expect.Equal(ref fmt.Sprint(s), "set[9]")
}

// owned copies a lent int, for a Map to owned items.
func owned(x ref int) int {
	return *x
}
