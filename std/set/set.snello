// Package set holds each value once. Insert adds a value and reports
// whether it was new, Contains asks after one, Remove takes one out,
// and a range over Iter gives each value once, in the order they were
// inserted, as a range over a map does. A Set is a map of its values to
// nothing, map[T](): it costs what the map costs, a hash and a look-up
// per operation, and hashes with the map's seed.
package set

import ("fmt"; "iter")

// A Set is a collection of values of type T, each held once. It owns
// its values and lends them for reading. It is moved, or lent with ref
// and mut; when it goes out of scope, the values are dropped. The zero
// value is an empty set ready for Insert:
//
//	var s set.Set<string>
//	s.Insert("a")
//	s.Contains("a") // true
//
// T is Eq and Hash, as a map's key is. A Set prints as set[a b], its
// values in the order they were inserted.
struct Set<T: Eq + Hash> impl fmt.Stringer {
	m map[T]()
}

// An Iter walks a set's values in the order they were inserted, lending
// each; it lends the set for as long as it lives, so the set cannot
// change during the walk. Set.Iter makes one, and the adapters of
// iter.Iterator wrap it.
struct Iter<T: Eq + Hash> impl iter.Iterator<ref T> {
	s  ref Set<T>
	at int
}

// New returns an empty set of values of type T, the same set as the
// zero value.
func New<T: Eq + Hash>() Set<T> {
	return Set<T>{}
}

// From returns a set of the values of xs, which it takes: each value is
// moved into the set, and one that comes twice is kept once, the first
// time it comes, and the second dropped. The set's table is allocated
// once, with room for len(xs) values.
//
//	s := set.From([]int{3, 1, 3}) // set[3 1]
func From<T: Eq + Hash>(xs []T) Set<T> {
	s := Set<T>{m: make(map[T](), len(xs))}
	for _, x := range xs {
		s.Insert(x)
	}

	return s
}

// Insert adds v, which the set takes and owns from then on, and reports
// whether it was new; a value already in the set is left as it was, and
// v is dropped. The value is hashed and looked for once.
//
//	if !s.Insert(name) { ... } // name was there already
func (s mut Set<T>) Insert(v T) bool {
	n := len(s.m)
	s.m.GetOrInsert(v, ())
	return len(s.m) != n
}

// Contains reports whether v is in the set. v is only read: one hash
// and one look-up.
func (s ref Set<T>) Contains(v ref T) bool {
	return s.m.Contains(v)
}

// Remove takes v out of the set, dropping the set's value, and reports
// whether it was there. v is only read.
func (s mut Set<T>) Remove(v ref T) bool {
	return s.m.Remove(v).IsSome()
}

// Len returns how many values the set holds.
func (s ref Set<T>) Len() int {
	return len(s.m)
}

// IsEmpty reports whether the set holds no value.
func (s ref Set<T>) IsEmpty() bool {
	return len(s.m) == 0
}

// Clear drops every value, and the memory they were held in with them:
// the map is replaced by an empty one, and its table goes with it.
func (s mut Set<T>) Clear() {
	s.m = map[T](){}
}

// Iter returns a walk over the values in the order they were inserted,
// lending each for as long as the set is lent; nothing is copied.
//
//	for v := range s.Iter() { ... }
func (s ref Set<T>) Iter() Iter<T> {
	return Iter<T>{s: s, at: 0}
}

// String returns the values in insertion order as a new string, written
// as a slice of them is printed, each by fmt.Sprint: set[a b c]. It is
// how fmt prints a Set.
func (s ref Set<T>) String() string {
	out := "set["
	sep := ""
	for v := range s.Iter() {
		out = out + sep + fmt.Sprint(v)
		sep = " "
	}

	return out + "]"
}

// Next lends the next value of the walk, in the order the values were
// inserted, or None once every value has been given. The value is lent
// from the set, not from the Iter, so it stays good while the walk goes
// on and for as long as the set is lent; nothing is copied. A call
// steps past the slots of values removed from the set.
func (it mut Iter<T>) Next() ref T? {
	if (i, v, _) := it.s.m.Entry(it.at) {
		it.at = i + 1
		return Some(v)
	}

	return None
}
