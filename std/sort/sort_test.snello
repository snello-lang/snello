package sort_test

import ("expect"; "sort"; "testing")

// Sort orders a slice least first, and an empty slice stays empty.
func TestSort() {
	xs := []int{3, 1, 2}
	sort.Sort(mut xs)
	expect.EqualSlice(ref xs, ref []int{1, 2, 3})
	expect.True(sort.IsSorted(ref xs))
	empty := []int{}
	sort.Sort(mut empty)
	expect.Empty(ref empty)
}

// SortBy orders by the function it is given.
func TestSortBy() {
	words := []string{"pear".Clone(), "fig".Clone(), "banana".Clone()}
	sort.SortBy(mut words, func(a ref string, b ref string) bool { return a.Len() < b.Len() })
	expect.Equal(ref words[0], "fig")
	expect.Equal(ref words[2], "banana")
}

// Search finds a value, where one would go, and the end for one past
// every element; IsSorted sees a slice out of order.
func TestSearch() {
	xs := []int{1, 3, 5, 7}
	expect.Equal(ref sort.Search(ref xs, ref 5), ref 2)
	expect.Equal(ref sort.Search(ref xs, ref 4), ref 2)
	expect.Equal(ref sort.Search(ref xs, ref 9), ref 4)
	expect.False(sort.IsSorted(ref []int{2, 1}))
}

// How long Sort takes for ten numbers in reverse order.
func BenchmarkSort() {
	for testing.Loop() {
		xs := []int{9, 8, 7, 6, 5, 4, 3, 2, 1, 0}
		sort.Sort(mut xs)
	}
}

// SearchBy finds a place by a function's order, as Search finds it by
// Cmp: a key that is there, one between two elements, and one past
// every element.
func TestSearchBy() {
	ages := []int{18, 21, 30, 30, 45}
	byAge := func(key int) func(ref int) Ordering {
		return func(a ref int) Ordering { return a.Cmp(ref key) }
	}

	expect.Equal(ref sort.SearchBy(ref ages, byAge(30)), ref 2)
	expect.Equal(ref sort.SearchBy(ref ages, byAge(25)), ref 2)
	expect.Equal(ref sort.SearchBy(ref ages, byAge(10)), ref 0)
	expect.Equal(ref sort.SearchBy(ref ages, byAge(50)), ref 5)
	empty := []int{}
	expect.Equal(ref sort.SearchBy(ref empty, byAge(1)), ref 0)
	words := []string{"apple".Clone(), "fig".Clone(), "pear".Clone()}
	expect.Equal(ref sort.SearchBy(ref words, func(w ref string) Ordering { return w.Cmp("fig") }), ref 1)
	expect.Equal(ref sort.SearchBy(ref words, func(w ref string) Ordering { return w.Cmp("grape") }), ref 2)
}
