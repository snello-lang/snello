// Package sort orders slices and searches them.
//
// Sort and Search work on a slice of any type implementing Ord, through
// the type's Cmp; SortBy takes the order from a function instead, for a
// type that is not Ord or an order that is not its own. A slice is
// sorted in place: it is lent mut, sort.Sort(mut xs), and its elements
// are moved within it, never copied.
package sort

// Sort orders xs in place, least first, by the Cmp of its element type.
// Elements that compare Equal keep their order.
func Sort<T: Ord>(xs mut []T) {
	xs.SortBy(func(a ref T, b ref T) bool { return a.Cmp(b) == Less })
}

// SortBy orders xs in place by less, which says whether its first
// argument comes before its second: sort.SortBy(mut list, func(a ref
// Count, b ref Count) bool { return a.n > b.n }). Elements neither of
// which comes before the other keep their order.
func SortBy<T>(xs mut []T, less func(a ref T, b ref T) bool) {
	xs.SortBy(less)
}

// Search finds x in xs, which must be sorted least first, and returns
// its index, or the index where x would be inserted to keep the order
// when it is not there: len(xs) when every element is less than x. It
// looks at about log2(len(xs)) elements.
func Search<T: Ord>(xs ref []T, x ref T) int {
	lo, hi := 0, len(xs)
	for lo < hi {
		mid := lo + (hi-lo)/2
		if xs[mid].Cmp(x) == Less {
			lo = mid + 1
		} else {
			hi = mid
		}
	}

	return lo
}

// IsSorted reports whether xs is ordered least first.
func IsSorted<T: Ord>(xs ref []T) bool {
	for i := 1; i < len(xs); i++ {
		if xs[i].Cmp(xs[i-1]) == Less {
			return false
		}
	}

	return true
}
