package bufio_test

import ("bufio"; "bytes"; "expect"; "io"; "os"; "strings"; "testing"; "unicode/utf8")

// The bytes the tests end their lines and records with.
const newline byte = '\n'
const comma byte = ','

// eAcuteSecondByte is the second byte of é in UTF-8, C3 A9.
const eAcuteSecondByte byte = 0xa9

// bufferSize is the size of a Reader's buffer, and pastBuffer a read
// longer than it, which goes straight into the caller's slice.
const bufferSize = 4096
const pastBuffer = 5000

// digits is ten bytes the tests repeat into a long input.
const digits = "0123456789"

// The lengths of the long inputs: a line longer than a Reader's buffer,
// a word past a Scanner's limit, a run of white space far longer than
// its buffer, and the lines a benchmark scans.
const longLine = 10000
const pastTokenLimit = 70000
const manySpaces = 200000
const benchLines = 1000

// moreThanLeft is a Peek of more bytes than the input has left.
const moreThanLeft = 100

// TestWriter writes through a small buffer, flushes it, and writes to
// the file under it through Get.
func TestWriter() {
	dir := testing.TempDir()
	path := dir.Join("out.txt")
	f := expect.IsOk(os.Create(ref path))
	w := bufio.NewWriterSize(mut f, 8)
	expect.Equal(ref w.Available(), ref 8)
	expect.Equal(ref expect.IsOk(w.WriteString("abc")), ref 3)
	expect.Equal(ref w.Buffered(), ref 3)
	expect.IsOk(w.WriteByte(byte('d')))
	expect.Equal(ref expect.IsOk(w.Write(ref []byte("efghij"))), ref 6)
	expect.IsOk(w.Flush())
	expect.Equal(ref w.Buffered(), ref 0)
	expect.IsOk(w.Get().WriteString("!"))
	expect.IsOk(w.Flush())
	expect.IsOk(f.Close())
	expect.Equal(ref expect.IsOk(os.ReadToString(ref path)), "abcdefghij!")
}

// TestReader reads a file by bytes, lines and a slice, to its end, and
// reaches the file under it through Get.
func TestReader() {
	dir := testing.TempDir()
	path := dir.Join("in.txt")
	expect.IsOk(os.WriteString(ref path, "one\ntwo\nthree"))
	f := expect.IsOk(os.Open(ref path))
	r := bufio.NewReader(mut f)
	expect.Equal(ref expect.IsSome(expect.IsOk(r.ReadByte())), ref byte('o'))
	expect.Equal(ref expect.IsSome(expect.IsOk(r.ReadString(newline))), "ne\n")
	buf := make([]byte, 3)
	expect.Equal(ref expect.IsOk(r.Read(mut buf)), ref 3)
	expect.Equal(ref expect.IsSome(expect.IsOk(r.ReadString(newline))), "\n")
	expect.Equal(ref expect.IsSome(expect.IsOk(r.ReadString(newline))), "three")
	expect.IsNone(expect.IsOk(r.ReadString(newline)))
	expect.IsNone(expect.IsOk(r.ReadByte()))
	expect.Equal(r.Get().Name(), ref path)
}

// A Trickle hands out its bytes one a call, so that every rune of more
// than one byte reaches the Reader split across reads.
struct Trickle impl io.Reader {
	data []byte
	at   int
}

// Read hands out the next byte into buf, and 0 at the end of the data.
func (t mut Trickle) Read(buf mut []byte) Result<int, io.Error> {
	if t.at == len(t.data) || len(buf) == 0 {
		return Ok(0)
	}

	buf[0] = t.data[t.at]
	t.at += 1
	return Ok(1)
}

// TestReadRune reads runes of every width, each split across reads,
// and a byte that starts no rune as U+FFFD.
func TestReadRune() {
	var t = Trickle{data: []byte("aé世\xff😀"), at: 0}
	rd := bufio.NewReader(mut t)
	runes := []rune{'a', 'é', '世', utf8.RuneError, '😀'} // a byte that starts no sequence is U+FFFD
	widths := []int{1, 2, 3, 1, 4}
	for i, want := range ref runes {
		r, n := expect.IsSome(expect.IsOk(rd.ReadRune()))
		expect.Equal(ref r, want)
		expect.Equal(ref n, widths[i])
	}

	expect.IsNone(expect.IsOk(rd.ReadRune()))
}

// TestUnreadRune reads a sequence that is already no rune's start at
// once, and puts back the rune just read with UnreadRune.
func TestUnreadRune() {
	var t = Trickle{data: []byte("\xe2Aé"), at: 0}
	rd := bufio.NewReader(mut t)
	r, n := expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref r, ref utf8.RuneError) // E2 then A: invalid without a third byte
	expect.Equal(ref n, ref 1)
	r, n = expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref r, ref 'A')
	expect.True(rd.UnreadRune())
	expect.False(rd.UnreadRune()) // once a read
	r, n = expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref r, ref 'A')
	r, n = expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref r, ref 'é')
	expect.Equal(ref n, ref 2)
	expect.True(rd.UnreadRune())
	expect.IsSome(expect.IsOk(rd.ReadByte()))
	expect.False(rd.UnreadRune()) // after another read
}

// TestReadRuneCut reads a rune cut short by the end of the input as
// U+FFFD, a byte at a time.
func TestReadRuneCut() {
	var t = Trickle{data: []byte("\xe4\xb8"), at: 0}
	rd := bufio.NewReader(mut t)
	r, n := expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref r, ref utf8.RuneError)
	expect.Equal(ref n, ref 1)
	r, n = expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref r, ref utf8.RuneError)
	expect.Equal(ref n, ref 1)
	expect.IsNone(expect.IsOk(rd.ReadRune()))
}

// TestScanner reads a file line by line, an empty line and a last line
// without a newline included.
func TestScanner() {
	dir := testing.TempDir()
	path := dir.Join("lines.txt")
	expect.IsOk(os.WriteString(ref path, "alpha\nbeta\n\ngamma"))
	f := expect.IsOk(os.Open(ref path))
	s := bufio.NewScanner(mut f)
	s.Buffer(bufio.MaxScanTokenSize)
	lines := []string{}
	for s.Scan() {
		lines.Push(s.Text())
	}

	expect.EqualSlice(ref lines, ref []string{"alpha".Clone(), "beta".Clone(), "".Clone(), "gamma".Clone()})
	expect.True(s.Err().IsNone())
	expect.Equal(ref len(s.Bytes()), ref 0)
}

// peeked returns the text of what Peek lent, or the message of its
// error after an "error: ".
func peeked(r Result<ref []byte, io.Error>) string {
	return match r {
		Ok(p) => string(p),
		Err(e) => "error: " + e.Error(),
	}
}

// TestPeek lends bytes without reading past them, fewer at the end of
// the input, and refuses a negative count and one past the buffer.
func TestPeek() {
	var t = Trickle{data: []byte("hello\nworld"), at: 0}
	rd := bufio.NewReader(mut t)
	expect.Equal(ref peeked(rd.Peek(3)), "hel") // read a byte at a time until three are there
	expect.Equal(ref peeked(rd.Peek(0)), "")
	expect.Equal(ref peeked(rd.Peek(-1)), "error: bufio: negative count")
	expect.Equal(ref peeked(rd.Peek(bufferSize + 1)), "error: bufio: buffer full")
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadString(newline))), "hello\n") // a peek reads nothing
	expect.Equal(ref peeked(rd.Peek(moreThanLeft)), "world")                        // fewer at the end of the input
	expect.IsOk(rd.ReadString(newline))
	expect.Equal(ref peeked(rd.Peek(3)), "")
	expect.False(rd.UnreadByte()) // a peek is no read
}

// TestReadBytes reads records up to a delimiter, and a line longer than
// the buffer whole.
func TestReadBytes() {
	var t = Trickle{data: []byte("ab,cd,"), at: 0}
	rd := bufio.NewReader(mut t)
	expect.True(expect.IsSome(expect.IsOk(rd.ReadBytes(comma))).Equal(ref []byte("ab,")))
	expect.True(expect.IsSome(expect.IsOk(rd.ReadBytes(comma))).Equal(ref []byte("cd,")))
	expect.IsNone(expect.IsOk(rd.ReadBytes(comma)))
	long := strings.Repeat("x", longLine) ?? "" // longer than the buffer, set aside in pieces
	in := strings.NewReader(long + "\ntail")
	lr := bufio.NewReader(mut in)
	expect.Equal(ref len(expect.IsSome(expect.IsOk(lr.ReadBytes(newline)))), ref (longLine + 1))
	expect.True(expect.IsSome(expect.IsOk(lr.ReadBytes(newline))).Equal(ref []byte("tail")))
	expect.IsNone(expect.IsOk(lr.ReadBytes(newline)))
}

// TestUnreadByte puts back the last byte after every kind of read, at
// the end of the input too, and refuses after a Peek or twice in a row.
func TestUnreadByte() {
	in := strings.NewReader("abc\ndef".Clone())
	rd := bufio.NewReader(mut in)
	expect.False(rd.UnreadByte()) // nothing read yet
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadByte())), ref byte('a'))
	expect.True(rd.UnreadByte())
	expect.False(rd.UnreadByte()) // once a read
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadString(newline))), "abc\n")
	expect.True(rd.UnreadByte()) // the newline, the last byte the line read
	buf := make([]byte, 2)
	expect.Equal(ref expect.IsOk(rd.Read(mut buf)), ref 2)
	expect.True(buf.Equal(ref []byte("\nd")))
	expect.True(rd.UnreadByte())
	r, n := expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref r, ref 'd')
	expect.Equal(ref n, ref 1)
	expect.True(rd.UnreadByte())
	expect.False(rd.UnreadRune()) // an UnreadByte is no ReadRune
	big := make([]byte, pastBuffer)
	expect.Equal(ref expect.IsOk(rd.Read(mut big)), ref 3) // read straight into the caller's buffer
	expect.True(rd.UnreadByte())
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadByte())), ref byte('f'))
	expect.IsNone(expect.IsOk(rd.ReadByte()))
	expect.Equal(ref expect.IsOk(rd.Read(mut buf)), ref 0)
	expect.IsNone(expect.IsOk(rd.ReadBytes(newline)))
	expect.IsNone(expect.IsOk(rd.ReadRune()))
	expect.True(rd.UnreadByte()) // reads that gave nothing at the end leave f the last byte read
	expect.Equal(ref peeked(rd.Peek(-1)), "error: bufio: negative count")
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadByte())), ref byte('f')) // a refused Peek changed nothing
	expect.Equal(ref peeked(rd.Peek(0)), "")
	expect.False(rd.UnreadByte()) // a Peek ends it
}

// TestUnreadRuneAfter puts a rune back only straight after the ReadRune
// that read it: any call between them ends that, even one that read
// nothing, while the rune's last byte is still UnreadByte's.
func TestUnreadRuneAfter() {
	in := strings.NewReader("éab".Clone())
	rd := bufio.NewReader(mut in)
	expect.IsSome(expect.IsOk(rd.ReadRune()))
	expect.Equal(ref peeked(rd.Peek(-1)), "error: bufio: negative count")
	expect.False(rd.UnreadRune())
	expect.True(rd.UnreadByte()) // a refused Peek left the last byte read
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadByte())), ref eAcuteSecondByte)
	rd.UnreadByte()
	rd.UnreadByte()
	expect.IsSome(expect.IsOk(rd.ReadRune()))
	none := []byte{}
	expect.Equal(ref expect.IsOk(rd.Read(mut none)), ref 0)
	expect.False(rd.UnreadRune()) // a Read of no bytes is a call
	one := make([]byte, 1)
	expect.Equal(ref expect.IsOk(rd.Read(mut one)), ref 1)
	expect.False(rd.UnreadRune())
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadByte())), ref byte('b'))
	expect.IsNone(expect.IsOk(rd.ReadByte()))
	expect.False(rd.UnreadRune())
	lines := strings.NewReader("éa\nb".Clone())
	rl := bufio.NewReader(mut lines)
	expect.IsSome(expect.IsOk(rl.ReadRune()))
	expect.Equal(ref expect.IsSome(expect.IsOk(rl.ReadString(newline))), "a\n")
	expect.False(rl.UnreadRune()) // a line read is a call
	expect.Equal(ref expect.IsSome(expect.IsOk(rl.ReadByte())), ref byte('b'))
}

// TestUnreadByteDirect reads at least as much as the buffer holds,
// straight into the caller's slice, and puts back its last byte with
// UnreadByte all the same.
func TestUnreadByteDirect() {
	long := strings.Repeat(digits, pastBuffer / len(digits)) ?? "" // 5000 bytes, past the buffer's 4096
	in := strings.NewReader(long + "!")
	rd := bufio.NewReader(mut in)
	big := make([]byte, pastBuffer)
	expect.Equal(ref expect.IsOk(rd.Read(mut big)), ref pastBuffer)
	expect.True(rd.UnreadByte())
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadByte())), ref byte('9')) // the 9 that ended the read
	expect.Equal(ref expect.IsSome(expect.IsOk(rd.ReadByte())), ref byte('!'))
}

// TestWords splits text into words at white space of every kind, a
// last word without space after it included, and ends the scan at a
// word past the limit.
func TestWords() {
	var t = Trickle{data: []byte("  one two\tthree\u3000four\n\n five\xffsix  "), at: 0} // a rune cut across reads, and a byte that starts none
	s := bufio.Words(mut t)
	words := []string{}
	for s.Scan() {
		words.Push(s.Text())
	}

	expect.EqualSlice(ref words, ref []string{"one".Clone(), "two".Clone(), "three".Clone(), "four".Clone(), "five\xffsix".Clone()})
	expect.True(s.Err().IsNone())
	in := strings.NewReader("tail".Clone())
	last := bufio.Words(mut in)
	expect.True(last.Scan()) // a last word with no space after it
	expect.True(last.Bytes().Equal(ref []byte("tail")))
	expect.False(last.Scan())
	expect.Equal(ref len(last.Bytes()), ref 0)
	blank := strings.NewReader("   \n\t ".Clone())
	none := bufio.Words(mut blank)
	expect.False(none.Scan())
	long := strings.NewReader(strings.Repeat("y", pastTokenLimit) ?? "")
	big := bufio.Words(mut long)
	expect.False(big.Scan()) // a word past the limit ends the scan
	match big.Err() {
		Some(e) => expect.Equal(ref e.Error(), "bufio.Scanner: token too long"),
		None => expect.Fail("the scan ended with no error"),
	}

	spaces := strings.NewReader((strings.Repeat(" ", manySpaces) ?? "") + "end")
	far := bufio.Words(mut spaces)
	expect.True(far.Scan()) // white space never fills the buffer
	expect.Equal(ref far.Text(), "end")
}

// BenchmarkWords measures splitting a thousand short lines into words.
func BenchmarkWords() {
	text := strings.Repeat("some words to split\n", benchLines) ?? ""
	testing.ResetTimer()
	for testing.Loop() {
		in := strings.NewReader(text.Clone())
		s := bufio.Words(mut in)
		for s.Scan() {}
	}
}

// BenchmarkWriteString measures a short WriteString into a file's
// buffer.
func BenchmarkWriteString() {
	dir := testing.TempDir()
	f := expect.IsOk(os.Create(ref dir.Join("bench.txt")))
	w := bufio.NewWriter(mut f)
	testing.ResetTimer()
	for testing.Loop() { _ = w.WriteString("line\n") }
}

// The split functions: bytes, runes whole across reads, lines and words
// through NewScannerSplit as through their own constructors, and a
// program's own cut at commas.
func TestSplitFunctions() {
	in := strings.NewReader("héy".Clone())
	byBytes := bufio.NewScannerSplit(mut in, bufio.ScanBytes)
	seen := []string{}
	for byBytes.Scan() {
		seen.Push(byBytes.Text())
	}

	expect.Equal(ref len(seen), ref 4) // four bytes, é being two
	expect.Equal(ref seen[0], "h")
	var t = Trickle{data: []byte("aé　b\xffz"), at: 0} // runes of one, two and three bytes, cut across reads, and a byte that starts none
	runes := bufio.NewScannerSplit(mut t, bufio.ScanRunes)
	got := []string{}
	for runes.Scan() {
		got.Push(runes.Text())
	}

	expect.EqualSlice(ref got, ref []string{"a".Clone(), "é".Clone(), "　".Clone(), "b".Clone(), "\xff".Clone(), "z".Clone()})
	expect.True(runes.Err().IsNone())
	lines := strings.NewReader("one\r\ntwo\n\nthree".Clone())
	byFunction := bufio.NewScannerSplit(mut lines, bufio.ScanLines)
	read := []string{}
	for byFunction.Scan() {
		read.Push(byFunction.Text())
	}

	expect.EqualSlice(ref read, ref []string{"one".Clone(), "two".Clone(), "".Clone(), "three".Clone()})
	var w = Trickle{data: []byte("  one two\tthree　four\n\n five\xffsix  "), at: 0}
	words := bufio.NewScannerSplit(mut w, bufio.ScanWords)
	found := []string{}
	for words.Scan() {
		found.Push(words.Text())
	}

	expect.EqualSlice(ref found, ref []string{"one".Clone(), "two".Clone(), "three".Clone(), "four".Clone(), "five\xffsix".Clone()})
	commas := func(data ref []byte, atEOF bool) bufio.Split? {
		if i := data.Index(ref ',') {
			return Some(bufio.Split{Start: 0, End: i, Advance: i + 1})
		}

		if atEOF && len(data) > 0 {
			return Some(bufio.Split{Start: 0, End: len(data), Advance: len(data)})
		}

		return None
	}
	csv := strings.NewReader("a,bb,,ccc".Clone())
	fields := bufio.NewScannerSplit(mut csv, commas)
	parts := []string{}
	for fields.Scan() {
		parts.Push(fields.Text())
	}

	expect.EqualSlice(ref parts, ref []string{"a".Clone(), "bb".Clone(), "".Clone(), "ccc".Clone()})
	expect.True(fields.Err().IsNone())
	expect.Equal(ref len(fields.Bytes()), ref 0) // empty once Scan returned false
	empty := strings.NewReader("".Clone())
	none := bufio.NewScannerSplit(mut empty, bufio.ScanRunes)
	expect.False(none.Scan())
	stuck := func(data ref []byte, atEOF bool) bufio.Split? { return Some(bufio.Split{Start: 0, End: 0, Advance: 0}) } // never moves: more input until the end, then a clean end
	never := strings.NewReader("abc".Clone())
	halted := bufio.NewScannerSplit(mut never, stuck)
	expect.False(halted.Scan())
	expect.True(halted.Err().IsNone())
	beyond := func(data ref []byte, atEOF bool) bufio.Split? { return Some(bufio.Split{Start: 0, End: 1, Advance: 100}) } // past the data: the scan ends with the error
	over := strings.NewReader("abc".Clone())
	cut := bufio.NewScannerSplit(mut over, beyond)
	expect.False(cut.Scan())
	match cut.Err() {
		Some(e) => expect.Equal(ref e.Error(), "bufio.Scanner: bad split"),
		None => expect.Fail("a split past the data ended the scan with no error"),
	}

	expect.False(cut.Scan()) // and stays ended, the error kept
	expect.True(cut.Err().IsSome())
	expect.Equal(ref len(cut.Bytes()), ref 0)
	atEnd := func(data ref []byte, atEOF bool) bufio.Split? { // right before the end, one past the data at it: the slip a hand-written splitter makes
		if i := data.Index(ref ',') {
			return Some(bufio.Split{Start: 0, End: i, Advance: i + 1})
		}

		if atEOF && len(data) > 0 {
			return Some(bufio.Split{Start: 0, End: len(data), Advance: len(data) + 1})
		}

		return None
	}
	last := strings.NewReader("a,bc".Clone())
	slipped := bufio.NewScannerSplit(mut last, atEnd)
	expect.True(slipped.Scan())
	expect.Equal(ref slipped.Text(), "a")
	expect.False(slipped.Scan())
	match slipped.Err() {
		Some(e) => expect.Equal(ref e.Error(), "bufio.Scanner: bad split"),
		None => expect.Fail("a bad split at the end of the input ended the scan with no error"),
	}

	overlap := func(data ref []byte, atEOF bool) bufio.Split? { return Some(bufio.Split{Start: 0, End: 2, Advance: 1}) } // a token past the move: tokens would overlap
	lapped := strings.NewReader("abc".Clone())
	twice := bufio.NewScannerSplit(mut lapped, overlap)
	expect.False(twice.Scan())
	expect.True(twice.Err().IsSome())
	fixed := func(data ref []byte, atEOF bool) bufio.Split? { // records of two bytes, written to the rule that data is never empty before the end
		if len(data) < 2 && !atEOF {
			return None
		}

		n := min(2, len(data))
		if n == 0 {
			return None
		}

		return Some(bufio.Split{Start: 0, End: n, Advance: n})
	}
	records := strings.NewReader("abcde".Clone())
	pairs := bufio.NewScannerSplit(mut records, fixed)
	got2 := []string{}
	for pairs.Scan() {
		got2.Push(pairs.Text())
	}

	expect.EqualSlice(ref got2, ref []string{"ab".Clone(), "cd".Clone(), "e".Clone()})
	long := strings.NewReader(strings.Repeat("y", pastTokenLimit) ?? "")
	big := bufio.NewScannerSplit(mut long, commas)
	expect.False(big.Scan()) // a token past the limit ends the scan
	match big.Err() {
		Some(e) => expect.Equal(ref e.Error(), "bufio.Scanner: token too long"),
		None => expect.Fail("the scan ended with no error"),
	}
}

// A Drip hands out at most step bytes a call, and fails with its error
// once it has handed out fail bytes.
struct Drip impl io.Reader {
	data []byte
	at   int
	step int
	fail int
}

// Read hands out the next bytes of d, at most step of them, or fails
// once fail bytes are out.
func (d mut Drip) Read(buf mut []byte) Result<int, io.Error> {
	if d.at >= d.fail {
		return Err(io.NewError("read".Clone(), "drip".Clone(), "broken".Clone(), io.Other))
	}

	n := min(d.step, len(buf), len(d.data)-d.at)
	for i := 0; i < n; i++ {
		buf[i] = d.data[d.at+i]
	}

	d.at += n
	return Ok(n)
}

// A Breaking writer takes bytes until it has taken limit, then fails
// every write.
struct Breaking impl io.Writer {
	taken int
	limit int
}

// Write takes buf while the limit allows and fails after it.
func (b mut Breaking) Write(buf ref []byte) Result<int, io.Error> {
	if b.taken+len(buf) > b.limit {
		return Err(io.NewError("write".Clone(), "breaking".Clone(), "full".Clone(), io.Other))
	}

	b.taken += len(buf)
	return Ok(len(buf))
}

// ReadSlice lends a line from the buffer and refuses one longer than
// it; Discard moves past bytes; Buffered, Size and Reset say and clear
// what the buffer holds.
func TestReadSliceDiscardReset() {
	in := strings.NewReader("one\ntwo\nthree".Clone())
	r := bufio.NewReader(mut in)
	expect.Equal(ref r.Buffered(), ref 0)
	expect.Equal(ref r.Size(), ref 4096)
	line := expect.IsSome(expect.IsOk(r.ReadSlice('\n')))
	expect.True(line.Equal(ref []byte("one\n")))
	expect.Equal(ref r.Buffered(), ref 9) // the rest was read in the same block
	expect.Equal(ref expect.IsOk(r.Discard(2)), ref 2)
	expect.Equal(ref expect.IsOk(r.Discard(0)), ref 0)
	expect.Equal(ref expect.IsOk(r.Discard(-5)), ref 0)
	line = expect.IsSome(expect.IsOk(r.ReadSlice('\n')))
	expect.True(line.Equal(ref []byte("o\n")))
	last := expect.IsSome(expect.IsOk(r.ReadSlice('\n'))) // no newline: the rest is the last line
	expect.True(last.Equal(ref []byte("three")))
	expect.IsNone(expect.IsOk(r.ReadSlice('\n')))
	expect.True(r.UnreadByte()) // the last byte of the last line
	expect.Equal(ref r.Buffered(), ref 1)
	r.Reset()
	expect.Equal(ref r.Buffered(), ref 0)
	expect.False(r.UnreadByte())
	expect.IsNone(expect.IsOk(r.ReadSlice('\n')))
	long := strings.NewReader(strings.Repeat("x", 5000) ?? "")
	full := bufio.NewReader(mut long)
	e := expect.IsErr(full.ReadSlice('\n'))
	expect.Equal(ref e.Error(), "bufio: buffer full")
	expect.Equal(ref full.Buffered(), ref 4096) // the bytes stay for ReadBytes
	rest := expect.IsSome(expect.IsOk(full.ReadBytes('\n')))
	expect.Equal(ref len(rest), ref 5000)
	short := strings.NewReader("abc".Clone())
	past := bufio.NewReader(mut short)
	expect.Equal(ref expect.IsOk(past.Discard(10)), ref 3) // fewer at the end
	expect.Equal(ref expect.IsOk(past.Discard(1)), ref 0)
	exact := strings.NewReader(strings.Repeat("z", 4096) ?? "")
	edge := bufio.NewReader(mut exact)
	e2 := expect.IsErr(edge.ReadSlice('\n')) // a line of exactly the buffer's size and no delimiter: full
	expect.Equal(ref e2.Error(), "bufio: buffer full")
	var failing = Drip{data: []byte("0123456789"), at: 0, step: 3, fail: 7}
	broken := bufio.NewReader(mut failing)
	e3 := expect.IsErr(broken.Discard(100)) // the reader fails after seven bytes: its error, the bytes before it gone
	expect.Contains(ref e3.Error(), "broken")
	expect.Equal(ref broken.Buffered(), ref 0)
}

// WriteRune writes a rune's bytes, Size says the buffer's, and Reset
// drops what was buffered and the error that stopped the Writer.
func TestWriteRuneSizeReset() {
	var sink bytes.Buffer
	w := bufio.NewWriterSize(mut sink, 8)
	expect.Equal(ref w.Size(), ref 8)
	expect.Equal(ref expect.IsOk(w.WriteRune('a')), ref 1)
	expect.Equal(ref expect.IsOk(w.WriteRune('é')), ref 2)
	expect.Equal(ref expect.IsOk(w.WriteRune('　')), ref 3)
	expect.Equal(ref expect.IsOk(w.WriteRune('\U0001F600')), ref 4) // crosses the buffer's end: flushed on the way
	expect.Equal(ref expect.IsOk(w.WriteRune(-1)), ref 3)           // no code point: U+FFFD
	expect.IsOk(w.Flush())
	w.WriteString("kept").Unwrap()
	expect.Equal(ref w.Buffered(), ref 4)
	w.Reset()
	expect.Equal(ref w.Buffered(), ref 0)
	expect.IsOk(w.Flush())
	expect.Equal(ref sink.String(), "aé　\U0001F600�") // the kept bytes never reached the sink
	var wall = Breaking{taken: 0, limit: 4}
	blocked := bufio.NewWriterSize(mut wall, 4)
	expect.Equal(ref expect.IsOk(blocked.WriteRune('\u00e9')), ref 2)
	expect.Equal(ref expect.IsOk(blocked.WriteRune('\u00e9')), ref 2) // the first two bytes flushed to make room: the writer took four
	expect.Equal(ref expect.IsOk(blocked.WriteRune('x')), ref 1)     // room for a byte
	expect.IsErr(blocked.WriteRune('\u3000'))                      // no room for three: the flush fails, the writer being full
	expect.IsErr(blocked.WriteRune('z'))                            // the error is kept for every call
	blocked.Reset()                                                 // drops the error and the bytes
	expect.Equal(ref blocked.Buffered(), ref 0)
	expect.Equal(ref expect.IsOk(blocked.WriteRune('y')), ref 1)   // writes again
}

// BenchmarkScanRunes measures scanning a megabyte of text rune by rune
// through the provided split function.
func BenchmarkScanRunes() {
	text := strings.Repeat("héllo wörld, scanning runes and commas,line by line\n", benchLines*20) ?? ""
	testing.ResetTimer()
	for testing.Loop() {
		in := strings.NewReader(text.Clone())
		s := bufio.NewScannerSplit(mut in, bufio.ScanRunes)
		for s.Scan() {}
	}
}

// BenchmarkSplit measures a split function of a program's own, cutting
// a megabyte of text at commas.
func BenchmarkSplit() {
	text := strings.Repeat("héllo wörld, scanning runes and commas,line by line\n", benchLines*20) ?? ""
	commas := func(data ref []byte, atEOF bool) bufio.Split? {
		if i := data.Index(ref ',') {
			return Some(bufio.Split{Start: 0, End: i, Advance: i + 1})
		}

		if atEOF && len(data) > 0 {
			return Some(bufio.Split{Start: 0, End: len(data), Advance: len(data)})
		}

		return None
	}
	testing.ResetTimer()
	for testing.Loop() {
		in := strings.NewReader(text.Clone())
		s := bufio.NewScannerSplit(mut in, commas)
		for s.Scan() {}
	}
}

// BenchmarkWriteRune measures a two-byte rune written into a buffer that
// is never flushed, with nothing allocated.
func BenchmarkWriteRune() {
	var sink bytes.Buffer
	w := bufio.NewWriterSize(mut sink, 1<<20)
	testing.ResetTimer()
	for testing.Loop() {
		if w.Available() < 4 {
			w.Reset()
		}

		_ = w.WriteRune('\u00e9')
	}
}
