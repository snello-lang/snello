// Package bufio puts a buffer between a program and a reader or a
// writer, so that many small reads or writes become a few large ones,
// and reads text by lines.
//
// Each type borrows the reader or writer under it, mut, for as long as
// it lives: bufio.NewWriter(mut os.Stdout) is a Writer<os.File> that
// holds the borrow, and the file is not written to directly while it
// does. A Writer, a Reader and a Scanner are borrows themselves, so
// they are lent to a call and dropped at the end of their scope, but
// not stored in a struct or a slice, nor sent. A Writer implements
// io.Writer and a Reader io.Reader, so fmt.Fprintln writes through a
// Writer and io.Copy reads through a Reader.
//
// What a Writer holds is written out by Flush, and by Write when the
// buffer is full. A Writer dropped without Flush loses what it holds,
// as Go's does, so a program defers Flush when it makes one. The end of
// the input is not an error: a Reader answers Ok(None) or Ok(0) there,
// and a Scanner's Scan answers false with Err None.
package bufio

import "io"

// A Writer collects what is written to it and writes it to the writer
// under it in blocks, when its buffer is full and on Flush. It is made
// with NewWriter.
struct Writer<W: io.Writer> impl io.Writer {
	w    mut W
	buf  []byte
	size int
}

// A Reader reads from the reader under it in blocks and hands them out
// in the pieces asked for: bytes, lines, and what an io.Reader is
// asked. It is made with NewReader.
struct Reader<R: io.Reader> impl io.Reader {
	r     mut R
	buf   []byte
	block []byte
	start int
	done  bool
}

// A Scanner reads a reader line by line: Scan reads the next line, and
// Bytes or Text give it, without its line ending. It is made with
// NewScanner.
struct Scanner<R: io.Reader> {
	r       mut R
	buf     []byte
	block   []byte
	start   int
	end     int
	scanned int // the bytes from start up to here hold no newline
	done    bool
	err     io.Error?
}

// The number of bytes a block read from or written to the underlying
// reader or writer has.
const blockSize int = 4096

// NewWriter returns a Writer that writes to w, borrowed for as long as
// the Writer lives. Its buffer holds 4096 bytes before it is written
// out.
func NewWriter<W: io.Writer>(w mut W) Writer<W> {
	return Writer<W>{w: w, buf: []byte{}, size: blockSize}
}

// NewWriterSize is NewWriter with a buffer of size bytes; a size below
// one is one.
func NewWriterSize<W: io.Writer>(w mut W, size int) Writer<W> {
	if size < 1 {
		size = 1
	}

	return Writer<W>{w: w, buf: []byte{}, size: size}
}

// NewReader returns a Reader that reads from r, borrowed for as long as
// the Reader lives.
func NewReader<R: io.Reader>(r mut R) Reader<R> {
	return Reader<R>{r: r, buf: []byte{}, block: make([]byte, blockSize), start: 0, done: false}
}

// NewScanner returns a Scanner over r, borrowed for as long as the
// Scanner lives, with no line read yet.
func NewScanner<R: io.Reader>(r mut R) Scanner<R> {
	return Scanner<R>{r: r, buf: []byte{}, block: make([]byte, blockSize), start: 0, end: 0, scanned: 0, done: false, err: None}
}

// Write adds p to the buffer, writing the buffer out when it fills, and
// returns the length of p. An error is the underlying writer's, from
// the write that failed. It is io.Writer's method.
func (b mut Writer<W>) Write(p ref []byte) Result<int, io.Error> {
	for _, c := range p {
		b.push(c)?
	}

	return Ok(len(p))
}

// WriteString adds s to the buffer, as Write does its bytes, and
// returns its length.
func (b mut Writer<W>) WriteString(s ref string) Result<int, io.Error> {
	for i := 0; i < s.Len(); i++ {
		b.push(s[i])?
	}

	return Ok(s.Len())
}

// WriteByte adds one byte to the buffer.
func (b mut Writer<W>) WriteByte(c byte) Result<(), io.Error> {
	return b.push(c)
}

// push adds one byte and writes the buffer out when it is full.
func (b mut Writer<W>) push(c byte) Result<(), io.Error> {
	b.buf.Push(c)
	if len(b.buf) >= b.size {
		b.Flush()?
	}

	return Ok(())
}

// Flush writes what the buffer holds to the writer under it, asking
// again for what a short write left, and empties the buffer. It is
// what a program defers after NewWriter.
func (b mut Writer<W>) Flush() Result<(), io.Error> {
	written := 0
	for written < len(b.buf) {
		n := b.w.Write(b.buf[written:])?
		if n <= 0 {
			return Err(io.ShortWrite())
		}

		written += n
	}

	b.buf.Clear()
	return Ok(())
}

// Buffered returns how many bytes the buffer holds that Flush has not
// written yet.
func (b ref Writer<W>) Buffered() int {
	return len(b.buf)
}

// Read fills p from the buffer, reading from the reader under it when
// the buffer is empty, and returns how many bytes it wrote to p: zero
// at the end of the input. It is io.Reader's method.
func (r mut Reader<R>) Read(p mut []byte) Result<int, io.Error> {
	if len(p) == 0 {
		return Ok(0)
	}

	if !r.fill()? {
		return Ok(0)
	}

	n := 0
	for n < len(p) && r.start < len(r.buf) {
		p[n] = r.buf[r.start]
		n++
		r.start++
	}

	return Ok(n)
}

// ReadByte returns the next byte, or None at the end of the input.
func (r mut Reader<R>) ReadByte() Result<byte?, io.Error> {
	if !r.fill()? {
		return Ok(None)
	}

	c := r.buf[r.start]
	r.start++
	return Ok(Some(c))
}

// ReadString reads up to and including the first delim and returns
// what it read, delim included; at the end of the input it returns
// what was left, and None once nothing is.
func (r mut Reader<R>) ReadString(delim byte) Result<string?, io.Error> {
	out := []byte{}
	for {
		if !r.fill()? {
			break
		}

		c := r.buf[r.start]
		r.start++
		out.Push(c)
		if c == delim {
			break
		}
	}

	if len(out) == 0 {
		return Ok(None)
	}

	return Ok(Some(string(out)))
}

// fill makes sure the buffer has a byte to give, reading a block when
// it is empty, and reports whether it has one: false at the end of the
// input.
func (r mut Reader<R>) fill() Result<bool, io.Error> {
	if r.start < len(r.buf) {
		return Ok(true)
	}

	if r.done {
		return Ok(false)
	}

	r.buf.Clear()
	r.start = 0
	n := r.r.Read(mut r.block)?
	if n == 0 {
		r.done = true
		return Ok(false)
	}

	for i := 0; i < n; i++ {
		r.buf.Push(r.block[i])
	}

	return Ok(true)
}

// Scan reads the next line and reports whether there was one; false at
// the end of the input, or when a read failed, which Err then says. The
// line is read without its ending, a newline or a carriage return and
// a newline; a last line without one is a line too.
func (s mut Scanner<R>) Scan() bool {
	if s.done {
		s.start = s.end // no line any more
		return false
	}

	// Drop the line Scan gave last time, and look for the end of the
	// next one, reading more while it has none; what was looked at
	// without finding one is not looked at again.
	s.start = s.end
	s.scanned = s.start
	for {
		if i := s.newline() {
			s.end = i + 1
			return true
		}

		s.scanned = len(s.buf)
		n := match s.r.Read(mut s.block) {
			Ok(n) => n,
			Err(e) => {
				s.err = Some(e)
				s.done = true
				return false
			},
		}

		if n == 0 {
			// The input ends: what is left is the last line, when
			// there is anything.
			s.done = true
			s.end = len(s.buf)
			return s.start < s.end
		}

		// Keep only what Scan has not given, then add the block.
		if s.start > 0 {
			kept := []byte{}
			for i := s.start; i < len(s.buf); i++ {
				kept.Push(s.buf[i])
			}

			s.scanned -= s.start
			s.buf = kept
			s.start = 0
			s.end = 0
		}

		for i := 0; i < n; i++ {
			s.buf.Push(s.block[i])
		}
	}
}

// newline returns the index of the first newline in what has not been
// looked at yet, from scanned on, or None.
func (s ref Scanner<R>) newline() int? {
	for i := s.scanned; i < len(s.buf); i++ {
		if s.buf[i] == '\n' {
			return Some(i)
		}
	}

	return None
}

// Bytes lends the last line Scan read, without its line ending; the
// borrow lasts as long as the Scanner's. Before Scan, or after it
// returned false, the line is empty.
func (s ref Scanner<R>) Bytes() ref []byte {
	end := s.end
	if end > s.start && s.buf[end-1] == '\n' {
		end--
	}

	if end > s.start && s.buf[end-1] == '\r' {
		end--
	}

	return s.buf[s.start:end]
}

// Text returns the last line Scan read as a new string, without its
// line ending.
func (s ref Scanner<R>) Text() string {
	return string(s.Bytes())
}

// Err returns the error that ended scanning, or None when the input
// ended or scanning goes on.
func (s ref Scanner<R>) Err() ref io.Error? {
	return match ref s.err {
		Some(e) => Some(e),
		None => None,
	}
}
