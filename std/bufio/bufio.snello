// Package bufio puts a buffer between a program and a reader or a
// writer, so that many small reads or writes become a few large ones,
// and reads text by lines or by words.
//
// Each type borrows the reader or writer under it, mut, for as long as
// it lives: out := os.Stdout(); bufio.NewWriter(mut out) is a Writer<os.File> that
// holds the borrow, and the file is not written to directly while it
// does. A Writer, a Reader and a Scanner are borrows themselves, so
// they are lent to a call and dropped at the end of their scope, but
// not stored in a struct or a slice, nor sent. A Writer implements
// io.Writer and a Reader io.Reader, so fmt.Fprintln writes through a
// Writer and io.Copy reads through a Reader.
//
// What a Writer holds is written out by Flush, and by Write when the
// buffer is full. A Writer dropped without Flush loses what it holds,
// as Go's does, so a program defers Flush when it makes one. The first
// error a Writer meets is kept: every Write and Flush after it returns
// that error, and a byte the writer under it took is never written
// again. The end of the input is not an error: a Reader answers
// Ok(None) or Ok(0) there, and a Scanner's Scan answers false with Err
// None. The end is not final either: a Reader asked again asks the
// reader under it again, as Go's does, so a file another program is
// appending to is read on as it grows. A read that fails costs no
// byte: what a Reader had read when the reader under it failed is
// returned by the next call.
//
// The buffers are Go's: a Writer and a Reader hold one block of a fixed
// size, filled and emptied by index, and a Scanner one that doubles up
// to its limit. Bytes move between them and the program in blocks, by
// memmove, and a line's end is found by memchr; a write or a read at
// least as large as the buffer, when it holds nothing, goes straight
// between the program and the writer or reader under it, with no copy.
package bufio

import ("io"; "unicode"; "unicode/utf8")

// MaxScanTokenSize is the longest line a Scanner reads, 64 KiB, its
// ending included, unless Buffer sets another: a longer one ends the
// scan with "bufio.Scanner: token too long" rather than grow the
// buffer without a bound on input a program does not control.
const MaxScanTokenSize int = 65536

// The size of a Writer's and a Reader's buffer, and the first size of a
// Scanner's, as Go's bufio has them.
const blockSize int = 4096

// A Writer collects what is written to it and writes it to the writer
// under it in blocks, when its buffer is full and on Flush. It is made
// with NewWriter.
struct Writer<W: io.Writer> impl io.Writer {
	w   mut W
	buf []byte // its whole size from the start, of which n bytes are held
	n   int
	err io.Error? // the first error, which every later call returns
}

// A Reader reads from the reader under it in blocks and hands them out
// in the pieces asked for: bytes, lines, and what an io.Reader is
// asked. It is made with NewReader.
struct Reader<R: io.Reader> impl io.Reader {
	r        mut R
	buf      []byte // what was read and not handed out lies from rp up to wp
	rp       int
	wp       int
	unread   int // the width of the rune the last ReadRune returned, which UnreadRune can step back over, or -1
	lastByte int // the last byte read, which UnreadByte puts back, or -1
}

// A Scanner reads a reader line by line, or word by word: Scan reads
// the next line or word, and Bytes or Text give it, a line without its
// line ending. It is made with NewScanner for lines and with Words for
// words.
struct Scanner<R: io.Reader> {
	r        mut R
	buf      []byte // what was read and not scanned lies from start up to end
	start    int
	end      int
	searched int // from start up to here holds no newline, or for words no white space
	line0    int // the line Scan gave last is buf[line0:line1]
	line1    int
	done     bool
	err      io.Error?
	max      int // the longest line, its ending included, or the longest word
	words    bool // Scan reads words, not lines
}

// NewWriter returns a Writer that writes to w, borrowed for as long as
// the Writer lives. Its buffer holds 4096 bytes before it is written
// out.
func NewWriter<W: io.Writer>(w mut W) Writer<W> {
	return Writer<W>{w: w, buf: make([]byte, blockSize), n: 0, err: None}
}

// NewWriterSize is NewWriter with a buffer of size bytes; a size below
// one is NewWriter's 4096, as Go's NewWriterSize has it.
func NewWriterSize<W: io.Writer>(w mut W, size int) Writer<W> {
	if size < 1 {
		size = blockSize
	}

	return Writer<W>{w: w, buf: make([]byte, size), n: 0, err: None}
}

// NewReader returns a Reader that reads from r, borrowed for as long as
// the Reader lives.
func NewReader<R: io.Reader>(r mut R) Reader<R> {
	return Reader<R>{r: r, buf: make([]byte, blockSize), rp: 0, wp: 0, unread: -1, lastByte: -1}
}

// NewScanner returns a Scanner over r, borrowed for as long as the
// Scanner lives, that reads lines, with no line read yet.
func NewScanner<R: io.Reader>(r mut R) Scanner<R> {
	return Scanner<R>{r: r, buf: []byte{}, start: 0, end: 0, searched: 0, line0: 0, line1: 0, done: false, err: None, max: MaxScanTokenSize, words: false}
}

// Words returns a Scanner over r, borrowed for as long as the Scanner
// lives, that reads words, with none read yet: the runs of runes
// between white space, as Go's ScanWords splits them, white space being
// what unicode.IsSpace says it is, and a byte that starts no rune
// counting as part of a word. A word is at most MaxScanTokenSize bytes
// long, or what Buffer sets; a longer one ends the scan as a long line
// does. It is a constructor of its own where Go has a Split method, so
// that a Scanner reads one kind of piece from its first Scan to its
// last.
func Words<R: io.Reader>(r mut R) Scanner<R> {
	return Scanner<R>{r: r, buf: []byte{}, start: 0, end: 0, searched: 0, line0: 0, line1: 0, done: false, err: None, max: MaxScanTokenSize, words: true}
}

// Buffer sets the longest line the Scanner reads, its ending included,
// or the longest word, in place of MaxScanTokenSize; a size below one
// is one. Go's Buffer
// also takes the first buffer to read into, which a Snello Scanner makes
// itself.
func (s mut Scanner<R>) Buffer(size int) {
	s.max = max(size, 1)
}

// Write adds p to the buffer, writing the buffer out when it fills, and
// returns the length of p. A p larger than what the buffer has room
// for, when it holds nothing, is written to the writer under it
// directly. An error is the underlying writer's, from the write that
// failed, or the one kept from an earlier call, which an empty p meets
// too, as Go's Write has it. It is io.Writer's method.
func (b mut Writer<W>) Write(p ref []byte) Result<int, io.Error> {
	if e := b.err {
		return Err(e.Clone())
	}

	nn := 0
	for len(p)-nn > len(b.buf)-b.n {
		if b.n == 0 {
			nn += b.writeOut(p[nn:])?
			return Ok(nn)
		}

		k := copyBytes(mut b.buf[b.n:], p[nn:])
		b.n += k
		nn += k
		b.Flush()?
	}

	k := copyBytes(mut b.buf[b.n:], p[nn:])
	b.n += k
	return Ok(nn + k)
}

// WriteString adds s to the buffer, as Write does its bytes, and
// returns its length; a kept error is returned for an empty s too. An s
// longer than the room left, when the buffer holds nothing, is written
// to the writer under it directly.
func (b mut Writer<W>) WriteString(s ref string) Result<int, io.Error> {
	if e := b.err {
		return Err(e.Clone())
	}

	nn := 0
	for s.Len()-nn > len(b.buf)-b.n {
		if b.n == 0 { // as Go writes a string straight to a writer that takes strings
			nn += b.writeOut(bytesOf(s[nn:]))?
			return Ok(nn)
		}

		k := copyString(mut b.buf[b.n:], s[nn:])
		b.n += k
		nn += k
		b.Flush()?
	}

	k := copyString(mut b.buf[b.n:], s[nn:])
	b.n += k
	return Ok(nn + k)
}

// WriteByte adds one byte to the buffer, writing the buffer out first
// when it is full.
func (b mut Writer<W>) WriteByte(c byte) Result<(), io.Error> {
	if e := b.err {
		return Err(e.Clone())
	}

	if b.n == len(b.buf) {
		b.Flush()?
	}

	b.buf[b.n] = c
	b.n++
	return Ok(())
}

// writeOut writes p to the writer under the Writer, asking again for
// what a short write left, and keeps the error of a write that fails.
func (b mut Writer<W>) writeOut(p ref []byte) Result<int, io.Error> {
	written := 0
	for written < len(p) {
		failed := match b.w.Write(p[written:]) {
			Ok(n) => {
				if n > 0 {
					written += n
					continue
				}

				io.ShortWrite()
			},
			Err(e) => e,
		}

		b.err = Some(failed.Clone())
		return Err(failed)
	}

	return Ok(written)
}

// Flush writes what the buffer holds to the writer under it, asking
// again for what a short write left, and empties the buffer. It is
// what a program defers after NewWriter. When a write fails, the bytes
// written before it leave the buffer, the rest stay, and the error is
// kept for every later call.
func (b mut Writer<W>) Flush() Result<(), io.Error> {
	if e := b.err {
		return Err(e.Clone())
	}

	written := 0
	for written < b.n {
		failed := match b.w.Write(b.buf[written:b.n]) {
			Ok(n) => {
				if n > 0 {
					written += n
					continue
				}

				io.ShortWrite()
			},
			Err(e) => e,
		}

		slide(mut b.buf, written, b.n)
		b.n -= written
		b.err = Some(failed.Clone())
		return Err(failed)
	}

	b.n = 0
	return Ok(())
}

// Buffered returns how many bytes the buffer holds that Flush has not
// written yet.
func (b ref Writer<W>) Buffered() int {
	return b.n
}

// Available returns how many bytes the buffer has room for before a
// write fills it.
func (b ref Writer<W>) Available() int {
	return len(b.buf) - b.n
}

// Get lends the writer under the Writer, for as long as the Writer is
// lent. The Writer holds that writer mut until it is dropped, so this
// is the way to reach it meanwhile, as Go's program reaches the value
// it gave bufio.NewWriter. A write made through it goes ahead of what
// the buffer still holds: Flush first to keep the order.
func (b mut Writer<W>) Get() mut W {
	return mut b.w
}

// Get lends the reader under the Reader, for as long as the Reader is
// lent. The Reader holds that reader mut until it is dropped, so this
// is the way to reach it meanwhile: a connection read line by line
// through a Reader is written to through Get. A read made through it
// takes bytes from after those the buffer already holds.
func (r mut Reader<R>) Get() mut R {
	return mut r.r
}

// Read fills p from the buffer, reading from the reader under it when
// the buffer is empty, and returns how many bytes it wrote to p: zero
// at the end of the input. A p at least as large as the buffer, when it
// holds nothing, is read into directly. It is io.Reader's method.
func (r mut Reader<R>) Read(p mut []byte) Result<int, io.Error> {
	r.unread = -1
	if len(p) == 0 {
		return Ok(0)
	}

	if r.rp == r.wp {
		if len(p) >= len(r.buf) {
			n := r.r.Read(p)?
			if n > 0 {
				r.lastByte = int(p[n-1])
			}

			return Ok(n)
		}

		r.rp = 0
		r.wp = 0
		n := r.r.Read(mut r.buf)?
		if n == 0 {
			return Ok(0)
		}

		r.wp = n
	}

	k := copyBytes(p, r.buf[r.rp:r.wp])
	r.rp += k
	r.lastByte = int(r.buf[r.rp-1])
	return Ok(k)
}

// ReadByte returns the next byte, or None at the end of the input.
func (r mut Reader<R>) ReadByte() Result<byte?, io.Error> {
	r.unread = -1
	if r.rp == r.wp && !r.fill()? {
		return Ok(None)
	}

	c := r.buf[r.rp]
	r.rp++
	r.lastByte = int(c)
	return Ok(Some(c))
}

// ReadRune returns the next rune and how many bytes it took, or None at
// the end of the input. A byte that does not start a valid UTF-8
// sequence reads as U+FFFD of width one, as a range over a string reads
// it. It asks the reader under it for more only while the bytes it has
// are the start of a rune cut short, so a rune typed at a terminal, or
// bytes already no rune's start, are returned without waiting.
func (r mut Reader<R>) ReadRune() Result<(rune, int)?, io.Error> {
	r.unread = -1
	for !utf8.FullRune(r.buf[r.rp:r.wp]) {
		before := r.wp - r.rp
		if !r.fill()? || r.wp - r.rp == before {
			break
		}
	}

	if r.rp == r.wp {
		return Ok(None)
	}

	c, n := utf8.DecodeRune(r.buf[r.rp:r.wp])
	r.rp += n
	r.unread = n
	r.lastByte = int(r.buf[r.rp-1])
	return Ok(Some((c, n)))
}

// UnreadRune puts back the rune the last call returned, so the next
// read gives it again, when that call was ReadRune; after any other
// call it returns false and changes nothing. It is stricter than
// UnreadByte, as Go's documentation says of its own.
func (r mut Reader<R>) UnreadRune() bool {
	if r.unread < 0 || r.rp < r.unread {
		return false
	}

	r.rp -= r.unread
	r.unread = -1
	r.lastByte = -1
	return true
}

// ReadString reads up to and including the first delim and returns
// what it read, delim included; at the end of the input it returns
// what was left, and None once nothing is. A later call asks the
// reader under it again, and gives what has arrived since.
func (r mut Reader<R>) ReadString(delim byte) Result<string?, io.Error> {
	return match r.collect(delim)? {
		None => Ok(None),
		Some((long, from)) => {
			if len(long) == 0 { // the whole line lay in the buffer: one copy, into the string
				return Ok(Some(string(r.buf[from:r.rp])))
			}

			appendBytes(mut long, r.buf[from:r.rp])
			Ok(Some(string(long)))
		},
	}
}

// ReadBytes is ReadString giving the line as bytes the caller owns.
func (r mut Reader<R>) ReadBytes(delim byte) Result<([]byte)?, io.Error> {
	return match r.collect(delim)? {
		None => Ok(None),
		Some((long, from)) => {
			appendBytes(mut long, r.buf[from:r.rp])
			Ok(Some(long))
		},
	}
}

// collect finds the next line, up to and including the first delim, or
// to the end of the input, and moves past it: the line is the bytes it
// returns, set aside when it was longer than the buffer, then those of
// the buffer from the index it returns up to rp. It returns None at the
// end of the input when nothing is left. On a failure of the reader
// under it, what it had set aside goes back in front of the buffer, so
// the next call reads it again: a failure costs no byte.
func (r mut Reader<R>) collect(delim byte) Result<([]byte, int)?, io.Error> {
	r.unread = -1
	long := []byte{} // the first parts of a line longer than the buffer
	for {
		i := indexByte(r.buf[r.rp:r.wp], delim)
		if i >= 0 {
			from := r.rp
			r.rp += i + 1
			r.lastByte = int(delim)
			return Ok(Some((long, from)))
		}

		if r.wp-r.rp == len(r.buf) { // full of one line: set it aside and read on
			appendBytes(mut long, r.buf[r.rp:r.wp])
			r.rp = r.wp
		}

		more := match r.fill() {
			Ok(more) => more,
			Err(e) => {
				if len(long) > 0 { // what was set aside goes back in front, for the next call
					appendBytes(mut long, r.buf[r.rp:r.wp])
					r.buf = long
					r.rp = 0
					r.wp = len(r.buf)
				}

				return Err(e)
			},
		}

		if !more { // the end of the input: what is left is the last line
			from := r.rp
			r.rp = r.wp
			if from < r.wp {
				r.lastByte = int(r.buf[r.wp-1])
			} else if len(long) > 0 {
				r.lastByte = int(long[len(long)-1])
			} else {
				return Ok(None)
			}

			return Ok(Some((long, from)))
		}
	}
}

// Peek lends the next n bytes without reading past them, so that the
// next read gives them again: fewer when the input ends first, and none
// at its end. The bytes are the buffer's, lent for as long as nothing
// else is asked of the Reader, which the compiler holds a program to,
// where Go's Peek says they stop being valid at the next read. A count
// below zero is an Error, "bufio: negative count", and one past the
// buffer's 4096 bytes another, "bufio: buffer full", since the buffer
// cannot hold what was asked.
func (r mut Reader<R>) Peek(n int) Result<ref []byte, io.Error> {
	r.unread = -1
	if n < 0 {
		return Err(io.NewError("bufio", "", "negative count", io.Other))
	}

	r.lastByte = -1
	if n > len(r.buf) {
		return Err(io.NewError("bufio", "", "buffer full", io.Other))
	}

	for r.wp-r.rp < n && r.fill()? {}
	return Ok(r.buf[r.rp:min(r.rp+n, r.wp)])
}

// UnreadByte puts back the last byte read, so the next read gives it
// again, as Go's UnreadByte does: the last byte Read, ReadByte,
// ReadRune, ReadString or ReadBytes returned, a read that returned
// nothing at the end of the input leaving it the last. Before any byte
// was read, and after Peek, UnreadRune or another UnreadByte, it
// returns false and changes nothing.
func (r mut Reader<R>) UnreadByte() bool {
	if r.lastByte < 0 || (r.rp == 0 && r.wp > 0) {
		return false
	}

	if r.rp > 0 {
		r.rp--
	} else { // a read straight into the caller's buffer left this one empty
		r.wp = 1
	}

	r.buf[r.rp] = byte(r.lastByte)
	r.lastByte = -1
	r.unread = -1
	return true
}

// fill moves what the buffer holds to its start and reads into the room
// after it, and reports whether it read anything: false at the end of
// the input, which is asked about again the next time, since the reader
// under it may have more by then.
func (r mut Reader<R>) fill() Result<bool, io.Error> {
	if r.rp > 0 {
		slide(mut r.buf, r.rp, r.wp)
		r.wp -= r.rp
		r.rp = 0
	}

	if r.wp == len(r.buf) {
		return Ok(true)
	}

	n := r.r.Read(mut r.buf[r.wp:])?
	r.wp += n
	return Ok(n > 0)
}

// Scan reads the next line, or the next word, and reports whether there
// was one; false at the end of the input, or when a read failed, which
// Err then says; what was read before a failure is given as the last
// line or word first. A line is read without its ending, a newline or a
// carriage return and a newline; a last line without one is a line too.
func (s mut Scanner<R>) Scan() bool {
	for {
		if s.words {
			if s.word() {
				return true
			}
		} else if i := s.newline() {
			s.line0 = s.start
			s.line1 = i + 1
			s.start = i + 1
			s.searched = s.start
			return true
		} else {
			s.searched = s.end
		}

		if s.done { // the input ended, or a read failed: what is left is the last line; word took the last word already
			s.line0 = s.start
			s.line1 = s.end
			s.start = s.end
			return s.line0 < s.line1
		}

		// Room for more: what is held moves to the start, and a buffer
		// full of one line doubles, up to the limit.
		if s.start > 0 {
			slide(mut s.buf, s.start, s.end)
			s.end -= s.start
			s.searched -= s.start
			s.start = 0
		}

		if s.end == len(s.buf) {
			if len(s.buf) >= s.max {
				s.err = Some(io.NewError("bufio.Scanner", "", "token too long", io.Other))
				s.done = true
				s.line0 = s.start // no line: the long one is not given in part
				s.line1 = s.start
				s.start = s.end
				return false
			}

			bigger := make([]byte, min(max(2*len(s.buf), blockSize), s.max))
			copyBytes(mut bigger, s.buf[0:s.end])
			s.buf = bigger
		}

		n := match s.r.Read(mut s.buf[s.end:]) {
			Ok(n) => n,
			Err(e) => {
				s.err = Some(e)
				0
			},
		}

		if n == 0 {
			s.done = true
		}

		s.end += n
	}
}

// word finds the next word in what was read and not scanned, by the
// rules of Go's ScanWords, and reports whether there is one: the white
// space before it is passed over whether or not a word follows, so that
// it never fills the buffer, and a word that reaches the end of what was
// read is one only when the input ended, since the next read may
// lengthen it. A rune cut short at that end is decoded once the rest is
// read, and at the end of the input as a byte that starts no rune, part
// of a word. The search goes on from where the last one stopped, which
// searched keeps, so that a word read in many small pieces is decoded
// once, where Go's ScanWords decodes it again from its start after every
// read.
func (s mut Scanner<R>) word() bool {
	if s.searched <= s.start { // not past the white space yet; a rune cut short stops the pass below
		for s.start < s.end {
			c, w := utf8.DecodeRune(s.buf[s.start:s.end])
			if !unicode.IsSpace(c) {
				break
			}

			s.start += w
		}

		s.searched = s.start
	}

	for s.searched < s.end {
		if !s.done && !utf8.FullRune(s.buf[s.searched:s.end]) {
			return false
		}

		c, w := utf8.DecodeRune(s.buf[s.searched:s.end])
		if unicode.IsSpace(c) {
			s.line0 = s.start
			s.line1 = s.searched
			s.start = s.searched + w
			s.searched = s.start
			return true
		}

		s.searched += w
	}

	if s.done && s.start < s.end {
		s.line0 = s.start
		s.line1 = s.end
		s.start = s.end
		s.searched = s.end
		return true
	}

	return false
}

// newline returns the index of the first newline in what has not been
// looked at yet, from searched on, or None.
func (s ref Scanner<R>) newline() int? {
	i := indexByte(s.buf[s.searched:s.end], '\n')
	if i < 0 {
		return None
	}

	return Some(s.searched + i)
}

// Bytes lends the last line Scan read, without its line ending, or the
// last word, which ends in neither a newline nor a carriage return,
// both being white space; the borrow lasts as long as the Scanner's.
// Before Scan, or after it returned false, it is empty.
func (s ref Scanner<R>) Bytes() ref []byte {
	end := s.line1
	if end > s.line0 && s.buf[end-1] == '\n' {
		end--
	}

	if end > s.line0 && s.buf[end-1] == '\r' {
		end--
	}

	return s.buf[s.line0:end]
}

// Text returns the last line Scan read as a new string, without its
// line ending, or the last word.
func (s ref Scanner<R>) Text() string {
	return string(s.Bytes())
}

// Err returns the error that ended scanning, or None when the input
// ended or scanning goes on.
func (s ref Scanner<R>) Err() ref io.Error? {
	return match ref s.err {
		Some(e) => Some(e),
		None => None,
	}
}

// copyBytes copies the bytes of src that fit to the start of dst, the
// two possibly overlapping, and returns how many: Go's copy. The
// runtime provides it, by memmove.
func copyBytes(dst mut []byte, src ref []byte) int

// copyString is copyBytes from a string.
func copyString(dst mut []byte, src ref string) int

// indexByte returns the index of the first c in p, or -1: Go's
// bytes.IndexByte, by memchr.
func indexByte(p ref []byte, c byte) int

// appendBytes appends the bytes of p to b in one copy, growing b once.
func appendBytes(b mut []byte, p ref []byte)

// slide moves the bytes of b from lo up to hi to its start, where a
// buffer keeps what it has not handed out.
func slide(b mut []byte, lo int, hi int)

// bytesOf lends the bytes of s as a slice of them, with no copy.
func bytesOf(s ref string) ref []byte
