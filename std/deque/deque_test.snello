package deque_test

import ("deque"; "expect"; "fmt"; "iter"; "testing")

// A deque pushed at the back and popped at the front is a queue, and an
// empty one gives None at both ends.
func TestQueue() {
	d := deque.New<int>()
	expect.True(d.IsEmpty())
	expect.IsNone(d.PopFront())
	expect.IsNone(d.PopBack())
	expect.True(d.Front().IsNone())
	expect.True(d.Back().IsNone())
	expect.True(d.Get(0).IsNone())
	expect.True(d.GetMut(0).IsNone())
	for i := 1; i <= 10; i++ {
		d.PushBack(i)
	}

	expect.Equal(ref d.Len(), ref 10)
	if v := d.Front() { expect.Equal(v, ref 1) } else { expect.Fail("no front") }
	if v := d.Back() { expect.Equal(v, ref 10) } else { expect.Fail("no back") }
	for i := 1; i <= 10; i++ {
		expect.Equal(ref expect.IsSome(d.PopFront()), ref i)
	}

	expect.True(d.IsEmpty())
}

// Pushes and pops at both ends, and Get and GetMut by index, the head
// wrapping round the buffer.
func TestBothEnds() {
	d := deque.New<string>()
	d.PushFront("b".Clone()) // on an empty deque: the head wraps to the buffer's last slot
	if v := d.Front() { expect.Equal(v, "b") } else { expect.Fail("no front") }
	if v := d.Back() { expect.Equal(v, "b") } else { expect.Fail("no back") }
	d.PushFront("a".Clone())
	d.PushBack("c".Clone())
	expect.Equal(ref fmt.Sprint(d), "deque[a b c]")
	if v := d.Get(1) { expect.Equal(v, "b") } else { expect.Fail("no middle element") }
	expect.True(d.Get(3).IsNone())
	expect.True(d.Get(-1).IsNone())
	if v := d.GetMut(1) { *v = "B".Clone() } else { expect.Fail("no middle element") }
	expect.Equal(ref expect.IsSome(d.PopBack()), "c")
	expect.Equal(ref expect.IsSome(d.PopFront()), "a")
	expect.Equal(ref expect.IsSome(d.PopFront()), "B")
	expect.IsNone(d.PopBack())
}

// The ring wraps round its buffer and grows with the elements in order,
// strings as ints: a grow with the head past the start lays them out
// straight, and each is moved, not copied.
func TestWrapAndGrow() {
	d := deque.WithCapacity<string>(4)
	expect.Equal(ref d.Cap(), ref 4)
	for i := 0; i < 3; i++ {
		d.PushBack(fmt.Sprint("s", i))
	}

	expect.Equal(ref expect.IsSome(d.PopFront()), "s0")
	expect.Equal(ref expect.IsSome(d.PopFront()), "s1")
	for i := 3; i < 9; i++ { // past the end of the buffer, then past its room
		d.PushBack(fmt.Sprint("s", i))
	}

	d.PushFront("s1".Clone())
	expect.Equal(ref fmt.Sprint(d), "deque[s1 s2 s3 s4 s5 s6 s7 s8]")
	expect.Equal(ref d.Cap(), ref 8)
	n := 0
	for v := range d.Iter() { // a full ring, wrapped
		expect.Equal(v, ref fmt.Sprint("s", n + 1))
		n++
	}

	expect.Equal(ref n, ref 8)
	d.Clear()
	expect.True(d.IsEmpty())
	expect.Equal(ref d.Cap(), ref 8)
	for range d.Iter() {
		expect.Fail("an empty deque yielded an element")
	}

	d.PushBack("again".Clone())
	expect.Equal(ref fmt.Sprint(d), "deque[again]")
}

// A full ring grows with its elements in order wherever its head is:
// at the start, so that it has not wrapped, or past it, so that a run
// lies at the start and a run at the end.
func TestGrowKeepsOrder() {
	for _, head := range []int{0, 2, 6} {
		d := deque.WithCapacity<string>(8)
		for i := 0; i < head; i++ { // move the head to where the case wants it
			d.PushBack("x".Clone())
			_ = d.PopFront()
		}

		for i := 0; i < 8; i++ {
			d.PushBack(fmt.Sprint(i))
		}

		expect.Equal(ref d.Cap(), ref 8)
		d.PushBack("8".Clone()) // full: it grows
		d.PushFront("-1".Clone())
		expect.Equal(ref d.Cap(), ref 16)
		expect.Equal(ref fmt.Sprint(d), "deque[-1 0 1 2 3 4 5 6 7 8]")
		for want := -1; want <= 8; want++ {
			expect.Equal(ref expect.IsSome(d.PopFront()), ref fmt.Sprint(want))
		}
	}
}

// A capacity is rounded up to a power of two, at least four, and one no
// memory can hold is out of memory.
func TestCapacity() {
	expect.Equal(ref deque.WithCapacity<int>(0).Cap(), ref 0)
	expect.Equal(ref deque.WithCapacity<int>(-3).Cap(), ref 0)
	expect.Equal(ref deque.WithCapacity<int>(5).Cap(), ref 8)
	expect.Equal(ref deque.WithCapacity<int>(17).Cap(), ref 32)
	d := deque.New<int>()
	expect.Equal(ref d.Cap(), ref 0)
	d.PushFront(1)
	expect.Equal(ref d.Cap(), ref 4)
	// A room whose bytes no address reaches is out of memory, where the
	// size would otherwise wrap to a small block written past its end.
	expect.PanicsWith(func() { _ = deque.WithCapacity<int>(2305843009213693952) }, "out of memory: no buffer holds that many elements")
	expect.PanicsWith(func() { _ = deque.WithCapacity<string>(4611686018427387905) }, "out of memory: no buffer holds that many elements")
}

// Elements are dropped with the deque, and a popped element is the
// caller's.
func TestOwnership() {
	d := deque.New<[]int>()
	d.PushBack([]int{1, 2})
	d.PushFront([]int{0})
	xs := expect.IsSome(d.PopFront())
	expect.Equal(ref len(xs), ref 1)
	expect.Equal(ref d.Len(), ref 1)
}

// Insert and Remove in the middle move the shorter side and keep the
// order, wherever the head is and whichever side is shorter, as a
// slice's Insert and Remove do; an index past the ends clamps for
// Insert and gives None for Remove.
func TestInsertRemove() {
	for _, head := range []int{0, 2, 5, 7} {
		for n := 0; n <= 7; n++ {
			for i := 0; i <= n; i++ {
				d := withHead(head, n)
				model := counting(n)
				d.Insert(i, 100)
				model.Insert(i, 100)
				expect.Equal(ref fmt.Sprint(d), ref "deque"+fmt.Sprint(model))
				expect.Equal(ref expect.IsSome(d.Remove(i)), ref 100)
				model.Remove(i)
				expect.Equal(ref fmt.Sprint(d), ref "deque"+fmt.Sprint(model))
				if i < n {
					expect.Equal(ref expect.IsSome(d.Remove(i)), ref model.Remove(i))
					expect.Equal(ref fmt.Sprint(d), ref "deque"+fmt.Sprint(model))
				}
			}
		}
	}

	d := deque.New<string>()
	d.Insert(5, "b".Clone()) // past the back: at the back
	d.Insert(-5, "a".Clone()) // before the front: at the front
	d.Insert(1, "x".Clone())
	expect.Equal(ref fmt.Sprint(d), "deque[a x b]")
	expect.IsNone(d.Remove(3))
	expect.IsNone(d.Remove(-1))
	expect.Equal(ref expect.IsSome(d.Remove(1)), "x")
	expect.Equal(ref fmt.Sprint(d), "deque[a b]")
	full := deque.WithCapacity<int>(4)
	for i := 0; i < 4; i++ {
		full.PushBack(i)
	}

	full.Insert(2, 9) // full: it grows first
	expect.Equal(ref fmt.Sprint(full), "deque[0 1 9 2 3]")
	expect.Equal(ref full.Cap(), ref 8)
}

// Rotate turns the ring by moving the fewer elements, any n in or out
// of range, wherever the head is, a full ring included.
func TestRotate() {
	for _, head := range []int{0, 3, 6} {
		for n := 0; n <= 8; n++ { // 8 fills the buffer of eight
			for by := -9; by <= 17; by++ {
				d := withHead(head, n)
				d.Rotate(by)
				expect.Equal(ref fmt.Sprint(d), ref "deque"+fmt.Sprint(rotated(counting(n), by)))
				expect.Equal(ref d.Cap(), ref 8)
			}
		}
	}

	d := deque.New<string>()
	for _, s := range []string{"a", "b", "c", "d"} {
		d.PushBack(s.Clone())
	}

	d.Rotate(1)
	expect.Equal(ref fmt.Sprint(d), "deque[d a b c]")
	d.Rotate(-2)
	expect.Equal(ref fmt.Sprint(d), "deque[b c d a]")
	expect.Equal(ref expect.IsSome(d.PopFront()), "b")
}

// Truncate drops from the back, Retain drops in place keeping the order,
// and Extend adds an iterator's items at the back.
func TestTruncateRetainExtend() {
	d := deque.New<string>()
	for i := 0; i < 6; i++ {
		d.PushBack(fmt.Sprint(i))
	}

	d.Truncate(10)
	expect.Equal(ref d.Len(), ref 6)
	d.Truncate(4)
	expect.Equal(ref fmt.Sprint(d), "deque[0 1 2 3]")
	d.Retain(func(s ref string) bool { return s != "1" && s != "3" })
	expect.Equal(ref fmt.Sprint(d), "deque[0 2]")
	d.Retain(func(s ref string) bool { return true })
	expect.Equal(ref fmt.Sprint(d), "deque[0 2]")
	more := []string{"x".Clone(), "y".Clone()}
	d.Extend(mut iter.Over(ref more).Map(func(s ref string) string { return s.Clone() }))
	expect.Equal(ref fmt.Sprint(d), "deque[0 2 x y]")
	d.Retain(func(s ref string) bool { return false })
	expect.True(d.IsEmpty())
	d.PushFront("z".Clone())
	expect.Equal(ref fmt.Sprint(d), "deque[z]")
	d.Truncate(-1)
	expect.True(d.IsEmpty())
	for _, head := range []int{0, 5} { // a wrapped ring: the gap closes round the end
		w := withHead(head, 7)
		w.Retain(func(v ref int) bool { return *v%3 != 1 })
		expect.Equal(ref fmt.Sprint(w), "deque[0 2 3 5 6]")
	}
}

// A range over the deque lent mut changes the elements in place, and
// Contains and Index find an element by Eq.
func TestIterMutContains() {
	d := withHead(3, 5)
	for v := range mut d {
		*v *= 10
	}

	expect.Equal(ref fmt.Sprint(d), "deque[0 10 20 30 40]")
	it := d.IterMut()
	if v := it.Next() { *v = 7 } else { expect.Fail("no first element") }
	expect.Equal(ref expect.IsSome(d.PopFront()), ref 7)
	expect.True(deque.Contains(ref d, ref 30))
	expect.False(deque.Contains(ref d, ref 7))
	names := deque.New<string>()
	names.PushBack("ann".Clone())
	names.PushBack("bob".Clone())
	names.PushBack("ann".Clone())
	expect.True(deque.Contains(ref names, "ann"))
	expect.False(deque.Contains(ref names, "cid"))
	expect.Equal(ref expect.IsSome(deque.Index(ref names, "bob")), ref 1)
	expect.Equal(ref expect.IsSome(deque.Index(ref names, "ann")), ref 0) // the first of two
	expect.IsNone(deque.Index(ref names, "cid"))
	if i := deque.Index(ref names, "bob") {
		expect.Equal(ref expect.IsSome(names.Remove(i)), "bob")
	}

	expect.Equal(ref fmt.Sprint(names), "deque[ann ann]")
}

// withHead returns a deque of a buffer of eight holding 0 to n-1, its
// head at the slot head.
func withHead(head int, n int) deque.Deque<int> {
	d := deque.WithCapacity<int>(8)
	for i := 0; i < head; i++ {
		d.PushBack(0)
		_ = d.PopFront()
	}

	for i := 0; i < n; i++ {
		d.PushBack(i)
	}

	return d
}

// counting returns the slice 0 to n-1.
func counting(n int) []int {
	xs := []int{}
	for i := 0; i < n; i++ {
		xs.Push(i)
	}

	return xs
}

// rotated returns xs turned by places toward the back, the model of
// Deque.Rotate.
func rotated(xs []int, by int) []int {
	n := len(xs)
	if n == 0 {
		return xs
	}

	k := by % n
	if k < 0 {
		k += n
	}

	out := []int{}
	for i := 0; i < n; i++ {
		out.Push(xs[(i+n-k)%n])
	}

	return out
}
