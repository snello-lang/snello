// Package deque is a double-ended queue: PushBack and PopFront make a
// queue, PushBack and PopBack a stack, and Front and Back read either
// end, each in constant time, a push amortized over the doubling of the
// buffer. The elements lie in a ring over one buffer, from the head
// onward and round its end, so an element is found from its index with
// one mask and no element moves on a push or a pop; when the buffer is
// full it doubles, and the elements are laid out straight again in the
// new one with two block moves. A slice used as a queue would move
// every element left down on each Remove(0). Insert and Remove in the
// middle move the shorter side, Rotate turns the ring by moving the
// fewer elements, each as block moves round the ring, and Retain and
// Truncate drop elements in place.
//
// The buffer's length is a power of two, so that the mask is the length
// less one. Its slots hold an element or nothing, which no value of the
// language can say without a tag beside each element, so the buffer is
// a block the compiler reads and writes for this package alone: the
// head and the count say which slots hold an element, every slot is
// written only when it holds nothing and read only when it holds one,
// and a slot costs the element alone.
package deque

import ("fmt"; "iter")

// The capacities of a Deque's buffer, in elements: the first buffer it
// allocates, and the largest power of two an int holds, past which no
// capacity grows.
const minCapacity int = 4
const maxCapacity int = 1 << 62

// A Deque is a double-ended queue of elements of type T. It owns its
// elements and lends them for reading or changing. It is moved, or lent
// with ref and mut; when it goes out of scope, the elements still in it
// are dropped with it. It has no zero value, as no type that frees what
// it holds has: one comes from New or WithCapacity.
//
//	d := deque.New<string>()
//	d.PushBack("a")
//	d.PushFront("b")
//	first := d.PopFront() // Some("b")
//
// It prints as deque[b a], the elements from front to back. It is Send
// when T is, so it may be sent to another task whole.
struct Deque<T> impl Drop, fmt.Stringer {
	elemType [0]*T // holds nothing: it gives the deque its elements' type, so that it is Send as they are, and a pointer, so that a type may hold a Deque of itself
	buf      int   // the block of slots, 0 before the first is made
	cap      int   // the slots, a power of two, or 0
	head     int   // the slot of the front element
	len      int   // the elements, in the slots from the head round the end
}

// An Iter walks a deque from front to back, or from the back through
// NextBack, lending each element; it
// lends the deque for as long as it lives, so the deque cannot change
// during the walk. Deque.Iter makes one, and the adapters of
// iter.Iterator wrap it: d.Iter().Filter(keep).Map(f).
struct Iter<T> impl iter.Iterator<ref T>, iter.DoubleEnded<ref T> {
	d   ref Deque<T>
	i   int // the element from the front Next gives
	end int // one past the element from the front NextBack gives
}

// An IterMut walks a deque from front to back, lending each element
// for changing; it lends the deque mut for as long as it lives. A range
// over the deque lent mut makes one, for v := range mut d, as
// Deque.IterMut does. It lists no trait, since an item it gives ties to
// the walk, where the trait's items are free of it.
struct IterMut<T> {
	d mut Deque<T>
	i int // the element from the front Next gives
}

// New returns an empty deque of elements of type T. It allocates
// nothing: the first push allocates a buffer of four elements.
func New<T>() Deque<T> {
	return Deque<T>{elemType: [0]*T{}, buf: 0, cap: 0, head: 0, len: 0}
}

// WithCapacity returns an empty deque with room for n elements before
// it grows: one allocation of n rounded up to a power of two, at least
// four, and none for an n of zero or less. An n no memory can hold
// panics, out of memory, as any allocation that fails does.
//
//	d := deque.WithCapacity<int>(100) // Cap() is 128
func WithCapacity<T>(n int) Deque<T> {
	d := New<T>()
	if n > 0 {
		d.cap = capacityFor(n)
		d.buf = rawAlloc<T>(d.cap)
	}

	return d
}

// Contains reports whether an element of d is Eq to v, both lent; it
// reads the elements from the front up to the first that is. It is a
// function, since it asks T to be Eq, which a method of Deque cannot.
//
//	if deque.Contains(ref d, ref name) { ... }
func Contains<T: Eq>(d ref Deque<T>, v ref T) bool {
	return Index(d, v).IsSome()
}

// Index returns the place from the front of the first element of d that
// is Eq to v, both lent, or None when there is none; it reads the
// elements from the front up to that one. It is a function, since it
// asks T to be Eq, which a method of Deque cannot.
//
//	if i := deque.Index(ref d, ref name) { d.Remove(i) }
func Index<T: Eq>(d ref Deque<T>, v ref T) int? {
	for i, x := range d.Iter().Enumerate() {
		if x.Eq(v) {
			return Some(i)
		}
	}

	return None
}

// Len returns how many elements the deque holds.
func (d ref Deque<T>) Len() int {
	return d.len
}

// IsEmpty reports whether the deque holds no element.
func (d ref Deque<T>) IsEmpty() bool {
	return d.len == 0
}

// Cap returns how many elements the deque holds before it grows: 0
// before its first buffer, and a power of two after.
func (d ref Deque<T>) Cap() int {
	return d.cap
}

// PushBack adds v at the back, which the deque takes and owns from then
// on. It costs constant time, amortized: when the buffer is full it
// doubles, in one allocation and two block moves of the elements.
func (d mut Deque<T>) PushBack(v T) {
	if d.len == d.cap {
		d.grow()
	}

	rawPut<T>(d.buf, d.slotIndex(d.len), v)
	d.len++
}

// PushFront adds v at the front, which the deque takes and owns from
// then on. It costs constant time, amortized, as PushBack does.
func (d mut Deque<T>) PushFront(v T) {
	if d.len == d.cap {
		d.grow()
	}

	d.head = (d.head - 1) & (d.cap - 1)
	rawPut<T>(d.buf, d.head, v)
	d.len++
}

// PopFront removes the front element and returns it, which the caller
// owns from then on, or None when the deque is empty. It costs constant
// time and never shrinks the buffer.
func (d mut Deque<T>) PopFront() T? {
	if d.len == 0 {
		return None
	}

	v := rawTake<T>(d.buf, d.head)
	d.head = (d.head + 1) & (d.cap - 1)
	d.len--
	return Some(v)
}

// PopBack removes the back element and returns it, which the caller
// owns from then on, or None when the deque is empty. It costs constant
// time and never shrinks the buffer.
func (d mut Deque<T>) PopBack() T? {
	if d.len == 0 {
		return None
	}

	d.len--
	return Some(rawTake<T>(d.buf, d.slotIndex(d.len)))
}

// Front lends the front element, the next PopFront gives, or None when
// the deque is empty. The borrow keeps the deque lent for as long as
// it lives.
func (d ref Deque<T>) Front() ref T? {
	return d.Get(0)
}

// Back lends the back element, the next PopBack gives, or None when
// the deque is empty. The borrow keeps the deque lent for as long as
// it lives.
func (d ref Deque<T>) Back() ref T? {
	return d.Get(d.len - 1)
}

// Get lends the element i from the front, 0 for the front and Len()-1
// for the back, or None when i is negative or Len() or more. It costs
// constant time; the borrow keeps the deque lent for as long as it
// lives.
//
//	if v := d.Get(2) { ... }
func (d ref Deque<T>) Get(i int) ref T? {
	if i < 0 || i >= d.len {
		return None
	}

	return Some(rawRef<T>(d.buf, d.slotIndex(i), d))
}

// GetMut lends the element i from the front for changing in place, or
// None when i is negative or Len() or more. The borrow keeps the deque
// lent mut for as long as it lives.
//
//	if v := d.GetMut(0) { *v = 7 }
func (d mut Deque<T>) GetMut(i int) mut T? {
	if i < 0 || i >= d.len {
		return None
	}

	return Some(rawMut<T>(d.buf, d.slotIndex(i), d))
}

// Insert adds v as the element i from the front, which the deque takes
// and owns from then on, moving the elements from i on one place
// toward the back, or those before i one place toward the front,
// whichever are fewer. An i of Len() or more adds v at the back, and
// one below 0 at the front. It costs a move of at most half the
// elements, in block moves round the ring, and the growth of a full
// buffer, as a push does.
//
//	d.Insert(2, v)
func (d mut Deque<T>) Insert(i int, v T) {
	if i < 0 {
		i = 0
	}

	if i > d.len {
		i = d.len
	}

	if d.len == d.cap {
		d.grow()
	}

	if i < d.len-i {
		d.moveRun(-1, 0, i)
		d.head = (d.head - 1) & (d.cap - 1)
	} else {
		d.moveRun(i+1, i, d.len-i)
	}

	rawPut<T>(d.buf, d.slotIndex(i), v)
	d.len++
}

// Remove takes the element i from the front out and returns it, which
// the caller owns from then on, or None when i is below 0 or Len() or
// more, closing the gap by moving the elements after it one place
// toward the front, or those before it one place toward the back,
// whichever are fewer. It costs a move of at most half the elements, in
// block moves round the ring, and never shrinks the buffer.
//
//	third := d.Remove(2) ?? return
func (d mut Deque<T>) Remove(i int) T? {
	if i < 0 || i >= d.len {
		return None
	}

	v := rawTake<T>(d.buf, d.slotIndex(i))
	if i < d.len-1-i {
		d.moveRun(1, 0, i)
		d.head = (d.head + 1) & (d.cap - 1)
	} else {
		d.moveRun(i, i+1, d.len-1-i)
	}

	d.len--
	return Some(v)
}

// Rotate turns the deque n places toward the back: the last n elements
// come round to the front, so that deque[a b c d] rotated by 1 is
// deque[d a b c]. A negative n turns the other way, the first -n
// elements going to the back, and n is taken modulo Len(), so any n is
// in range. It costs a block move of the fewer elements, the n or the
// Len()-n, round the ring; a full ring moves none, since turning it is
// moving its head.
//
//	d.Rotate(1)  // the back element to the front
//	d.Rotate(-1) // the front element to the back
func (d mut Deque<T>) Rotate(n int) {
	if d.len == 0 {
		return
	}

	n %= d.len
	if n < 0 {
		n += d.len
	}

	if n == 0 {
		return
	}

	if n <= d.len-n { // the last n elements to the slots before the head
		d.moveRun(-n, d.len-n, n)
		d.head = (d.head - n) & (d.cap - 1)
	} else { // the first Len()-n elements to the slots after the back
		m := d.len - n
		d.moveRun(d.len, 0, m)
		d.head = (d.head + m) & (d.cap - 1)
	}
}

// Truncate drops the elements from n on, from the back, and keeps the
// first n and the buffer; an n of Len() or more drops none, and one of
// 0 or less drops every element. It costs one drop for each element
// dropped.
func (d mut Deque<T>) Truncate(n int) {
	if n < 0 {
		n = 0
	}

	for d.len > n {
		_ = d.PopBack()
	}
}

// Extend adds every item of it, an iterator of owned elements, at the
// back, in order; the iterator is lent mut and pulled to the end. It
// costs a PushBack per item.
//
//	d.Extend(mut names.Iter().Map(clone))
func (d mut Deque<T>) Extend<I: iter.Iterator<T>>(it mut I) {
	for {
		d.PushBack(it.Next() ?? break)
	}
}

// Retain calls keep once for each element, from the front, and drops
// every element for which keep returns false; the elements that stay
// keep their order. keep is given the element lent, and held for the
// call alone. Up to the first element dropped nothing moves; after it,
// each element kept moves once, into the gap. The buffer is kept.
//
//	d.Retain(func(v ref int) bool { return *v > 0 })
func (d mut Deque<T>) Retain(keep func(ref T) bool) {
	w := 0
	for w < d.len && keep(rawRef<T>(d.buf, d.slotIndex(w), d)) {
		w++
	}

	if w == d.len {
		return
	}

	_ = rawTake<T>(d.buf, d.slotIndex(w)) // the first element refused, dropped; its slot is the gap
	for i := w + 1; i < d.len; i++ {
		v := rawTake<T>(d.buf, d.slotIndex(i))
		if keep(ref v) {
			rawPut<T>(d.buf, d.slotIndex(w), v)
			w++
		}
	}

	d.len = w
}

// Clear drops every element, from the back, and keeps the buffer for
// the next push. It costs one drop for each element.
func (d mut Deque<T>) Clear() {
	for d.len > 0 {
		_ = d.PopBack()
	}

	d.head = 0
}

// Drop drops the elements still in the deque and frees the buffer. The
// compiler calls it when the deque goes out of scope; a program does
// not call it.
func (d mut Deque<T>) Drop() {
	d.Clear()
	if d.buf != 0 {
		rawFree(d.buf)
		d.buf = 0
	}
}

// Iter returns a walk over the elements from front to back, lending
// each for as long as the deque is lent; nothing is copied. A range
// over the deque lent walks through it: for v := range ref d.
//
//	for v := range ref d { ... }
//	evens := d.Iter().Filter(isEven).Count()
func (d ref Deque<T>) Iter() Iter<T> {
	return Iter<T>{d: d, i: 0, end: d.len}
}

// IterMut returns a walk over the elements from front to back, lending
// each for changing, for as long as the deque is lent mut. A range over
// the deque lent mut walks through it: for v := range mut d.
//
//	for v := range mut d { *v *= 2 }
func (d mut Deque<T>) IterMut() IterMut<T> {
	return IterMut<T>{d: d, i: 0}
}

// String returns the elements from front to back as a new string,
// written as a slice of them is printed, each by fmt.Sprint:
// deque[a b c]. It is how fmt prints a Deque.
func (d ref Deque<T>) String() string {
	out := "deque["
	sep := ""
	for v := range d {
		out = out + sep + fmt.Sprint(v)
		sep = " "
	}

	return out + "]"
}

// Next lends the next element of the walk, from front to back, or None
// once every element has been given from either end. The element is
// lent from the deque, not from the Iter, so it stays good while the
// walk goes on and for as long as the deque is lent; nothing is copied,
// and each call is one index into the ring.
func (it mut Iter<T>) Next() ref T? {
	if it.i >= it.end {
		return None
	}

	it.i++
	return it.d.Get(it.i - 1)
}

// NextBack lends the next element of the walk from the back, or None
// once the back has met the front: iter.Rev over it walks the deque
// from back to front.
func (it mut Iter<T>) NextBack() ref T? {
	if it.end <= it.i {
		return None
	}

	it.end--
	return it.d.Get(it.end)
}

// Next lends the next element of the walk for changing, from front to
// back, or None once every element has been given.
func (it mut IterMut<T>) Next() mut T? {
	if it.i >= it.d.len {
		return None
	}

	it.i++
	return it.d.GetMut(it.i - 1)
}

// moveRun moves the n elements at the places src on to the places dst
// on, places counted from the head, which may be before it: the slots
// they come to hold nothing beforehand, or hold elements of the run
// itself, and n is at most half the buffer, which every caller keeps,
// moving the shorter side or the fewer elements. The runs are moved as
// blocks, each as long as both lie straight in the buffer, in the order
// that reads an element before its slot is written: from the back when
// the move toward the back is shorter than the run, else from the
// front; with a run over half the buffer a move could be unsafe both
// ways. A move by a whole turn of the ring, a full ring rotated, moves
// nothing.
func (d mut Deque<T>) moveRun(dst int, src int, n int) {
	if n == 0 {
		return
	}

	mask := d.cap - 1
	shift := (dst - src) & mask
	if shift == 0 {
		return
	}

	if shift < n { // toward the back, overlapping: the last element first
		for k := n; k > 0; {
			s, t := (d.head+src+k-1)&mask, (d.head+dst+k-1)&mask
			c := k
			if s+1 < c {
				c = s + 1
			}

			if t+1 < c {
				c = t + 1
			}

			rawMove<T>(d.buf, t-c+1, d.buf, s-c+1, c)
			k -= c
		}

		return
	}

	for k := 0; k < n; {
		s, t := (d.head+src+k)&mask, (d.head+dst+k)&mask
		c := n - k
		if d.cap-s < c {
			c = d.cap - s
		}

		if d.cap-t < c {
			c = d.cap - t
		}

		rawMove<T>(d.buf, t, d.buf, s, c)
		k += c
	}
}

// slotIndex returns the slot of the buffer that holds the element i
// from the front.
func (d ref Deque<T>) slotIndex(i int) int {
	return (d.head + i) & (d.cap - 1)
}

// grow doubles the buffer of a full deque, moving the elements to the
// new one as the two runs they lie in, from the head to the end of the
// old buffer and from its start, laid out straight from the new start.
func (d mut Deque<T>) grow() {
	n := d.cap * 2
	if n < minCapacity {
		n = minCapacity
	}

	fresh := rawAlloc<T>(n)
	if d.cap > 0 {
		first := d.cap - d.head
		if first > d.len {
			first = d.len
		}

		rawMove<T>(fresh, 0, d.buf, d.head, first)
		rawMove<T>(fresh, first, d.buf, 0, d.len - first)
		rawFree(d.buf)
	}

	d.buf = fresh
	d.cap = n
	d.head = 0
}

// capacityFor returns the capacity of a buffer for n elements: the
// least power of two that is at least n and at least minCapacity. Past
// maxCapacity it is maxCapacity, which no allocation gives.
func capacityFor(n int) int {
	c := minCapacity
	for c < n && c < maxCapacity {
		c *= 2
	}

	return c
}

// rawAlloc makes a block of n slots of T, n above zero, with a few words
// of a header before them, which a btree's node keeps its count in and
// a deque leaves unread, and returns the first slot's address. The
// compiler writes it for this package and the btree's.
func rawAlloc<T>(n int) int

// rawFree frees the block of slots at p. The compiler writes it.
func rawFree(p int)

// rawPut moves v into the slot i of the block p, which holds nothing.
// The compiler writes it.
func rawPut<T>(p int, i int, v T)

// rawTake moves the element out of the slot i of the block p, which
// holds one. The compiler writes it.
func rawTake<T>(p int, i int) T

// rawRef lends the element in the slot i of the block p, the borrow
// the deque's. The compiler writes it.
func rawRef<T>(p int, i int, d ref Deque<T>) ref T

// rawMut lends the element in the slot i of the block p for changing,
// the borrow the deque's. The compiler writes it.
func rawMut<T>(p int, i int, d mut Deque<T>) mut T

// rawMove moves n elements from the run of slots at si of the block
// src to the run at di of the block dst, which holds nothing. The
// compiler writes it.
func rawMove<T>(dst int, di int, src int, si int, n int)
