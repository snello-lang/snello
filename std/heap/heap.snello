// Package heap is a priority queue: a binary min-heap over a slice,
// ordered by the Cmp of its element type, as sort orders a slice. Pop
// returns the least element first; a type that wants the greatest
// first, or another order, gives itself a Cmp that says so.
//
// The elements are kept in a slice laid out as a complete binary tree:
// the children of the element at index i are at 2i+1 and 2i+2, and no
// element is less than its parent, so the least is at index 0. Push and
// Pop restore that order by moving one element along a path of the
// tree, so each costs O(log n) comparisons; From builds a heap from a
// slice in O(n), Floyd's construction. This is the layout and algorithm
// of Go's container/heap and Rust's BinaryHeap, and Pop is Rust's:
// Floyd's bottom-up descent, about half the comparisons of the textbook
// one. Elements that compare Equal come out in no particular order: a
// heap is not a stable sort.
package heap

// A Heap owns its elements and hands them back least first. It is
// moved, or lent with ref and mut; when it goes out of scope, the
// elements still in it are dropped. The zero value, var h Heap<T>, is
// an empty heap ready for Push.
struct Heap<T: Ord> {
	items []T
}

// New returns an empty heap.
func New<T: Ord>() Heap<T> {
	return Heap<T>{}
}

// From returns a heap holding the elements of xs, which it takes and
// reorders in place, in O(n): each parent, from the last to the root,
// is moved down below its children until it is not greater than
// either. That costs less than pushing the elements one by one, which
// is O(n log n).
func From<T: Ord>(xs []T) Heap<T> {
	h := Heap<T>{items: xs}
	for i := len(h.items)/2 - 1; i >= 0; i-- {
		h.down(i)
	}

	return h
}

// Len returns how many elements the heap holds.
func (h ref Heap<T>) Len() int {
	return len(h.items)
}

// IsEmpty reports whether the heap holds no element.
func (h ref Heap<T>) IsEmpty() bool {
	return len(h.items) == 0
}

// Clear drops every element and keeps the memory for the next Push.
func (h mut Heap<T>) Clear() {
	h.items.Clear()
}

// Push adds v to the heap, which owns it from then on.
func (h mut Heap<T>) Push(v T) {
	h.items.Push(v)
	h.up(len(h.items) - 1)
}

// Pop removes the least element and returns it, or None when the heap
// is empty.
func (h mut Heap<T>) Pop() T? {
	n := len(h.items) - 1
	if n < 0 {
		return None
	}

	h.items.Swap(0, n)
	v := h.items.Pop()
	h.bottom()
	return v
}

// bottom puts the element at the root in its place after a Pop moved
// the last element there. That element is one of the greatest, so it
// belongs near a leaf: it goes down the path of lesser children to the
// bottom, one comparison a level, between the two children, and then
// up while it is less than its parent, which is rarely more than a
// level or two. The textbook descent compares it with a child at every
// level too, twice the comparisons, which counts when Cmp is costly, as
// for strings.
func (h mut Heap<T>) bottom() {
	n := len(h.items)
	i := 0
	child := 1
	for child < n-1 {
		if h.items[child+1].Cmp(h.items[child]) == Less {
			child += 1
		}

		h.items.Swap(i, child)
		i = child
		child = 2*i + 1
	}

	if child == n-1 {
		h.items.Swap(i, child)
		i = child
	}

	h.up(i)
}

// Peek lends the least element without removing it, or None when the
// heap is empty. The borrow lasts as long as the heap's.
func (h ref Heap<T>) Peek() ref T? {
	if len(h.items) == 0 {
		return None
	}

	return Some(ref h.items[0])
}

// up moves the element at i towards the root while it is less than its
// parent.
func (h mut Heap<T>) up(i int) {
	for i > 0 {
		parent := (i - 1) / 2
		if h.items[i].Cmp(h.items[parent]) != Less {
			return
		}

		h.items.Swap(i, parent)
		i = parent
	}
}

// down moves the element at i away from the root while one of its
// children is less than it, swapping it with the lesser child.
func (h mut Heap<T>) down(i int) {
	n := len(h.items)
	for {
		least := 2*i + 1
		if least >= n {
			return
		}

		if right := least + 1; right < n && h.items[right].Cmp(h.items[least]) == Less {
			least = right
		}

		if h.items[least].Cmp(h.items[i]) != Less {
			return
		}

		h.items.Swap(i, least)
		i = least
	}
}
