// Malformed match arms and patterns.

package p

func f(x State) string {
    return match x {
        Closed "closed",                    // ERROR "expected '=>', found '"closed"'"
        Some(n => "n",                      // ERROR "expected ')' to close the pattern, found '=>'"
        1..= => "range",                    // ERROR "expected literal after '..=', found '=>'"
        2 => "a" 3 => "b",                  // ERROR "expected ',' or newline after the arm, found '3'"
        Open { a; b },                      // ERROR "expected '=>', found '{'"
        - => "minus",                       // ERROR "expected number after '-', found '=>'"
        _ => "other",
    }
}
